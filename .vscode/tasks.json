{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build-windows",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Bible.Alarm/Bible.Alarm.csproj",
        "/p:TargetFramework=net9.0-windows10.0.19041.0",
        "/p:Configuration=Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "build-android",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Bible.Alarm/Bible.Alarm.csproj",
        "/p:TargetFramework=net9.0-android",
        "/p:Configuration=Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "build-ios",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Bible.Alarm/Bible.Alarm.csproj",
        "/p:TargetFramework=net9.0-ios",
        "/p:Configuration=Debug"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "deploy-android",
      "dependsOn": "build-android",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Bible.Alarm/Bible.Alarm.csproj",
        "/p:TargetFramework=net9.0-android",
        "/p:Configuration=Debug",
        "/t:Install"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "deploy-ios",
      "dependsOn": "build-ios",
      "command": "dotnet",
      "type": "process",
      "args": [
        "build",
        "${workspaceFolder}/src/Bible.Alarm/Bible.Alarm.csproj",
        "/p:TargetFramework=net9.0-ios",
        "/p:Configuration=Debug",
        "/t:Install"
      ],
      "problemMatcher": "$msCompile",
      "group": "build"
    },
    {
      "label": "clean",
      "command": "dotnet",
      "type": "process",
      "args": [
        "clean",
        "${workspaceFolder}/src/Bible.Alarm/Bible.Alarm.csproj"
      ],
      "problemMatcher": "$msCompile"
    }
  ]
}

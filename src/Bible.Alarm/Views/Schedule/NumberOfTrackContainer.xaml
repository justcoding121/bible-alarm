<?xml version="1.0" encoding="utf-8"?>
<ContentView x:Class="Bible.Alarm.Views.Schedule.NumberOfTrackContainer"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels.Schedule;assembly=Bible.Alarm"
             xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared"
             x:DataType="vm:NumberOfTrackContainerViewModel"
             IsVisible="True">
    <Border Margin="0"
            Padding="0"
            StrokeThickness="0"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            HorizontalOptions="Fill"
            MinimumHeightRequest="56"
            IsVisible="True">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}" 
                    Offset="0,4" 
                    Radius="12" 
                    Opacity="0.2" />
        </Border.Shadow>
        <Grid RowSpacing="0"
              Padding="0"
              MinimumHeightRequest="56"
              IsVisible="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid x:Name="TracksButton"
                  Grid.Row="0"
                  Margin="0"
                  Padding="16,16"
                  BackgroundColor="{DynamicResource ControlBackgroundColor}"
                  MinimumHeightRequest="56"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill"
                  IsVisible="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenModalCommand}"
                                          NumberOfTapsRequired="1" />
                </Grid.GestureRecognizers>
                <Label Grid.Column="0"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       Text="{Binding TrackLabelText}"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       IsVisible="True" />
                <Label Grid.Column="1"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontAttributes="None"
                       HorizontalOptions="End"
                       Text="{Binding CurrentNumberOfTracksText, TargetNullValue=''}"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       IsVisible="True" />
            </Grid>
            <!-- Divider -->
            <BoxView Grid.Row="1"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource DividerColor}"
                     Margin="0"
                     HorizontalOptions="Fill" />
            <Grid x:Name="AlwaysPlayFromStartButton"
                  Grid.Row="2"
                  Margin="0"
                  Padding="16,16"
                  BackgroundColor="{DynamicResource ControlBackgroundColor}"
                  MinimumHeightRequest="56"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleAlwaysPlayFromStartCommand}"
                                          NumberOfTapsRequired="1" />
                </Grid.GestureRecognizers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       Text="{Binding RestartLabelText}"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                <Grid Grid.Column="1"
                      HorizontalOptions="End"
                      VerticalOptions="Center"
                      ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <shared:PlatformSwitch
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        HorizontalOptions="End"
                        IsToggled="{Binding AlwaysPlayFromStart, Mode=TwoWay}"
                        Scale="{OnPlatform Android='1', Default='1'}" />
                </Grid>
            </Grid>
            <!-- Divider -->
            <BoxView Grid.Row="3"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource DividerColor}"
                     Margin="0"
                     HorizontalOptions="Fill">
                <BoxView.IsVisible>
                    <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                        <On Platform="Android" Value="true" />
                    </OnPlatform>
                </BoxView.IsVisible>
            </BoxView>
            <Grid x:Name="ShowNotificationButton"
                  Grid.Row="4"
                  Margin="0"
                  Padding="16,16"
                  BackgroundColor="{DynamicResource ControlBackgroundColor}"
                  MinimumHeightRequest="56"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                <Grid.IsVisible>
                    <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                        <On Platform="Android" Value="true" />
                    </OnPlatform>
                </Grid.IsVisible>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding NotificationEnabledCommand}"
                                          NumberOfTapsRequired="1" />
                </Grid.GestureRecognizers>
                <Label Grid.Column="0"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center">
                    Tap to play
                </Label>
                <Grid Grid.Column="1"
                      HorizontalOptions="End"
                      VerticalOptions="Center"
                      ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <shared:PlatformSwitch
                        Grid.Column="0"
                        Margin="0,0,12,0"
                        HorizontalOptions="End"
                        IsToggled="{Binding NotificationEnabled, Mode=TwoWay}"
                        Scale="{OnPlatform Android='1', Default='1'}" />
                </Grid>
            </Grid>
        </Grid>
    </Border>
</ContentView>


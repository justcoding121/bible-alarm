<?xml version="1.0" encoding="utf-8"?>
<ContentView x:Class="Bible.Alarm.Views.Schedule.NumberOfTrackContainer"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels.Schedule;assembly=Bible.Alarm"
             xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:DataType="vm:NumberOfTrackContainerViewModel"
             IsVisible="True">
    <Border Margin="0"
            Padding="0"
            StrokeThickness="0"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            HorizontalOptions="Fill"
            MinimumHeightRequest="56"
            IsVisible="True">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}" 
                    Offset="0,4" 
                    Radius="12" 
                    Opacity="0.2" />
        </Border.Shadow>
        <Grid RowSpacing="0"
              Padding="0"
              MinimumHeightRequest="56"
              IsVisible="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <core:SfEffectsView Grid.Row="0"
                                 TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                 TouchUpEffects="None"
                                 RippleBackground="{StaticResource PrimaryColor}"
                                 HighlightBackground="{StaticResource PrimaryLightColor}"
                                 RippleAnimationDuration="200"
                                 ShouldIgnoreTouches="False">
                <core:SfEffectsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenModalCommand}"
                                          NumberOfTapsRequired="1" />
                </core:SfEffectsView.GestureRecognizers>
                <Grid x:Name="TracksButton"
                      Margin="0"
                      Padding="16,16"
                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                      MinimumHeightRequest="56"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      IsVisible="True">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontAttributes="None"
                       HorizontalOptions="Start"
                       HorizontalTextAlignment="Start"
                       Text="{Binding TracksLabelText}"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       IsVisible="True" />
                    <Label Grid.Column="1"
                       Margin="16,0,0,0"
                       FontSize="{DynamicResource HeaderFontSize}"
                       FontAttributes="Bold"
                       HorizontalOptions="End"
                       HorizontalTextAlignment="End"
                       Text="{Binding SelectedNumberText}"
                       TextColor="{DynamicResource PrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center"
                       IsVisible="True" />
                </Grid>
            </core:SfEffectsView>
            <!-- Divider -->
            <BoxView Grid.Row="1"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource DividerColor}"
                     Margin="0"
                     HorizontalOptions="Fill" />
            <core:SfEffectsView Grid.Row="2"
                                 TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                 TouchUpEffects="None"
                                 RippleBackground="{StaticResource PrimaryColor}"
                                 HighlightBackground="{StaticResource PrimaryLightColor}"
                                 RippleAnimationDuration="200"
                                 ShouldIgnoreTouches="False">
                <core:SfEffectsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ToggleAlwaysPlayFromStartCommand}"
                                          NumberOfTapsRequired="1" />
                </core:SfEffectsView.GestureRecognizers>
                <Grid x:Name="AlwaysPlayFromStartButton"
                      Margin="0"
                      Padding="16,16"
                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                      MinimumHeightRequest="56"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       Text="{Binding RestartLabelText}"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                <Grid Grid.Column="1"
                      HorizontalOptions="End"
                      VerticalOptions="Center"
                      ColumnSpacing="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <shared:PlatformSwitch
                        Grid.Column="0"
                        Margin="{OnPlatform Default='0'}"
                        HorizontalOptions="End"
                        IsToggled="{Binding AlwaysPlayFromStart, Mode=TwoWay}"
                        Scale="{OnPlatform Android='1', Default='1'}" />
                </Grid>
                </Grid>
            </core:SfEffectsView>
        </Grid>
    </Border>
</ContentView>


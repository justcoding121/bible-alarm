<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage x:Class="Bible.Alarm.Views.Schedule.Schedule"
             xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
             xmlns:scheduleViews="clr-namespace:Bible.Alarm.Views.Schedule;assembly=Bible.Alarm"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:models="clr-namespace:Bible.Alarm.Models"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
             xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:enums="clr-namespace:Bible.Alarm.Shared.Models.Enums;assembly=Bible.Alarm.Shared"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared"
             xmlns:fn="clr-namespace:Bible.Alarm.Views"
             xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
             x:DataType="vm:ScheduleViewModel"
             NavigationPage.HasBackButton="False"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <converters:DayColorConverter x:Key="dayColorConverter" />
        <converters:DayBackgroundColorConverter x:Key="dayBackgroundColorConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid AutomationId="SchedulePage"
              BackgroundColor="{DynamicResource PageBackgroundColor}">
            <Grid Grid.ZIndex="1"
                  Margin="{OnPlatform Default='0', iOS='0,44,0,0', Android='0,24,0,0'}"
                  IsVisible="{Binding IsSchedulePageOverlayVisible, Converter={StaticResource negateBooleanConverter}}"
                  RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Margin="{OnPlatform Default='5,5,5,10',
                                    iOS='5,25,5,10'}"
                  ColumnSpacing="0"
                  RowSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <OnPlatform x:TypeArguments="View">
                    <OnPlatform.Platforms>
                        <On Platform="WinUI">
                            <Button Grid.Column="0"
                                    Margin="0,3,3,3"
                                    AutomationId="CancelButton"
                                    BackgroundColor="{DynamicResource DividerColor}"
                                    CornerRadius="8"
                                    Command="{Binding CancelCommand}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Fill"
                                    HeightRequest="45"
                                    Padding="10,10"
                                    Text="CANCEL"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Fill">
                                <Button.Shadow>
                                    <Shadow Brush="#20000000" 
                                            Offset="0,2" 
                                            Radius="4" 
                                            Opacity="0.2" />
                                </Button.Shadow>
                            </Button>
                        </On>
                        <On Platform="iOS">
                            <Button Grid.Column="0"
                                    Margin="0,3,3,3"
                                    AutomationId="CancelButton"
                                    BackgroundColor="{DynamicResource DividerColor}"
                                    CornerRadius="8"
                                    Command="{Binding CancelCommand}"
                                    FontSize="{StaticResource ButtonFontSize}"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Fill"
                                    HeightRequest="50"
                                    Padding="10,12"
                                    Text="CANCEL"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Fill">
                                <Button.Shadow>
                                    <Shadow Brush="#20000000" 
                                            Offset="0,2" 
                                            Radius="4" 
                                            Opacity="0.2" />
                                </Button.Shadow>
                            </Button>
                        </On>
                        <On Platform="Android">
                            <Button Grid.Column="0"
                                    Margin="0,3,3,3"
                                    AutomationId="CancelButton"
                                    BackgroundColor="{DynamicResource DividerColor}"
                                    CornerRadius="8"
                                    Command="{Binding CancelCommand}"
                                    FontSize="{StaticResource ButtonFontSize}"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Fill"
                                    HeightRequest="45"
                                    Padding="10,6,10,10"
                                    Text="CANCEL"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Center">
                                <Button.Shadow>
                                    <Shadow Brush="#20000000" 
                                            Offset="0,2" 
                                            Radius="4" 
                                            Opacity="0.2" />
                                </Button.Shadow>
                            </Button>
                        </On>
                        <On Platform="Default">
                            <Button Grid.Column="0"
                                    Margin="0,3,3,3"
                                    AutomationId="CancelButton"
                                    BackgroundColor="{DynamicResource DividerColor}"
                                    CornerRadius="8"
                                    Command="{Binding CancelCommand}"
                                    FontSize="{StaticResource ButtonFontSize}"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Fill"
                                    HeightRequest="45"
                                    Padding="10,8"
                                    Text="CANCEL"
                                    TextColor="{DynamicResource TextSecondaryColor}"
                                    VerticalOptions="Fill">
                                <Button.Shadow>
                                    <Shadow Brush="#20000000" 
                                            Offset="0,2" 
                                            Radius="4" 
                                            Opacity="0.2" />
                                </Button.Shadow>
                            </Button>
                        </On>
                    </OnPlatform.Platforms>
                </OnPlatform>
                <OnPlatform x:TypeArguments="View">
                    <OnPlatform.Platforms>
                        <On Platform="WinUI">
                            <Button Grid.Column="1"
                                    Margin="3,3,0,3"
                                    AutomationId="SaveButton"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    CornerRadius="8"
                                    Command="{Binding SaveCommand}"
                                    FontSize="17"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Fill"
                                    HeightRequest="45"
                                    Padding="10,10"
                                    Text="SAVE"
                                    TextColor="White"
                                    VerticalOptions="Fill">
                                <Button.Shadow>
                                    <Shadow Brush="#40000000" 
                                            Offset="0,2" 
                                            Radius="4" 
                                            Opacity="0.3" />
                                </Button.Shadow>
                            </Button>
                        </On>
                        <On Platform="iOS">
                            <Button Grid.Column="1"
                                    Margin="3,3,0,3"
                                    AutomationId="SaveButton"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    CornerRadius="8"
                                    Command="{Binding SaveCommand}"
                                    FontSize="{StaticResource ButtonFontSize}"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Fill"
                                    HeightRequest="50"
                                    Padding="10,12"
                                    Text="SAVE"
                                    TextColor="White"
                                    VerticalOptions="Fill">
                                <Button.Shadow>
                                    <Shadow Brush="#40000000" 
                                            Offset="0,2" 
                                            Radius="4" 
                                            Opacity="0.3" />
                                </Button.Shadow>
                            </Button>
                        </On>
                        <On Platform="Android">
                            <Button Grid.Column="1"
                                    Margin="3,3,0,3"
                                    AutomationId="SaveButton"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    CornerRadius="8"
                                    Command="{Binding SaveCommand}"
                                    FontSize="{StaticResource ButtonFontSize}"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Fill"
                                    HeightRequest="45"
                                    Padding="10,6,10,10"
                                    Text="SAVE"
                                    TextColor="White"
                                    VerticalOptions="Center">
                                <Button.Shadow>
                                    <Shadow Brush="#40000000" 
                                            Offset="0,2" 
                                            Radius="4" 
                                            Opacity="0.3" />
                                </Button.Shadow>
                            </Button>
                        </On>
                        <On Platform="Default">
                            <Button Grid.Column="1"
                                    Margin="3,3,0,3"
                                    AutomationId="SaveButton"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    CornerRadius="8"
                                    Command="{Binding SaveCommand}"
                                    FontSize="{StaticResource ButtonFontSize}"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Fill"
                                    HeightRequest="45"
                                    Padding="10,8"
                                    Text="SAVE"
                                    TextColor="White"
                                    VerticalOptions="Fill">
                                <Button.Shadow>
                                    <Shadow Brush="#40000000" 
                                            Offset="0,2" 
                                            Radius="4" 
                                            Opacity="0.3" />
                                </Button.Shadow>
                            </Button>
                        </On>
                    </OnPlatform.Platforms>
                </OnPlatform>
            </Grid>
            <ScrollView Grid.Row="1"
                        Margin="0,0,0,0">
                    <StackLayout HorizontalOptions="Fill"
                                 Orientation="Vertical"
                                 Spacing="10"
                                 Margin="10,0,10,0">
                        <scheduleViews:ScheduleDetailsContainer BindingContext="{Binding ScheduleDetailsContainerViewModel}" />
                        <scheduleViews:BibleSelectionContainer BindingContext="{Binding BibleSelectionContainerViewModel}" />
                        <scheduleViews:ChaptersSelectionContainer BindingContext="{Binding ChaptersSelectionContainerViewModel}" />
                        <scheduleViews:MusicSelectionContainer BindingContext="{Binding MusicSelectionContainerViewModel}" />

                        <OnPlatform x:TypeArguments="View">
                            <OnPlatform.Platforms>
                                <On Platform="WinUI">
                                    <Button Margin="0,10,0,5"
                                          IsVisible="{Binding IsExistingSchedule}"
                                          VerticalOptions="End"
                                          BackgroundColor="{StaticResource ErrorColor}"
                                          CornerRadius="8"
                                          Command="{Binding DeleteCommand}"
                                          FontSize="17"
                                          FontAttributes="Bold"
                                          HorizontalOptions="Fill"
                                          HeightRequest="45"
                                          Padding="10,10"
                                          Text="DELETE"
                                          TextColor="White">
                                        <Button.Shadow>
                                            <Shadow Brush="#40000000" 
                                                    Offset="0,2" 
                                                    Radius="4" 
                                                    Opacity="0.3" />
                                        </Button.Shadow>
                                    </Button>
                                </On>
                                <On Platform="iOS">
                                    <Button Margin="0,10,0,5"
                                          IsVisible="{Binding IsExistingSchedule}"
                                          VerticalOptions="End"
                                          BackgroundColor="{StaticResource ErrorColor}"
                                          CornerRadius="8"
                                          Command="{Binding DeleteCommand}"
                                          FontSize="{StaticResource ButtonFontSize}"
                                          FontAttributes="Bold"
                                          HorizontalOptions="Fill"
                                          HeightRequest="50"
                                          Padding="10,12"
                                          Text="DELETE"
                                          TextColor="White">
                                        <Button.Shadow>
                                            <Shadow Brush="#40000000" 
                                                    Offset="0,2" 
                                                    Radius="4" 
                                                    Opacity="0.3" />
                                        </Button.Shadow>
                                    </Button>
                                </On>
                                <On Platform="Android">
                                    <Button Margin="0,10,0,5"
                                          IsVisible="{Binding IsExistingSchedule}"
                                          VerticalOptions="End"
                                          BackgroundColor="{StaticResource ErrorColor}"
                                          CornerRadius="8"
                                          Command="{Binding DeleteCommand}"
                                          FontSize="{StaticResource ButtonFontSize}"
                                          FontAttributes="Bold"
                                          HorizontalOptions="Fill"
                                          HeightRequest="45"
                                          Padding="10,6,10,10"
                                          Text="DELETE"
                                          TextColor="White">
                                        <Button.Shadow>
                                            <Shadow Brush="#40000000" 
                                                    Offset="0,2" 
                                                    Radius="4" 
                                                    Opacity="0.3" />
                                        </Button.Shadow>
                                    </Button>
                                </On>
                                <On Platform="Default">
                                    <Button Margin="0,10,0,5"
                                          IsVisible="{Binding IsExistingSchedule}"
                                          VerticalOptions="End"
                                          BackgroundColor="{StaticResource ErrorColor}"
                                          CornerRadius="8"
                                          Command="{Binding DeleteCommand}"
                                          FontSize="{StaticResource ButtonFontSize}"
                                          FontAttributes="Bold"
                                          HorizontalOptions="Fill"
                                          HeightRequest="45"
                                          Padding="10,8"
                                          Text="DELETE"
                                          TextColor="White">
                                        <Button.Shadow>
                                            <Shadow Brush="#40000000" 
                                                    Offset="0,2" 
                                                    Radius="4" 
                                                    Opacity="0.3" />
                                        </Button.Shadow>
                                    </Button>
                                </On>
                            </OnPlatform.Platforms>
                        </OnPlatform>
                    </StackLayout>
                </ScrollView>
            </Grid>
            <!-- Overlay with busy indicator -->
            <Grid Grid.ZIndex="2"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                IsVisible="{Binding IsSchedulePageOverlayVisible}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsEnabled="True"
                IsRunning="{Binding IsSchedulePageOverlayVisible}"
                IsVisible="{Binding IsSchedulePageOverlayVisible}"
                Scale="0.5"
                VerticalOptions="Center"
                Color="SlateBlue">
                <ActivityIndicator.Scale>
                    <OnPlatform x:TypeArguments="system:Double">
                        <OnPlatform.Platforms>
                            <On Platform="iOS" Value="4.0" />
                            <On Platform="Android" Value="1.0" />
                            <On Platform="Win" Value="1.0" />
                        </OnPlatform.Platforms>
                    </OnPlatform>
                </ActivityIndicator.Scale>
            </ActivityIndicator>
            </Grid>
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>

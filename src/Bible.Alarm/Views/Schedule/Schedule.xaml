<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage x:Class="Bible.Alarm.Views.Schedule.Schedule"
             xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
             xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared"
             x:DataType="vm:ScheduleViewModel"
             NavigationPage.HasBackButton="False"
             NavigationPage.HasNavigationBar="False">
    <Grid AutomationId="SchedulePage"
          BackgroundColor="{DynamicResource PageBackgroundColor}"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        
        <!-- Content container - will be populated asynchronously after page loads -->
        <ContentView x:Name="contentContainer"
                     Opacity="0" />
        
        <!-- Overlay with busy indicator - shown immediately, overlays content -->
        <shared:BusyOverlay x:Name="scheduleBusyOverlay"
                            Grid.ZIndex="1"
                            IsVisible="{Binding IsSchedulePageOverlayVisible, Mode=OneWay}" />
    </Grid>
</views:BaseContentPage>

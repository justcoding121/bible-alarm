<?xml version="1.0" encoding="utf-8"?>

<ContentPage x:Class="Bible.Alarm.Views.Schedule.Schedule"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Bible.Alarm.Models"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
             xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
             xmlns:system="clr-namespace:System;assembly=System.Runtime"
             xmlns:enums="clr-namespace:Bible.Alarm.Shared.Models.Enums;assembly=Bible.Alarm.Shared"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
             xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared"
             xmlns:fn="clr-namespace:Bible.Alarm.Views"
             xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
             x:DataType="vm:ScheduleViewModel"
             NavigationPage.HasBackButton="False"
             NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <converters:DayColorConverter x:Key="dayColorConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid AutomationId="SchedulePage"
              BackgroundColor="White">
            <Grid Grid.ZIndex="1"
                  Margin="{OnPlatform iOS='0,10,0,0'}"
                  IsVisible="{Binding IsSchedulePageOverlayVisible, Converter={StaticResource negateBooleanConverter}}"
                  RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="auto" />
                </Grid.RowDefinitions>
            <Grid Grid.Row="0"
                  Margin="{OnPlatform Default='5,5,5,10',
                                    iOS='5,25,5,10'}"
                  ColumnSpacing="0"
                  RowSpacing="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0"
                        Margin="0,3,3,3"
                        AutomationId="CancelButton"
                        BackgroundColor="{OnPlatform Default='WhiteSmoke',
                                                     WinUI='LightGray'}"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding CancelCommand}"
                        FontSize="{StaticResource ButtonFontSize}"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        MinimumHeightRequest="{OnPlatform Default='40',
                                                      WinUI='30'}"
                        Padding="10,8"
                        Text="CANCEL"
                        TextColor="SlateBlue"
                        VerticalOptions="Fill" />
                <Button Grid.Column="1"
                        Margin="3,3,0,3"
                        AutomationId="SaveButton"
                        BackgroundColor="{OnPlatform Default='WhiteSmoke',
                                                     WinUI='LightGray'}"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding SaveCommand}"
                        FontSize="{StaticResource ButtonFontSize}"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        MinimumHeightRequest="{OnPlatform Default='40',
                                                          WinUI='30'}"
                        Padding="10,8"
                        Text="SAVE"
                        TextColor="SlateBlue"
                        VerticalOptions="Fill" />
            </Grid>
            <ScrollView Grid.Row="1"
                        Margin="0,0,0,0">
                    <StackLayout HorizontalOptions="Fill"
                                 Orientation="Vertical"
                                 Spacing="10"
                                 Margin="10,0">
                        <StackLayout.Resources>
                            <enums:DaysOfWeek x:Key="Sunday">Sunday</enums:DaysOfWeek>
                            <enums:DaysOfWeek x:Key="Monday">Monday</enums:DaysOfWeek>
                            <enums:DaysOfWeek x:Key="Tuesday">Tuesday</enums:DaysOfWeek>
                            <enums:DaysOfWeek x:Key="Wednesday">Wednesday</enums:DaysOfWeek>
                            <enums:DaysOfWeek x:Key="Thursday">Thursday</enums:DaysOfWeek>
                            <enums:DaysOfWeek x:Key="Friday">Friday</enums:DaysOfWeek>
                            <enums:DaysOfWeek x:Key="Saturday">Saturday</enums:DaysOfWeek>
                        </StackLayout.Resources>
                        <TimePicker AutomationId="AlarmTimePicker"
                                    BackgroundColor="White"
                                    FontSize="{StaticResource TitleFontSize}"
                                    HorizontalOptions="Center"
                                    Margin="0"
                                    TextColor="SlateBlue"
                                    Time="{Binding Time, Mode=TwoWay}">
                            <TimePicker.Format>hh:mm tt</TimePicker.Format>
                        </TimePicker>
                        <StackLayout Margin="0"
                                     HorizontalOptions="Center"
                                     Orientation="Horizontal">
                            <Button Margin="5,0,0,0"
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Sunday}}"
                                    BorderWidth="2"
                                    Command="{Binding ToggleDayCommand}"
                                    CommandParameter="{StaticResource Sunday}"
                                    FontAttributes="Bold"
                                    Text="S"
                                    TextColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Sunday}}"
                                    WidthRequest="35"
                                    HeightRequest="35" />
                            <Button Margin="2,0,0,0"
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Monday}}"
                                    BorderWidth="2"
                                    Command="{Binding ToggleDayCommand}"
                                    CommandParameter="{StaticResource Monday}"
                                    FontAttributes="Bold"
                                    Text="M"
                                    TextColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Monday}}"
                                    WidthRequest="35"
                                    HeightRequest="35" />
                            <Button Margin="2,0,0,0"
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Tuesday}}"
                                    BorderWidth="2"
                                    Command="{Binding ToggleDayCommand}"
                                    CommandParameter="{StaticResource Tuesday}"
                                    FontAttributes="Bold"
                                    Text="T"
                                    TextColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Tuesday}}"
                                    WidthRequest="35"
                                    HeightRequest="35" />
                            <Button Margin="2,0,0,0"
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Wednesday}}"
                                    BorderWidth="2"
                                    Command="{Binding ToggleDayCommand}"
                                    CommandParameter="{StaticResource Wednesday}"
                                    FontAttributes="Bold"
                                    Text="W"
                                    TextColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Wednesday}}"
                                    WidthRequest="35"
                                    HeightRequest="35" />
                            <Button Margin="2,0,0,0"
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Thursday}}"
                                    BorderWidth="2"
                                    Command="{Binding ToggleDayCommand}"
                                    CommandParameter="{StaticResource Thursday}"
                                    FontAttributes="Bold"
                                    Text="T"
                                    TextColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Thursday}}"
                                    WidthRequest="35"
                                    HeightRequest="35" />
                            <Button Margin="2,0,0,0"
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Friday}}"
                                    BorderWidth="2"
                                    Command="{Binding ToggleDayCommand}"
                                    CommandParameter="{StaticResource Friday}"
                                    FontAttributes="Bold"
                                    Text="F"
                                    TextColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Friday}}"
                                    WidthRequest="35"
                                    HeightRequest="35" />
                            <Button Margin="2,0,0,0"
                                    Padding="0"
                                    BackgroundColor="White"
                                    BorderColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Saturday}}"
                                    BorderWidth="2"
                                    Command="{Binding ToggleDayCommand}"
                                    CommandParameter="{StaticResource Saturday}"
                                    FontAttributes="Bold"
                                    Text="S"
                                    TextColor="{Binding DaysOfWeek, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Saturday}}"
                                    WidthRequest="35"
                                    HeightRequest="35" />
                        </StackLayout>
                        <StackLayout
                            Margin="0"
                            HorizontalOptions="Center"
                            Orientation="Horizontal">
                            <Border
                                StrokeThickness="1"
                                Stroke="LightGray"
                                BackgroundColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="5" />
                                </Border.StrokeShape>
                                <Entry
                                    Margin="8,4"
                                    MaxLength="30"
                                    MinimumWidthRequest="200"
                                    Placeholder="Schedule Name"
                                    Text="{Binding Name, Mode=TwoWay}"
                                    BackgroundColor="Transparent" />
                            </Border>
                        </StackLayout>
                        <Border Margin="0"
                               Padding="0"
                               StrokeThickness="1"
                               Stroke="LightGray"
                               BackgroundColor="WhiteSmoke"
                               HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <StackLayout Orientation="Vertical"
                                         Spacing="0">
                                <Grid x:Name="BibleButton"
                                      Margin="5,5,5,5"
                                      BackgroundColor="WhiteSmoke"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectBibleCommand}"
                                                              NumberOfTapsRequired="1" />
                                    </Grid.GestureRecognizers>

                                    <Label Grid.Column="0"
                                           Margin="5,0,0,0"
                                           Padding="10"
                                           HorizontalTextAlignment="Start"
                                           Text="Current schedule"
                                           TextColor="Black"
                                           VerticalOptions="Center" />
                                    <StackLayout Grid.Column="1"
                                                 HorizontalOptions="End"
                                                 Orientation="Horizontal"
                                                 VerticalOptions="Center">
                                        <Label Margin="5,0,0,0"
                                               HorizontalTextAlignment="End"
                                               Text="{Binding BibleReadingTitleText}"
                                               TextColor="SlateBlue" />
                                        <Label
                                            Margin="10,0,10,0"
                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                            Style="{StaticResource MediumLabelStyle}"
                                            HorizontalOptions="End"
                                            Text="{x:Static fn:GlyphNames.Right}"
                                            TextColor="Gray"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                </Grid>
                                <Grid x:Name="BibleBookButton"
                                      Margin="5,5,5,5"
                                      BackgroundColor="WhiteSmoke"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <Label Grid.Column="0"
                                           Margin="5,0,0,0"
                                           Padding="10"
                                           HorizontalTextAlignment="Start"
                                           Text="Book"
                                           TextColor="Black"
                                           VerticalOptions="Center" />
                                    <StackLayout Grid.Column="1"
                                                 HorizontalOptions="End"
                                                 Orientation="Horizontal"
                                                 VerticalOptions="Center">
                                        <Button
                                            Margin="10,0,10,0"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            BorderColor="Transparent"
                                            Command="{Binding PreviousBookCommand}"
                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                            Style="{StaticResource MediumLabelStyle}"
                                            HorizontalOptions="End"
                                            Text="{x:Static fn:GlyphNames.Previous}"
                                            TextColor="Gray"
                                            VerticalOptions="Center" />
                                        <Button
                                            Margin="10,0,15,0"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            BorderColor="Transparent"
                                            Command="{Binding NextBookCommand}"
                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                            Style="{StaticResource MediumLabelStyle}"
                                            HorizontalOptions="End"
                                            Text="{x:Static fn:GlyphNames.Next}"
                                            TextColor="Gray"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                </Grid>
                                <Grid x:Name="BibleChapterButton"
                                      Margin="5,5,5,5"
                                      BackgroundColor="WhiteSmoke"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>

                                    <Label Grid.Column="0"
                                           Margin="5,0,0,0"
                                           Padding="10"
                                           HorizontalTextAlignment="Start"
                                           Text="Chapter"
                                           TextColor="Black"
                                           VerticalOptions="Center" />
                                    <StackLayout Grid.Column="1"
                                                 HorizontalOptions="End"
                                                 Orientation="Horizontal"
                                                 VerticalOptions="Center">
                                        <Button
                                            Margin="10,0,10,0"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            BorderColor="Transparent"
                                            Command="{Binding PreviousChapterCommand}"
                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                            Style="{StaticResource MediumLabelStyle}"
                                            HorizontalOptions="End"
                                            Text="{x:Static fn:GlyphNames.Previous}"
                                            TextColor="Gray"
                                            VerticalOptions="Center" />
                                        <Button
                                            Margin="10,0,15,0"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            BorderColor="Transparent"
                                            Command="{Binding NextChapterCommand}"
                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                            Style="{StaticResource MediumLabelStyle}"
                                            HorizontalOptions="End"
                                            Text="{x:Static fn:GlyphNames.Next}"
                                            TextColor="Gray"
                                            VerticalOptions="Center" />
                                    </StackLayout>
                                </Grid>
                            </StackLayout>
                        </Border>
                        <Border Margin="0"
                               Padding="0"
                               StrokeThickness="1"
                               Stroke="LightGray"
                               BackgroundColor="WhiteSmoke"
                               HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid x:Name="ChaptersButton"
                                  Margin="5,5,5,5"
                                  BackgroundColor="WhiteSmoke"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="7*" />
                                <ColumnDefinition Width="3*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenModalCommand}"
                                                      NumberOfTapsRequired="1" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Margin="5,0,0,0"
                                   Padding="10"
                                   HorizontalTextAlignment="Start"
                                   Text="Number of chapters to play"
                                   TextColor="Black"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="1"
                                   Margin="0,0,5,0"
                                   HorizontalOptions="End"
                                   Text="{Binding CurrentNumberOfChaptersText}"
                                   TextColor="SlateBlue"
                                   VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        <Border Margin="0"
                               Padding="0"
                               StrokeThickness="1"
                               Stroke="LightGray"
                               BackgroundColor="WhiteSmoke"
                               HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <StackLayout Orientation="Vertical"
                                         Spacing="0">
                                <Grid x:Name="AlwaysPlayFromStartButton"
                                      Margin="5,5,5,5"
                                      BackgroundColor="WhiteSmoke"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding ToggleAlwaysPlayFromStartCommand}"
                                                          NumberOfTapsRequired="1" />
                                </Grid.GestureRecognizers>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="7*" />
                                    <ColumnDefinition Width="3*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                            <Label Grid.Column="0"
                                   Margin="5,0,0,0"
                                   Padding="10"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   TextColor="Black"
                                   VerticalOptions="Center">
                                Resume unfinished chapters from the beginning
                            </Label>
                            <StackLayout Grid.Column="1"
                                         HorizontalOptions="End"
                                         Orientation="Horizontal"
                                         VerticalOptions="Center">
                                <shared:PlatformSwitch
                                    Margin="0,0,15,0"
                                    HorizontalOptions="End"
                                    IsToggled="{Binding AlwaysPlayFromStart, Mode=TwoWay}"
                                    Scale="{OnPlatform Android='1', Default='1'}" />
                            </StackLayout>
                            </Grid>
                            <Grid x:Name="ShowNotificationButton"
                                  Margin="5,0,5,0"
                                  BackgroundColor="WhiteSmoke"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill">
                            <Grid.IsVisible>
                                <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                                    <On Platform="Android" Value="true" />
                                </OnPlatform>
                            </Grid.IsVisible>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="6*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NotificationEnabledCommand}"
                                                      NumberOfTapsRequired="1" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Margin="5,0,0,0"
                                   Padding="10"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   TextColor="Black"
                                   VerticalOptions="Center">
                                Play only when I tap on alarm notification
                            </Label>
                            <StackLayout Grid.Column="1"
                                         HorizontalOptions="End"
                                         Orientation="Horizontal"
                                         VerticalOptions="Center">
                                <shared:PlatformSwitch
                                    Margin="0,0,15,0"
                                    HorizontalOptions="End"
                                    IsToggled="{Binding NotificationEnabled, Mode=TwoWay}"
                                    Scale="{OnPlatform Android='1', Default='1'}" />
                            </StackLayout>
                                </Grid>
                            </StackLayout>
                        </Border>
                        <Border Margin="0"
                               Padding="0"
                               StrokeThickness="1"
                               Stroke="LightGray"
                               BackgroundColor="WhiteSmoke"
                               HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="10" />
                            </Border.StrokeShape>
                            <Grid x:Name="MusicButton"
                                  Margin="5,5,5,5"
                                  BackgroundColor="WhiteSmoke"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="5*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectMusicCommand}"
                                                      NumberOfTapsRequired="1" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Margin="5,0,0,0"
                                   Padding="10"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   TextColor="Black"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center">
                                Play a music track before Bible audio
                            </Label>
                            <StackLayout Grid.Column="1"
                                         HorizontalOptions="End"
                                         Orientation="Horizontal"
                                         Spacing="0"
                                         VerticalOptions="Center">
                                <shared:PlatformSwitch
                                    Margin="0,0,5,0"
                                    HorizontalOptions="Start"
                                    IsToggled="{Binding MusicEnabled, Mode=TwoWay}"
                                    Scale="{OnPlatform Android='1', Default='1'}" />
                                <Label Margin="0,0,10,0"
                                       FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                       Style="{StaticResource MediumLabelStyle}"
                                       HorizontalOptions="End"
                                       Text="{x:Static fn:GlyphNames.Right}"
                                       TextColor="Gray"
                                       VerticalOptions="Center"
                                       VerticalTextAlignment="Center" />
                            </StackLayout>
                        </Grid>
                        </Border>

                        <Grid Margin="5,10,5,5"
                              IsVisible="{Binding IsExistingSchedule}"
                              VerticalOptions="End">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                            </Grid.GestureRecognizers>
                            <Border BackgroundColor="{OnPlatform Default='WhiteSmoke',
                                                                 WinUI='LightGray'}"
                                    StrokeThickness="0"
                                    Padding="10,8"
                                    HorizontalOptions="Fill"
                                    MinimumHeightRequest="{OnPlatform Default='40',
                                                                  WinUI='30'}">
                                <StackLayout Orientation="Horizontal"
                                             HorizontalOptions="Center"
                                             Spacing="8"
                                             VerticalOptions="Center">
                                    <Label Text="DELETE"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           FontAttributes="Bold"
                                           TextColor="SlateBlue"
                                           VerticalOptions="Center" />
                                    <Label FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                           FontSize="{StaticResource ButtonFontSize}"
                                           Text="{x:Static fn:GlyphNames.Trash}"
                                           TextColor="SlateBlue"
                                           VerticalOptions="Center" />
                                </StackLayout>
                            </Border>
                        </Grid>
                    </StackLayout>
                </ScrollView>
            </Grid>
            <!-- Overlay with busy indicator -->
            <Grid Grid.ZIndex="2"
                BackgroundColor="White"
                IsVisible="{Binding IsSchedulePageOverlayVisible}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsEnabled="True"
                IsRunning="{Binding IsSchedulePageOverlayVisible}"
                IsVisible="{Binding IsSchedulePageOverlayVisible}"
                Scale="0.5"
                VerticalOptions="Center"
                Color="SlateBlue">
                <ActivityIndicator.Scale>
                    <OnPlatform x:TypeArguments="system:Double">
                        <OnPlatform.Platforms>
                            <On Platform="iOS" Value="4.0" />
                            <On Platform="Android" Value="1.0" />
                            <On Platform="Win" Value="1.0" />
                        </OnPlatform.Platforms>
                    </OnPlatform>
                </ActivityIndicator.Scale>
            </ActivityIndicator>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
                                            Opacity="0.1" />
                                </Border.Shadow>
                                <Entry
                                    Margin="12,8"
                                    MaxLength="30"
                                    MinimumWidthRequest="200"
                                    Placeholder="Schedule Name"
                                    Text="{Binding Name, Mode=TwoWay}"
                                    BackgroundColor="Transparent"
                                    TextColor="{DynamicResource TextPrimaryColor}" />
                            </Border>
                        </StackLayout>
                        <Border Margin="0"
                               Padding="0"
                               StrokeThickness="2"
                               Stroke="{StaticResource PrimaryColor}"
                               BackgroundColor="{DynamicResource CardBackgroundColor}"
                               HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#20000000" 
                                        Offset="0,2" 
                                        Radius="8" 
                                        Opacity="0.2" />
                            </Border.Shadow>
                            <StackLayout Orientation="Vertical"
                                         Spacing="0">
                                <!-- Translation Name & Language with right arrow -->
                                <Grid x:Name="BibleTranslationButton"
                                      Margin="8,8,8,8"
                                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectBibleCommand}"
                                                              NumberOfTapsRequired="1" />
                                    </Grid.GestureRecognizers>

                                    <Grid Padding="10"
                                          ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <Label Grid.Column="0"
                                               FontSize="16"
                                               HorizontalOptions="Fill"
                                               HorizontalTextAlignment="Start"
                                               Text="{Binding TranslationDisplayText}"
                                               TextColor="{DynamicResource PrimaryTextColor}"
                                               VerticalOptions="Center"
                                               VerticalTextAlignment="Center" />
                                        <!-- Arrow Indicator - more prominent to indicate tappable -->
                                        <Border
                                            Grid.Column="1"
                                            BackgroundColor="{DynamicResource DividerColor}"
                                            HeightRequest="36"
                                            HorizontalOptions="End"
                                            StrokeThickness="0"
                                            VerticalOptions="Center"
                                            WidthRequest="36">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18" />
                                            </Border.StrokeShape>
                                            <Label
                                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                FontSize="16"
                                                HorizontalOptions="Center"
                                                HorizontalTextAlignment="Center"
                                                InputTransparent="True"
                                                Text="{x:Static fn:GlyphNames.Right}"
                                                TextColor="{DynamicResource PrimaryTextColor}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Grid>
                                <Grid x:Name="BibleBookButton"
                                      Margin="8,0,8,8"
                                      BackgroundColor="Transparent"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill">
                                    <Grid Padding="10"
                                          ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <Label Grid.Column="0"
                                               FontSize="16"
                                               HorizontalTextAlignment="Start"
                                               Text="{Binding BookDisplayText}"
                                               TextColor="{DynamicResource PrimaryTextColor}"
                                               VerticalOptions="Center" />
                                        <StackLayout Grid.Column="1"
                                                     HorizontalOptions="End"
                                                     Orientation="Horizontal"
                                                     Spacing="8"
                                                     VerticalOptions="Center">
                                            <OnPlatform x:TypeArguments="View">
                                                <OnPlatform.Platforms>
                                                    <On Platform="iOS">
                                                        <Button Padding="0"
                                                                BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                                CornerRadius="6"
                                                                Command="{Binding PreviousBookCommand}"
                                                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                                FontSize="20"
                                                                HeightRequest="36"
                                                                WidthRequest="36"
                                                                HorizontalOptions="End"
                                                                Text="{x:Static fn:GlyphNames.Left}"
                                                                TextColor="{DynamicResource TextSecondaryColor}"
                                                                VerticalOptions="Center" />
                                                    </On>
                                                    <On Platform="Default">
                                                        <Button
                                                            Padding="0"
                                                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                            CornerRadius="6"
                                                            Command="{Binding PreviousBookCommand}"
                                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                            FontSize="20"
                                                            HeightRequest="36"
                                                            WidthRequest="36"
                                                            HorizontalOptions="End"
                                                            Text="{x:Static fn:GlyphNames.Left}"
                                                            TextColor="{DynamicResource TextSecondaryColor}"
                                                            VerticalOptions="Center" />
                                                    </On>
                                                </OnPlatform.Platforms>
                                            </OnPlatform>
                                            <OnPlatform x:TypeArguments="View">
                                                <OnPlatform.Platforms>
                                                    <On Platform="iOS">
                                                        <Button Padding="0"
                                                                BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                                CornerRadius="6"
                                                                Command="{Binding NextBookCommand}"
                                                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                                FontSize="20"
                                                                HeightRequest="36"
                                                                WidthRequest="36"
                                                                HorizontalOptions="End"
                                                                Text="{x:Static fn:GlyphNames.Right}"
                                                                TextColor="{DynamicResource TextSecondaryColor}"
                                                                VerticalOptions="Center" />
                                                    </On>
                                                    <On Platform="Default">
                                                        <Button
                                                            Padding="0"
                                                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                            CornerRadius="6"
                                                            Command="{Binding NextBookCommand}"
                                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                            FontSize="20"
                                                            HeightRequest="36"
                                                            WidthRequest="36"
                                                            HorizontalOptions="End"
                                                            Text="{x:Static fn:GlyphNames.Right}"
                                                            TextColor="{DynamicResource TextSecondaryColor}"
                                                            VerticalOptions="Center" />
                                                    </On>
                                                </OnPlatform.Platforms>
                                            </OnPlatform>
                                        </StackLayout>
                                    </Grid>
                                </Grid>
                                <Grid x:Name="BibleChapterButton"
                                      Margin="8,0,8,8"
                                      BackgroundColor="Transparent"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill">
                                    <Grid Padding="10"
                                          ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <Label Grid.Column="0"
                                               FontSize="16"
                                               HorizontalTextAlignment="Start"
                                               Text="{Binding ChapterDisplayText}"
                                               TextColor="{DynamicResource PrimaryTextColor}"
                                               VerticalOptions="Center" />
                                        <StackLayout Grid.Column="1"
                                                     HorizontalOptions="End"
                                                     Orientation="Horizontal"
                                                     Spacing="8"
                                                     VerticalOptions="Center">
                                            <OnPlatform x:TypeArguments="View">
                                                <OnPlatform.Platforms>
                                                    <On Platform="iOS">
                                                        <Button Padding="0"
                                                                BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                                CornerRadius="6"
                                                                Command="{Binding PreviousChapterCommand}"
                                                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                                FontSize="20"
                                                                HeightRequest="36"
                                                                WidthRequest="36"
                                                                HorizontalOptions="End"
                                                                Text="{x:Static fn:GlyphNames.Left}"
                                                                TextColor="{DynamicResource TextSecondaryColor}"
                                                                VerticalOptions="Center" />
                                                    </On>
                                                    <On Platform="Default">
                                                        <Button
                                                            Padding="0"
                                                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                            CornerRadius="6"
                                                            Command="{Binding PreviousChapterCommand}"
                                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                            FontSize="20"
                                                            HeightRequest="36"
                                                            WidthRequest="36"
                                                            HorizontalOptions="End"
                                                            Text="{x:Static fn:GlyphNames.Left}"
                                                            TextColor="{DynamicResource TextSecondaryColor}"
                                                            VerticalOptions="Center" />
                                                    </On>
                                                </OnPlatform.Platforms>
                                            </OnPlatform>
                                            <OnPlatform x:TypeArguments="View">
                                                <OnPlatform.Platforms>
                                                    <On Platform="iOS">
                                                        <Button Padding="0"
                                                                BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                                CornerRadius="6"
                                                                Command="{Binding NextChapterCommand}"
                                                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                                FontSize="20"
                                                                HeightRequest="36"
                                                                WidthRequest="36"
                                                                HorizontalOptions="End"
                                                                Text="{x:Static fn:GlyphNames.Right}"
                                                                TextColor="{DynamicResource TextSecondaryColor}"
                                                                VerticalOptions="Center" />
                                                    </On>
                                                    <On Platform="Default">
                                                        <Button
                                                            Padding="0"
                                                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                            CornerRadius="6"
                                                            Command="{Binding NextChapterCommand}"
                                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                            FontSize="20"
                                                            HeightRequest="36"
                                                            WidthRequest="36"
                                                            HorizontalOptions="End"
                                                            Text="{x:Static fn:GlyphNames.Right}"
                                                            TextColor="{DynamicResource TextSecondaryColor}"
                                                            VerticalOptions="Center" />
                                                    </On>
                                                </OnPlatform.Platforms>
                                            </OnPlatform>
                                        </StackLayout>
                                    </Grid>
                                </Grid>
                            </StackLayout>
                        </Border>
                        <Border Margin="0"
                               Padding="0"
                               StrokeThickness="0"
                               BackgroundColor="{DynamicResource CardBackgroundColor}"
                               HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}" 
                                        Offset="0,2" 
                                        Radius="8" 
                                        Opacity="0.15" />
                            </Border.Shadow>
                            <Grid x:Name="MusicButton"
                                  Margin="8,8,8,8"
                                  BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                  HorizontalOptions="Fill"
                                  VerticalOptions="Fill">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="5*" />
                                <ColumnDefinition Width="5*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                            </Grid.RowDefinitions>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding SelectMusicCommand}"
                                                      NumberOfTapsRequired="1" />
                            </Grid.GestureRecognizers>
                            <Label Grid.Column="0"
                                   Margin="5,0,0,0"
                                   Padding="10"
                                   HorizontalOptions="Fill"
                                   HorizontalTextAlignment="Start"
                                   TextColor="{DynamicResource TextPrimaryColor}"
                                   VerticalOptions="Center"
                                   VerticalTextAlignment="Center">
                                Play a music track before Bible audio
                            </Label>
                            <StackLayout Grid.Column="1"
                                         HorizontalOptions="End"
                                         Orientation="Horizontal"
                                         Spacing="8"
                                         VerticalOptions="Center">
                                <shared:PlatformSwitch
                                    Margin="0,0,0,0"
                                    HorizontalOptions="Start"
                                    IsToggled="{Binding MusicEnabled, Mode=TwoWay}"
                                    Scale="{OnPlatform Android='1', Default='1'}" />
                                <!-- Arrow Indicator matching list view items -->
                                <Border
                                    BackgroundColor="{DynamicResource DividerColor}"
                                    HeightRequest="32"
                                    HorizontalOptions="End"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="32">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Label
                                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                        FontSize="14"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        InputTransparent="True"
                                        Text="{x:Static fn:GlyphNames.Right}"
                                        TextColor="{DynamicResource TextSecondaryColor}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </Border>
                            </StackLayout>
                        </Grid>
                        </Border>
                        <Border Margin="0"
                               Padding="0"
                               StrokeThickness="0"
                               BackgroundColor="{DynamicResource CardBackgroundColor}"
                               HorizontalOptions="Fill">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}" 
                                        Offset="0,2" 
                                        Radius="8" 
                                        Opacity="0.15" />
                            </Border.Shadow>
                            <StackLayout Orientation="Vertical"
                                         Spacing="0">
                                <Grid x:Name="ChaptersButton"
                                      Margin="8,8,8,8"
                                      BackgroundColor="Transparent"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenModalCommand}"
                                                              NumberOfTapsRequired="1" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0"
                                           Margin="5,0,0,0"
                                           Padding="10"
                                           HorizontalTextAlignment="Start"
                                           Text="Number of chapters to play"
                                           TextColor="{DynamicResource TextPrimaryColor}"
                                           VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                           Margin="0,0,5,0"
                                           HorizontalOptions="End"
                                           Text="{Binding CurrentNumberOfChaptersText}"
                                           TextColor="{DynamicResource PrimaryTextColor}"
                                           VerticalOptions="Center" />
                                </Grid>
                                <Grid x:Name="AlwaysPlayFromStartButton"
                                      Margin="8,0,8,8"
                                      BackgroundColor="Transparent"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding ToggleAlwaysPlayFromStartCommand}"
                                                              NumberOfTapsRequired="1" />
                                    </Grid.GestureRecognizers>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="7*" />
                                        <ColumnDefinition Width="3*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Label Grid.Column="0"
                                           Margin="5,0,0,0"
                                           Padding="10"
                                           HorizontalOptions="Fill"
                                           HorizontalTextAlignment="Start"
                                           TextColor="{DynamicResource TextPrimaryColor}"
                                           VerticalOptions="Center">
                                        Resume unfinished chapters from the beginning
                                    </Label>
                                    <StackLayout Grid.Column="1"
                                                 HorizontalOptions="End"
                                                 Orientation="Horizontal"
                                                 VerticalOptions="Center">
                                        <shared:PlatformSwitch
                                            Margin="0,0,15,0"
                                            HorizontalOptions="End"
                                            IsToggled="{Binding AlwaysPlayFromStart, Mode=TwoWay}"
                                            Scale="{OnPlatform Android='1', Default='1'}" />
                                    </StackLayout>
                                </Grid>
                                <Grid x:Name="ShowNotificationButton"
                                      Margin="8,0,8,8"
                                      BackgroundColor="Transparent"
                                      HorizontalOptions="Fill"
                                      VerticalOptions="Fill">
                                    <Grid.IsVisible>
                                        <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                                            <On Platform="Android" Value="true" />
                                        </OnPlatform>
                                    </Grid.IsVisible>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="6*" />
                                        <ColumnDefinition Width="4*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding NotificationEnabledCommand}"
                                                              NumberOfTapsRequired="1" />
                                    </Grid.GestureRecognizers>
                                    <Label Grid.Column="0"
                                           Margin="5,0,0,0"
                                           Padding="10"
                                           HorizontalOptions="Fill"
                                           HorizontalTextAlignment="Start"
                                           TextColor="{DynamicResource TextPrimaryColor}"
                                           VerticalOptions="Center">
                                        Play only when I tap on alarm notification
                                    </Label>
                                    <StackLayout Grid.Column="1"
                                                 HorizontalOptions="End"
                                                 Orientation="Horizontal"
                                                 VerticalOptions="Center">
                                        <shared:PlatformSwitch
                                            Margin="0,0,15,0"
                                            HorizontalOptions="End"
                                            IsToggled="{Binding NotificationEnabled, Mode=TwoWay}"
                                            Scale="{OnPlatform Android='1', Default='1'}" />
                                    </StackLayout>
                                </Grid>
                            </StackLayout>
                        </Border>

                        <OnPlatform x:TypeArguments="View">
                            <OnPlatform.Platforms>
                                <On Platform="WinUI">
                                    <Button Margin="0,10,0,5"
                                          IsVisible="{Binding IsExistingSchedule}"
                                          VerticalOptions="End"
                                          BackgroundColor="{StaticResource ErrorColor}"
                                          CornerRadius="8"
                                          Command="{Binding DeleteCommand}"
                                          FontSize="17"
                                          FontAttributes="Bold"
                                          HorizontalOptions="Fill"
                                          HeightRequest="45"
                                          Padding="10,10"
                                          Text="DELETE"
                                          TextColor="White">
                                        <Button.Shadow>
                                            <Shadow Brush="#40000000" 
                                                    Offset="0,2" 
                                                    Radius="4" 
                                                    Opacity="0.3" />
                                        </Button.Shadow>
                                    </Button>
                                </On>
                                <On Platform="iOS">
                                    <Button Margin="0,10,0,5"
                                          IsVisible="{Binding IsExistingSchedule}"
                                          VerticalOptions="End"
                                          BackgroundColor="{StaticResource ErrorColor}"
                                          CornerRadius="8"
                                          Command="{Binding DeleteCommand}"
                                          FontSize="{StaticResource ButtonFontSize}"
                                          FontAttributes="Bold"
                                          HorizontalOptions="Fill"
                                          HeightRequest="50"
                                          Padding="10,12"
                                          Text="DELETE"
                                          TextColor="White">
                                        <Button.Shadow>
                                            <Shadow Brush="#40000000" 
                                                    Offset="0,2" 
                                                    Radius="4" 
                                                    Opacity="0.3" />
                                        </Button.Shadow>
                                    </Button>
                                </On>
                                <On Platform="Android">
                                    <Button Margin="0,10,0,5"
                                          IsVisible="{Binding IsExistingSchedule}"
                                          VerticalOptions="End"
                                          BackgroundColor="{StaticResource ErrorColor}"
                                          CornerRadius="8"
                                          Command="{Binding DeleteCommand}"
                                          FontSize="{StaticResource ButtonFontSize}"
                                          FontAttributes="Bold"
                                          HorizontalOptions="Fill"
                                          HeightRequest="45"
                                          Padding="10,6,10,10"
                                          Text="DELETE"
                                          TextColor="White">
                                        <Button.Shadow>
                                            <Shadow Brush="#40000000" 
                                                    Offset="0,2" 
                                                    Radius="4" 
                                                    Opacity="0.3" />
                                        </Button.Shadow>
                                    </Button>
                                </On>
                                <On Platform="Default">
                                    <Button Margin="0,10,0,5"
                                          IsVisible="{Binding IsExistingSchedule}"
                                          VerticalOptions="End"
                                          BackgroundColor="{StaticResource ErrorColor}"
                                          CornerRadius="8"
                                          Command="{Binding DeleteCommand}"
                                          FontSize="{StaticResource ButtonFontSize}"
                                          FontAttributes="Bold"
                                          HorizontalOptions="Fill"
                                          HeightRequest="45"
                                          Padding="10,8"
                                          Text="DELETE"
                                          TextColor="White">
                                        <Button.Shadow>
                                            <Shadow Brush="#40000000" 
                                                    Offset="0,2" 
                                                    Radius="4" 
                                                    Opacity="0.3" />
                                        </Button.Shadow>
                                    </Button>
                                </On>
                            </OnPlatform.Platforms>
                        </OnPlatform>
                    </StackLayout>
                </ScrollView>
            </Grid>
            <!-- Overlay with busy indicator -->
            <Grid Grid.ZIndex="2"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                IsVisible="{Binding IsSchedulePageOverlayVisible}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsEnabled="True"
                IsRunning="{Binding IsSchedulePageOverlayVisible}"
                IsVisible="{Binding IsSchedulePageOverlayVisible}"
                Scale="0.5"
                VerticalOptions="Center"
                Color="SlateBlue">
                <ActivityIndicator.Scale>
                    <OnPlatform x:TypeArguments="system:Double">
                        <OnPlatform.Platforms>
                            <On Platform="iOS" Value="4.0" />
                            <On Platform="Android" Value="1.0" />
                            <On Platform="Win" Value="1.0" />
                        </OnPlatform.Platforms>
                    </OnPlatform>
                </ActivityIndicator.Scale>
            </ActivityIndicator>
            </Grid>
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>

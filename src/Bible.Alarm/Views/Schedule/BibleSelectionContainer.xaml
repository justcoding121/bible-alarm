<?xml version="1.0" encoding="utf-8"?>
<ContentView x:Class="Bible.Alarm.Views.Schedule.BibleSelectionContainer"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels.Schedule;assembly=Bible.Alarm"
             xmlns:fn="clr-namespace:Bible.Alarm.Views"
             x:DataType="vm:BibleSelectionContainerViewModel">
    <Border Margin="0"
            Padding="0"
            StrokeThickness="2"
            Stroke="{StaticResource PrimaryColor}"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            HorizontalOptions="Fill">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}" 
                    Offset="0,6" 
                    Radius="16" 
                    Opacity="0.3" />
        </Border.Shadow>
        <Grid RowSpacing="0"
              Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Bible Type Selector with icon -->
            <Grid x:Name="BibleTypeButton"
                  Grid.Row="0"
                  Margin="0"
                  Padding="16,16"
                  BackgroundColor="{DynamicResource ControlBackgroundColor}"
                  MinimumHeightRequest="56"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectBibleTypeCommand}"
                                          NumberOfTapsRequired="1" />
                </Grid.GestureRecognizers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Bible Type Name -->
                <Label Grid.Column="0"
                       FontSize="16"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       Text="{Binding BibleTypeDisplayText}"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                
                <!-- Bible Icon -->
                <Border Grid.Column="1"
                        BackgroundColor="{DynamicResource ControlBackgroundColor}"
                        HeightRequest="32"
                        HorizontalOptions="End"
                        Margin="12,0,0,0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="32">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="16"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        InputTransparent="True"
                        Text="{x:Static fn:GlyphNames.Bible}"
                        TextColor="{DynamicResource PrimaryColor}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </Border>
            </Grid>
            <!-- Divider -->
            <BoxView Grid.Row="1"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource DividerColor}"
                     Margin="0"
                     HorizontalOptions="Fill" />
            <!-- Language Name with icon -->
            <Grid x:Name="BibleLanguageButton"
                  Grid.Row="2"
                  Margin="0"
                  Padding="16,16"
                  BackgroundColor="{DynamicResource ControlBackgroundColor}"
                  MinimumHeightRequest="56"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectLanguageCommand}"
                                          NumberOfTapsRequired="1" />
                </Grid.GestureRecognizers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Language Name -->
                <Label Grid.Column="0"
                       FontSize="16"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       Text="{Binding LanguageDisplayText}"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                
                <!-- Language Icon -->
                <Border Grid.Column="1"
                        BackgroundColor="{DynamicResource ControlBackgroundColor}"
                        HeightRequest="32"
                        HorizontalOptions="End"
                        Margin="12,0,0,0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="32">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="16"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        InputTransparent="True"
                        Text="{x:Static fn:GlyphNames.Language}"
                        TextColor="{DynamicResource PrimaryColor}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </Border>
            </Grid>
            <!-- Divider -->
            <BoxView Grid.Row="3"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource DividerColor}"
                     Margin="0"
                     HorizontalOptions="Fill" />
            <!-- Translation Name with right arrow -->
            <Grid x:Name="BibleTranslationButton"
                  Grid.Row="4"
                  Margin="0"
                  Padding="16,16"
                  BackgroundColor="{DynamicResource ControlBackgroundColor}"
                  MinimumHeightRequest="56"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectBibleCommand}"
                                          NumberOfTapsRequired="1" />
                </Grid.GestureRecognizers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Label Grid.Column="0"
                       FontSize="16"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       Text="{Binding TranslationDisplayText}"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                <!-- Arrow Indicator -->
                <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="24"
                        HorizontalOptions="End"
                        Margin="8,0,0,0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="24">
                    <Label
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        InputTransparent="True"
                        Text="{x:Static fn:GlyphNames.Right}"
                        TextColor="{StaticResource PrimaryColor}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </Border>
            </Grid>
            <!-- Divider for Section (only visible when Section is visible) -->
            <BoxView Grid.Row="5"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource DividerColor}"
                     Margin="0"
                     HorizontalOptions="Fill"
                     IsVisible="{Binding IsSectionVisible}" />
            <!-- Section Selection (only visible for traditional Bible reading) -->
            <Grid x:Name="BiblePublicationSectionButton"
                  Grid.Row="6"
                  Margin="0"
                  Padding="16,16"
                  BackgroundColor="{DynamicResource ControlBackgroundColor}"
                  MinimumHeightRequest="56"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill"
                  IsVisible="{Binding IsSectionVisible}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectSectionCommand}"
                                          NumberOfTapsRequired="1" />
                </Grid.GestureRecognizers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Label Grid.Column="0"
                       FontSize="16"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       Text="{Binding SectionDisplayText}"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                <!-- Arrow Indicator -->
                <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="24"
                        HorizontalOptions="End"
                        Margin="8,0,0,0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="24">
                    <Label
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        InputTransparent="True"
                        Text="{x:Static fn:GlyphNames.Right}"
                        TextColor="{StaticResource PrimaryColor}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </Border>
            </Grid>
            <!-- Divider -->
            <BoxView Grid.Row="7"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource DividerColor}"
                     Margin="0"
                     HorizontalOptions="Fill" />
            <!-- Track/Part Selection -->
            <Grid x:Name="BibleTrackButton"
                  Grid.Row="8"
                  Margin="0"
                  Padding="16,16"
                  BackgroundColor="{DynamicResource ControlBackgroundColor}"
                  MinimumHeightRequest="56"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectTrackCommand}"
                                          NumberOfTapsRequired="1" />
                </Grid.GestureRecognizers>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Label Grid.Column="0"
                       FontSize="16"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       Text="{Binding TrackDisplayText}"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                <!-- Arrow Indicator -->
                <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        HeightRequest="24"
                        HorizontalOptions="End"
                        Margin="8,0,0,0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="24">
                    <Label
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="14"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        InputTransparent="True"
                        Text="{x:Static fn:GlyphNames.Right}"
                        TextColor="{StaticResource PrimaryColor}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </Border>
            </Grid>
        </Grid>
    </Border>
</ContentView>

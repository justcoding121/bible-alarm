<?xml version="1.0" encoding="utf-8"?>
<ContentView x:Class="Bible.Alarm.Views.Schedule.BibleSelectionContainer"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels.Schedule;assembly=Bible.Alarm"
             xmlns:fn="clr-namespace:Bible.Alarm.Views"
             xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             x:DataType="vm:BiblePublicationSelectionContainerViewModel">
    <ContentView.Resources>
        <converters:FlowDirectionToArrowConverter x:Key="flowDirectionToArrowConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
    </ContentView.Resources>
    <Border Margin="0"
            Padding="0"
            StrokeThickness="2"
            Stroke="{DynamicResource TextPrimaryColor}"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            HorizontalOptions="Fill">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}" 
                    Offset="0,6" 
                    Radius="16" 
                    Opacity="0.3" />
        </Border.Shadow>
        <Grid RowSpacing="0"
              Padding="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <!-- Category Name with icon -->
            <core:SfEffectsView Grid.Row="0"
                                 TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                 TouchUpEffects="None"
                                 RippleBackground="{StaticResource PrimaryColor}"
                                 HighlightBackground="{StaticResource PrimaryLightColor}"
                                 RippleAnimationDuration="200"
                                 ShouldIgnoreTouches="False">
                <core:SfEffectsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectCategoryCommand}"
                                          NumberOfTapsRequired="1" />
                </core:SfEffectsView.GestureRecognizers>
                <Grid x:Name="BibleCategoryButton"
                      Margin="0"
                      Padding="16,16"
                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                      MinimumHeightRequest="56"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Category Name -->
                <Label Grid.Column="0"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       LineBreakMode="WordWrap"
                       Text="{Binding CategoryDisplayText}"
                       TextColor="{StaticResource PrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                
                <!-- Category Icon -->
                <Border Grid.Column="1"
                        BackgroundColor="{DynamicResource ControlBackgroundColor}"
                        HeightRequest="{DynamicResource IconSmallContainerSize}"
                        HorizontalOptions="End"
                        Margin="12,0,0,0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="{DynamicResource IconSmallContainerSize}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="{DynamicResource IconStandardFontSize}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        InputTransparent="True"
                        Text="{x:Static fn:GlyphNames.Folder}"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </Border>
                </Grid>
            </core:SfEffectsView>
            <!-- Divider -->
            <BoxView Grid.Row="1"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource DividerColor}"
                     Margin="0"
                     HorizontalOptions="Fill"
                     IsVisible="{Binding IsLanguageVisible}" />
            <!-- Language Name with icon -->
            <core:SfEffectsView Grid.Row="2"
                                 IsVisible="{Binding IsLanguageVisible}"
                                 TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                 TouchUpEffects="None"
                                 RippleBackground="{StaticResource PrimaryColor}"
                                 HighlightBackground="{StaticResource PrimaryLightColor}"
                                 RippleAnimationDuration="200"
                                 ShouldIgnoreTouches="{Binding IsLanguageSelectable, Converter={StaticResource negateBooleanConverter}}">
                <core:SfEffectsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectLanguageCommand}"
                                          NumberOfTapsRequired="1" />
                </core:SfEffectsView.GestureRecognizers>
                <Grid x:Name="BibleLanguageButton"
                      Margin="0"
                      Padding="16,16"
                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                      MinimumHeightRequest="56"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <!-- Language Name -->
                <Label Grid.Column="0"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       LineBreakMode="WordWrap"
                       Text="{Binding LanguageDisplayText}"
                       TextColor="{StaticResource PrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                
                <!-- Language Icon -->
                <Border Grid.Column="1"
                        BackgroundColor="{DynamicResource ControlBackgroundColor}"
                        HeightRequest="{DynamicResource IconSmallContainerSize}"
                        HorizontalOptions="End"
                        Margin="12,0,0,0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        WidthRequest="{DynamicResource IconSmallContainerSize}">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Label
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="{DynamicResource IconStandardFontSize}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        InputTransparent="True"
                        Text="{x:Static fn:GlyphNames.Language}"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </Border>
                </Grid>
            </core:SfEffectsView>
            <!-- Divider -->
            <BoxView Grid.Row="3"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource DividerColor}"
                     Margin="0"
                     HorizontalOptions="Fill" />
            <!-- Publication Name with right arrow -->
            <core:SfEffectsView Grid.Row="4"
                                 TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                 TouchUpEffects="None"
                                 RippleBackground="{StaticResource PrimaryColor}"
                                 HighlightBackground="{StaticResource PrimaryLightColor}"
                                 RippleAnimationDuration="200"
                                 ShouldIgnoreTouches="{Binding IsPublicationSelectable, Converter={StaticResource negateBooleanConverter}}"
                                 FlowDirection="{Binding ContentFlowDirection}">
                <core:SfEffectsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectBibleCommand}"
                                          NumberOfTapsRequired="1" />
                </core:SfEffectsView.GestureRecognizers>
                <Grid x:Name="BiblePublicationButton"
                      Margin="0"
                      Padding="16,16"
                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                      MinimumHeightRequest="56"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Label Grid.Column="0"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       LineBreakMode="WordWrap"
                       Text="{Binding PublicationDisplayText}"
                       TextColor="{StaticResource PrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                <!-- Arrow Indicator -->
                <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        MinimumHeightRequest="24"
                        HorizontalOptions="End"
                        Margin="8,0,0,0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        MinimumWidthRequest="24"
                        IsVisible="{Binding IsPublicationSelectable}">
                    <Label
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="{DynamicResource IconSmallFontSize}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        InputTransparent="True"
                        Text="{Binding ContentFlowDirection, Converter={StaticResource flowDirectionToArrowConverter}}"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </Border>
                </Grid>
            </core:SfEffectsView>
            <!-- Divider for Section (only visible when Section is visible) -->
            <BoxView Grid.Row="5"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource DividerColor}"
                     Margin="0"
                     HorizontalOptions="Fill"
                     IsVisible="{Binding IsSectionVisible}" />
            <!-- Section Selection (only visible for traditional Bible reading) -->
            <core:SfEffectsView Grid.Row="6"
                                 TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                 TouchUpEffects="None"
                                 RippleBackground="{StaticResource PrimaryColor}"
                                 HighlightBackground="{StaticResource PrimaryLightColor}"
                                 RippleAnimationDuration="200"
                                 ShouldIgnoreTouches="{Binding IsSectionSelectable, Converter={StaticResource negateBooleanConverter}}"
                                 IsVisible="{Binding IsSectionVisible}"
                                 FlowDirection="{Binding ContentFlowDirection}">
                <core:SfEffectsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectSectionCommand}"
                                          NumberOfTapsRequired="1" />
                </core:SfEffectsView.GestureRecognizers>
                <Grid x:Name="BiblePublicationSectionButton"
                      Margin="0"
                      Padding="16,16"
                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                      MinimumHeightRequest="56"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Label Grid.Column="0"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       LineBreakMode="WordWrap"
                       Text="{Binding SectionDisplayText}"
                       TextColor="{StaticResource PrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                <!-- Arrow Indicator -->
                <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        MinimumHeightRequest="24"
                        HorizontalOptions="End"
                        Margin="8,0,0,0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        MinimumWidthRequest="24"
                        IsVisible="{Binding IsSectionSelectable}">
                    <Label
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="{DynamicResource IconSmallFontSize}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        InputTransparent="True"
                        Text="{Binding ContentFlowDirection, Converter={StaticResource flowDirectionToArrowConverter}}"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </Border>
                </Grid>
            </core:SfEffectsView>
            <!-- Divider -->
            <BoxView Grid.Row="7"
                     HeightRequest="1"
                     BackgroundColor="{DynamicResource DividerColor}"
                     Margin="0"
                     HorizontalOptions="Fill" />
            <!-- Track/Part Selection -->
            <core:SfEffectsView Grid.Row="8"
                                 TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                 TouchUpEffects="None"
                                 RippleBackground="{StaticResource PrimaryColor}"
                                 HighlightBackground="{StaticResource PrimaryLightColor}"
                                 RippleAnimationDuration="200"
                                 ShouldIgnoreTouches="{Binding IsTrackSelectable, Converter={StaticResource negateBooleanConverter}}"
                                 FlowDirection="{Binding ContentFlowDirection}">
                <core:SfEffectsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SelectTrackCommand}"
                                          NumberOfTapsRequired="1" />
                </core:SfEffectsView.GestureRecognizers>
                <Grid x:Name="BiblePublicationTrackButton"
                      Margin="0"
                      Padding="16,16"
                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                      MinimumHeightRequest="56"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                
                <Label Grid.Column="0"
                       FontSize="{DynamicResource LargeFontSize}"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       LineBreakMode="WordWrap"
                       Text="{Binding TrackDisplayText}"
                       TextColor="{StaticResource PrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center" />
                <!-- Arrow Indicator -->
                <Border Grid.Column="1"
                        BackgroundColor="Transparent"
                        MinimumHeightRequest="24"
                        HorizontalOptions="End"
                        Margin="8,0,0,0"
                        StrokeThickness="0"
                        VerticalOptions="Center"
                        MinimumWidthRequest="24"
                        IsVisible="{Binding IsTrackSelectable}">
                    <Label
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="{DynamicResource IconSmallFontSize}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        InputTransparent="True"
                        Text="{Binding ContentFlowDirection, Converter={StaticResource flowDirectionToArrowConverter}}"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        VerticalOptions="Center"
                        VerticalTextAlignment="Center" />
                </Border>
                </Grid>
            </core:SfEffectsView>
        </Grid>
    </Border>
</ContentView>

<?xml version="1.0" encoding="utf-8"?>
<ContentView x:Class="Bible.Alarm.Views.Schedule.ScheduleDetailsContainer"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels.Schedule;assembly=Bible.Alarm"
             xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
             xmlns:helpers="clr-namespace:Bible.Alarm.Common.ViewHelpers;assembly=Bible.Alarm"
             x:DataType="vm:ScheduleDetailsContainerViewModel">
    <ContentView.Resources>
        <converters:DayColorConverter x:Key="dayColorConverter" />
        <converters:DayBackgroundColorConverter x:Key="dayBackgroundColorConverter" />
        <converters:IsEnabledColorConverter x:Key="isEnabledColorConverter" />
        <converters:TimeToMeridianConverter x:Key="timeToMeridianConverter" />
        <!-- Local double resources: avoid Release InvalidCastException (generated code casts DynamicResource to double) -->
        <x:Double x:Key="SpacingStandard">12.0</x:Double>
        <x:Double x:Key="PaddingStandard">12.0</x:Double>
        <x:Double x:Key="PaddingSmall">4.0</x:Double>
        <x:Double x:Key="IconSmallContainerSize">32.0</x:Double>
        <x:Double x:Key="CornerRadiusMedium">6.0</x:Double>
        <x:Double x:Key="LargeFontSize">22.0</x:Double>
        <x:Double x:Key="AlarmTimeFontSize">36.0</x:Double>
        <x:Double x:Key="ContentWidthLarge">280.0</x:Double>
        <x:Double x:Key="CornerRadiusStandard">8.0</x:Double>
        <x:String x:Key="Sunday">Sunday</x:String>
        <x:String x:Key="Monday">Monday</x:String>
        <x:String x:Key="Tuesday">Tuesday</x:String>
        <x:String x:Key="Wednesday">Wednesday</x:String>
        <x:String x:Key="Thursday">Thursday</x:String>
        <x:String x:Key="Friday">Friday</x:String>
        <x:String x:Key="Saturday">Saturday</x:String>
    </ContentView.Resources>
    <Grid RowSpacing="{StaticResource SpacingStandard}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Time picker row: transparent background so it blends seamlessly with the page -->
        <!-- iOS: show time and AM/PM separately to avoid UIDatePicker triangle rendering bug -->
        <HorizontalStackLayout Grid.Row="0"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              Padding="{StaticResource PaddingStandard}"
              Spacing="2">
            <TimePicker AutomationId="AlarmTimePicker"
                        BackgroundColor="Transparent"
                        TextColor="{Binding IsEnabled, Converter={StaticResource isEnabledColorConverter}, ConverterParameter='PrimaryTextColor'}"
                        FontSize="{StaticResource AlarmTimeFontSize}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="0"
                        Time="{Binding Time, Mode=TwoWay}"
                        Format="{OnPlatform iOS='hh:mm', Default='hh:mm tt'}"
                        ios:TimePicker.UpdateMode="WhenFinished" />
            <Label Text="{Binding Time, Converter={StaticResource timeToMeridianConverter}}"
                   TextColor="{Binding IsEnabled, Converter={StaticResource isEnabledColorConverter}, ConverterParameter='PrimaryTextColor'}"
                   FontSize="{DynamicResource AlarmMeridianFontSize}"
                   VerticalOptions="End"
                   Margin="0,0,0,4"
                   IsVisible="{OnPlatform iOS=True, Default=False}" />
        </HorizontalStackLayout>
        <FlexLayout Grid.Row="1"
              Margin="0"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              Wrap="Wrap"
              JustifyContent="Center"
              AlignItems="Center"
              AlignContent="Center">
            <Border Margin="1"
                    Padding="{StaticResource PaddingSmall}"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MinimumWidthRequest="{StaticResource IconSmallContainerSize}"
                    MinimumHeightRequest="{StaticResource IconSmallContainerSize}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusMedium}" />
                </Border.StrokeShape>
                <Border.BackgroundColor>
                    <MultiBinding Converter="{StaticResource dayBackgroundColorConverter}" ConverterParameter="{StaticResource Sunday}">
                        <Binding Path="DaysOfWeek" />
                        <Binding Path="IsEnabled" />
                    </MultiBinding>
                </Border.BackgroundColor>
                <!-- Single Button for all platforms - BorderWidth/BorderColor are harmless on iOS -->
                <Button Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding ToggleDayCommand}"
                        CommandParameter="{StaticResource Sunday}"
                        FontAttributes="Bold"
                        FontSize="{StaticResource LargeFontSize}"
                        Text="S">
                    <Button.TextColor>
                        <MultiBinding Converter="{StaticResource dayColorConverter}" ConverterParameter="{StaticResource Sunday}">
                            <Binding Path="DaysOfWeek" />
                            <Binding Path="IsEnabled" />
                        </MultiBinding>
                    </Button.TextColor>
                </Button>
            </Border>
            <Border Margin="1"
                    Padding="{StaticResource PaddingSmall}"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MinimumWidthRequest="{StaticResource IconSmallContainerSize}"
                    MinimumHeightRequest="{StaticResource IconSmallContainerSize}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusMedium}" />
                </Border.StrokeShape>
                <Border.BackgroundColor>
                    <MultiBinding Converter="{StaticResource dayBackgroundColorConverter}" ConverterParameter="{StaticResource Monday}">
                        <Binding Path="DaysOfWeek" />
                        <Binding Path="IsEnabled" />
                    </MultiBinding>
                </Border.BackgroundColor>
                <!-- Single Button for all platforms - BorderWidth/BorderColor are harmless on iOS -->
                <Button Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding ToggleDayCommand}"
                        CommandParameter="{StaticResource Monday}"
                        FontAttributes="Bold"
                        FontSize="{StaticResource LargeFontSize}"
                        Text="M">
                    <Button.TextColor>
                        <MultiBinding Converter="{StaticResource dayColorConverter}" ConverterParameter="{StaticResource Monday}">
                            <Binding Path="DaysOfWeek" />
                            <Binding Path="IsEnabled" />
                        </MultiBinding>
                    </Button.TextColor>
                </Button>
            </Border>
            <Border Margin="1"
                    Padding="{StaticResource PaddingSmall}"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MinimumWidthRequest="{StaticResource IconSmallContainerSize}"
                    MinimumHeightRequest="{StaticResource IconSmallContainerSize}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusMedium}" />
                </Border.StrokeShape>
                <Border.BackgroundColor>
                    <MultiBinding Converter="{StaticResource dayBackgroundColorConverter}" ConverterParameter="{StaticResource Tuesday}">
                        <Binding Path="DaysOfWeek" />
                        <Binding Path="IsEnabled" />
                    </MultiBinding>
                </Border.BackgroundColor>
                <!-- Single Button for all platforms - BorderWidth/BorderColor are harmless on iOS -->
                <Button Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding ToggleDayCommand}"
                        CommandParameter="{StaticResource Tuesday}"
                        FontAttributes="Bold"
                        FontSize="{StaticResource LargeFontSize}"
                        Text="T">
                    <Button.TextColor>
                        <MultiBinding Converter="{StaticResource dayColorConverter}" ConverterParameter="{StaticResource Tuesday}">
                            <Binding Path="DaysOfWeek" />
                            <Binding Path="IsEnabled" />
                        </MultiBinding>
                    </Button.TextColor>
                </Button>
            </Border>
            <Border Margin="1"
                    Padding="{StaticResource PaddingSmall}"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MinimumWidthRequest="{StaticResource IconSmallContainerSize}"
                    MinimumHeightRequest="{StaticResource IconSmallContainerSize}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusMedium}" />
                </Border.StrokeShape>
                <Border.BackgroundColor>
                    <MultiBinding Converter="{StaticResource dayBackgroundColorConverter}" ConverterParameter="{StaticResource Wednesday}">
                        <Binding Path="DaysOfWeek" />
                        <Binding Path="IsEnabled" />
                    </MultiBinding>
                </Border.BackgroundColor>
                <!-- Single Button for all platforms - BorderWidth/BorderColor are harmless on iOS -->
                <Button Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding ToggleDayCommand}"
                        CommandParameter="{StaticResource Wednesday}"
                        FontAttributes="Bold"
                        FontSize="{StaticResource LargeFontSize}"
                        Text="W">
                    <Button.TextColor>
                        <MultiBinding Converter="{StaticResource dayColorConverter}" ConverterParameter="{StaticResource Wednesday}">
                            <Binding Path="DaysOfWeek" />
                            <Binding Path="IsEnabled" />
                        </MultiBinding>
                    </Button.TextColor>
                </Button>
            </Border>
            <Border Margin="1"
                    Padding="{StaticResource PaddingSmall}"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MinimumWidthRequest="{StaticResource IconSmallContainerSize}"
                    MinimumHeightRequest="{StaticResource IconSmallContainerSize}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusMedium}" />
                </Border.StrokeShape>
                <Border.BackgroundColor>
                    <MultiBinding Converter="{StaticResource dayBackgroundColorConverter}" ConverterParameter="{StaticResource Thursday}">
                        <Binding Path="DaysOfWeek" />
                        <Binding Path="IsEnabled" />
                    </MultiBinding>
                </Border.BackgroundColor>
                <!-- Single Button for all platforms - BorderWidth/BorderColor are harmless on iOS -->
                <Button Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding ToggleDayCommand}"
                        CommandParameter="{StaticResource Thursday}"
                        FontAttributes="Bold"
                        FontSize="{StaticResource LargeFontSize}"
                        Text="T">
                    <Button.TextColor>
                        <MultiBinding Converter="{StaticResource dayColorConverter}" ConverterParameter="{StaticResource Thursday}">
                            <Binding Path="DaysOfWeek" />
                            <Binding Path="IsEnabled" />
                        </MultiBinding>
                    </Button.TextColor>
                </Button>
            </Border>
            <Border Margin="1"
                    Padding="{StaticResource PaddingSmall}"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MinimumWidthRequest="{StaticResource IconSmallContainerSize}"
                    MinimumHeightRequest="{StaticResource IconSmallContainerSize}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusMedium}" />
                </Border.StrokeShape>
                <Border.BackgroundColor>
                    <MultiBinding Converter="{StaticResource dayBackgroundColorConverter}" ConverterParameter="{StaticResource Friday}">
                        <Binding Path="DaysOfWeek" />
                        <Binding Path="IsEnabled" />
                    </MultiBinding>
                </Border.BackgroundColor>
                <!-- Single Button for all platforms - BorderWidth/BorderColor are harmless on iOS -->
                <Button Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding ToggleDayCommand}"
                        CommandParameter="{StaticResource Friday}"
                        FontAttributes="Bold"
                        FontSize="{StaticResource LargeFontSize}"
                        Text="F">
                    <Button.TextColor>
                        <MultiBinding Converter="{StaticResource dayColorConverter}" ConverterParameter="{StaticResource Friday}">
                            <Binding Path="DaysOfWeek" />
                            <Binding Path="IsEnabled" />
                        </MultiBinding>
                    </Button.TextColor>
                </Button>
            </Border>
            <Border Margin="1"
                    Padding="{StaticResource PaddingSmall}"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    MinimumWidthRequest="{StaticResource IconSmallContainerSize}"
                    MinimumHeightRequest="{StaticResource IconSmallContainerSize}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusMedium}" />
                </Border.StrokeShape>
                <Border.BackgroundColor>
                    <MultiBinding Converter="{StaticResource dayBackgroundColorConverter}" ConverterParameter="{StaticResource Saturday}">
                        <Binding Path="DaysOfWeek" />
                        <Binding Path="IsEnabled" />
                    </MultiBinding>
                </Border.BackgroundColor>
                <!-- Single Button for all platforms - BorderWidth/BorderColor are harmless on iOS -->
                <Button Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding ToggleDayCommand}"
                        CommandParameter="{StaticResource Saturday}"
                        FontAttributes="Bold"
                        FontSize="{StaticResource LargeFontSize}"
                        Text="S">
                    <Button.TextColor>
                        <MultiBinding Converter="{StaticResource dayColorConverter}" ConverterParameter="{StaticResource Saturday}">
                            <Binding Path="DaysOfWeek" />
                            <Binding Path="IsEnabled" />
                        </MultiBinding>
                    </Button.TextColor>
                </Button>
            </Border>
        </FlexLayout>
        <Grid Grid.Row="2"
              Margin="0"
              HorizontalOptions="Center"
              VerticalOptions="Center"
              ColumnSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0"
                    StrokeThickness="1"
                    Stroke="{DynamicResource DividerColor}"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Padding="{OnPlatform iOS='12,8', Default='12,3'}"
                    MinimumWidthRequest="{StaticResource ContentWidthLarge}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{StaticResource CornerRadiusStandard}" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <helpers:PlatformShadow LightBrush="#E0E0E0" DarkBrush="#000000"
                            Offset="0,2"
                            Radius="4"
                            Opacity="0.1" />
                </Border.Shadow>
                <Entry x:Name="ScheduleNameEntry"
                       Margin="0"
                       MaxLength="30"
                       HorizontalOptions="FillAndExpand"
                       Placeholder="Schedule Name"
                       PlaceholderColor="{DynamicResource TextSecondaryColor}"
                       Text="{Binding Name, Mode=TwoWay}"
                       BackgroundColor="Transparent"
                       FontSize="{StaticResource LargeFontSize}"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       VerticalOptions="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentView>


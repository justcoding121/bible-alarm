<?xml version="1.0" encoding="utf-8"?>
<ContentView x:Class="Bible.Alarm.Views.Schedule.MusicSelectionContainer"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels.Schedule;assembly=Bible.Alarm"
             xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared"
             xmlns:fn="clr-namespace:Bible.Alarm.Views"
             xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
             x:DataType="vm:MusicSelectionContainerViewModel">
    <Border Margin="0"
            Padding="0"
            StrokeThickness="0"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            HorizontalOptions="Fill">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Border.Shadow>
            <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}" 
                    Offset="0,4" 
                    Radius="12" 
                    Opacity="0.2" />
        </Border.Shadow>
        <Border.Resources>
            <converters:RepeatColorConverter x:Key="repeatColorConverter" />
        </Border.Resources>
        <StackLayout Orientation="Vertical"
                     Spacing="0"
                     Padding="0">
            <Grid x:Name="MusicButton"
                  Margin="0"
                  Padding="16,16"
                  BackgroundColor="{DynamicResource ControlBackgroundColor}"
                  MinimumHeightRequest="56"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0"
                       FontSize="16"
                       FontAttributes="None"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="Start"
                       TextColor="{DynamicResource TextPrimaryColor}"
                       VerticalOptions="Center"
                       VerticalTextAlignment="Center">
                    Play a music track before Bible audio
                </Label>
                <StackLayout Grid.Column="1"
                             HorizontalOptions="End"
                             Orientation="Horizontal"
                             Spacing="12"
                             VerticalOptions="Center">
                    <shared:PlatformSwitch
                        Margin="0"
                        HorizontalOptions="Start"
                        IsToggled="{Binding MusicEnabled, Mode=TwoWay}"
                        Scale="{OnPlatform Android='1', Default='1'}" />
                </StackLayout>
            </Grid>
            <!-- Collapsible Content Container -->
            <StackLayout x:Name="CollapsibleContent"
                         Orientation="Vertical"
                         Spacing="0"
                         Padding="0">
                <!-- Divider -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{DynamicResource DividerColor}"
                         Margin="0"
                         HorizontalOptions="Fill" />
                <!-- Music Type Row -->
                <Grid x:Name="MusicTypeButton"
                      Margin="0"
                      Padding="16,16"
                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                      MinimumHeightRequest="56"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectMusicTypeCommand}"
                                              NumberOfTapsRequired="1" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label x:Name="MusicTypeLabel"
                           Grid.Column="0"
                           FontSize="16"
                           FontAttributes="None"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Start"
                           Text="{Binding MusicTypeDisplayText, Mode=OneWay}"
                           TextColor="{DynamicResource TextPrimaryColor}"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center" />
                    <Border Grid.Column="1"
                            BackgroundColor="Transparent"
                            HeightRequest="24"
                            HorizontalOptions="End"
                            Margin="8,0,0,0"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="24">
                        <Label
                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                            FontSize="14"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            InputTransparent="True"
                            Text="{x:Static fn:GlyphNames.Right}"
                            TextColor="{DynamicResource TextSecondaryColor}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />
                    </Border>
                </Grid>
                <!-- Divider -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{DynamicResource DividerColor}"
                         Margin="0"
                         HorizontalOptions="Fill"
                         IsVisible="{Binding IsMusicLanguageVisible}" />
                <!-- Music Language Row (only visible when Music Type is Vocals) -->
                <Grid x:Name="MusicLanguageButton"
                      Margin="0"
                      Padding="16,16"
                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                      MinimumHeightRequest="56"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      IsVisible="{Binding IsMusicLanguageVisible}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectMusicLanguageCommand}"
                                              NumberOfTapsRequired="1" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0"
                           FontSize="16"
                           FontAttributes="None"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Start"
                           Text="{Binding MusicLanguageDisplayText}"
                           TextColor="{DynamicResource TextPrimaryColor}"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center" />
                    <Border Grid.Column="1"
                            BackgroundColor="Transparent"
                            HeightRequest="24"
                            HorizontalOptions="End"
                            Margin="8,0,0,0"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="24">
                        <Label
                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                            FontSize="14"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            InputTransparent="True"
                            Text="{x:Static fn:GlyphNames.Language}"
                            TextColor="{DynamicResource TextSecondaryColor}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />
                    </Border>
                </Grid>
                <!-- Divider -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{DynamicResource DividerColor}"
                         Margin="0"
                         HorizontalOptions="Fill"
                         IsVisible="{Binding IsSongBookVisible}" />
                <!-- Song Book Row (only visible when Music Type is Vocals) -->
                <Grid x:Name="SongBookButton"
                      Margin="0"
                      Padding="16,16"
                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                      MinimumHeightRequest="56"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      IsVisible="{Binding IsSongBookVisible}">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectSongBookCommand}"
                                              NumberOfTapsRequired="1" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0"
                           FontSize="16"
                           FontAttributes="None"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Start"
                           Text="{Binding SongBookDisplayText}"
                           TextColor="{DynamicResource TextPrimaryColor}"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center" />
                    <Border Grid.Column="1"
                            BackgroundColor="Transparent"
                            HeightRequest="24"
                            HorizontalOptions="End"
                            Margin="8,0,0,0"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="24">
                        <Label
                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                            FontSize="14"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            InputTransparent="True"
                            Text="{x:Static fn:GlyphNames.Right}"
                            TextColor="{DynamicResource TextSecondaryColor}"
                            VerticalOptions="Center"
                            VerticalTextAlignment="Center" />
                    </Border>
                </Grid>
                <!-- Divider -->
                <BoxView HeightRequest="1"
                         BackgroundColor="{DynamicResource DividerColor}"
                         Margin="0"
                         HorizontalOptions="Fill" />
                <!-- Track Name Row -->
                <Grid x:Name="TrackButton"
                      Margin="0"
                      Padding="16,16"
                      BackgroundColor="{DynamicResource ControlBackgroundColor}"
                      MinimumHeightRequest="56"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectTrackCommand}"
                                              NumberOfTapsRequired="1" />
                    </Grid.GestureRecognizers>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0"
                           FontSize="16"
                           FontAttributes="None"
                           HorizontalOptions="Fill"
                           HorizontalTextAlignment="Start"
                           Text="{Binding TrackDisplayText}"
                           TextColor="{DynamicResource TextPrimaryColor}"
                           VerticalOptions="Center"
                           VerticalTextAlignment="Center" />
                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="8"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center">
                        <!-- Repeat Button (only visible when track is selected) -->
                        <Border
                            IsVisible="{Binding HasTrackSelected}"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            HeightRequest="36"
                            HorizontalOptions="End"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="36">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Button
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding ToggleRepeatCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="16"
                                MinimumWidthRequest="36"
                                Padding="0"
                                Text="{x:Static fn:GlyphNames.Repeat}"
                                TextColor="{Binding IsRepeatEnabled, Converter={StaticResource repeatColorConverter}}"
                                VerticalOptions="Fill"
                                HorizontalOptions="Fill" />
                        </Border>
                        <!-- Arrow Indicator -->
                        <Border
                            BackgroundColor="Transparent"
                            HeightRequest="24"
                            HorizontalOptions="End"
                            Margin="0,0,0,0"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="24">
                            <Label
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="14"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                InputTransparent="True"
                                Text="{x:Static fn:GlyphNames.Right}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                VerticalOptions="Center"
                                VerticalTextAlignment="Center" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>
            </StackLayout>
        </StackLayout>
    </Border>
</ContentView>


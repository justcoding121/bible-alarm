<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Schedule.NumberOfTracksModal"
    x:Name="PageRoot"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels.Schedule;assembly=Bible.Alarm"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:shared="clr-namespace:Bible.Alarm.ViewModels.Shared"
    xmlns:sharedViews="clr-namespace:Bible.Alarm.Views.Shared"
    xmlns:sharedControls="clr-namespace:Bible.Alarm.Views.Shared;assembly=Bible.Alarm"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    x:DataType="vm:NumberOfTrackContainerViewModel"
    Padding="0"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->

        <!-- Style for selected/unselected item background using DynamicResource -->
        <Style x:Key="TracksItemBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundColor}" />
        </Style>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid
            x:Name="MainGrid"
            BackgroundColor="{DynamicResource BackgroundColor}"
            ColumnSpacing="0"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>

            <!-- Enhanced Header -->
            <Border
                Grid.Row="0"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="20,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,20,20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                            Offset="0,4"
                            Opacity="0.1"
                            Radius="8" />
                </Border.Shadow>
                <Label
                    FontSize="{DynamicResource HeaderFontSize}"
                    FontAttributes="Bold"
                    MinimumHeightRequest="56"
                    Text="{Binding ModalHeaderText}"
                    TextColor="{DynamicResource TextPrimaryColor}"
                    VerticalOptions="Fill"
                    VerticalTextAlignment="Center" />
            </Border>

            <!-- Enhanced Collection View -->
            <CollectionView
                x:Name="TracksCollectionView"
                Grid.Row="1"
                Margin="0,8,0,20"
                BackgroundColor="Transparent"
                Footer="{OnPlatform iOS=''}"
                HorizontalOptions="Fill"
                ItemsSource="{Binding NumberOfTracksList}"
                MinimumHeightRequest="300"
                MinimumWidthRequest="250"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical">
                        <LinearItemsLayout.ItemSpacing>
                            <OnPlatform x:TypeArguments="x:Double">
                                <On Platform="WinUI" Value="4" />
                                <On Platform="Default" Value="8" />
                            </OnPlatform>
                        </LinearItemsLayout.ItemSpacing>
                    </LinearItemsLayout>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="shared:NumberOfTracksListViewItemModel">
                            <Grid Margin="16,0">
                                <core:SfEffectsView
                                    TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                    TouchUpEffects="None"
                                    RippleBackground="{StaticResource PrimaryColor}"
                                    HighlightBackground="{StaticResource PrimaryLightColor}"
                                    RippleAnimationDuration="200"
                                    ShouldIgnoreTouches="False">
                                    <core:SfEffectsView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTrackItemTapped" />
                                    </core:SfEffectsView.GestureRecognizers>
                                    <Border
                                            Style="{StaticResource TracksItemBorderStyle}"
                                            StrokeThickness="0"
                                            Padding="0">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                                    Offset="0,2"
                                                    Opacity="0.08"
                                                    Radius="4" />
                                        </Border.Shadow>
                                        <Grid
                                            Padding="20,18"
                                            ColumnSpacing="12"
                                            HorizontalOptions="Fill"
                                            MinimumHeightRequest="56"
                                            BackgroundColor="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Column="0"
                                                Margin="0"
                                                FontSize="{DynamicResource LargeFontSize}"
                                                FontAttributes="None"
                                                HorizontalOptions="Start"
                                                HorizontalTextAlignment="Start"
                                                InputTransparent="True"
                                                Text="{Binding Text}"
                                                TextColor="{DynamicResource TextPrimaryColor}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                            <!-- Progress indicator - shows when IsNavigating is true -->
                                            <Grid Grid.Column="1"
                                                  Margin="12,0,0,0"
                                                  VerticalOptions="Center"
                                                  HorizontalOptions="End"
                                                  HeightRequest="{DynamicResource IconStandardFontSize}"
                                                  WidthRequest="{DynamicResource IconStandardFontSize}">
                                                <ActivityIndicator
                                                        IsRunning="{Binding IsNavigating}"
                                                        IsVisible="{Binding IsNavigating}"
                                                        Color="{DynamicResource TextPrimaryColor}"
                                                        WidthRequest="{DynamicResource IconStandardFontSize}"
                                                        HeightRequest="{DynamicResource IconStandardFontSize}"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="Center"
                                                        Opacity="0.95" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </core:SfEffectsView>
                            </Grid>
                        </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Close Button - SfEffectsView for WinUI only -->
            <core:SfEffectsView Grid.Row="2"
                x:Name="CloseButtonEffectsView"
                Margin="16,8,16,16"
                TouchDownEffects="Ripple"
                TouchUpEffects="None"
                RippleBackground="{DynamicResource PrimaryColor}"
                RippleAnimationDuration="200"
                ShouldIgnoreTouches="False"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                HeightRequest="{DynamicResource IconStandardContainerSize}">
                <core:SfEffectsView.IsVisible>
                    <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                        <On Platform="WinUI" Value="true" />
                    </OnPlatform>
                </core:SfEffectsView.IsVisible>
                <core:SfEffectsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseModalCommand}" />
                </core:SfEffectsView.GestureRecognizers>
                <Border x:Name="CloseButton"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Padding="20,12"
                    InputTransparent="True"
                    IsEnabled="False">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                Offset="0,2"
                                Opacity="0.1"
                                Radius="4" />
                    </Border.Shadow>
                    <Label Text="{x:Static fn:GlyphNames.Xmark}" 
                           FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                           FontSize="{DynamicResource IconStandardFontSize}"
                           TextColor="{AppThemeBinding Light=#212529, Dark=White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </core:SfEffectsView>
            <!-- Regular button for Android/iOS -->
            <Border Grid.Row="2"
                x:Name="CloseButtonNoEffects"
                Margin="16,8,16,16"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                HorizontalOptions="Fill"
                Padding="{OnPlatform Android='20,6,20,10', iOS='20,12', Default='20,12'}"
                VerticalOptions="Center"
                HeightRequest="{DynamicResource IconStandardContainerSize}"
                IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseModalCommand}" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                            Offset="0,2"
                            Opacity="0.1"
                            Radius="4" />
                </Border.Shadow>
                <Label Text="{x:Static fn:GlyphNames.Xmark}" 
                       FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                       FontSize="{DynamicResource IconStandardFontSize}"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>

            <!-- BUSY OVERLAY – visibility controlled from code-behind -->
            <sharedViews:BusyOverlay x:Name="BusyOverlay"
                                     Grid.Row="0"
                                     Grid.RowSpan="3"
                                     IsVisible="True" />
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>


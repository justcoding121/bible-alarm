<?xml version="1.0" encoding="utf-8"?>

<ContentView x:Class="Bible.Alarm.Views.Schedule.ScheduleContent"
             x:Name="ScheduleContentView"
             xmlns:scheduleViews="clr-namespace:Bible.Alarm.Views.Schedule;assembly=Bible.Alarm"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
             xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared;assembly=Bible.Alarm"
             xmlns:fn="clr-namespace:Bible.Alarm.Views"
             x:DataType="vm:ScheduleViewModel"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">
    <ContentView.Resources>
        <!-- Local double resources: avoid Release InvalidCastException (generated code casts DynamicResource to double) -->
        <x:Double x:Key="IconStandardContainerSize">48.0</x:Double>
        <x:Double x:Key="IconStandardFontSize">20.0</x:Double>
        <x:Double x:Key="CornerRadiusStandard">8.0</x:Double>
        <x:Double x:Key="SpacingStandard">12.0</x:Double>
    </ContentView.Resources>
    <!-- Converters moved to App.xaml for better performance - shared across all pages -->
    <!-- Theme-aware colors are inherited from BaseContentPage -->
    <Grid x:Name="MainGrid"
          RowSpacing="0"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              x:Name="ButtonContainer"
              Margin="0,0,0,4"
              ColumnSpacing="4"
              HorizontalOptions="FillAndExpand"
              VerticalOptions="Start">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Cancel button - SfEffectsView for WinUI only -->
            <Grid Grid.Column="0"
                  Margin="0"
                  HorizontalOptions="FillAndExpand"
                  VerticalOptions="Start"
                  HeightRequest="{StaticResource IconStandardContainerSize}">
                <core:SfEffectsView Margin="0"
                                     TouchDownEffects="Ripple"
                                     TouchUpEffects="None"
                                     RippleBackground="{DynamicResource DividerColor}"
                                     RippleAnimationDuration="200"
                                     ShouldIgnoreTouches="False"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill">
                    <core:SfEffectsView.IsVisible>
                        <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                            <On Platform="WinUI" Value="true" />
                        </OnPlatform>
                    </core:SfEffectsView.IsVisible>
                    <core:SfEffectsView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}" />
                    </core:SfEffectsView.GestureRecognizers>
                    <Border x:Name="CancelButton"
                            AutomationId="CancelButton"
                            BackgroundColor="{DynamicResource DividerColor}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="True"
                            IsEnabled="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusStandard}" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#20000000" 
                                    Offset="0,2" 
                                    Radius="4" 
                                    Opacity="0.2" />
                        </Border.Shadow>
                        <Label Text="{x:Static fn:GlyphNames.ArrowLeft}" 
                               FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                               FontSize="{StaticResource IconStandardFontSize}"
                               TextColor="{DynamicResource TextSecondaryColor}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding IsCancelBusy, Converter={StaticResource negateBooleanConverter}}" />
                    </Border>
                </core:SfEffectsView>
                <!-- Loading indicator overlay - shows when IsCancelBusy is true -->
                <ActivityIndicator
                        IsRunning="{Binding IsCancelBusy}"
                        IsVisible="{Binding IsCancelBusy}"
                        Color="{DynamicResource TextSecondaryColor}"
                        WidthRequest="{StaticResource IconStandardFontSize}"
                        HeightRequest="{StaticResource IconStandardFontSize}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Opacity="0.95" />
            </Grid>
            <Grid Grid.Column="0"
                  Margin="0"
                  HorizontalOptions="FillAndExpand"
                  HeightRequest="{StaticResource IconStandardContainerSize}"
                  IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}">
                <Border x:Name="CancelButtonNoEffects"
                        Margin="0"
                        AutomationId="CancelButton"
                        BackgroundColor="{DynamicResource DividerColor}"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CancelCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusStandard}" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#20000000" 
                                Offset="0,2" 
                                Radius="4" 
                                Opacity="0.2" />
                    </Border.Shadow>
                    <Label Text="{x:Static fn:GlyphNames.Xmark}" 
                           FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                           FontSize="{StaticResource IconStandardFontSize}"
                           TextColor="{DynamicResource TextSecondaryColor}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsCancelBusy, Converter={StaticResource negateBooleanConverter}}" />
                </Border>
                <!-- Loading indicator overlay - shows when IsCancelBusy is true -->
                <ActivityIndicator
                        IsRunning="{Binding IsCancelBusy}"
                        IsVisible="{Binding IsCancelBusy}"
                        Color="{DynamicResource TextSecondaryColor}"
                        WidthRequest="{StaticResource IconStandardFontSize}"
                        HeightRequest="{StaticResource IconStandardFontSize}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Opacity="0.95" />
            </Grid>
            <!-- Save button - SfEffectsView for WinUI only -->
            <Grid Grid.Column="1"
                  Margin="0"
                  HorizontalOptions="FillAndExpand"
                  VerticalOptions="Start"
                  HeightRequest="{StaticResource IconStandardContainerSize}">
                <core:SfEffectsView Margin="0"
                                     TouchDownEffects="Ripple"
                                     TouchUpEffects="None"
                                     RippleBackground="{StaticResource PrimaryColor}"
                                     RippleAnimationDuration="200"
                                     ShouldIgnoreTouches="False"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Fill">
                    <core:SfEffectsView.IsVisible>
                        <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                            <On Platform="WinUI" Value="true" />
                        </OnPlatform>
                    </core:SfEffectsView.IsVisible>
                    <core:SfEffectsView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveCommand}" />
                    </core:SfEffectsView.GestureRecognizers>
                    <Border x:Name="SaveButton"
                            AutomationId="SaveButton"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            InputTransparent="True"
                            IsEnabled="False">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusStandard}" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#40000000" 
                                    Offset="0,2" 
                                    Radius="4" 
                                    Opacity="0.3" />
                        </Border.Shadow>
                        <Label Text="{x:Static fn:GlyphNames.FloppyDisk}" 
                               FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                               FontSize="{StaticResource IconStandardFontSize}"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding IsSaveBusy, Converter={StaticResource negateBooleanConverter}}" />
                    </Border>
                </core:SfEffectsView>
                <!-- Loading indicator overlay - shows when IsSaveBusy is true -->
                <ActivityIndicator
                        IsRunning="{Binding IsSaveBusy}"
                        IsVisible="{Binding IsSaveBusy}"
                        Color="White"
                        WidthRequest="{StaticResource IconStandardFontSize}"
                        HeightRequest="{StaticResource IconStandardFontSize}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Opacity="0.95" />
            </Grid>
            <Grid Grid.Column="1"
                  Margin="0"
                  HorizontalOptions="FillAndExpand"
                  HeightRequest="{StaticResource IconStandardContainerSize}"
                  IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}">
                <Border x:Name="SaveButtonNoEffects"
                        Margin="0"
                        AutomationId="SaveButton"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SaveCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusStandard}" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="#40000000" 
                                Offset="0,2" 
                                Radius="4" 
                                Opacity="0.3" />
                    </Border.Shadow>
                    <Label Text="{x:Static fn:GlyphNames.FloppyDisk}" 
                           FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                           FontSize="{StaticResource IconStandardFontSize}"
                           TextColor="White"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           IsVisible="{Binding IsSaveBusy, Converter={StaticResource negateBooleanConverter}}" />
                </Border>
                <!-- Loading indicator overlay - shows when IsSaveBusy is true -->
                <ActivityIndicator
                        IsRunning="{Binding IsSaveBusy}"
                        IsVisible="{Binding IsSaveBusy}"
                        Color="White"
                        WidthRequest="{StaticResource IconStandardFontSize}"
                        HeightRequest="{StaticResource IconStandardFontSize}"
                        VerticalOptions="Center"
                        HorizontalOptions="Center"
                        Opacity="0.95" />
            </Grid>
        </Grid>
        <ScrollView x:Name="ScheduleScrollView"
                    Grid.Row="1"
                    Margin="0,0,0,0">
            <Grid x:Name="ScrollContentGrid"
                  HorizontalOptions="Fill"
                  RowSpacing="{StaticResource SpacingStandard}">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnScrollContentTapped" />
                </Grid.GestureRecognizers>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <scheduleViews:ScheduleDetailsContainer Grid.Row="0" BindingContext="{Binding ScheduleDetailsContainerViewModel}" />
                <scheduleViews:AlarmSettingsContainer Grid.Row="1" BindingContext="{Binding AlarmSettingsContainerViewModel}" />
                <scheduleViews:BibleSelectionContainer Grid.Row="2" BindingContext="{Binding BibleSelectionContainerViewModel}" />
                <scheduleViews:NumberOfTrackContainer Grid.Row="3" BindingContext="{Binding NumberOfTrackContainerViewModel}" />
                <scheduleViews:MusicSelectionContainer Grid.Row="4" 
                                                       BindingContext="{Binding MusicSelectionContainerViewModel}"
                                                       IsVisible="{Binding IsMusicSelectionVisible}" />

                <!-- Delete button - SfEffectsView for WinUI only -->
                <Grid Grid.Row="5"
                      Margin="0"
                      VerticalOptions="End"
                      HorizontalOptions="Fill"
                      HeightRequest="{StaticResource IconStandardContainerSize}">
                    <core:SfEffectsView Margin="0"
                                        TouchDownEffects="Ripple"
                                        TouchUpEffects="None"
                                        RippleBackground="{StaticResource ErrorColor}"
                                        RippleAnimationDuration="200"
                                        ShouldIgnoreTouches="False"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill">
                        <core:SfEffectsView.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                                <On Platform="WinUI" Value="true" />
                            </OnPlatform>
                        </core:SfEffectsView.IsVisible>
                        <core:SfEffectsView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                        </core:SfEffectsView.GestureRecognizers>
                        <Border x:Name="DeleteButton"
                                IsVisible="{Binding IsExistingSchedule}"
                                BackgroundColor="{StaticResource ErrorColor}"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                InputTransparent="True"
                                IsEnabled="False">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource CornerRadiusStandard}" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#40000000" 
                                        Offset="0,2" 
                                        Radius="4" 
                                        Opacity="0.3" />
                            </Border.Shadow>
                            <Label Text="{x:Static fn:GlyphNames.Trash}" 
                                   FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                                   FontSize="{StaticResource IconStandardFontSize}"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsDeleteBusy, Converter={StaticResource negateBooleanConverter}}" />
                        </Border>
                    </core:SfEffectsView>
                    <!-- Loading indicator overlay - shows when IsDeleteBusy is true -->
                    <ActivityIndicator
                            IsRunning="{Binding IsDeleteBusy}"
                            IsVisible="{Binding IsDeleteBusy}"
                            Color="White"
                            WidthRequest="{StaticResource IconStandardFontSize}"
                            HeightRequest="{StaticResource IconStandardFontSize}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Opacity="0.95" />
                </Grid>
                <Grid Grid.Row="5"
                      x:Name="DeleteButtonNoEffects"
                      Margin="0"
                      IsVisible="{Binding IsExistingSchedule}"
                      VerticalOptions="End"
                      HorizontalOptions="Fill"
                      HeightRequest="{StaticResource IconStandardContainerSize}">
                    <Border x:Name="DeleteButtonNoEffectsBorder"
                            Margin="0"
                            BackgroundColor="{StaticResource ErrorColor}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusStandard}" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#40000000" 
                                    Offset="0,2" 
                                    Radius="4" 
                                    Opacity="0.3" />
                        </Border.Shadow>
                        <Label Text="{x:Static fn:GlyphNames.Trash}" 
                               FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                               FontSize="{StaticResource IconStandardFontSize}"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               IsVisible="{Binding IsDeleteBusy, Converter={StaticResource negateBooleanConverter}}" />
                    </Border>
                    <!-- Loading indicator overlay - shows when IsDeleteBusy is true -->
                    <ActivityIndicator
                            IsRunning="{Binding IsDeleteBusy}"
                            IsVisible="{Binding IsDeleteBusy}"
                            Color="White"
                            WidthRequest="{StaticResource IconStandardFontSize}"
                            HeightRequest="{StaticResource IconStandardFontSize}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Opacity="0.95" />
                </Grid>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>


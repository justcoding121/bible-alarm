<?xml version="1.0" encoding="utf-8"?>

<ContentView x:Class="Bible.Alarm.Views.Schedule.ScheduleContent"
             xmlns:scheduleViews="clr-namespace:Bible.Alarm.Views.Schedule;assembly=Bible.Alarm"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
             xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared;assembly=Bible.Alarm"
             xmlns:fn="clr-namespace:Bible.Alarm.Views"
             x:DataType="vm:ScheduleViewModel"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">
    <!-- Converters moved to App.xaml for better performance - shared across all pages -->
    <!-- Theme-aware colors are inherited from BaseContentPage -->
    <Grid x:Name="MainGrid"
          RowSpacing="0"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <FlexLayout Grid.Row="0"
              x:Name="ButtonContainer"
              Margin="0,0,0,4"
              Wrap="Wrap"
              JustifyContent="Center"
              AlignItems="Stretch"
              AlignContent="Start"
              HorizontalOptions="Fill">
            <!-- Cancel button - SfEffectsView for WinUI only -->
            <core:SfEffectsView Margin="0,0,3,0"
                                 FlexLayout.Basis="45%"
                                 FlexLayout.Grow="1"
                                 TouchDownEffects="Ripple"
                                 TouchUpEffects="None"
                                 RippleBackground="{DynamicResource DividerColor}"
                                 RippleAnimationDuration="200"
                                 ShouldIgnoreTouches="False"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Start"
                                 HeightRequest="{DynamicResource IconStandardContainerSize}">
                <core:SfEffectsView.IsVisible>
                    <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                        <On Platform="WinUI" Value="true" />
                    </OnPlatform>
                </core:SfEffectsView.IsVisible>
                <core:SfEffectsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CancelCommand}" />
                </core:SfEffectsView.GestureRecognizers>
                <Button x:Name="CancelButton"
                        AutomationId="CancelButton"
                        BackgroundColor="{DynamicResource DividerColor}"
                        CornerRadius="{DynamicResource CornerRadiusStandard}"
                        FontSize="{DynamicResource ButtonFontSize}"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        InputTransparent="True"
                        IsEnabled="False">
                    <Button.Text>
                        <FormattedString>
                            <Span Text="{x:Static fn:GlyphNames.Xmark}" 
                                  FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                                  FontSize="{DynamicResource ButtonFontSize}" />
                            <Span Text=" CANCEL" />
                        </FormattedString>
                    </Button.Text>
                    <Button.Shadow>
                        <Shadow Brush="#20000000" 
                                Offset="0,2" 
                                Radius="4" 
                                Opacity="0.2" />
                    </Button.Shadow>
                </Button>
            </core:SfEffectsView>
            <Button x:Name="CancelButtonNoEffects"
                    Margin="0,0,3,0"
                    FlexLayout.Basis="45%"
                    FlexLayout.Grow="1"
                    AutomationId="CancelButton"
                    BackgroundColor="{DynamicResource DividerColor}"
                    CornerRadius="{DynamicResource CornerRadiusStandard}"
                    Command="{Binding CancelCommand}"
                    FontSize="{DynamicResource ButtonFontSize}"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    HeightRequest="{DynamicResource IconStandardContainerSize}"
                    TextColor="{DynamicResource TextSecondaryColor}"
                    IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}">
                <Button.Text>
                    <FormattedString>
                        <Span Text="{x:Static fn:GlyphNames.Xmark}" 
                              FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                              FontSize="{DynamicResource ButtonFontSize}" />
                        <Span Text=" CANCEL" />
                    </FormattedString>
                </Button.Text>
                <Button.Shadow>
                    <Shadow Brush="#20000000" 
                            Offset="0,2" 
                            Radius="4" 
                            Opacity="0.2" />
                </Button.Shadow>
            </Button>
            <!-- Save button - SfEffectsView for WinUI only -->
            <core:SfEffectsView Margin="3,0,0,0"
                                 FlexLayout.Basis="45%"
                                 FlexLayout.Grow="1"
                                 TouchDownEffects="Ripple"
                                 TouchUpEffects="None"
                                 RippleBackground="{StaticResource PrimaryColor}"
                                 RippleAnimationDuration="200"
                                 ShouldIgnoreTouches="False"
                                 HorizontalOptions="Fill"
                                 VerticalOptions="Start"
                                 HeightRequest="{DynamicResource IconStandardContainerSize}">
                <core:SfEffectsView.IsVisible>
                    <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                        <On Platform="WinUI" Value="true" />
                    </OnPlatform>
                </core:SfEffectsView.IsVisible>
                <core:SfEffectsView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SaveCommand}" />
                </core:SfEffectsView.GestureRecognizers>
                <Button x:Name="SaveButton"
                        AutomationId="SaveButton"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        CornerRadius="{DynamicResource CornerRadiusStandard}"
                        FontSize="{DynamicResource ButtonFontSize}"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        TextColor="White"
                        InputTransparent="True"
                        IsEnabled="False">
                    <Button.Text>
                        <FormattedString>
                            <Span Text="{x:Static fn:GlyphNames.FloppyDisk}" 
                                  FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                                  FontSize="{DynamicResource ButtonFontSize}" />
                            <Span Text=" SAVE" />
                        </FormattedString>
                    </Button.Text>
                    <Button.Shadow>
                        <Shadow Brush="#40000000" 
                                Offset="0,2" 
                                Radius="4" 
                                Opacity="0.3" />
                    </Button.Shadow>
                </Button>
            </core:SfEffectsView>
            <Button x:Name="SaveButtonNoEffects"
                    Margin="3,0,0,0"
                    FlexLayout.Basis="45%"
                    FlexLayout.Grow="1"
                    AutomationId="SaveButton"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    CornerRadius="{DynamicResource CornerRadiusStandard}"
                    Command="{Binding SaveCommand}"
                    FontSize="{DynamicResource ButtonFontSize}"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    HeightRequest="{DynamicResource IconStandardContainerSize}"
                    TextColor="White"
                    IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}">
                <Button.Text>
                    <FormattedString>
                        <Span Text="{x:Static fn:GlyphNames.FloppyDisk}" 
                              FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                              FontSize="{DynamicResource ButtonFontSize}" />
                        <Span Text=" SAVE" />
                    </FormattedString>
                </Button.Text>
                <Button.Shadow>
                    <Shadow Brush="#40000000" 
                            Offset="0,2" 
                            Radius="4" 
                            Opacity="0.3" />
                </Button.Shadow>
            </Button>
        </FlexLayout>
        <ScrollView x:Name="ScheduleScrollView"
                    Grid.Row="1"
                    Margin="0,0,0,0">
            <Grid x:Name="ScrollContentGrid"
                  HorizontalOptions="Fill"
                  RowSpacing="{DynamicResource SpacingStandard}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <scheduleViews:ScheduleDetailsContainer Grid.Row="0" BindingContext="{Binding ScheduleDetailsContainerViewModel}" />
                <scheduleViews:AlarmSettingsContainer Grid.Row="1" BindingContext="{Binding AlarmSettingsContainerViewModel}" />
                <scheduleViews:BibleSelectionContainer Grid.Row="2" BindingContext="{Binding BibleSelectionContainerViewModel}" />
                <scheduleViews:NumberOfTrackContainer Grid.Row="3" BindingContext="{Binding NumberOfTrackContainerViewModel}" />
                <scheduleViews:MusicSelectionContainer Grid.Row="4" 
                                                       BindingContext="{Binding MusicSelectionContainerViewModel}"
                                                       IsVisible="{Binding IsMusicSelectionVisible}" />

                <!-- Delete button - SfEffectsView for WinUI only -->
                <core:SfEffectsView Grid.Row="5"
                                    Margin="0,10,0,5"
                                    VerticalOptions="End"
                                    TouchDownEffects="Ripple"
                                    TouchUpEffects="None"
                                    RippleBackground="{StaticResource ErrorColor}"
                                    RippleAnimationDuration="200"
                                    ShouldIgnoreTouches="False"
                                    HorizontalOptions="Fill"
                                    HeightRequest="{DynamicResource IconStandardContainerSize}">
                    <core:SfEffectsView.IsVisible>
                        <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                            <On Platform="WinUI" Value="true" />
                        </OnPlatform>
                    </core:SfEffectsView.IsVisible>
                    <core:SfEffectsView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                    </core:SfEffectsView.GestureRecognizers>
                    <Button x:Name="DeleteButton"
                            IsVisible="{Binding IsExistingSchedule}"
                            BackgroundColor="{StaticResource ErrorColor}"
                            CornerRadius="{DynamicResource CornerRadiusStandard}"
                            FontSize="{DynamicResource ButtonFontSize}"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill"
                            TextColor="White"
                            InputTransparent="True"
                            IsEnabled="False">
                        <Button.Text>
                            <FormattedString>
                                <Span Text="{x:Static fn:GlyphNames.Trash}" 
                                      FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                                      FontSize="{DynamicResource ButtonFontSize}" />
                                <Span Text=" DELETE" />
                            </FormattedString>
                        </Button.Text>
                        <Button.Shadow>
                            <Shadow Brush="#40000000" 
                                    Offset="0,2" 
                                    Radius="4" 
                                    Opacity="0.3" />
                        </Button.Shadow>
                    </Button>
                </core:SfEffectsView>
                <Button Grid.Row="5"
                        x:Name="DeleteButtonNoEffects"
                        Margin="0,10,0,5"
                        IsVisible="{Binding IsExistingSchedule}"
                        VerticalOptions="End"
                        BackgroundColor="{StaticResource ErrorColor}"
                        CornerRadius="{DynamicResource CornerRadiusStandard}"
                        Command="{Binding DeleteCommand}"
                        FontSize="{DynamicResource ButtonFontSize}"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        HeightRequest="{DynamicResource IconStandardContainerSize}"
                        TextColor="White">
                    <Button.Text>
                        <FormattedString>
                            <Span Text="{x:Static fn:GlyphNames.Trash}" 
                                  FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                                  FontSize="{DynamicResource ButtonFontSize}" />
                            <Span Text=" DELETE" />
                        </FormattedString>
                    </Button.Text>
                    <Button.Shadow>
                        <Shadow Brush="#40000000" 
                                Offset="0,2" 
                                Radius="4" 
                                Opacity="0.3" />
                    </Button.Shadow>
                </Button>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>


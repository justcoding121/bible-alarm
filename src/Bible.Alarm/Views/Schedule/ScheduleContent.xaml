<?xml version="1.0" encoding="utf-8"?>

<ContentView x:Class="Bible.Alarm.Views.Schedule.ScheduleContent"
             xmlns:scheduleViews="clr-namespace:Bible.Alarm.Views.Schedule;assembly=Bible.Alarm"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
             xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
             xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
             x:DataType="vm:ScheduleViewModel"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">
    <!-- Converters moved to App.xaml for better performance - shared across all pages -->
    <!-- Theme-aware colors are inherited from BaseContentPage -->
    <Grid x:Name="MainGrid"
          RowSpacing="0"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0"
              x:Name="ButtonContainer"
              ColumnSpacing="0"
              RowSpacing="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <!-- Cancel button - platform-specific styling handled via code-behind for better performance -->
            <Button Grid.Column="0"
                    x:Name="CancelButton"
                    Margin="0,3,3,3"
                    AutomationId="CancelButton"
                    BackgroundColor="{DynamicResource DividerColor}"
                    CornerRadius="8"
                    Command="{Binding CancelCommand}"
                    FontSize="{DynamicResource LargeFontSize}"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    Text="CANCEL"
                    TextColor="{DynamicResource TextSecondaryColor}">
                <Button.Shadow>
                    <Shadow Brush="#20000000" 
                            Offset="0,2" 
                            Radius="4" 
                            Opacity="0.2" />
                </Button.Shadow>
            </Button>
            <!-- Save button - platform-specific styling handled via code-behind for better performance -->
            <Button Grid.Column="1"
                    x:Name="SaveButton"
                    Margin="3,3,0,3"
                    AutomationId="SaveButton"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    CornerRadius="8"
                    Command="{Binding SaveCommand}"
                    FontSize="{DynamicResource LargeFontSize}"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    Text="SAVE"
                    TextColor="White">
                <Button.Shadow>
                    <Shadow Brush="#40000000" 
                            Offset="0,2" 
                            Radius="4" 
                            Opacity="0.3" />
                </Button.Shadow>
            </Button>
        </Grid>
        <ScrollView x:Name="ScheduleScrollView"
                    Grid.Row="1"
                    Margin="0,0,0,0">
            <Grid x:Name="ScrollContentGrid"
                  HorizontalOptions="Fill"
                  RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <scheduleViews:ScheduleDetailsContainer Grid.Row="0" BindingContext="{Binding ScheduleDetailsContainerViewModel}" />
                <scheduleViews:BibleSelectionContainer Grid.Row="1" BindingContext="{Binding BibleSelectionContainerViewModel}" />
                <scheduleViews:NumberOfTrackContainer Grid.Row="2" BindingContext="{Binding NumberOfTrackContainerViewModel}" />
                <scheduleViews:MusicSelectionContainer Grid.Row="3" BindingContext="{Binding MusicSelectionContainerViewModel}" />

                <!-- Delete button - platform-specific styling handled via code-behind for better performance -->
                <Button Grid.Row="4"
                        x:Name="DeleteButton"
                        Margin="0,10,0,5"
                        IsVisible="{Binding IsExistingSchedule}"
                        VerticalOptions="End"
                        BackgroundColor="{StaticResource ErrorColor}"
                        CornerRadius="8"
                        Command="{Binding DeleteCommand}"
                        FontSize="{DynamicResource LargeFontSize}"
                        FontAttributes="Bold"
                        HorizontalOptions="Fill"
                        Text="DELETE"
                        TextColor="White">
                    <Button.Shadow>
                        <Shadow Brush="#40000000" 
                                Offset="0,2" 
                                Radius="4" 
                                Opacity="0.3" />
                    </Button.Shadow>
                </Button>
            </Grid>
        </ScrollView>
    </Grid>
</ContentView>


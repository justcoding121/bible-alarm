<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Bible.Alarm.Views.Styles"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Font size resources - set with default values, will be updated in code-behind -->
    <!-- These are updated automatically when screen size/orientation changes or OS font scale changes -->
    <!-- Using platform-specific defaults per industry standards (iOS/Android/Windows) -->
    <!-- Initial values are iOS defaults; actual platform-specific values are set at runtime -->
    <x:Double x:Key="StandardFontSize">17.0</x:Double>
    <x:Double x:Key="HeaderFontSize">22.0</x:Double>
    <x:Double x:Key="ButtonFontSize">21.0</x:Double>
    <x:Double x:Key="SmallFontSize">13.0</x:Double>
    <x:Double x:Key="SmallMediumFontSize">15.0</x:Double>
    <x:Double x:Key="MediumFontSize">17.0</x:Double>
    <x:Double x:Key="LargeFontSize">22.0</x:Double>
    <x:Double x:Key="TitleFontSize">28.0</x:Double>
    <x:Double x:Key="AlarmTimeFontSize">36.0</x:Double>
    <x:Double x:Key="AlarmMeridianFontSize">18.0</x:Double>
    <x:Double x:Key="AlarmBellIconFontSize">80.0</x:Double>
    
    <!-- Icon font sizes - for Font Awesome and other icon fonts -->
    <!-- These scale with OS accessibility settings for better visibility -->
    <x:Double x:Key="IconSmallFontSize">14.0</x:Double>
    <x:Double x:Key="IconStandardFontSize">20.0</x:Double>
    <x:Double x:Key="IconLargeFontSize">28.0</x:Double>
    
    <!-- Icon container sizes - for icon button containers -->
    <!-- These scale with OS accessibility settings so containers grow with icons -->
    <x:Double x:Key="IconSmallContainerSize">32.0</x:Double>
    <x:Double x:Key="IconStandardContainerSize">48.0</x:Double>
    <x:Double x:Key="IconLargeContainerSize">56.0</x:Double>
    
    <!-- Content width resources - for modal and content widths -->
    <!-- These scale with OS accessibility settings for better layout at larger font sizes -->
    <x:Double x:Key="ContentWidthSmall">200.0</x:Double>
    <x:Double x:Key="ContentWidthMedium">240.0</x:Double>
    <x:Double x:Key="ContentWidthLarge">280.0</x:Double>
    
    <!-- Spacing and padding resources - scale with OS font size for fluent UI -->
    <!-- These are updated automatically when screen size/orientation changes or OS font scale changes -->
    <x:Double x:Key="SpacingExtraSmall">2.0</x:Double>
    <x:Double x:Key="SpacingSmall">4.0</x:Double>
    <x:Double x:Key="SpacingMedium">8.0</x:Double>
    <x:Double x:Key="SpacingStandard">12.0</x:Double>
    <x:Double x:Key="SpacingLarge">16.0</x:Double>
    <x:Double x:Key="SpacingExtraLarge">20.0</x:Double>
    <x:Double x:Key="SpacingXLarge">24.0</x:Double>
    
    <!-- Padding resources - scale with OS font size -->
    <x:Double x:Key="PaddingSmall">4.0</x:Double>
    <x:Double x:Key="PaddingMedium">8.0</x:Double>
    <x:Double x:Key="PaddingStandard">12.0</x:Double>
    <x:Double x:Key="PaddingLarge">16.0</x:Double>
    <x:Double x:Key="PaddingExtraLarge">20.0</x:Double>
    <x:Double x:Key="PaddingXLarge">24.0</x:Double>
    <x:Double x:Key="PaddingXXLarge">32.0</x:Double>
    <x:Double x:Key="PaddingXXXLarge">40.0</x:Double>
    <x:Double x:Key="PaddingXXXXLarge">48.0</x:Double>
    
    <!-- Margin resources - scale with OS font size -->
    <x:Double x:Key="MarginSmall">4.0</x:Double>
    <x:Double x:Key="MarginMedium">8.0</x:Double>
    <x:Double x:Key="MarginStandard">12.0</x:Double>
    <x:Double x:Key="MarginLarge">16.0</x:Double>
    <x:Double x:Key="MarginExtraLarge">20.0</x:Double>
    <x:Double x:Key="MarginXLarge">24.0</x:Double>
    
    <!-- Minimum height resources - scale with OS font size for touch targets -->
    <x:Double x:Key="MinimumHeightStandard">56.0</x:Double>
    
    <!-- Corner radius resources - scale slightly with font size for better proportions -->
    <x:Double x:Key="CornerRadiusSmall">4.0</x:Double>
    <x:Double x:Key="CornerRadiusMedium">6.0</x:Double>
    <x:Double x:Key="CornerRadiusStandard">8.0</x:Double>
    <x:Double x:Key="CornerRadiusLarge">12.0</x:Double>

    <!-- Color Resources (static - theme-aware colors are defined per-page) -->
    <Color x:Key="PrimaryColor">#6A5ACD</Color>
    <Color x:Key="PrimaryColorDark">#512BD4</Color>
    <Color x:Key="ErrorColor">#FF3B30</Color>
    <Color x:Key="WarningColor">#FF9500</Color>
    <Color x:Key="SuccessColor">#34C759</Color>

    <!-- Base Label Style - Applied globally to all Labels -->
    <Style x:Key="BaseLabelStyle" TargetType="Label">
        <Setter Property="FontSize" Value="{DynamicResource StandardFontSize}" />
    </Style>

    <!-- Header Label Style - For headers and titles -->
    <Style x:Key="HeaderLabelStyle" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{DynamicResource HeaderFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Small Label Style -->
    <Style x:Key="SmallLabelStyle" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{DynamicResource SmallFontSize}" />
    </Style>

    <!-- Medium Label Style -->
    <Style x:Key="MediumLabelStyle" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{DynamicResource MediumFontSize}" />
    </Style>

    <!-- Large Label Style -->
    <Style x:Key="LargeLabelStyle" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{DynamicResource LargeFontSize}" />
    </Style>

    <!-- Title Label Style -->
    <Style x:Key="TitleLabelStyle" TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}">
        <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
        <Setter Property="FontAttributes" Value="Bold" />
    </Style>

    <!-- Base Button Style - Applied globally to all Buttons -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="FontSize" Value="{DynamicResource StandardFontSize}" />
    </Style>

    <!-- Base Entry Style - Applied globally to all Entry controls -->
    <Style x:Key="BaseEntryStyle" TargetType="Entry">
        <Setter Property="FontSize" Value="{DynamicResource StandardFontSize}" />
    </Style>

    <!-- Base Editor Style - Applied globally to all Editor controls -->
    <Style x:Key="BaseEditorStyle" TargetType="Editor">
        <Setter Property="FontSize" Value="{DynamicResource StandardFontSize}" />
    </Style>

    <!-- Base Picker Style - Applied globally to all Picker controls -->
    <Style x:Key="BasePickerStyle" TargetType="Picker">
        <Setter Property="FontSize" Value="{DynamicResource StandardFontSize}" />
    </Style>

    <!-- Base DatePicker Style - Applied globally to all DatePicker controls -->
    <Style x:Key="BaseDatePickerStyle" TargetType="DatePicker">
        <Setter Property="FontSize" Value="{DynamicResource StandardFontSize}" />
    </Style>

    <!-- Base TimePicker Style - Applied globally to all TimePicker controls -->
    <Style x:Key="BaseTimePickerStyle" TargetType="TimePicker">
        <Setter Property="FontSize" Value="{DynamicResource StandardFontSize}" />
    </Style>

    <!-- Base SearchBar Style - Applied globally to all SearchBar controls -->
    <Style x:Key="BaseSearchBarStyle" TargetType="SearchBar">
        <Setter Property="FontSize" Value="{DynamicResource StandardFontSize}" />
    </Style>

</ResourceDictionary>



<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Bible.BiblePublicationTrackSelection"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:bible="clr-namespace:Bible.Alarm.ViewModels.BiblePublications"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    x:DataType="bible:BiblePublicationTrackSelectionViewModel"
    Title="Select Track">
    <ContentPage.Resources>
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource BackgroundColor}"
              FlowDirection="LeftToRight">
            <!-- MAIN LIST -->
            <Grid
                Margin="0"
                IsVisible="{Binding IsBusy, Converter={StaticResource negateBooleanConverter}}"
                RowSpacing="0">
                <!-- Enhanced Collection View -->
                <CollectionView
                    x:Name="trackCollectionView"
                    Margin="0,8,0,0"
                    BackgroundColor="Transparent"
                    Footer="{OnPlatform iOS=''}"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding Tracks}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical">
                            <LinearItemsLayout.ItemSpacing>
                                <OnPlatform x:TypeArguments="x:Double">
                                    <On Platform="WinUI" Value="4" />
                                    <On Platform="Default" Value="8" />
                                </OnPlatform>
                            </LinearItemsLayout.ItemSpacing>
                        </LinearItemsLayout>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="bible:BiblePublicationTrackListViewItemModel">
                            <Grid Margin="16,0">
                                <core:SfEffectsView
                                    TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                    TouchUpEffects="None"
                                    RippleBackground="{StaticResource PrimaryColor}"
                                    HighlightBackground="{StaticResource PrimaryLightColor}"
                                    RippleAnimationDuration="200"
                                    ShouldIgnoreTouches="False">
                                    <core:SfEffectsView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnTrackItemTapped" />
                                    </core:SfEffectsView.GestureRecognizers>
                                    <Border
                                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                                        StrokeThickness="0"
                                        Padding="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                                    Offset="0,2"
                                                    Opacity="0.08"
                                                    Radius="4" />
                                        </Border.Shadow>
                                        <Grid
                                            Padding="20,18"
                                            ColumnSpacing="12"
                                            MinimumHeightRequest="56"
                                            BackgroundColor="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            
                                            <!-- Track Title -->
                                            <Label
                                                Grid.Column="0"
                                                FontSize="{DynamicResource LargeFontSize}"
                                                HorizontalOptions="Fill"
                                                HorizontalTextAlignment="Start"
                                                InputTransparent="True"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Title}"
                                                TextColor="{DynamicResource TextPrimaryColor}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                            <!-- Progress indicator - shows when IsNavigating is true -->
                                            <Grid Grid.Column="1"
                                                  Margin="12,0,0,0"
                                                  VerticalOptions="Center"
                                                  HorizontalOptions="End"
                                                  HeightRequest="{DynamicResource IconStandardFontSize}"
                                                  WidthRequest="{DynamicResource IconStandardFontSize}">
                                                <ActivityIndicator
                                                        IsRunning="{Binding IsNavigating}"
                                                        IsVisible="{Binding IsNavigating}"
                                                        Color="{DynamicResource TextPrimaryColor}"
                                                        WidthRequest="{DynamicResource IconStandardFontSize}"
                                                        HeightRequest="{DynamicResource IconStandardFontSize}"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="Center"
                                                        Opacity="0.95" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </core:SfEffectsView>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            
            <!-- BUSY OVERLAY – appears only while IsBusy = true -->
            <shared:BusyOverlay IsVisible="{Binding IsBusy}" />
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>

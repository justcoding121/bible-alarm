<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Bible.BiblePublicationLanguageModal"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:bible="clr-namespace:Bible.Alarm.ViewModels.BiblePublications"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:shared="clr-namespace:Bible.Alarm.ViewModels.Shared"
    xmlns:sharedViews="clr-namespace:Bible.Alarm.Views.Shared"
    xmlns:sharedControls="clr-namespace:Bible.Alarm.Views.Shared;assembly=Bible.Alarm"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:helpers="clr-namespace:Bible.Alarm.Common.ViewHelpers;assembly=Bible.Alarm"
    x:DataType="bible:BiblePublicationSelectionViewModel"
    Padding="0,0,0,0">
    <ContentPage.Resources>
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid
            x:Name="MainGrid"
            BackgroundColor="{DynamicResource BackgroundColor}"
            ColumnSpacing="0"
            RowSpacing="0"
            HorizontalOptions="Fill"
            VerticalOptions="Fill">
            <Grid.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnGridTapped" />
            </Grid.GestureRecognizers>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            
            <!-- Enhanced Header -->
            <Border
                Grid.Row="0"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="20,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,20,20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <helpers:PlatformShadow LightBrush="#E0E0E0" DarkBrush="#000000"
                            Offset="0,4"
                            Opacity="0.1"
                            Radius="8" />
                </Border.Shadow>
                <Label
                    FontSize="{DynamicResource HeaderFontSize}"
                    FontAttributes="Bold"
                    MinimumHeightRequest="{DynamicResource IconLargeContainerSize}"
                    Text="Select Language"
                    TextColor="{DynamicResource TextPrimaryColor}"
                    VerticalOptions="Fill"
                    VerticalTextAlignment="Center" />
            </Border>
            
            <!-- Search Entry -->
            <Border
                Grid.Row="1"
                Margin="16,8,16,0"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="{OnPlatform iOS='12,8', Default='12,3'}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="{DynamicResource CornerRadiusLarge}" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <helpers:PlatformShadow LightBrush="#E0E0E0" DarkBrush="#000000"
                            Offset="0,2"
                            Opacity="0.08"
                            Radius="4" />
                </Border.Shadow>
                <Grid ColumnSpacing="{DynamicResource SpacingMedium}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0"
                           Text="{x:Static fn:GlyphNames.Search}"
                           FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                           FontSize="{DynamicResource IconSmallFontSize}"
                           TextColor="{DynamicResource TextSecondaryColor}"
                           VerticalOptions="Center" />
                    <Entry x:Name="LanguageSearchEntry"
                           AutomationId="LanguageSearchBar"
                           Grid.Column="1"
                           Margin="0"
                           BackgroundColor="Transparent"
                           HorizontalOptions="FillAndExpand"
                           Placeholder="Search languages"
                           PlaceholderColor="{DynamicResource TextSecondaryColor}"
                           Text="{Binding LanguageSearchTerm, Mode=TwoWay}"
                           TextColor="{DynamicResource TextPrimaryColor}"
                           FontSize="{DynamicResource LargeFontSize}"
                           VerticalOptions="Center" />
                </Grid>
            </Border>
            
            <!-- Enhanced Collection View - hidden on Android until helper reveals after list is rendered (avoids empty-list flash) -->
            <CollectionView
                x:Name="LanguageCollectionView"
                Grid.Row="2"
                Margin="0,8,0,20"
                BackgroundColor="Transparent"
                Footer="{OnPlatform iOS=''}"
                HorizontalOptions="Fill"
                IsVisible="True"
                ItemsSource="{Binding Languages}"
                Opacity="{OnPlatform Android=0, iOS=0, Default=1}"
                MinimumHeightRequest="300"
                MinimumWidthRequest="250"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <!-- Use inline OnPlatform syntax for better release mode compatibility -->
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="{OnPlatform WinUI=4, Default=8}" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="shared:LanguageListViewItemModel">
                            <Grid Margin="16,0">
                                <core:SfEffectsView
                                    TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                    TouchUpEffects="None"
                                    RippleBackground="{StaticResource PrimaryColor}"
                                    HighlightBackground="{StaticResource PrimaryLightColor}"
                                    RippleAnimationDuration="200"
                                    ShouldIgnoreTouches="False">
                                    <core:SfEffectsView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnLanguageItemTapped" />
                                    </core:SfEffectsView.GestureRecognizers>
                                    <Border
                                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                                        StrokeThickness="0"
                                        Padding="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <helpers:PlatformShadow LightBrush="#E0E0E0" DarkBrush="#000000"
                                                    Offset="0,2"
                                                    Opacity="0.08"
                                                    Radius="4" />
                                        </Border.Shadow>
                                        <Grid
                                            Padding="20,18"
                                            ColumnSpacing="12"
                                            HorizontalOptions="Fill"
                                            MinimumHeightRequest="56"
                                            BackgroundColor="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Label
                                                Grid.Column="0"
                                                FontSize="{DynamicResource LargeFontSize}"
                                                HorizontalOptions="Start"
                                                HorizontalTextAlignment="Start"
                                                InputTransparent="True"
                                                LineBreakMode="WordWrap"
                                                Text="{Binding Name}"
                                                TextColor="{DynamicResource TextPrimaryColor}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                            <!-- Row progress (language ad-hoc fetch) -->
                                            <HorizontalStackLayout
                                                Grid.Column="1"
                                                Margin="12,0,0,0"
                                                Spacing="{DynamicResource SpacingSmall}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="End">
                                                <ActivityIndicator
                                                    IsRunning="{Binding IsNavigating}"
                                                    IsVisible="{Binding IsNavigating}"
                                                    Color="{DynamicResource TextPrimaryColor}"
                                                    WidthRequest="{DynamicResource SpinnerFontSize}"
                                                    HeightRequest="{DynamicResource SpinnerFontSize}"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="End"
                                                    Opacity="0.95" />
                                            </HorizontalStackLayout>
                                        </Grid>
                                    </Border>
                                </core:SfEffectsView>
                            </Grid>
                        </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <!-- Close Button - SfEffectsView for WinUI only -->
            <core:SfEffectsView Grid.Row="3"
                x:Name="CloseButtonEffectsView"
                Margin="{DynamicResource MarginThicknessModalClose}"
                TouchDownEffects="Ripple"
                TouchUpEffects="None"
                RippleBackground="{DynamicResource PrimaryColor}"
                RippleAnimationDuration="200"
                ShouldIgnoreTouches="False"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                HeightRequest="{DynamicResource IconStandardContainerSize}">
                <core:SfEffectsView.IsVisible>
                    <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                        <On Platform="WinUI" Value="true" />
                    </OnPlatform>
                </core:SfEffectsView.IsVisible>
                <Border x:Name="CloseButton"
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    Padding="20,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding CloseModalCommand}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <helpers:PlatformShadow LightBrush="#E0E0E0" DarkBrush="#000000"
                                Offset="0,2"
                                Opacity="0.1"
                                Radius="4" />
                    </Border.Shadow>
                    <Label Text="{x:Static fn:GlyphNames.Xmark}" 
                           FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                           FontSize="{DynamicResource IconStandardFontSize}"
                           TextColor="{AppThemeBinding Light=#212529, Dark=White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </core:SfEffectsView>
            <!-- Regular button for Android/iOS -->
            <Border Grid.Row="3"
                x:Name="CloseButtonNoEffects"
                Margin="{DynamicResource MarginThicknessModalClose}"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                HorizontalOptions="Fill"
                Padding="{OnPlatform Android='20,6,20,10', iOS='20,12', Default='20,12'}"
                VerticalOptions="Center"
                HeightRequest="{DynamicResource IconStandardContainerSize}"
                IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseModalCommand}" />
                </Border.GestureRecognizers>
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <helpers:PlatformShadow LightBrush="#E0E0E0" DarkBrush="#000000"
                            Offset="0,2"
                            Opacity="0.1"
                            Radius="4" />
                </Border.Shadow>
                <Label Text="{x:Static fn:GlyphNames.Xmark}" 
                       FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}" 
                       FontSize="{DynamicResource IconStandardFontSize}"
                       TextColor="{DynamicResource PrimaryTextColor}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Border>
            
            <!-- Progress indicator when fetching -->
            <sharedViews:ProgressIndicator Grid.Row="0"
                                           Grid.RowSpan="4" />
            
            <!-- BUSY OVERLAY – appears only while IsBusy = true -->
            <sharedViews:BusyOverlay x:Name="BusyOverlay"
                                     Grid.Row="0"
                                     Grid.RowSpan="4"
                                     HardTimeoutMs="0"
                                     ShowCancelButton="True"
                                     CancelCommand="{Binding CancelFetchCommand}"
                                     IsCancelBusy="{Binding IsCancelBusy}"
                                     IsVisible="{Binding IsBusy}" />
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>

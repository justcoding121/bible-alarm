<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Bible.BiblePublicationSelection"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:bible="clr-namespace:Bible.Alarm.ViewModels.Bible"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:shared="clr-namespace:Bible.Alarm.ViewModels.Shared"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:DataType="bible:BiblePublicationSelectionViewModel"
    Title="Select Translation"
    BackgroundColor="{DynamicResource BackgroundColor}">
    <ContentPage.Resources>
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid x:Name="MainContentGrid" BackgroundColor="{DynamicResource BackgroundColor}">
            <!-- MAIN LIST -->
            <Grid x:Name="MainContentList"
                Margin="0"
                RowSpacing="0">
                <!-- Enhanced Collection View with Card Layout -->
                <CollectionView
                    x:Name="translationsCollectionView"
                    Margin="0,8,0,0"
                    BackgroundColor="Transparent"
                    Footer="{OnPlatform iOS=''}"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding Translations}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical">
                            <LinearItemsLayout.ItemSpacing>
                                <OnPlatform x:TypeArguments="x:Double">
                                    <On Platform="WinUI" Value="4" />
                                    <On Platform="Default" Value="8" />
                                </OnPlatform>
                            </LinearItemsLayout.ItemSpacing>
                        </LinearItemsLayout>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="shared:PublicationListViewItemModel">
                            <Grid Margin="16,0">
                                <Border
                                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                                    StrokeThickness="0"
                                    Padding="0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                                Offset="0,2"
                                                Opacity="0.08"
                                                Radius="4" />
                                    </Border.Shadow>
                                    <Grid
                                        Padding="20,18"
                                        ColumnSpacing="12"
                                        MinimumHeightRequest="56"
                                        BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnTranslationItemTapped" />
                                        </Grid.GestureRecognizers>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Bible Translation Name -->
                                        <Label
                                            Grid.Column="0"
                                            FontSize="16"
                                            HorizontalOptions="Fill"
                                            HorizontalTextAlignment="Start"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Name}"
                                            TextColor="{DynamicResource TextPrimaryColor}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>

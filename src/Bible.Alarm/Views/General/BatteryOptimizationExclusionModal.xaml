<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.General.BatteryOptimizationExclusionModal"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels.Schedule;assembly=Bible.Alarm"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    x:DataType="vm:NumberOfChapterContainerViewModel"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource BackgroundColor}" Padding="20">
            <Border
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="24">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                            Offset="0,8"
                            Opacity="0.15"
                            Radius="16" />
                </Border.Shadow>
                <Grid
                    Margin="0,0,0,125"
                    AutomationId="BatteryOptimizationModal"
                    HorizontalOptions="Fill"
                    RowSpacing="20"
                    VerticalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Info Icon -->
                    <Label Grid.Row="0"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="48"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static fn:GlyphNames.InfoCircle}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        VerticalOptions="Center" />
                    
                    <!-- Main Message -->
                    <Label Grid.Row="1"
                        FontSize="16"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="Audio may not play in background on certain android devices like OnePlus due to aggressive battery optimization. This application will not drain your device battery. We recommend to exclude this app from battery optimization."
                        TextColor="{DynamicResource TextPrimaryColor}"
                        VerticalOptions="Start"
                        VerticalTextAlignment="Start" />
                    
                    <!-- Instructions -->
                    <Label Grid.Row="2"
                        IsVisible="{Binding CanOptimizeBattery}"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="Click Exclude Now => Apps not optimized => All Apps => Bible Alarm => Off"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        VerticalOptions="Start"
                        VerticalTextAlignment="Start" />
                    
                    <Label Grid.Row="3"
                        IsVisible="{Binding CanOptimizeBattery, Converter={StaticResource negateBooleanConverter}}"
                        Margin="0,10,0,0"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="You may exclude through Android Settings => Apps => : => Special access => Optimize battery usage => Apps not optimized => All Apps => Bible Alarm => Off"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        VerticalOptions="Start"
                        VerticalTextAlignment="Start" />
                    
                    <!-- Action Buttons -->
                    <Grid Grid.Row="4"
                          RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0"
                            IsVisible="{Binding CanOptimizeBattery}"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            BorderWidth="0"
                            BorderColor="Transparent"
                            Command="{Binding BatteryOptimizationExcludeCommand}"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill"
                            HeightRequest="50"
                            Padding="20,0"
                            Text="EXCLUDE NOW"
                            TextColor="White"
                            VerticalOptions="Fill">
                            <Button.Shadow>
                                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                        Offset="0,4"
                                        Opacity="0.2"
                                        Radius="8" />
                            </Button.Shadow>
                        </Button>
                        
                        <Button Grid.Row="1"
                            IsVisible="{Binding CanOptimizeBattery}"
                            AutomationId="BatteryOptimizationDismissButton"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            BorderWidth="0"
                            BorderColor="Transparent"
                            Command="{Binding BatteryOptimizationDismissCommand}"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill"
                            HeightRequest="50"
                            Padding="20,0"
                            Text="LATER"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            VerticalOptions="Fill">
                            <Button.Shadow>
                                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                        Offset="0,2"
                                        Opacity="0.1"
                                        Radius="4" />
                            </Button.Shadow>
                        </Button>
                        
                        <Button Grid.Row="2"
                            IsVisible="{Binding CanOptimizeBattery, Converter={StaticResource negateBooleanConverter}}"
                            AutomationId="BatteryOptimizationDismissButton"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            BorderWidth="0"
                            BorderColor="Transparent"
                            Command="{Binding BatteryOptimizationDismissCommand}"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill"
                            HeightRequest="50"
                            Padding="20,0"
                            Text="OKAY"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            VerticalOptions="Fill">
                            <Button.Shadow>
                                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                        Offset="0,2"
                                        Opacity="0.1"
                                        Radius="4" />
                            </Button.Shadow>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>


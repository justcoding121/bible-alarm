<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="Bible.Alarm.Views.General.AlarmModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:forms="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:shared="clr-namespace:Bible.Alarm.ViewModels.Shared"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    x:DataType="shared:AlarmViewModal"
    BackgroundColor="White">
    <ContentPage.Resources>
        <converters:IsEnabledColorConverter x:Key="isEnabledConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            <Grid.Resources>
                <forms:Color x:Key="SlateBlue">SlateBlue</forms:Color>
            </Grid.Resources>
            <FlexLayout
                Grid.Row="0"
                AlignItems="Center"
                Direction="Column"
                HorizontalOptions="Center"
                JustifyContent="SpaceEvenly">
                <!-- Progress indicator when preparing tracks -->
                <StackLayout
                    IsVisible="{Binding IsPreparing}"
                    Orientation="Vertical"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="20">
                    <Label
                        Style="{StaticResource MediumLabelStyle}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding ProgressText}" />
                    <ProgressBar
                        Margin="10,5"
                        MinimumWidthRequest="200"
                        Progress="{Binding PreparationProgress}"
                        ProgressColor="SlateBlue" />
                </StackLayout>
                
                <!-- Error message when playback fails -->
                <StackLayout
                    IsVisible="{Binding HasError}"
                    Orientation="Vertical"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Margin="20">
                    <Label
                        Style="{StaticResource MediumLabelStyle}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        TextColor="Red"
                        Text="{Binding ErrorMessage}" />
                </StackLayout>
                <StackLayout 
                    Orientation="Vertical">
                    <Label
                        Padding="10,0,10,0"
                        Style="{StaticResource MediumLabelStyle}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Title}" />
                    <Label
                        Padding="10,0,10,0"
                        Style="{StaticResource MediumLabelStyle}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{Binding Description}" />
                </StackLayout>
                <StackLayout
                    AutomationId="AlarmModal"
                    HorizontalOptions="Center"
                    Orientation="Vertical"
                    VerticalOptions="Center">
                    <StackLayout.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding DismissCommand}" NumberOfTapsRequired="1" />
                    </StackLayout.GestureRecognizers>
                    <Label
                        Margin="5"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="{StaticResource AlarmBellIconFontSize}"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Text="{x:Static fn:GlyphNames.Bell}"
                        TextColor="SlateBlue"
                        VerticalOptions="Center" />
                    <Grid>
                        <Button
                            Margin="5"
                            AutomationId="AlarmDismissButton"
                            BackgroundColor="{OnPlatform iOS='WhiteSmoke',
                                                         WinUI='WhiteSmoke'}"
                            BorderWidth="0"
                            BorderColor="Transparent"
                            Command="{Binding DismissCommand}"
                            CornerRadius="10"
                            FontSize="{StaticResource ButtonFontSize}"
                            FontAttributes="Bold"
                            HeightRequest="{OnPlatform Default='45',
                                                       WinUI='37'}"
                            HorizontalOptions="Center"
                            IsVisible="{Binding IsBusy, Converter={StaticResource negateBooleanConverter}}"
                            Padding="40,8"
                            Text="DISMISS"
                            TextColor="SlateBlue"
                            VerticalOptions="Center" />
                        <ActivityIndicator
                            IsRunning="{Binding IsBusy}"
                            IsVisible="{Binding IsBusy}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            WidthRequest="30"
                            HeightRequest="30">
                            <ActivityIndicator.Color>
                                <OnPlatform x:TypeArguments="Color">
                                    <OnPlatform.Platforms>
                                        <On Platform="iOS" Value="SlateBlue" />
                                        <On Platform="Android" Value="SlateBlue" />
                                        <On Platform="Win" Value="#483D8B" />
                                    </OnPlatform.Platforms>
                                </OnPlatform>
                            </ActivityIndicator.Color>
                        </ActivityIndicator>
                    </Grid>
                </StackLayout>
                <Label
                    Margin="15,0,15,0"
                    Padding="10,0,10,0"
                    Style="{StaticResource MediumLabelStyle}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    Text="{Binding SubTitle}" />
            </FlexLayout>
            <Grid
                Grid.Row="1"
                Margin="5,5,5,25"
                Padding="0"
                FlexLayout.AlignSelf="Stretch"
                IsEnabled="{Binding AreControlsEnabled}"
                RowSpacing="0"
                VerticalOptions="End">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="{OnPlatform Default='10,0,0,0', WinUI='10,0,0,10'}"
                    Style="{StaticResource SmallLabelStyle}"
                    HorizontalOptions="Start"
                    Text="{Binding CurrentTime}"
                    TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                    VerticalOptions="Center" />
                <ProgressBar
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="5,0,5,0"
                    HorizontalOptions="Fill"
                    IsEnabled="{Binding AreControlsEnabled}"
                    Progress="{Binding Progress}"
                    ProgressColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                    VerticalOptions="Center" />
                <Label
                    Grid.Row="0"
                    Grid.Column="2"
                    Margin="{OnPlatform Default='0,0,10,0', WinUI='0,0,10,10'}"
                    Style="{StaticResource SmallLabelStyle}"
                    HorizontalOptions="End"
                    Text="{Binding EndTime}"
                    TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                    VerticalOptions="Center" />
                <Grid
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Padding="0"
                    RowSpacing="0"
                    VerticalOptions="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Margin="10,0,0,0"
                        Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding PreviousCommand}"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        Style="{StaticResource MediumLabelStyle}"
                        HorizontalOptions="Center"
                        IsEnabled="{Binding AreControlsEnabled}"
                        Text="{x:Static fn:GlyphNames.Previous}"
                        TextColor="{Binding PreviousEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="1"
                        Margin="0"
                        Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding BackwardCommand}"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        Style="{StaticResource MediumLabelStyle}"
                        HorizontalOptions="Center"
                        IsEnabled="{Binding AreControlsEnabled}"
                        Text="{x:Static fn:GlyphNames.Backward}"
                        TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="2"
                        Margin="0"
                        Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding PlayCommand}"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="{StaticResource LargeFontSize}"
                        HorizontalOptions="Center"
                        IsEnabled="{Binding AreControlsEnabled}"
                        IsVisible="{Binding PlayVisible}"
                        Text="{x:Static fn:GlyphNames.Play}"
                        TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="2"
                        Margin="0"
                        Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding PauseCommand}"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="{StaticResource LargeFontSize}"
                        HorizontalOptions="Center"
                        IsEnabled="{Binding AreControlsEnabled}"
                        IsVisible="{Binding PauseVisible}"
                        Text="{x:Static fn:GlyphNames.Pause}"
                        TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                        VerticalOptions="Center" />
                    <Button
                        Grid.Column="3"
                        Margin="0"
                        Padding="0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding ForwardCommand}"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        Style="{StaticResource MediumLabelStyle}"
                        HorizontalOptions="Center"
                        IsEnabled="{Binding AreControlsEnabled}"
                        Text="{x:Static fn:GlyphNames.Forward}"
                        TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}" />
                    <Button
                        Grid.Column="4"
                        Margin="0,0,10,0"
                        Padding="10,0,10,0"
                        BackgroundColor="Transparent"
                        BorderWidth="0"
                        BorderColor="Transparent"
                        Command="{Binding NextCommand}"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        Style="{StaticResource MediumLabelStyle}"
                        HorizontalOptions="Center"
                        IsEnabled="{Binding AreControlsEnabled}"
                        Text="{x:Static fn:GlyphNames.Next}"
                        TextColor="{Binding NextEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                        VerticalOptions="Center" />
                </Grid>
            </Grid>
        </Grid>

    </ContentPage.Content>
</ContentPage>
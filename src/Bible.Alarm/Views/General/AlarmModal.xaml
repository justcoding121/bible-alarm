<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="Bible.Alarm.Views.General.AlarmModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:forms="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:shared="clr-namespace:Bible.Alarm.ViewModels.Shared"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    x:DataType="shared:AlarmViewModal">
    <ContentPage.Resources>
        <converters:IsEnabledColorConverter x:Key="isEnabledConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <converters:IsNullConverter x:Key="isNullConverter" />
        <converters:IsNotNullConverter x:Key="isNotNullConverter" />
        
        <!-- Modern Color Resources - System Theme Aware -->
        <forms:Color x:Key="SlateBlue">#6A5ACD</forms:Color>
        <Color x:Key="PrimaryColor">#6A5ACD</Color>
        <OnPlatform x:Key="BackgroundColor" x:TypeArguments="Color">
            <On Platform="iOS" Value="#F8F9FA" />
            <On Platform="Android" Value="#F8F9FA" />
            <On Platform="WinUI" Value="#F8F9FA" />
        </OnPlatform>
        <OnPlatform x:Key="CardBackgroundColor" x:TypeArguments="Color">
            <On Platform="iOS" Value="#FFFFFF" />
            <On Platform="Android" Value="#FFFFFF" />
            <On Platform="WinUI" Value="#FFFFFF" />
        </OnPlatform>
        <OnPlatform x:Key="CardShadowColor" x:TypeArguments="Color">
            <On Platform="iOS" Value="#E0E0E0" />
            <On Platform="Android" Value="#E0E0E0" />
            <On Platform="WinUI" Value="#E0E0E0" />
        </OnPlatform>
        <OnPlatform x:Key="TextPrimaryColor" x:TypeArguments="Color">
            <On Platform="iOS" Value="#212529" />
            <On Platform="Android" Value="#212529" />
            <On Platform="WinUI" Value="#212529" />
        </OnPlatform>
        <OnPlatform x:Key="TextSecondaryColor" x:TypeArguments="Color">
            <On Platform="iOS" Value="#6C757D" />
            <On Platform="Android" Value="#6C757D" />
            <On Platform="WinUI" Value="#6C757D" />
        </OnPlatform>
        <OnPlatform x:Key="ControlBackgroundColor" x:TypeArguments="Color">
            <On Platform="iOS" Value="#F5F5F5" />
            <On Platform="Android" Value="#F5F5F5" />
            <On Platform="WinUI" Value="#F5F5F5" />
        </OnPlatform>
        <OnPlatform x:Key="ProgressBarBackgroundColor" x:TypeArguments="Color">
            <On Platform="iOS" Value="#E9ECEF" />
            <On Platform="Android" Value="#E9ECEF" />
            <On Platform="WinUI" Value="#E9ECEF" />
        </OnPlatform>
        <Color x:Key="WhiteColor">#FFFFFF</Color>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" BackgroundColor="{StaticResource BackgroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            
            <!-- Main Content Area -->
            <ScrollView
                Grid.Row="0"
                VerticalScrollBarVisibility="Never">
                <StackLayout
                    Padding="24,40,24,24"
                    Spacing="32"
                    VerticalOptions="Center">
                    
                    <!-- Progress indicator when preparing tracks -->
                    <Border
                        IsVisible="{Binding IsPreparing}"
                        BackgroundColor="{StaticResource CardBackgroundColor}"
                        StrokeThickness="0"
                        Padding="24,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <StackLayout
                            Orientation="Vertical"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            Spacing="12">
                            <Label
                                FontSize="16"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding ProgressText}"
                                TextColor="{StaticResource TextPrimaryColor}" />
                            <ProgressBar
                                Margin="10,5"
                                MinimumWidthRequest="200"
                                Progress="{Binding PreparationProgress}"
                                ProgressColor="{StaticResource PrimaryColor}" />
                        </StackLayout>
                    </Border>
                    
                    <!-- Error message when playback fails -->
                    <Border
                        IsVisible="{Binding HasError}"
                        BackgroundColor="#2A1A1A"
                        StrokeThickness="1"
                        Stroke="#4A2A2A"
                        Padding="24,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Label
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            TextColor="#FF6B6B"
                            Text="{Binding ErrorMessage}"
                            LineBreakMode="WordWrap" />
                    </Border>
                    
                    <!-- Main Music Player Content -->
                    <StackLayout
                        AutomationId="AlarmModal"
                        IsVisible="{Binding IsPreparing, Converter={StaticResource negateBooleanConverter}}"
                        Spacing="32"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        
                        <!-- Album Artwork -->
                        <Grid
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <!-- Activity Indicator for loading artwork -->
                            <ActivityIndicator
                                IsVisible="{Binding IsArtworkLoading}"
                                IsRunning="{Binding IsArtworkLoading}"
                                Color="{StaticResource PrimaryColor}"
                                HeightRequest="280"
                                WidthRequest="280"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            
                            <!-- Album Artwork or Bell Icon -->
                            <Border
                                IsVisible="{Binding IsArtworkLoading, Converter={StaticResource negateBooleanConverter}}"
                                BackgroundColor="{StaticResource ControlBackgroundColor}"
                                HeightRequest="280"
                                WidthRequest="280"
                                StrokeThickness="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="0" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource CardShadowColor}"
                                            Offset="0,8"
                                            Opacity="0.2"
                                            Radius="20" />
                                </Border.Shadow>
                                <Grid>
                                    <!-- Album Artwork Image -->
                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="280"
                                        HorizontalOptions="Fill"
                                        IsVisible="{Binding HasArtwork}"
                                        Source="{Binding ArtworkSource}"
                                        VerticalOptions="Fill"
                                        WidthRequest="280" />
                                    <!-- Fallback Bell Icon when no artwork -->
                                    <Label
                                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                        FontSize="80"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        IsVisible="{Binding HasArtwork, Converter={StaticResource negateBooleanConverter}}"
                                        Text="{x:Static fn:GlyphNames.Bell}"
                                        TextColor="{StaticResource PrimaryColor}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <!-- Track Metadata -->
                        <StackLayout
                            Spacing="8"
                            HorizontalOptions="Center">
                            <Label
                                FontSize="24"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Title}"
                                TextColor="{StaticResource TextPrimaryColor}"
                                LineBreakMode="TailTruncation"
                                MaxLines="2" />
                            <Label
                                FontSize="18"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding SubTitle}"
                                TextColor="{StaticResource TextSecondaryColor}"
                                LineBreakMode="TailTruncation"
                                MaxLines="1" />
                            <Label
                                FontSize="14"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Description}"
                                TextColor="{StaticResource TextSecondaryColor}"
                                LineBreakMode="TailTruncation"
                                MaxLines="1" />
                        </StackLayout>
                    </StackLayout>
                </StackLayout>
            </ScrollView>
            
            <!-- Bottom Controls Panel -->
            <Border
                Grid.Row="1"
                BackgroundColor="{StaticResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0" />
                </Border.StrokeShape>
                <Grid
                    Padding="24,20,24,32"
                    RowSpacing="20"
                    IsEnabled="{Binding AreControlsEnabled}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Stop Button -->
                    <Border
                        Grid.Row="0"
                        AutomationId="AlarmDismissButton"
                        BackgroundColor="#FF3B30"
                        HeightRequest="48"
                        WidthRequest="48"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="0,0,0,16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#FF3B30"
                                    Offset="0,4"
                                    Opacity="0.4"
                                    Radius="8" />
                        </Border.Shadow>
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            BorderColor="Transparent"
                            Command="{Binding DismissCommand}"
                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="{x:Static fn:GlyphNames.Stop}"
                            TextColor="White"
                            VerticalOptions="Center" />
                    </Border>
                    
                    <!-- Progress Bar Row -->
                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="12"
                        VerticalOptions="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            FontSize="12"
                            FontAttributes="Bold"
                            HorizontalOptions="Start"
                            Text="{Binding CurrentTime}"
                            TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource TextSecondaryColor}}"
                            VerticalOptions="Center" />
                        <Slider
                            Grid.Column="1"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            Minimum="0"
                            Maximum="1"
                            IsEnabled="{Binding AreControlsEnabled}"
                            Value="{Binding Progress}"
                            ValueChanged="OnSliderValueChanged"
                            DragStarted="OnSliderDragStarted"
                            DragCompleted="OnSliderDragCompleted"
                            ThumbColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource PrimaryColor}}"
                            MinimumTrackColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource PrimaryColor}}"
                            MaximumTrackColor="{StaticResource ProgressBarBackgroundColor}" />
                        <Label
                            Grid.Column="2"
                            FontSize="12"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            Text="{Binding EndTime}"
                            TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource TextSecondaryColor}}"
                            VerticalOptions="Center" />
                    </Grid>
                    
                    <!-- Main Control Buttons Row -->
                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="16"
                        HorizontalOptions="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Previous Track -->
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{StaticResource ControlBackgroundColor}"
                            HeightRequest="48"
                            WidthRequest="48"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding PreviousCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="20"
                                HorizontalOptions="Center"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Previous}"
                                TextColor="{Binding PreviousEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource TextPrimaryColor}}"
                                VerticalOptions="Center" />
                        </Border>
                        
                        <!-- Backward (Seek Back) -->
                        <Border
                            Grid.Column="1"
                            BackgroundColor="{StaticResource ControlBackgroundColor}"
                            HeightRequest="48"
                            WidthRequest="48"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding BackwardCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="18"
                                HorizontalOptions="Center"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Backward}"
                                TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource TextPrimaryColor}}"
                                VerticalOptions="Center" />
                        </Border>
                        
                        <!-- Play/Pause Button (Primary) -->
                        <Border
                            Grid.Column="2"
                            BackgroundColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource PrimaryColor}}"
                            HeightRequest="64"
                            WidthRequest="64"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="32" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#6A5ACD"
                                        Offset="0,4"
                                        Opacity="0.4"
                                        Radius="12" />
                            </Border.Shadow>
                            <Grid>
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    BorderColor="Transparent"
                                    Command="{Binding PlayCommand}"
                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                    FontSize="28"
                                    HorizontalOptions="Center"
                                    IsEnabled="{Binding AreControlsEnabled}"
                                    IsVisible="{Binding PlayVisible}"
                                    Text="{x:Static fn:GlyphNames.Play}"
                                    TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource WhiteColor}}"
                                    VerticalOptions="Center" />
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    BorderColor="Transparent"
                                    Command="{Binding PauseCommand}"
                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                    FontSize="28"
                                    HorizontalOptions="Center"
                                    IsEnabled="{Binding AreControlsEnabled}"
                                    IsVisible="{Binding PauseVisible}"
                                    Text="{x:Static fn:GlyphNames.Pause}"
                                    TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource WhiteColor}}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        
                        <!-- Forward (Seek Forward) -->
                        <Border
                            Grid.Column="3"
                            BackgroundColor="{StaticResource ControlBackgroundColor}"
                            HeightRequest="48"
                            WidthRequest="48"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding ForwardCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="18"
                                HorizontalOptions="Center"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Forward}"
                                TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource TextPrimaryColor}}"
                                VerticalOptions="Center" />
                        </Border>
                        
                        <!-- Next Track -->
                        <Border
                            Grid.Column="4"
                            BackgroundColor="{StaticResource ControlBackgroundColor}"
                            HeightRequest="48"
                            WidthRequest="48"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding NextCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="20"
                                HorizontalOptions="Center"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Next}"
                                TextColor="{Binding NextEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource TextPrimaryColor}}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>

<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.General.AlarmModal"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:forms="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:shared="clr-namespace:Bible.Alarm.ViewModels.Shared"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    x:DataType="shared:AlarmViewModel">
    <ContentPage.Resources>
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <converters:IsNullConverter x:Key="isNullConverter" />
        <converters:IsNotNullConverter x:Key="isNotNullConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
        <forms:Color x:Key="SlateBlue">#6A5ACD</forms:Color>
        <Color x:Key="WhiteColor">#FFFFFF</Color>
        
        <!-- Style for enabled/disabled label text color -->
        <Style x:Key="ControlLabelTextColorStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource TextSecondaryColor}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding AreControlsEnabled}" Value="False">
                    <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Style for enabled/disabled slider colors -->
        <Style x:Key="ControlSliderStyle" TargetType="Slider">
            <Setter Property="ThumbColor" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="MinimumTrackColor" Value="{DynamicResource PrimaryColor}" />
            <Style.Triggers>
                <DataTrigger TargetType="Slider" Binding="{Binding AreControlsEnabled}" Value="False">
                    <Setter Property="ThumbColor" Value="{DynamicResource DisabledTextColor}" />
                    <Setter Property="MinimumTrackColor" Value="{DynamicResource DisabledTextColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Style for enabled/disabled border background color (for play/pause button) -->
        <Style x:Key="PlayPauseBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding AreControlsEnabled}" Value="False">
                    <Setter Property="BackgroundColor" Value="{DynamicResource DisabledTextColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" BackgroundColor="{DynamicResource BackgroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            
            <!-- Main Content Area -->
            <ScrollView
                Grid.Row="0"
                VerticalScrollBarVisibility="Never">
                <Grid
                    Padding="24,40,24,24"
                    RowSpacing="32"
                    VerticalOptions="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Progress indicator when preparing tracks -->
                    <Border Grid.Row="0"
                        IsVisible="{Binding ShowPreparingProgress}"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        StrokeThickness="0"
                        Padding="24,20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            RowSpacing="12">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
                                FontSize="16"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding ProgressText}"
                                TextColor="{DynamicResource TextPrimaryColor}" />
                            <ProgressBar Grid.Row="1"
                                Margin="10,5"
                                MinimumWidthRequest="200"
                                Progress="{Binding PreparationProgress}"
                                ProgressColor="{StaticResource PrimaryColor}" />
                            <!-- Busy Indicator below progress bar -->
                            <Grid Grid.Row="2"
                                IsVisible="{Binding ShowPreparingProgress}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                HeightRequest="40"
                                WidthRequest="40"
                                Margin="0,8,0,0">
                                <core:SfBusyIndicator
                                    IsRunning="{Binding ShowPreparingProgress}"
                                    AnimationType="DoubleCircle"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    HeightRequest="40"
                                    WidthRequest="40"
                                    IndicatorColor="{StaticResource PrimaryColor}" />
                            </Grid>
                        </Grid>
                    </Border>
                    
                    <!-- Error message when playback fails -->
                    <Border Grid.Row="1"
                        IsVisible="{Binding HasError}"
                        BackgroundColor="{DynamicResource ControlBackgroundColor}"
                        StrokeThickness="1"
                        Stroke="#4A2A2A"
                        Padding="24,20,24,48">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid
                            RowSpacing="16"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
                                FontSize="16"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                TextColor="#FF6B6B"
                                Text="{Binding ErrorMessage}"
                                LineBreakMode="WordWrap" />
                            <!-- Retry Button -->
                            <Border Grid.Row="1"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                HeightRequest="64"
                                WidthRequest="64"
                                StrokeThickness="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Margin="0,8,0,0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="32" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="#6A5ACD"
                                            Offset="0,4"
                                            Opacity="0.4"
                                            Radius="12" />
                                </Border.Shadow>
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    BorderColor="Transparent"
                                    Command="{Binding RetryCommand}"
                                    IsEnabled="{Binding HasError}"
                                    InputTransparent="False"
                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                    FontSize="28"
                                    HorizontalOptions="Fill"
                                    Text="{x:Static fn:GlyphNames.Retry}"
                                    TextColor="White"
                                    VerticalOptions="Fill">
                                    <Button.Triggers>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                        </Trigger>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource WhiteColor}" />
                                        </Trigger>
                                    </Button.Triggers>
                                </Button>
                            </Border>
                        </Grid>
                    </Border>
                    
                    <!-- Main Music Player Content -->
                    <Grid Grid.Row="2"
                        AutomationId="AlarmModal"
                        IsVisible="{Binding ShowMainPlayerContent}"
                        RowSpacing="32"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <!-- Album Artwork -->
                        <Grid Grid.Row="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <!-- Activity Indicator for loading artwork -->
                            <ActivityIndicator
                                IsVisible="{Binding IsArtworkLoading}"
                                IsRunning="{Binding IsArtworkLoading}"
                                Color="{StaticResource PrimaryColor}"
                                HeightRequest="280"
                                WidthRequest="280"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            
                            <!-- Album Artwork or Bell Icon -->
                            <Border
                                IsVisible="{Binding IsArtworkLoading, Converter={StaticResource negateBooleanConverter}}"
                                BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                HeightRequest="280"
                                WidthRequest="280"
                                StrokeThickness="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="0" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                            Offset="0,8"
                                            Opacity="0.2"
                                            Radius="20" />
                                </Border.Shadow>
                                <Grid>
                                    <!-- Album Artwork Image -->
                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="280"
                                        HorizontalOptions="Fill"
                                        IsVisible="{Binding HasArtwork}"
                                        Source="{Binding ArtworkSource}"
                                        VerticalOptions="Fill"
                                        WidthRequest="280" />
                                    <!-- Fallback Bell Icon when no artwork -->
                                    <Label
                                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                        FontSize="80"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        IsVisible="{Binding HasArtwork, Converter={StaticResource negateBooleanConverter}}"
                                        Text="{x:Static fn:GlyphNames.Bell}"
                                        TextColor="{DynamicResource PrimaryTextColor}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <!-- Track Metadata -->
                        <Grid Grid.Row="1"
                            RowSpacing="8"
                            HorizontalOptions="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
                                FontSize="24"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Title}"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                LineBreakMode="WordWrap" />
                            <Label Grid.Row="1"
                                FontSize="18"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding SubTitle}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                LineBreakMode="WordWrap" />
                            <Label Grid.Row="2"
                                FontSize="14"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Description}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                LineBreakMode="WordWrap" />
                        </Grid>
                    </Grid>
                </Grid>
            </ScrollView>
            
            <!-- Bottom Controls Panel -->
            <Border
                Grid.Row="1"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0" />
                </Border.StrokeShape>
                <Grid
                    Padding="24,20,24,32"
                    RowSpacing="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Stop Button - Always enabled, outside of AreControlsEnabled binding -->
                    <Border
                        Grid.Row="0"
                        AutomationId="AlarmDismissButton"
                        BackgroundColor="{StaticResource ErrorColor}"
                        HeightRequest="48"
                        WidthRequest="48"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="0,0,0,16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <Shadow Brush="#FF3B30"
                                    Offset="0,4"
                                    Opacity="0.4"
                                    Radius="8" />
                        </Border.Shadow>
                        <Button
                            Padding="0"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            BorderColor="Transparent"
                            Command="{Binding DismissCommand}"
                            Clicked="OnStopButtonClicked"
                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                            FontSize="20"
                            HorizontalOptions="Fill"
                            IsEnabled="{Binding IsStopButtonEnabled}"
                            Text="{x:Static fn:GlyphNames.Stop}"
                            TextColor="White"
                            VerticalOptions="Fill">
                            <Button.Triggers>
                                <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                    <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                </Trigger>
                                <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                    <Setter Property="TextColor" Value="White" />
                                </Trigger>
                            </Button.Triggers>
                        </Button>
                    </Border>
                    
                    <!-- Progress Bar Row - Respects AreControlsEnabled -->
                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="12"
                        VerticalOptions="Center"
                        IsEnabled="{Binding AreControlsEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="50" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            FontSize="12"
                            FontAttributes="Bold"
                            HorizontalOptions="Start"
                            HorizontalTextAlignment="Start"
                            Text="{Binding CurrentTime}"
                            Style="{StaticResource ControlLabelTextColorStyle}"
                            VerticalOptions="Center" />
                        <Slider
                            Grid.Column="1"
                            x:Name="ProgressSlider"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            Minimum="0"
                            Maximum="1"
                            IsEnabled="{Binding AreControlsEnabled}"
                            Value="{Binding Progress}"
                            ValueChanged="OnSliderValueChanged"
                            DragStarted="OnSliderDragStarted"
                            DragCompleted="OnSliderDragCompleted"
                            Style="{StaticResource ControlSliderStyle}"
                            MaximumTrackColor="{DynamicResource ProgressBarBackgroundColor}" />
                        <Label
                            Grid.Column="2"
                            FontSize="12"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            HorizontalTextAlignment="End"
                            Text="{Binding EndTime}"
                            Style="{StaticResource ControlLabelTextColorStyle}"
                            VerticalOptions="Center" />
                    </Grid>
                    
                    <!-- Main Control Buttons Row - Respects AreControlsEnabled -->
                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="16"
                        HorizontalOptions="Center"
                        IsEnabled="{Binding AreControlsEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Previous Track -->
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            HeightRequest="48"
                            WidthRequest="48"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding PreviousCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="20"
                                HorizontalOptions="Fill"
                                IsEnabled="{Binding PreviousEnabled}"
                                Text="{x:Static fn:GlyphNames.Previous}"
                                VerticalOptions="Fill">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                    </Trigger>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>
                        </Border>
                        
                        <!-- Backward (Seek Back) -->
                        <Border
                            Grid.Column="1"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            HeightRequest="48"
                            WidthRequest="48"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding BackwardCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="18"
                                HorizontalOptions="Fill"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Backward}"
                                VerticalOptions="Fill">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                    </Trigger>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>
                        </Border>
                        
                        <!-- Play/Pause Button (Primary) -->
                        <Border
                            Grid.Column="2"
                            Style="{StaticResource PlayPauseBorderStyle}"
                            HeightRequest="64"
                            WidthRequest="64"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="32" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#6A5ACD"
                                        Offset="0,4"
                                        Opacity="0.4"
                                        Radius="12" />
                            </Border.Shadow>
                            <Grid>
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    BorderColor="Transparent"
                                    Command="{Binding PlayCommand}"
                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                    FontSize="28"
                                    HorizontalOptions="Fill"
                                    IsEnabled="{Binding AreControlsEnabled}"
                                    IsVisible="{Binding PlayVisible}"
                                    Text="{x:Static fn:GlyphNames.Play}"
                                    VerticalOptions="Fill">
                                    <Button.Triggers>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                        </Trigger>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource WhiteColor}" />
                                        </Trigger>
                                    </Button.Triggers>
                                </Button>
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    BorderColor="Transparent"
                                    Command="{Binding PauseCommand}"
                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                    FontSize="28"
                                    HorizontalOptions="Fill"
                                    IsEnabled="{Binding AreControlsEnabled}"
                                    IsVisible="{Binding PauseVisible}"
                                    Text="{x:Static fn:GlyphNames.Pause}"
                                    VerticalOptions="Fill">
                                    <Button.Triggers>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                        </Trigger>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource WhiteColor}" />
                                        </Trigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                        
                        <!-- Forward (Seek Forward) -->
                        <Border
                            Grid.Column="3"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            HeightRequest="48"
                            WidthRequest="48"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding ForwardCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="18"
                                HorizontalOptions="Fill"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Forward}"
                                VerticalOptions="Fill">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                    </Trigger>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>
                        </Border>
                        
                        <!-- Next Track -->
                        <Border
                            Grid.Column="4"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            HeightRequest="48"
                            WidthRequest="48"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding NextCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="20"
                                HorizontalOptions="Fill"
                                IsEnabled="{Binding NextEnabled}"
                                Text="{x:Static fn:GlyphNames.Next}"
                                VerticalOptions="Fill">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                    </Trigger>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>


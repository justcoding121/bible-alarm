<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="Bible.Alarm.Views.General.AlarmModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:forms="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:shared="clr-namespace:Bible.Alarm.ViewModels.Shared"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    x:DataType="shared:AlarmViewModal"
    BackgroundColor="#F8F9FA">
    <ContentPage.Resources>
        <converters:IsEnabledColorConverter x:Key="isEnabledConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <converters:IsNullConverter x:Key="isNullConverter" />
        <converters:IsNotNullConverter x:Key="isNotNullConverter" />
        
        <!-- Modern Color Resources -->
        <forms:Color x:Key="SlateBlue">#6A5ACD</forms:Color>
        <Color x:Key="PrimaryColor">#6A5ACD</Color>
        <Color x:Key="BackgroundColor">#F8F9FA</Color>
        <Color x:Key="CardBackgroundColor">#FFFFFF</Color>
        <Color x:Key="CardShadowColor">#E0E0E0</Color>
        <Color x:Key="TextPrimaryColor">#212529</Color>
        <Color x:Key="TextSecondaryColor">#6C757D</Color>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" BackgroundColor="{StaticResource BackgroundColor}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            
            <FlexLayout
                Grid.Row="0"
                AlignItems="Center"
                Direction="Column"
                HorizontalOptions="Center"
                JustifyContent="SpaceEvenly"
                Padding="20">
                
                <!-- Progress indicator when preparing tracks -->
                <Border
                    IsVisible="{Binding IsPreparing}"
                    BackgroundColor="{StaticResource CardBackgroundColor}"
                    StrokeThickness="0"
                    Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource CardShadowColor}"
                                Offset="0,4"
                                Opacity="0.1"
                                Radius="8" />
                    </Border.Shadow>
                    <StackLayout
                        Orientation="Vertical"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="12">
                        <Label
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{Binding ProgressText}"
                            TextColor="{StaticResource TextPrimaryColor}" />
                        <ProgressBar
                            Margin="10,5"
                            MinimumWidthRequest="200"
                            Progress="{Binding PreparationProgress}"
                            ProgressColor="{StaticResource PrimaryColor}" />
                    </StackLayout>
                </Border>
                
                <!-- Error message when playback fails -->
                <Border
                    IsVisible="{Binding HasError}"
                    BackgroundColor="#FFF5F5"
                    StrokeThickness="1"
                    Stroke="#FFE0E0"
                    Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource CardShadowColor}"
                                Offset="0,4"
                                Opacity="0.1"
                                Radius="8" />
                    </Border.Shadow>
                    <Label
                        FontSize="16"
                        FontAttributes="Bold"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        TextColor="#DC3545"
                        Text="{Binding ErrorMessage}"
                        LineBreakMode="WordWrap" />
                </Border>
                
                <!-- Main Content Card -->
                <Border
                    BackgroundColor="{StaticResource CardBackgroundColor}"
                    StrokeThickness="0"
                    Padding="32">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{StaticResource CardShadowColor}"
                                Offset="0,8"
                                Opacity="0.15"
                                Radius="16" />
                    </Border.Shadow>
                    <StackLayout 
                        Orientation="Vertical"
                        Spacing="20">
                        <StackLayout Orientation="Vertical" Spacing="8">
                            <Label
                                FontSize="20"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Title}"
                                TextColor="{StaticResource TextPrimaryColor}" />
                            <Label
                                FontSize="16"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Description}"
                                TextColor="{StaticResource TextSecondaryColor}"
                                LineBreakMode="WordWrap" />
                        </StackLayout>
                        
                        <StackLayout
                            AutomationId="AlarmModal"
                            HorizontalOptions="Center"
                            Orientation="Vertical"
                            VerticalOptions="Center"
                            Spacing="20">
                            <StackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding DismissCommand}" NumberOfTapsRequired="1" />
                            </StackLayout.GestureRecognizers>
                            
                            <!-- Activity Indicator for loading artwork -->
                            <ActivityIndicator
                                IsVisible="{Binding IsArtworkLoading}"
                                IsRunning="{Binding IsArtworkLoading}"
                                Color="{StaticResource PrimaryColor}"
                                HeightRequest="160"
                                WidthRequest="160"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            
                            <!-- Album Artwork or Bell Icon -->
                            <Border
                                IsVisible="{Binding IsArtworkLoading, Converter={StaticResource negateBooleanConverter}}"
                                BackgroundColor="#F0F0FF"
                                HeightRequest="160"
                                WidthRequest="160"
                                StrokeThickness="0"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{StaticResource CardShadowColor}"
                                            Offset="0,4"
                                            Opacity="0.2"
                                            Radius="8" />
                                </Border.Shadow>
                                <Grid>
                                    <!-- Album Artwork Image - only show when artwork is ready -->
                                    <Image
                                        Aspect="AspectFill"
                                        HeightRequest="160"
                                        HorizontalOptions="Fill"
                                        IsVisible="{Binding HasArtwork}"
                                        Source="{Binding ArtworkSource}"
                                        VerticalOptions="Fill"
                                        WidthRequest="160" />
                                    <!-- Fallback Bell Icon when no artwork or artwork is loading -->
                                    <Label
                                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                        FontSize="60"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        IsVisible="{Binding HasArtwork, Converter={StaticResource negateBooleanConverter}}"
                                        Text="{x:Static fn:GlyphNames.Bell}"
                                        TextColor="{StaticResource PrimaryColor}"
                                        VerticalOptions="Center" />
                                </Grid>
                            </Border>
                            
                            <!-- Dismiss Button -->
                            <Grid>
                                <Button
                                    AutomationId="AlarmDismissButton"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    BorderWidth="0"
                                    BorderColor="Transparent"
                                    Command="{Binding DismissCommand}"
                                    CornerRadius="12"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    HeightRequest="{OnPlatform Default='50',
                                                               WinUI='42'}"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding IsBusy, Converter={StaticResource negateBooleanConverter}}"
                                    Padding="40,0"
                                    Text="DISMISS"
                                    TextColor="White"
                                    VerticalOptions="Center">
                                    <Button.Shadow>
                                        <Shadow Brush="{StaticResource CardShadowColor}"
                                                Offset="0,4"
                                                Opacity="0.2"
                                                Radius="8" />
                                    </Button.Shadow>
                                </Button>
                                <ActivityIndicator
                                    IsRunning="{Binding IsBusy}"
                                    IsVisible="{Binding IsBusy}"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center"
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    Color="{StaticResource PrimaryColor}" />
                            </Grid>
                        </StackLayout>
                        
                        <Label
                            FontSize="14"
                            HorizontalOptions="Center"
                            HorizontalTextAlignment="Center"
                            Text="{Binding SubTitle}"
                            TextColor="{StaticResource TextSecondaryColor}"
                            LineBreakMode="WordWrap" />
                    </StackLayout>
                </Border>
            </FlexLayout>
            
            <!-- Enhanced Media Controls -->
            <Border
                Grid.Row="1"
                Margin="16,8,16,20"
                BackgroundColor="{StaticResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="16,12">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="16" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{StaticResource CardShadowColor}"
                            Offset="0,4"
                            Opacity="0.15"
                            Radius="8" />
                </Border.Shadow>
                <Grid
                    IsEnabled="{Binding AreControlsEnabled}"
                    RowSpacing="12"
                    VerticalOptions="End">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Progress Bar Row -->
                    <Grid
                        Grid.Row="0"
                        ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            FontSize="12"
                            HorizontalOptions="Start"
                            Text="{Binding CurrentTime}"
                            TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                            VerticalOptions="Center" />
                        <ProgressBar
                            Grid.Column="1"
                            HorizontalOptions="Fill"
                            IsEnabled="{Binding AreControlsEnabled}"
                            Progress="{Binding Progress}"
                            ProgressColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                            VerticalOptions="Center" />
                        <Label
                            Grid.Column="2"
                            FontSize="12"
                            HorizontalOptions="End"
                            Text="{Binding EndTime}"
                            TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                            VerticalOptions="Center" />
                    </Grid>
                    
                    <!-- Control Buttons Row -->
                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="8"
                        HorizontalOptions="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <Border
                            Grid.Column="0"
                            BackgroundColor="#F5F5F5"
                            HeightRequest="44"
                            WidthRequest="44"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding PreviousCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="18"
                                HorizontalOptions="Center"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Previous}"
                                TextColor="{Binding PreviousEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                                VerticalOptions="Center" />
                        </Border>
                        
                        <Border
                            Grid.Column="1"
                            BackgroundColor="#F5F5F5"
                            HeightRequest="44"
                            WidthRequest="44"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding BackwardCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="18"
                                HorizontalOptions="Center"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Backward}"
                                TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                                VerticalOptions="Center" />
                        </Border>
                        
                        <Border
                            Grid.Column="2"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            HeightRequest="56"
                            WidthRequest="56"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="28" />
                            </Border.StrokeShape>
                            <Grid>
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    BorderColor="Transparent"
                                    Command="{Binding PlayCommand}"
                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    IsEnabled="{Binding AreControlsEnabled}"
                                    IsVisible="{Binding PlayVisible}"
                                    Text="{x:Static fn:GlyphNames.Play}"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    BorderColor="Transparent"
                                    Command="{Binding PauseCommand}"
                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                    FontSize="24"
                                    HorizontalOptions="Center"
                                    IsEnabled="{Binding AreControlsEnabled}"
                                    IsVisible="{Binding PauseVisible}"
                                    Text="{x:Static fn:GlyphNames.Pause}"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                        
                        <Border
                            Grid.Column="3"
                            BackgroundColor="#F5F5F5"
                            HeightRequest="44"
                            WidthRequest="44"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding ForwardCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="18"
                                HorizontalOptions="Center"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Forward}"
                                TextColor="{Binding AreControlsEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                                VerticalOptions="Center" />
                        </Border>
                        
                        <Border
                            Grid.Column="4"
                            BackgroundColor="#F5F5F5"
                            HeightRequest="44"
                            WidthRequest="44"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="22" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding NextCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="18"
                                HorizontalOptions="Center"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Next}"
                                TextColor="{Binding NextEnabled, Converter={StaticResource isEnabledConverter}, ConverterParameter={StaticResource SlateBlue}}"
                                VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ContentPage.Content>
</ContentPage>

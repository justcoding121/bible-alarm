<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.General.AlarmSettingsModal"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels.General;assembly=Bible.Alarm"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    x:DataType="vm:BatteryOptimizationViewModel"
    mc:Ignorable="d">
    <ContentPage.Resources>
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
    </ContentPage.Resources>
    <ContentPage.Content>
        <ScrollView>
            <Grid BackgroundColor="{DynamicResource BackgroundColor}" Padding="20,20,20,20">
                <Border
                    BackgroundColor="{DynamicResource CardBackgroundColor}"
                    StrokeThickness="0"
                    Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="20" />
                    </Border.StrokeShape>
                    <Border.Shadow>
                        <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                Offset="0,8"
                                Opacity="0.15"
                                Radius="16" />
                    </Border.Shadow>
                    <Grid
                        AutomationId="AlarmSettingsModal"
                        HorizontalOptions="Fill"
                        RowSpacing="20"
                        VerticalOptions="Start">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Info Icon -->
                    <Label Grid.Row="0"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="48"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Center"
                        Margin="0,0,0,0"
                        Text="{x:Static fn:GlyphNames.InfoCircle}"
                        TextColor="{DynamicResource PrimaryTextColor}"
                        VerticalOptions="Start" />
                    
                    <!-- Main Message -->
                    <Label Grid.Row="1"
                        FontSize="16"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="To ensure alarms work reliably, please configure these essential settings:&#10;&#10;1. Battery Optimization: Prevent the system from stopping alarms in the background&#10;2. Do Not Disturb: Allow alarms to play even when your device is in silent or DND mode"
                        TextColor="{DynamicResource TextPrimaryColor}"
                        VerticalOptions="Start"
                        VerticalTextAlignment="Start" />
                    
                    <!-- Instructions -->
                    <Label Grid.Row="2"
                        IsVisible="{Binding IsInstructionsVisible}"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="After clicking the buttons below, follow these steps:&#10;&#10;Battery Optimization:&#10;1. Select the option to exempt apps from battery optimization (may be labeled 'Not optimized', 'Unrestricted', or 'Don't optimize' depending on your device)&#10;2. Find 'Bible Alarm' in the list&#10;3. Select the option to disable battery optimization for this app&#10;&#10;Do Not Disturb:&#10;1. Find 'Bible Alarm' in the list&#10;2. Tap on 'Bible Alarm'&#10;3. Enable 'Allow Modes access' or toggle it to 'Allowed'"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        VerticalOptions="Start"
                        VerticalTextAlignment="Start" />
                    
                    <Label Grid.Row="3"
                        IsVisible="{Binding CanOptimizeBattery, Converter={StaticResource negateBooleanConverter}}"
                        Margin="0,10,0,0"
                        FontSize="14"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Center"
                        LineBreakMode="WordWrap"
                        Text="Manual setup: Settings → Apps → Special app access → Battery optimization → Find 'Bible Alarm' → Select the option to disable battery optimization (may be labeled 'Not optimized', 'Unrestricted', or 'Don't optimize')"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        VerticalOptions="Start"
                        VerticalTextAlignment="Start" />
                    
                    <!-- Action Buttons -->
                    <Grid Grid.Row="4"
                          RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Button Grid.Row="0"
                            IsVisible="{Binding IsBatteryOptimizationButtonVisible}"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            BorderWidth="0"
                            BorderColor="Transparent"
                            Command="{Binding BatteryOptimizationExcludeCommand}"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill"
                            HeightRequest="50"
                            Padding="20,0"
                            Text="{Binding BatteryOptimizationButtonText}"
                            TextColor="White"
                            VerticalOptions="Fill">
                            <Button.Shadow>
                                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                        Offset="0,4"
                                        Opacity="0.2"
                                        Radius="8" />
                            </Button.Shadow>
                        </Button>
                        
                        <Button Grid.Row="1"
                            IsVisible="{Binding IsDndButtonVisible}"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            BorderWidth="0"
                            BorderColor="Transparent"
                            Command="{Binding DoNotDisturbExcludeCommand}"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill"
                            HeightRequest="50"
                            Padding="20,0"
                            Text="{Binding DndButtonText}"
                            TextColor="White"
                            VerticalOptions="Fill">
                            <Button.Shadow>
                                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                        Offset="0,4"
                                        Opacity="0.2"
                                        Radius="8" />
                            </Button.Shadow>
                        </Button>
                        
                        <Button Grid.Row="2"
                            IsVisible="{Binding CanOptimizeBattery}"
                            AutomationId="BatteryOptimizationDismissButton"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            BorderWidth="0"
                            BorderColor="Transparent"
                            Command="{Binding BatteryOptimizationDismissCommand}"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill"
                            HeightRequest="50"
                            Padding="20,0"
                            Text="CLOSE"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            VerticalOptions="Fill">
                            <Button.Shadow>
                                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                        Offset="0,2"
                                        Opacity="0.1"
                                        Radius="4" />
                            </Button.Shadow>
                        </Button>
                        
                        <Button Grid.Row="2"
                            IsVisible="{Binding CanOptimizeBattery, Converter={StaticResource negateBooleanConverter}}"
                            AutomationId="BatteryOptimizationDismissButton"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            BorderWidth="0"
                            BorderColor="Transparent"
                            Command="{Binding BatteryOptimizationDismissCommand}"
                            CornerRadius="12"
                            FontSize="16"
                            FontAttributes="Bold"
                            HorizontalOptions="Fill"
                            HeightRequest="50"
                            Padding="20,0"
                            Text="OKAY"
                            TextColor="{DynamicResource PrimaryTextColor}"
                            VerticalOptions="Fill">
                            <Button.Shadow>
                                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                        Offset="0,2"
                                        Opacity="0.1"
                                        Radius="4" />
                            </Button.Shadow>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
        </ScrollView>
    </ContentPage.Content>
</views:BaseContentPage>


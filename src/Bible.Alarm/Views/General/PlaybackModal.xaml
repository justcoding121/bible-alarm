<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.General.PlaybackModal"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns:general="clr-namespace:Bible.Alarm.Views.General;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:forms="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:shared="clr-namespace:Bible.Alarm.ViewModels.Shared"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:sharedViews="clr-namespace:Bible.Alarm.Views.Shared"
    xmlns:helpers="clr-namespace:Bible.Alarm.Common.ViewHelpers;assembly=Bible.Alarm"
    x:DataType="shared:PlaybackViewModel">
    <ContentPage.Resources>
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <converters:IsNullConverter x:Key="isNullConverter" />
        <converters:IsNotNullConverter x:Key="isNotNullConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
        <forms:Color x:Key="SlateBlue">#6A5ACD</forms:Color>
        <Color x:Key="WhiteColor">#FFFFFF</Color>
        
        <!-- Style for enabled/disabled label text color -->
        <Style x:Key="ControlLabelTextColorStyle" TargetType="Label">
            <Setter Property="TextColor" Value="{DynamicResource TextSecondaryColor}" />
            <Style.Triggers>
                <DataTrigger TargetType="Label" Binding="{Binding AreControlsEnabled}" Value="False">
                    <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Style for enabled/disabled slider colors -->
        <Style x:Key="ControlSliderStyle" TargetType="Slider">
            <Setter Property="ThumbColor" Value="{DynamicResource PrimaryColor}" />
            <Setter Property="MinimumTrackColor" Value="{DynamicResource PrimaryColor}" />
            <Style.Triggers>
                <DataTrigger TargetType="Slider" Binding="{Binding AreControlsEnabled}" Value="False">
                    <Setter Property="ThumbColor" Value="{DynamicResource DisabledTextColor}" />
                    <Setter Property="MinimumTrackColor" Value="{DynamicResource DisabledTextColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        
        <!-- Style for enabled/disabled border background color (for play/pause button) -->
        <Style x:Key="PlayPauseBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource PrimaryColor}" />
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding AreControlsEnabled}" Value="False">
                    <Setter Property="BackgroundColor" Value="{DynamicResource DisabledTextColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid HorizontalOptions="Fill" VerticalOptions="Fill" BackgroundColor="{DynamicResource BackgroundColor}">
            <Grid.Triggers>
                <!-- Landscape: transparent backdrop -->
                <DataTrigger TargetType="Grid" Binding="{Binding IsLandscape}" Value="True">
                    <Setter Property="BackgroundColor" Value="Transparent" />
                </DataTrigger>
            </Grid.Triggers>
            <Grid.GestureRecognizers>
                <!-- Landscape: tap anywhere to show controls -->
                <TapGestureRecognizer Tapped="OnPlaybackModalTapped" />
            </Grid.GestureRecognizers>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            
            <!-- Main Content Area - No scrolling, content sized to fit -->
            <Grid
                x:Name="MainContentArea"
                Grid.Row="0"
                IsVisible="{Binding ShowPortraitLayout}"
                Padding="{DynamicResource PaddingThickness24_40_24_24}"
                RowSpacing="{DynamicResource SpacingXLarge}"
                VerticalOptions="Fill">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                    
                    <!-- Progress indicator when preparing tracks (only when API fetch, e.g. section change) -->
                    <Border Grid.Row="0"
                        IsVisible="{Binding ShowPreparingCard}"
                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                        StrokeThickness="0"
                        Padding="{DynamicResource PaddingThickness24_20}"
                        MinimumWidthRequest="{DynamicResource ContentWidthLarge}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            RowSpacing="12"
                            WidthRequest="{DynamicResource ContentWidthMedium}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <!-- Percent + progress bar: only visible when API fetch (section change); hidden for stream/cache -->
                            <Grid Grid.Row="0" Grid.RowSpan="2" IsVisible="{Binding ShowPreparationPercent, FallbackValue=False}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Label Grid.Row="0"
                                    FontSize="{DynamicResource LargeFontSize}"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Fill"
                                    HorizontalTextAlignment="Center"
                                    Text="{Binding ProgressText}"
                                    TextColor="{DynamicResource TextPrimaryColor}"
                                    MinimumHeightRequest="{DynamicResource IconStandardContainerSize}" />
                                <ProgressBar Grid.Row="1"
                                    Margin="{DynamicResource MarginThickness10_5}"
                                    WidthRequest="{DynamicResource ContentWidthSmall}"
                                    HorizontalOptions="Center"
                                    Progress="{Binding PreparationProgress}"
                                    ProgressColor="{StaticResource PrimaryColor}" />
                            </Grid>
                            <!-- Busy Indicator below progress bar -->
                            <Grid Grid.Row="2"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                HeightRequest="{DynamicResource SpinnerContainerSize}"
                                WidthRequest="{DynamicResource SpinnerContainerSize}"
                                Margin="0,8,0,0">
                                <core:SfBusyIndicator
                                    IsRunning="{Binding ShowPreparingProgress}"
                                    AnimationType="DoubleCircle"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill"
                                    HeightRequest="{DynamicResource IconStandardContainerSize}"
                                    WidthRequest="{DynamicResource IconStandardContainerSize}"
                                    IndicatorColor="{StaticResource PrimaryColor}" />
                            </Grid>
                        </Grid>
                    </Border>
                    
                    <!-- Error message when playback fails -->
                    <Border Grid.Row="1"
                        IsVisible="{Binding HasError}"
                        BackgroundColor="{DynamicResource ControlBackgroundColor}"
                        StrokeThickness="1"
                        Stroke="#4A2A2A"
                        Padding="{DynamicResource PaddingThickness24_20_24_48}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16" />
                        </Border.StrokeShape>
                        <Grid
                            RowSpacing="16"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
                                FontSize="{DynamicResource LargeFontSize}"
                                FontAttributes="Bold"
                                HorizontalOptions="Center"
                                HorizontalTextAlignment="Center"
                                TextColor="#FF6B6B"
                                Text="{Binding ErrorMessage}"
                                LineBreakMode="WordWrap" />
                            <!-- Retry Button -->
                            <Grid Grid.Row="1"
                                HeightRequest="{DynamicResource IconLargeContainerSize}"
                                WidthRequest="{DynamicResource IconLargeContainerSize}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                Margin="0,8,0,0">
                                <Border
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    HeightRequest="{DynamicResource IconLargeContainerSize}"
                                    WidthRequest="{DynamicResource IconLargeContainerSize}"
                                    StrokeThickness="0"
                                    HorizontalOptions="Center"
                                    VerticalOptions="Center">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="100" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <helpers:PlatformShadow Brush="#6A5ACD"
                                                Offset="0,4"
                                                Opacity="0.4"
                                                Radius="12" />
                                    </Border.Shadow>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding RetryCommand}" />
                                    </Border.GestureRecognizers>
                                    <Label
                                        Text="{x:Static fn:GlyphNames.Retry}"
                                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                        FontSize="{DynamicResource IconLargeFontSize}"
                                        TextColor="White"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center"
                                        IsVisible="{Binding IsRetryBusy, Converter={StaticResource negateBooleanConverter}}" />
                                </Border>
                                <ActivityIndicator
                                    IsRunning="{Binding IsRetryBusy}"
                                    IsVisible="{Binding IsRetryBusy}"
                                    Color="White"
                                    WidthRequest="{DynamicResource SpinnerFontSize}"
                                    HeightRequest="{DynamicResource SpinnerFontSize}"
                                    VerticalOptions="Center"
                                    HorizontalOptions="Center"
                                    Opacity="0.95" />
                            </Grid>
                        </Grid>
                    </Border>
                    
                    <!-- Main Music Player Content -->
                    <Grid Grid.Row="2"
                        AutomationId="PlaybackModal"
                        IsVisible="{Binding ShowMainPlayerContent}"
                        RowSpacing="{DynamicResource SpacingXLarge}"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill">
                        <Grid.RowDefinitions>
                            <!-- Artwork takes remaining space -->
                            <RowDefinition Height="*" />
                            <!-- Metadata has fixed height -->
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        
                        <!-- Album Artwork - fixed size, centered. x:Name for layout invalidation on orientation change (portrait render fix). -->
                        <Grid x:Name="PortraitArtworkGrid"
                            Grid.Row="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center"
                            WidthRequest="{DynamicResource ContentWidthLarge}"
                            HeightRequest="{DynamicResource ContentWidthLarge}">
                            <!-- Busy Indicator for loading artwork or transitioning track -->
                            <ActivityIndicator
                                IsRunning="{Binding ShowArtworkSpinner}"
                                IsVisible="{Binding ShowArtworkSpinner}"
                                Color="{StaticResource PrimaryColor}"
                                WidthRequest="{DynamicResource IconLargeContainerSize}"
                                HeightRequest="{DynamicResource IconLargeContainerSize}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />
                            
                            <!-- Album Artwork or Bell Icon (spinner hidden; bell only when artwork fetch failed) -->
                            <Border
                                IsVisible="{Binding ShowArtworkSpinner, Converter={StaticResource negateBooleanConverter}}"
                                BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                StrokeThickness="0"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="8" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <helpers:PlatformShadow LightBrush="#E0E0E0" DarkBrush="#000000"
                                            Offset="0,8"
                                            Opacity="0.2"
                                            Radius="20" />
                                </Border.Shadow>
                                <Grid>
                                    <!-- Bell icon only when artwork fetch failed (never during loading or while artwork loads) -->
                                    <Label
                                        IsVisible="{Binding HasArtwork, Converter={StaticResource negateBooleanConverter}}"
                                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                        FontSize="{DynamicResource AlarmBellIconFontSize}"
                                        HorizontalOptions="Center"
                                        HorizontalTextAlignment="Center"
                                        Text="{x:Static fn:GlyphNames.Bell}"
                                        TextColor="{DynamicResource PrimaryTextColor}"
                                        VerticalOptions="Center" />
                                    <!-- Album Artwork Image (renders on top of bell when loaded) -->
                                    <Image
                                        Aspect="AspectFill"
                                        HorizontalOptions="Fill"
                                        IsVisible="{Binding HasArtwork}"
                                        Source="{Binding ArtworkSource}"
                                        VerticalOptions="Fill" />
                                </Grid>
                            </Border>
                        </Grid>
                        
                        <!-- Track Metadata - truncated text with enough height to avoid clipping on iOS (e.g. iPhone 13 Pro) -->
                        <Grid x:Name="MetadataGrid"
                            Grid.Row="1"
                            Margin="{DynamicResource MarginThickness0_8_0_0}"
                            RowSpacing="{DynamicResource SpacingSmall}"
                            Padding="{DynamicResource PaddingThickness16_8_16_0}"
                            HorizontalOptions="Fill"
                            MinimumHeightRequest="100">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label Grid.Row="0"
                                FontSize="{DynamicResource TitleFontSize}"
                                FontAttributes="Bold"
                                LineHeight="1.25"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Title}"
                                TextColor="{DynamicResource TextPrimaryColor}"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                MinimumHeightRequest="44" />
                            <Label Grid.Row="1"
                                FontSize="{DynamicResource LargeFontSize}"
                                LineHeight="1.25"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Center"
                                Text="{Binding SubTitle}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                LineBreakMode="TailTruncation"
                                MaxLines="2"
                                MinimumHeightRequest="32" />
                            <Label Grid.Row="2"
                                FontSize="{DynamicResource MediumFontSize}"
                                HorizontalOptions="Fill"
                                HorizontalTextAlignment="Center"
                                Text="{Binding Description}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                MinimumHeightRequest="24" />
                        </Grid>
                    </Grid>
            </Grid>

            <!-- Landscape layout (separate content file) -->
            <general:PlaybackModalLandscapeContent
                x:Name="LandscapeContent"
                Grid.Row="0"
                Grid.RowSpan="2" />

            <!-- Bottom Controls Panel -->
            <Border
                Grid.Row="1"
                IsVisible="{Binding ShowPortraitLayout}"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="24,24,0,0" />
                </Border.StrokeShape>
                <Grid
                    Padding="{DynamicResource PaddingThickness24_20_24_32}"
                    RowSpacing="{DynamicResource MarginExtraLarge}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    
                    <!-- Stop Button - Always enabled, outside of AreControlsEnabled binding -->
                    <Border
                        Grid.Row="0"
                        AutomationId="AlarmDismissButton"
                        BackgroundColor="{StaticResource ErrorColor}"
                        HeightRequest="{DynamicResource IconStandardContainerSize}"
                        WidthRequest="{DynamicResource IconStandardContainerSize}"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Margin="{DynamicResource MarginThickness0_0_0_16}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="100" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <helpers:PlatformShadow Brush="#FF3B30"
                                    Offset="0,4"
                                    Opacity="0.4"
                                    Radius="8" />
                        </Border.Shadow>
                        <Grid
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill">
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding DismissCommand}"
                                Clicked="OnStopButtonClicked"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="{DynamicResource IconStandardFontSize}"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill"
                                IsEnabled="{Binding IsStopButtonEnabled}"
                                IsVisible="{Binding IsStopping, Converter={StaticResource negateBooleanConverter}}"
                                Text="{x:Static fn:GlyphNames.Xmark}"
                                TextColor="White">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                    </Trigger>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                        <Setter Property="TextColor" Value="White" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>

                            <!-- Busy indicator while stopping -->
                            <ActivityIndicator
                                IsRunning="{Binding IsStopping}"
                                IsVisible="{Binding IsStopping}"
                                Color="White"
                                WidthRequest="{DynamicResource IconStandardFontSize}"
                                HeightRequest="{DynamicResource IconStandardFontSize}"
                                VerticalOptions="Center"
                                HorizontalOptions="Center"
                                Opacity="0.95" />
                        </Grid>
                    </Border>
                    
                    <!-- Progress Bar Row - Respects AreControlsEnabled -->
                    <Grid
                        Grid.Row="1"
                        ColumnSpacing="12"
                        VerticalOptions="Center"
                        IsVisible="{Binding ShowPlaybackControls}"
                        IsEnabled="{Binding AreControlsEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Label
                            Grid.Column="0"
                            MinimumWidthRequest="48"
                            FontSize="{DynamicResource StandardFontSize}"
                            FontAttributes="Bold"
                            HorizontalOptions="Start"
                            HorizontalTextAlignment="Start"
                            Text="{Binding CurrentTime}"
                            Style="{StaticResource ControlLabelTextColorStyle}"
                            VerticalOptions="Center" />
                        <!-- Slider (hidden when buffering or transitioning track) -->
                        <Slider
                            Grid.Column="1"
                            x:Name="ProgressSlider"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            Minimum="0"
                            Maximum="1"
                            IsEnabled="{Binding AreControlsEnabled}"
                            IsVisible="{Binding IsShowProgressBarAnimation, Converter={StaticResource negateBooleanConverter}}"
                            Value="{Binding Progress}"
                            ValueChanged="OnSliderValueChanged"
                            DragStarted="OnSliderDragStarted"
                            DragCompleted="OnSliderDragCompleted"
                            Style="{StaticResource ControlSliderStyle}"
                            MaximumTrackColor="{DynamicResource ProgressBarBackgroundColor}" />
                        <!-- Animated progress bar shown during buffering or track transition -->
                        <sharedViews:AnimatedProgressBar
                            Grid.Column="1"
                            IsVisible="{Binding IsShowProgressBarAnimation}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Center"
                            Margin="0" />
                        <Label
                            Grid.Column="2"
                            MinimumWidthRequest="48"
                            FontSize="{DynamicResource StandardFontSize}"
                            FontAttributes="Bold"
                            HorizontalOptions="End"
                            HorizontalTextAlignment="End"
                            Text="{Binding EndTime}"
                            Style="{StaticResource ControlLabelTextColorStyle}"
                            VerticalOptions="Center" />
                    </Grid>
                    
                    <!-- Main Control Buttons Row - Respects AreControlsEnabled -->
                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="16"
                        HorizontalOptions="Center"
                        IsVisible="{Binding ShowPlaybackControls}"
                        IsEnabled="{Binding AreControlsEnabled}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        
                        <!-- Previous Track -->
                        <Border
                            Grid.Column="0"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            HeightRequest="{DynamicResource IconStandardContainerSize}"
                            WidthRequest="{DynamicResource IconStandardContainerSize}"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="100" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding PreviousCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="{DynamicResource IconStandardFontSize}"
                                HorizontalOptions="Fill"
                                IsEnabled="{Binding PreviousEnabled}"
                                Text="{x:Static fn:GlyphNames.Previous}"
                                VerticalOptions="Fill">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                    </Trigger>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>
                        </Border>
                        
                        <!-- Backward (Seek Back) -->
                        <Border
                            Grid.Column="1"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            HeightRequest="{DynamicResource IconStandardContainerSize}"
                            WidthRequest="{DynamicResource IconStandardContainerSize}"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="100" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding BackwardCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="{DynamicResource HeaderFontSize}"
                                HorizontalOptions="Fill"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Backward}"
                                VerticalOptions="Fill">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                    </Trigger>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>
                        </Border>
                        
                        <!-- Play/Pause Button (Primary) -->
                        <Border
                            Grid.Column="2"
                            Style="{StaticResource PlayPauseBorderStyle}"
                            HeightRequest="{DynamicResource IconLargeContainerSize}"
                            WidthRequest="{DynamicResource IconLargeContainerSize}"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="100" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <helpers:PlatformShadow Brush="#6A5ACD"
                                        Offset="0,4"
                                        Opacity="0.4"
                                        Radius="12" />
                            </Border.Shadow>
                            <Grid>
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    BorderColor="Transparent"
                                    Command="{Binding PlayCommand}"
                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                    FontSize="{DynamicResource IconLargeFontSize}"
                                    HorizontalOptions="Fill"
                                    IsEnabled="{Binding AreControlsEnabled}"
                                    IsVisible="{Binding PlayVisible}"
                                    Text="{x:Static fn:GlyphNames.Play}"
                                    VerticalOptions="Fill">
                                    <Button.Triggers>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                        </Trigger>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource WhiteColor}" />
                                        </Trigger>
                                    </Button.Triggers>
                                </Button>
                                <Button
                                    Padding="0"
                                    BackgroundColor="Transparent"
                                    BorderWidth="0"
                                    BorderColor="Transparent"
                                    Command="{Binding PauseCommand}"
                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                    FontSize="{DynamicResource IconLargeFontSize}"
                                    HorizontalOptions="Fill"
                                    IsEnabled="{Binding AreControlsEnabled}"
                                    IsVisible="{Binding PauseVisible}"
                                    Text="{x:Static fn:GlyphNames.Pause}"
                                    VerticalOptions="Fill">
                                    <Button.Triggers>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                            <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                        </Trigger>
                                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                            <Setter Property="TextColor" Value="{StaticResource WhiteColor}" />
                                        </Trigger>
                                    </Button.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                        
                        <!-- Forward (Seek Forward) -->
                        <Border
                            Grid.Column="3"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            HeightRequest="{DynamicResource IconStandardContainerSize}"
                            WidthRequest="{DynamicResource IconStandardContainerSize}"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="100" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding ForwardCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="{DynamicResource HeaderFontSize}"
                                HorizontalOptions="Fill"
                                IsEnabled="{Binding AreControlsEnabled}"
                                Text="{x:Static fn:GlyphNames.Forward}"
                                VerticalOptions="Fill">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                    </Trigger>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>
                        </Border>
                        
                        <!-- Next Track -->
                        <Border
                            Grid.Column="4"
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            HeightRequest="{DynamicResource IconStandardContainerSize}"
                            WidthRequest="{DynamicResource IconStandardContainerSize}"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="100" />
                            </Border.StrokeShape>
                            <Button
                                Padding="0"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                BorderColor="Transparent"
                                Command="{Binding NextCommand}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="{DynamicResource IconStandardFontSize}"
                                HorizontalOptions="Fill"
                                IsEnabled="{Binding NextEnabled}"
                                Text="{x:Static fn:GlyphNames.Next}"
                                VerticalOptions="Fill">
                                <Button.Triggers>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                        <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                                    </Trigger>
                                    <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                        <Setter Property="TextColor" Value="{DynamicResource TextPrimaryColor}" />
                                    </Trigger>
                                </Button.Triggers>
                            </Button>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>


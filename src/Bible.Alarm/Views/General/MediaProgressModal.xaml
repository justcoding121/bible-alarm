<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="Bible.Alarm.Views.General.MediaProgressModal"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:d="http://schemas.microsoft.com/dotnet/2021/maui/design"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels.Shared"
    x:DataType="vm:MediaProgressViewModal"
    BackgroundColor="White"
    mc:Ignorable="d">
    <ContentPage.Content>
        <StackLayout
            HorizontalOptions="Fill"
            Orientation="Vertical"
            VerticalOptions="Center">
            <Label FontSize="Medium" Text="{Binding ProgressText}" />
            <ProgressBar
                MinimumWidthRequest="200"
                Progress="{Binding Progress}"
                ProgressColor="SlateBlue" />
        </StackLayout>
    </ContentPage.Content>
</ContentPage>
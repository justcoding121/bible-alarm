<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Home"
    x:Name="HomePage"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared;assembly=Bible.Alarm"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:enums="clr-namespace:Bible.Alarm.Shared.Models.Enums;assembly=Bible.Alarm.Shared"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:helpers="clr-namespace:Bible.Alarm.Common.ViewHelpers;assembly=Bible.Alarm"
    x:DataType="vm:HomeViewModel"
    Title="Bible Alarm"
    NavigationPage.HasNavigationBar="False">
    <views:BaseContentPage.Resources>
        <!-- Local double resources: avoid Release InvalidCastException (generated code casts DynamicResource to double) -->
        <x:Double x:Key="IconStandardContainerSize">48.0</x:Double>
        <x:Double x:Key="IconStandardFontSize">20.0</x:Double>
        <x:Double x:Key="CornerRadiusLarge">12.0</x:Double>
        <x:Double x:Key="PaddingLarge">16.0</x:Double>
        <x:Double x:Key="SpacingMedium">8.0</x:Double>
        <x:Double x:Key="SpacingSmall">4.0</x:Double>
        <x:Double x:Key="SpacingExtraSmall">2.0</x:Double>
        <x:Double x:Key="CornerRadiusSmall">4.0</x:Double>
        <x:Double x:Key="AlarmTimeFontSize">36.0</x:Double>
        <x:Double x:Key="PaddingSmall">4.0</x:Double>
    </views:BaseContentPage.Resources>
    <!-- Converters moved to App.xaml for better performance - shared across all pages -->
    <!-- Theme-aware colors are inherited from BaseContentPage and available via StaticResource -->
    <Grid AutomationId="HomePage" BackgroundColor="{DynamicResource PageBackgroundColor}" HorizontalOptions="Fill" VerticalOptions="Fill">
        <Grid
            Grid.Row="0"
            RowSpacing="0"
            Grid.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="{DynamicResource PaddingThickness16_8_16_0}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- SfEffectsView wrapper for WinUI only -->
                <Grid Grid.Row="0"
                      Margin="{DynamicResource MarginThickness0}"
                      HorizontalOptions="Fill"
                      HeightRequest="{StaticResource IconStandardContainerSize}">
                    <core:SfEffectsView Margin="0"
                                        TouchDownEffects="Ripple"
                                        TouchUpEffects="None"
                                        RippleBackground="{StaticResource PrimaryColor}"
                                        RippleAnimationDuration="200"
                                        ShouldIgnoreTouches="{Binding IsBootstrapReady, Converter={StaticResource negateBooleanConverter}}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill">
                        <core:SfEffectsView.IsVisible>
                            <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                                <On Platform="WinUI" Value="true" />
                            </OnPlatform>
                        </core:SfEffectsView.IsVisible>
                        <core:SfEffectsView.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddScheduleCommand}" />
                        </core:SfEffectsView.GestureRecognizers>
                        <Border x:Name="AddScheduleEffectsButton"
                                Margin="{DynamicResource MarginThickness0}"
                                AutomationId="AddScheduleButton"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                HorizontalOptions="Fill"
                                VerticalOptions="Fill">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsBootstrapReady}" Value="False">
                                    <Setter Property="Opacity" Value="0.5" />
                                </DataTrigger>
                                <DataTrigger TargetType="Border" Binding="{Binding IsBootstrapReady}" Value="True">
                                    <Setter Property="Opacity" Value="1.0" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="{StaticResource CornerRadiusLarge}" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <helpers:PlatformShadow Brush="#40000000" 
                                        Offset="0,2" 
                                        Radius="4" 
                                        Opacity="0.3" />
                            </Border.Shadow>
                            <Label Text="{x:Static fn:GlyphNames.Plus}"
                                   FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                   FontSize="{StaticResource IconStandardFontSize}"
                                   TextColor="White"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   VerticalTextAlignment="Center"
                                   IsVisible="{Binding IsAddBusy, Converter={StaticResource negateBooleanConverter}}" />
                        </Border>
                    </core:SfEffectsView>
                    <!-- Loading indicator overlay - shows when IsAddBusy is true -->
                    <ActivityIndicator
                            IsRunning="{Binding IsAddBusy}"
                            IsVisible="{Binding IsAddBusy}"
                            Color="White"
                            WidthRequest="{DynamicResource SpinnerFontSize}"
                            HeightRequest="{DynamicResource SpinnerFontSize}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Opacity="0.95" />
                </Grid>
                <!-- Regular button for Android/iOS (with native effects) -->
                <Grid Grid.Row="0"
                      Margin="{DynamicResource MarginThickness0}"
                      HorizontalOptions="Fill"
                      HeightRequest="{StaticResource IconStandardContainerSize}"
                      IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}">
                    <Border x:Name="AddScheduleButtonNoEffects"
                            Margin="{DynamicResource MarginThickness0}"
                            AutomationId="AddScheduleButton"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            HorizontalOptions="Fill"
                            VerticalOptions="Fill">
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsBootstrapReady}" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="InputTransparent" Value="True" />
                            </DataTrigger>
                            <DataTrigger TargetType="Border" Binding="{Binding IsBootstrapReady}" Value="True">
                                <Setter Property="Opacity" Value="1.0" />
                                <Setter Property="InputTransparent" Value="False" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding AddScheduleCommand}" />
                        </Border.GestureRecognizers>
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="{StaticResource CornerRadiusLarge}" />
                        </Border.StrokeShape>
                        <Border.Shadow>
                            <helpers:PlatformShadow Brush="#40000000" 
                                    Offset="0,2" 
                                    Radius="4" 
                                    Opacity="0.3" />
                        </Border.Shadow>
                        <Label Text="{x:Static fn:GlyphNames.Plus}"
                               FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                               FontSize="{StaticResource IconStandardFontSize}"
                               TextColor="White"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HorizontalTextAlignment="Center"
                               VerticalTextAlignment="Center"
                               IsVisible="{Binding IsAddBusy, Converter={StaticResource negateBooleanConverter}}" />
                    </Border>
                    <!-- Loading indicator overlay - shows when IsAddBusy is true -->
                    <ActivityIndicator
                            IsRunning="{Binding IsAddBusy}"
                            IsVisible="{Binding IsAddBusy}"
                            Color="White"
                            WidthRequest="{DynamicResource SpinnerFontSize}"
                            HeightRequest="{DynamicResource SpinnerFontSize}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Opacity="0.95" />
                </Grid>
            </Grid>
            <!-- Progress bar for schedule loading -->
            <shared:AnimatedProgressBar
                Grid.Row="1"
                Margin="{DynamicResource MarginThickness0_8_0_8}"
                Opacity="{Binding ProgressBarOpacity}"
                VerticalOptions="Start"
                InputTransparent="{Binding IsProgressBarHidden}"
                BindingContext="{Binding}" />
            <CollectionView
                x:Name="SchedulesCollectionView"
                Grid.Row="2"
                BackgroundColor="Transparent"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                ItemsSource="{Binding Schedules}"
                SelectionMode="None">
                <CollectionView.Footer>
                    <BoxView HeightRequest="{Binding CollectionViewBottomMargin, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}}"
                             Color="Transparent"
                             InputTransparent="True" />
                </CollectionView.Footer>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" 
                                       ItemSpacing="12" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleListItemViewModel">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem
                                            BackgroundColor="{StaticResource ErrorColor}"
                                            Command="{Binding DeleteCommand}">
                                        <SwipeItem.IconImageSource>
                                            <FontImageSource
                                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                    Glyph="{x:Static fn:GlyphNames.Trash}"
                                                    Color="White"
                                                    Size="{DynamicResource IconSmallFontSize}" />
                                        </SwipeItem.IconImageSource>
                                    </SwipeItem>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid>
                                <core:SfEffectsView
                                        x:Name="ScheduleItemEffectsView"
                                        Margin="{DynamicResource MarginThickness16_0}"
                                        HorizontalOptions="Fill"
                                        TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                        TouchUpEffects="None"
                                        RippleBackground="{StaticResource PrimaryColor}"
                                        HighlightBackground="{StaticResource PrimaryLightColor}"
                                        RippleAnimationDuration="200"
                                        ShouldIgnoreTouches="False">
                                    <core:SfEffectsView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnScheduleItemTapped" />
                                    </core:SfEffectsView.GestureRecognizers>
                                <Border
                                        x:Name="ScheduleItemBorder"
                                        Padding="{StaticResource PaddingLarge}"
                                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                                        StrokeThickness="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusLarge}" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <helpers:PlatformShadow Brush="#20000000" 
                                                    Offset="0,2" 
                                                    Radius="8" 
                                                    Opacity="0.15" />
                                    </Border.Shadow>
                                    <Grid
                                            x:Name="ScheduleItemGrid"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Start"
                                            ColumnSpacing="{DynamicResource SpacingStandard}"
                                            RowSpacing="{StaticResource SpacingMedium}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        
                                        <!-- Row 1, Column 1: Play (Syncfusion SfButton — rounded rectangle, scales with accessibility) -->
                                        <Grid Grid.Column="0"
                                              Grid.Row="0"
                                              Margin="{DynamicResource MarginThickness0}"
                                              VerticalOptions="Center"
                                              HorizontalOptions="Start"
                                              HeightRequest="{DynamicResource IconLargeContainerSize}"
                                              WidthRequest="{DynamicResource ScheduleListPlayButtonWidth}">
                                            <buttons:SfButton
                                                    AutomationId="ScheduleListPlayButton"
                                                    Background="{StaticResource PrimaryColor}"
                                                    Command="{Binding PlayCommand}"
                                                    CornerRadius="{DynamicResource ScheduleListPlayButtonCornerRadius}"
                                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                    FontSize="{DynamicResource IconLargeFontSize}"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill"
                                                    Text="{x:Static fn:GlyphNames.Play}"
                                                    TextColor="White" />
                                            <Border IsVisible="{Binding IsBusy, FallbackValue=False}"
                                                    BackgroundColor="{StaticResource PrimaryColor}"
                                                    StrokeThickness="0"
                                                    HorizontalOptions="Fill"
                                                    VerticalOptions="Fill"
                                                    InputTransparent="True">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="{DynamicResource ScheduleListPlayButtonCornerRadius}" />
                                                </Border.StrokeShape>
                                                <ActivityIndicator
                                                        IsRunning="{Binding IsBusy, FallbackValue=False}"
                                                        Color="White"
                                                        WidthRequest="24"
                                                        HeightRequest="24"
                                                        VerticalOptions="Center"
                                                        HorizontalOptions="Center"
                                                        Opacity="0.95" />
                                            </Border>
                                        </Grid>
                                        
                                        <!-- Row 1, Column 2: Time, days, and enable toggle -->
                                        <Grid Grid.Column="1"
                                              Grid.Row="0"
                                              HorizontalOptions="Fill"
                                              VerticalOptions="Center"
                                              ColumnSpacing="{StaticResource SpacingMedium}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <VerticalStackLayout Grid.Column="0"
                                                  HorizontalOptions="Fill"
                                                  VerticalOptions="Center"
                                                  Spacing="{StaticResource SpacingSmall}">
                                            <!-- Time display - most prominent for alarm app -->
                                            <HorizontalStackLayout Margin="{DynamicResource MarginThickness0}"
                                                  HorizontalOptions="Start"
                                                  VerticalOptions="Center"
                                                  Spacing="{StaticResource SpacingExtraSmall}">
                                                <Label Margin="{DynamicResource MarginThickness0}"
                                                       Padding="{DynamicResource PaddingThickness0}"
                                                       FontSize="{StaticResource AlarmTimeFontSize}"
                                                       FontAttributes="Bold"
                                                       Text="{Binding TimeText}"
                                                       VerticalOptions="Center"
                                                       TextColor="{Binding IsEnabled, Converter={StaticResource isEnabledColorConverter}}"
                                                       LineBreakMode="NoWrap" />
                                                <Label Margin="{DynamicResource MarginThickness0}"
                                                       Padding="{DynamicResource PaddingThickness0}"
                                                       MinimumWidthRequest="{OnPlatform iOS=40, Default=0}"
                                                       FontSize="{DynamicResource AlarmMeridianFontSize}"
                                                       Text="{Binding MeridianText}"
                                                       VerticalOptions="Center"
                                                       TextColor="{Binding IsEnabled, Converter={StaticResource isEnabledColorConverter}}"
                                                       VerticalTextAlignment="Center" />
                                            </HorizontalStackLayout>
                                            <!-- Days of week badges -->
                                            <FlexLayout HorizontalOptions="Start"
                                                  Wrap="Wrap"
                                                  JustifyContent="Start"
                                                  AlignItems="Center"
                                                  Margin="{DynamicResource MarginThickness0}">
                                                <Border Margin="{DynamicResource MarginThickness0_5}"
                                                        Padding="{DynamicResource PaddingThickness4_2}"
                                                        BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Sunday'}"
                                                        Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusSmall}" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                            FontAttributes="Bold"
                                                            FontSize="{DynamicResource SmallFontSize}"
                                                            Text="S"
                                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Sunday'}"
                                                            HorizontalTextAlignment="Center"
                                                            VerticalTextAlignment="Center"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />
                                                </Border>
                                                <Border Margin="{DynamicResource MarginThickness0_5}"
                                                        Padding="{DynamicResource PaddingThickness4_2}"
                                                        BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Monday'}"
                                                        Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusSmall}" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                            FontAttributes="Bold"
                                                            FontSize="{DynamicResource SmallFontSize}"
                                                            Text="M"
                                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Monday'}"
                                                            HorizontalTextAlignment="Center"
                                                            VerticalTextAlignment="Center"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />
                                                </Border>
                                                <Border Margin="{DynamicResource MarginThickness0_5}"
                                                        Padding="{DynamicResource PaddingThickness4_2}"
                                                        BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Tuesday'}"
                                                        Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusSmall}" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                            FontAttributes="Bold"
                                                            FontSize="{DynamicResource SmallFontSize}"
                                                            Text="T"
                                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Tuesday'}"
                                                            HorizontalTextAlignment="Center"
                                                            VerticalTextAlignment="Center"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />
                                                </Border>
                                                <Border Margin="{DynamicResource MarginThickness0_5}"
                                                        Padding="{DynamicResource PaddingThickness4_2}"
                                                        BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Wednesday'}"
                                                        Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusSmall}" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                            FontAttributes="Bold"
                                                            FontSize="{DynamicResource SmallFontSize}"
                                                            Text="W"
                                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Wednesday'}"
                                                            HorizontalTextAlignment="Center"
                                                            VerticalTextAlignment="Center"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />
                                                </Border>
                                                <Border Margin="{DynamicResource MarginThickness0_5}"
                                                        Padding="{DynamicResource PaddingThickness4_2}"
                                                        BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Thursday'}"
                                                        Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusSmall}" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                            FontAttributes="Bold"
                                                            FontSize="{DynamicResource SmallFontSize}"
                                                            Text="T"
                                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Thursday'}"
                                                            HorizontalTextAlignment="Center"
                                                            VerticalTextAlignment="Center"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />
                                                </Border>
                                                <Border Margin="{DynamicResource MarginThickness0_5}"
                                                        Padding="{DynamicResource PaddingThickness4_2}"
                                                        BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Friday'}"
                                                        Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusSmall}" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                            FontAttributes="Bold"
                                                            FontSize="{DynamicResource SmallFontSize}"
                                                            Text="F"
                                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Friday'}"
                                                            HorizontalTextAlignment="Center"
                                                            VerticalTextAlignment="Center"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />
                                                </Border>
                                                <Border Margin="{DynamicResource MarginThickness0_5}"
                                                        Padding="{DynamicResource PaddingThickness4_2}"
                                                        BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Saturday'}"
                                                        Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                        StrokeThickness="0"
                                                        HorizontalOptions="Center"
                                                        VerticalOptions="Center">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="{StaticResource CornerRadiusSmall}" />
                                                    </Border.StrokeShape>
                                                    <Label
                                                            FontAttributes="Bold"
                                                            FontSize="{DynamicResource SmallFontSize}"
                                                            Text="S"
                                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Saturday'}"
                                                            HorizontalTextAlignment="Center"
                                                            VerticalTextAlignment="Center"
                                                            HorizontalOptions="Center"
                                                            VerticalOptions="Center" />
                                                </Border>
                                            </FlexLayout>
                                            </VerticalStackLayout>
                                            <!-- Enable/disable toggle -->
                                            <shared:PlatformSwitch
                                                    Grid.Column="1"
                                                    IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                                                    Margin="{DynamicResource MarginThickness0}"
                                                    VerticalOptions="Center"
                                                    HorizontalOptions="End" />
                                        </Grid>
                                        
                                        <!-- Navigation busy indicator: overlaid at bottom-right, spans full card, floats above content -->
                                        <ActivityIndicator
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Grid.Row="0"
                                            Grid.RowSpan="2"
                                            IsRunning="{Binding IsNavigating, FallbackValue=False}"
                                            IsVisible="{Binding IsNavigating, FallbackValue=False}"
                                            Color="{DynamicResource PrimaryColor}"
                                            WidthRequest="20"
                                            HeightRequest="20"
                                            HorizontalOptions="End"
                                            VerticalOptions="End"
                                            ZIndex="10"
                                            InputTransparent="True" />

                                        <!-- Row 2: Schedule details (name, publication, section, track, language/music) - spans full width -->
                                        <VerticalStackLayout Grid.Column="0"
                                              Grid.ColumnSpan="2"
                                              Grid.Row="1"
                                              HorizontalOptions="Fill"
                                              VerticalOptions="Start"
                                              Spacing="{StaticResource PaddingSmall}">
                                            <!-- 1. Schedule name + music indicator (♫ shown when music enabled; row collapses when both hidden) -->
                                            <HorizontalStackLayout Margin="{DynamicResource MarginThickness0}"
                                                   HorizontalOptions="Start"
                                                   VerticalOptions="Start"
                                                   Spacing="{StaticResource SpacingSmall}">
                                                <Label FontSize="{DynamicResource LargeFontSize}"
                                                       FontAttributes="Bold"
                                                       Text="{Binding Name}"
                                                       TextColor="{DynamicResource TextPrimaryColor}"
                                                       LineBreakMode="WordWrap"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding Name, Converter={StaticResource isStringNotEmptyConverter}}" />
                                                <Label FontSize="{DynamicResource LargeFontSize}"
                                                       Text="♫"
                                                       TextColor="{DynamicResource TextPrimaryColor}"
                                                       VerticalOptions="Center"
                                                       IsVisible="{Binding MusicEnabled, Mode=OneWay}"
                                                       InputTransparent="True" />
                                            </HorizontalStackLayout>
                                            <!-- 1b. Category name (hidden when same as schedule name) -->
                                            <Label Margin="{DynamicResource MarginThickness0}"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="Start"
                                                   FontSize="{DynamicResource MediumFontSize}"
                                                   Text="{Binding CategoryNameDisplay}"
                                                   TextColor="{DynamicResource PrimaryTextColor}"
                                                   LineBreakMode="WordWrap"
                                                   IsVisible="{Binding CategoryNameDisplay, Converter={StaticResource isStringNotEmptyConverter}}" />
                                            <!-- 2. Schedule Publication Name -->
                                            <Label Margin="{DynamicResource MarginThickness0}"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="Start"
                                                   FontSize="{DynamicResource MediumFontSize}"
                                                   Text="{Binding BiblePublicationName}"
                                                   TextColor="{DynamicResource PrimaryTextColor}"
                                                   LineBreakMode="WordWrap"
                                                   IsVisible="{Binding BiblePublicationName, Converter={StaticResource isStringNotEmptyConverter}}" />
                                            <!-- 3. Bible-only: combine section + track number on one line (e.g. "Exodus 9") -->
                                            <Label Margin="{DynamicResource MarginThickness0}"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="Start"
                                                   FontSize="{DynamicResource MediumFontSize}"
                                                   Text="{Binding BiblePublicationSectionAndTrackOneLine}"
                                                   TextColor="{DynamicResource PrimaryTextColor}"
                                                   LineBreakMode="WordWrap"
                                                   IsVisible="{Binding ShouldShowBiblePublicationSectionAndTrackOneLine}" />
                                            <!-- 4. Non-Bible: Schedule section Name (if sectioned) -->
                                            <Label Margin="{DynamicResource MarginThickness0}"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="Start"
                                                   FontSize="{DynamicResource MediumFontSize}"
                                                   Text="{Binding BiblePublicationSectionName}"
                                                   TextColor="{DynamicResource PrimaryTextColor}"
                                                   LineBreakMode="WordWrap"
                                                   IsVisible="{Binding ShouldShowBiblePublicationSectionNameLine}" />
                                            <!-- 5. Non-Bible: Schedule Track Name -->
                                            <Label Margin="{DynamicResource MarginThickness0}"
                                                   HorizontalOptions="Fill"
                                                   HorizontalTextAlignment="Start"
                                                   FontSize="{DynamicResource MediumFontSize}"
                                                   Text="{Binding BiblePublicationTrackName}"
                                                   TextColor="{DynamicResource PrimaryTextColor}"
                                                   LineBreakMode="WordWrap"
                                                   IsVisible="{Binding ShouldShowBiblePublicationTrackNameLine}" />
                                            <!-- 6. Language Name (hidden when both Language and Music are empty) -->
                                            <Label Margin="{DynamicResource MarginThickness0}"
                                                   HorizontalOptions="Start"
                                                   HorizontalTextAlignment="Start"
                                                   FontSize="{DynamicResource StandardFontSize}"
                                                   Text="{Binding Language}"
                                                   TextColor="{DynamicResource TextPrimaryColor}"
                                                   IsVisible="{Binding ShouldShowLanguageOrMusicLine}"
                                                   VerticalOptions="Start"
                                                   LineBreakMode="WordWrap" />
                                        </VerticalStackLayout>
                                    </Grid>
                            </Border>
                            </core:SfEffectsView>
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        
        <!-- Floating Alarm Settings Button (Android only) -->
        <!-- Floating alarm settings button - SfEffectsView for WinUI only -->
            <core:SfEffectsView AutomationId="AlarmSettingsFloatingButton"
            TouchDownEffects="Ripple"
            TouchUpEffects="None"
            RippleBackground="{StaticResource PrimaryColor}"
            RippleAnimationDuration="200"
            ShouldIgnoreTouches="False"
            HorizontalOptions="End"
            VerticalOptions="End"
            IsVisible="{Binding IsFloatingButtonVisible}"
            Margin="{DynamicResource MarginThickness0_0_16_16}"
            Opacity="{Binding IsFloatingButtonVisible, Converter={StaticResource booleanToOpacityConverter}}"
            ZIndex="100">
            <core:SfEffectsView.IsVisible>
                <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                    <On Platform="WinUI" Value="true" />
                </OnPlatform>
            </core:SfEffectsView.IsVisible>
            <core:SfEffectsView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenAlarmSettingsCommand}" />
            </core:SfEffectsView.GestureRecognizers>
            <Button BackgroundColor="{StaticResource PrimaryColor}"
                    CornerRadius="100"
                    Command="{Binding OpenAlarmSettingsCommand}"
                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                    FontSize="{StaticResource IconStandardFontSize}"
                    HeightRequest="{DynamicResource IconLargeContainerSize}"
                    WidthRequest="{DynamicResource IconLargeContainerSize}"
                    HorizontalOptions="End"
                    Padding="{DynamicResource PaddingThickness0}"
                    Text="{x:Static fn:GlyphNames.ExclamationTriangle}"
                    VerticalOptions="End"
                    InputTransparent="True">
                <Button.Shadow>
                    <helpers:PlatformShadow Brush="#40000000" 
                            Offset="0,4" 
                            Radius="8" 
                            Opacity="0.4" />
                </Button.Shadow>
            </Button>
        </core:SfEffectsView>
        <!-- Notification Permission Warning Button (Android and iOS) -->
        <!-- Android: Left bottom corner -->
        <!-- iOS: Right bottom corner -->
        <Button x:Name="NotificationPermissionFloatingButton"
            AutomationId="NotificationPermissionFloatingButton"
            BackgroundColor="{StaticResource PrimaryColor}"
            CornerRadius="100"
            Command="{Binding OpenNotificationPermissionCommand}"
            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
            FontSize="{StaticResource IconStandardFontSize}"
            HeightRequest="{DynamicResource IconLargeContainerSize}"
            WidthRequest="{DynamicResource IconLargeContainerSize}"
            Opacity="{Binding IsNotificationPermissionButtonVisible, Converter={StaticResource booleanToOpacityConverter}}"
            Padding="{DynamicResource PaddingThickness0}"
            Text="{x:Static fn:GlyphNames.ExclamationTriangle}"
            VerticalOptions="End"
            IsVisible="{Binding IsNotificationPermissionButtonVisible}"
            Margin="{DynamicResource MarginThicknessNotificationFloatingButton}"
            ZIndex="101">
            <Button.HorizontalOptions>
                <OnPlatform x:TypeArguments="LayoutOptions">
                    <On Platform="Android" Value="Start" />
                    <On Platform="iOS" Value="End" />
                    <On Platform="WinUI" Value="Start" />
                </OnPlatform>
            </Button.HorizontalOptions>
            <Button.Shadow>
                <helpers:PlatformShadow Brush="#40000000" 
                        Offset="0,4" 
                        Radius="8" 
                        Opacity="0.4" />
            </Button.Shadow>
        </Button>
        <!-- Battery Optimization Warning Button (Android only) - Right bottom corner -->
        <Button x:Name="AlarmSettingsFloatingButtonNoEffects"
            AutomationId="AlarmSettingsFloatingButton"
            BackgroundColor="{StaticResource PrimaryColor}"
            CornerRadius="100"
            Command="{Binding OpenAlarmSettingsCommand}"
            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
            FontSize="{StaticResource IconStandardFontSize}"
            HeightRequest="{DynamicResource IconLargeContainerSize}"
            WidthRequest="{DynamicResource IconLargeContainerSize}"
            HorizontalOptions="End"
            Opacity="{Binding IsFloatingButtonVisible, Converter={StaticResource booleanToOpacityConverter}}"
            Padding="{DynamicResource PaddingThickness0}"
            Text="{x:Static fn:GlyphNames.ExclamationTriangle}"
            VerticalOptions="End"
            IsVisible="{Binding IsFloatingButtonVisible}"
            Margin="{DynamicResource MarginThicknessAlarmSettingsFloatingButton}"
            ZIndex="100">
            <Button.Shadow>
                <helpers:PlatformShadow Brush="#40000000" 
                        Offset="0,4" 
                        Radius="8" 
                        Opacity="0.4" />
            </Button.Shadow>
        </Button>
    </Grid>
</views:BaseContentPage>

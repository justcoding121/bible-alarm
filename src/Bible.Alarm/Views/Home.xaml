<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Home"
    x:Name="HomePage"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:models="clr-namespace:Bible.Alarm.Models"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:progressbar="clr-namespace:Syncfusion.Maui.ProgressBar;assembly=Syncfusion.Maui.ProgressBar"
    xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:enums="clr-namespace:Bible.Alarm.Shared.Models.Enums;assembly=Bible.Alarm.Shared"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    x:DataType="vm:HomeViewModel"
    Title="Bible Alarm"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <converters:DayColorConverter x:Key="dayColorConverter" />
        <converters:DayBackgroundColorConverter x:Key="dayBackgroundColorConverter" />
        <converters:DayOpacityConverter x:Key="dayOpacityConverter" />
        <converters:IsEnabledColorConverter x:Key="isEnabledColorConverter" />
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <converters:IsStringNotEmptyConverter x:Key="isStringNotEmptyConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage and available via StaticResource -->
    </ContentPage.Resources>
    <Grid AutomationId="HomePage" BackgroundColor="{DynamicResource PageBackgroundColor}">
        <Grid
            Grid.Row="0"
            Margin="{OnPlatform Default='0', iOS='0,44,0,0', Android='0,24,0,0'}"
            RowSpacing="0"
            Grid.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0" Padding="16,12">
                <Button
                    Margin="{OnPlatform Default='0,0,0,8',
                                        iOS='0,0,0,8'}"
                    AutomationId="AddScheduleButton"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    CornerRadius="12"
                    Command="{Binding AddScheduleCommand}"
                    IsEnabled="{Binding Loaded}"
                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                    FontSize="20"
                    HorizontalOptions="Fill"
                    HeightRequest="{OnPlatform Default='50',
                                               WinUI='45',
                                               iOS='50'}"
                    Padding="0"
                    Text="{x:Static fn:GlyphNames.Plus}"
                    TextColor="White">
                    <Button.Shadow>
                        <Shadow Brush="#40000000" 
                                Offset="0,2" 
                                Radius="4" 
                                Opacity="0.3" />
                    </Button.Shadow>
                </Button>
            </StackLayout>
            <!-- Progress bar for schedule loading -->
            <shared:AnimatedProgressBar
                Grid.Row="1"
                Opacity="{Binding ProgressBarOpacity}"
                VerticalOptions="Start"
                InputTransparent="{Binding IsProgressBarHidden}"
                BindingContext="{Binding}" />
            <CollectionView
                x:Name="SchedulesCollectionView"
                Grid.Row="2"
                BackgroundColor="Transparent"
                Footer="{OnPlatform iOS=''}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                ItemsSource="{Binding Schedules}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" 
                                       ItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleListItem">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem
                                            BackgroundColor="{StaticResource ErrorColor}"
                                            Command="{Binding DeleteCommand}">
                                        <SwipeItem.IconImageSource>
                                            <FontImageSource
                                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                    Glyph="{x:Static fn:GlyphNames.Trash}"
                                                    Color="White"
                                                    Size="20" />
                                        </SwipeItem.IconImageSource>
                                    </SwipeItem>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid>
                                <Border
                                        x:Name="ScheduleItemBorder"
                                        Margin="{OnPlatform Default='16,0,16,0',
                                                             WinUI='16,0,16,0',
                                                             iOS='16,0,16,0'}"
                                        Padding="16,16,16,16"
                                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12,12,12,12">
                                    <Border.Shadow>
                                        <Shadow Brush="#20000000" 
                                                    Offset="0,2" 
                                                    Radius="8" 
                                                    Opacity="0.15" />
                                    </Border.Shadow>
                                    <Grid
                                            x:Name="ScheduleItemGrid"
                                    ColumnSpacing="{OnPlatform iOS='0'}"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer 
                                            Tapped="OnScheduleItemTapped" />
                                </Grid.GestureRecognizers>
                                <Grid.Resources>
                                    <enums:DaysOfWeek x:Key="Sunday">Sunday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Monday">Monday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Tuesday">Tuesday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Wednesday">Wednesday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Thursday">Thursday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Friday">Friday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Saturday">Saturday</enums:DaysOfWeek>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{OnPlatform WinUI='50', Default='auto'}" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackLayout VerticalOptions="Center"
                                                 Grid.Column="0"
                                                 Margin="{OnIdiom Default={OnPlatform Default='0,0,12,0',
                                                                         iOS='0,0,12,0',
                                                                         WinUI='0,0,12,0'},
                                                     Tablet={OnPlatform Default='0,0,12,0'}}"
                                                 Padding="0"
                                                 Orientation="Vertical">
                                    <Grid
                                            Margin="0,0,0,8"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            HeightRequest="{OnPlatform iOS='56',
                                                                      WinUI='48',
                                                                      Default='56'}"
                                            WidthRequest="{OnPlatform iOS='56',
                                                                     WinUI='48',
                                                                     Default='56'}">
                                        <Border
                                                BackgroundColor="{StaticResource PrimaryColor}"
                                                StrokeThickness="0"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="{OnPlatform iOS='28', WinUI='24', Default='28'}" />
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="#60000000" 
                                                            Offset="0,4" 
                                                            Radius="8" 
                                                            Opacity="0.4" />
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PlayCommand}" />
                                            </Border.GestureRecognizers>
                                            <Label
                                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                    FontSize="24"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Text="{x:Static fn:GlyphNames.Play}"
                                                    TextColor="White"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    IsVisible="{Binding IsBusy, Converter={StaticResource negateBooleanConverter}}" />
                                        </Border>
                                        <!-- Loading indicator overlay - shows when IsBusy is true -->
                                        <ActivityIndicator
                                                IsRunning="{Binding IsBusy}"
                                                IsVisible="{Binding IsBusy}"
                                                Color="White"
                                                WidthRequest="28"
                                                HeightRequest="28"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center"
                                                Opacity="0.95" />
                                    </Grid>
                                    <StackLayout
                                            Margin="0"
                                            Padding="0"
                                            HorizontalOptions="Center"
                                            Orientation="Horizontal"
                                            VerticalOptions="Center"
                                            Spacing="2">
                                        <Label
                                                Padding="0"
                                                FontSize="{StaticResource AlarmTimeFontSize}"
                                                FontAttributes="Bold"
                                                Text="{Binding TimeText}"
                                                VerticalOptions="Center"
                                                TextColor="{Binding IsEnabled, Converter={StaticResource isEnabledColorConverter}}" />
                                        <Label
                                                Margin="0"
                                                Padding="0"
                                                FontSize="{StaticResource AlarmMeridianFontSize}"
                                                Text="{Binding MeridianText}"
                                                VerticalOptions="Center"
                                                TextColor="{Binding IsEnabled, Converter={StaticResource isEnabledColorConverter}}"
                                                VerticalTextAlignment="Center" />
                                    </StackLayout>
                                </StackLayout>
                                <Grid
                                        Grid.Column="1"
                                        Margin="{OnPlatform Default='0,0,12,0',
                                                            iOS='0,0,12,0',
                                                            WinUI='0,0,8,0'}"
                                        HorizontalOptions="Start"
                                        VerticalOptions="Fill">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackLayout Grid.Row="0" 
                                                     Orientation="Horizontal"
                                                     HorizontalOptions="Start"
                                                     Spacing="{OnPlatform WinUI='3', Default='4'}"
                                                     Margin="0,0,0,8">
                                        <Border
                                                Padding="{OnPlatform WinUI='5,3', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter={StaticResource Sunday}}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{OnPlatform WinUI='11', Default={StaticResource SmallFontSize}}"
                                                    Text="S"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Sunday}}" />
                                        </Border>
                                        <Border
                                                Padding="{OnPlatform WinUI='5,3', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter={StaticResource Monday}}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{OnPlatform WinUI='11', Default={StaticResource SmallFontSize}}"
                                                    Text="M"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Monday}}" />
                                        </Border>
                                        <Border
                                                Padding="{OnPlatform WinUI='5,3', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter={StaticResource Tuesday}}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{OnPlatform WinUI='11', Default={StaticResource SmallFontSize}}"
                                                    Text="T"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Tuesday}}" />
                                        </Border>
                                        <Border
                                                Padding="{OnPlatform WinUI='5,3', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter={StaticResource Wednesday}}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{OnPlatform WinUI='11', Default={StaticResource SmallFontSize}}"
                                                    Text="W"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Wednesday}}" />
                                        </Border>
                                        <Border
                                                Padding="{OnPlatform WinUI='5,3', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter={StaticResource Thursday}}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{OnPlatform WinUI='11', Default={StaticResource SmallFontSize}}"
                                                    Text="T"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Thursday}}" />
                                        </Border>
                                        <Border
                                                Padding="{OnPlatform WinUI='5,3', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter={StaticResource Friday}}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{OnPlatform WinUI='11', Default={StaticResource SmallFontSize}}"
                                                    Text="F"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Friday}}" />
                                        </Border>
                                        <Border
                                                Padding="{OnPlatform WinUI='5,3', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter={StaticResource Saturday}}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{OnPlatform WinUI='11', Default={StaticResource SmallFontSize}}"
                                                    Text="S"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Saturday}}" />
                                        </Border>
                                    </StackLayout>
                                    <StackLayout Grid.Row="1" 
                                                     Orientation="Vertical"
                                                     HorizontalOptions="Start"
                                                     VerticalOptions="Start"
                                                     Spacing="4">
                                        <Label
                                                Margin="0,0,0,4"
                                                HorizontalOptions="Start"
                                                HorizontalTextAlignment="Start"
                                                FontSize="16"
                                                FontAttributes="Bold"
                                                Text="{Binding Name}"
                                                TextColor="{DynamicResource TextPrimaryColor}" />
                                        <Label
                                                Margin="0"
                                                HorizontalOptions="Start"
                                                HorizontalTextAlignment="Start"
                                                FontSize="14"
                                                Text="{Binding SubTitle}"
                                                TextColor="{DynamicResource PrimaryTextColor}" />
                                    </StackLayout>
                                    <StackLayout Grid.Row="2"
                                                     Grid.Column="0"
                                                     Orientation="Horizontal" 
                                                     HorizontalOptions="Start"
                                                     Margin="0,8,0,0"
                                                     Spacing="8"
                                                     VerticalOptions="End">
                                        <Button
                                                Padding="0"
                                                BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                CornerRadius="6"
                                                Command="{Binding PreviousCommand}"
                                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                FontSize="20"
                                                HorizontalOptions="Start"
                                                HeightRequest="36"
                                                WidthRequest="36"
                                                Text="{x:Static fn:GlyphNames.Left}"
                                                TextColor="{DynamicResource TextSecondaryColor}"
                                                VerticalOptions="Center" />
                                        <Button
                                                Padding="0"
                                                BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                CornerRadius="6"
                                                Command="{Binding NextCommand}"
                                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                FontSize="20"
                                                HeightRequest="36"
                                                WidthRequest="36"
                                                HorizontalOptions="Start"
                                                Text="{x:Static fn:GlyphNames.Right}"
                                                TextColor="{DynamicResource TextSecondaryColor}"
                                                VerticalOptions="Center" />
                                    </StackLayout>
                                </Grid>
                                <StackLayout
                                        Grid.Column="2"
                                        Margin="0"
                                        HorizontalOptions="End"
                                        Orientation="Vertical"
                                        VerticalOptions="Center">
                                    <!-- Windows-specific delete button -->
                                    <Button
                                            Margin="0,0,0,8"
                                            Padding="0"
                                            BackgroundColor="{StaticResource ErrorColor}"
                                            CornerRadius="16"
                                            Command="{Binding DeleteCommand}"
                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                            FontSize="14"
                                            HeightRequest="32"
                                            WidthRequest="32"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            Text="{x:Static fn:GlyphNames.Trash}"
                                            TextColor="White"
                                            IsVisible="{OnPlatform WinUI='True', Default='False'}">
                                        <Button.Shadow>
                                            <Shadow Brush="#40000000" 
                                                    Offset="0,2" 
                                                    Radius="4" 
                                                    Opacity="0.3" />
                                        </Button.Shadow>
                                    </Button>
                                    <shared:PlatformSwitch
                                            HorizontalOptions="End"
                                            IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                                            Scale="1" />
                                </StackLayout>
                                <!-- Language label and music icon positioned at bottom right -->
                                <HorizontalStackLayout
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Grid.Row="0"
                                        Margin="0,0,0,0"
                                        HorizontalOptions="End"
                                        VerticalOptions="End"
                                        Spacing="4">
                                    <Label
                                            HorizontalOptions="End"
                                            HorizontalTextAlignment="End"
                                            FontSize="12"
                                            Text="{Binding Language}"
                                            TextColor="{DynamicResource PrimaryTextColor}"
                                            IsVisible="{Binding Language, Converter={StaticResource isStringNotEmptyConverter}}"
                                            VerticalOptions="Center" />
                                    <Label
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                            FontSize="12"
                                            Text="{x:Static fn:GlyphNames.Music}"
                                            TextColor="{DynamicResource PrimaryTextColor}"
                                            Opacity="0.8"
                                            IsVisible="{Binding MusicEnabled, Mode=OneWay}"
                                            InputTransparent="True" />
                                </HorizontalStackLayout>
                            </Grid>
                            </Border>
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
    </Grid>
</views:BaseContentPage>

<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="Bible.Alarm.Views.Home"
    x:Name="HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:models="clr-namespace:Bible.Alarm.Models"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:enums="clr-namespace:Bible.Alarm.Shared.Models.Enums;assembly=Bible.Alarm.Shared"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    x:DataType="vm:HomeViewModel"
    Title="Bible Alarm"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <converters:DayColorConverter x:Key="dayColorConverter" />
        <converters:IsEnabledColorConverter x:Key="isEnabledColorConverter" />
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
    </ContentPage.Resources>
    <Grid AutomationId="HomePage" BackgroundColor="White">
        <Grid
            Grid.Row="0"
            Margin="{OnPlatform iOS='0,10,0,0'}"
            RowSpacing="0"
            IsVisible="{Binding IsHomePageOverlayVisible, Converter={StaticResource negateBooleanConverter}}"
            Grid.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackLayout Grid.Row="0">
                <Button
                    Margin="{OnPlatform Default='5,5,5,10',
                                        iOS='5,25,5,10'}"
                    AutomationId="AddScheduleButton"
                    BackgroundColor="{OnPlatform Default='WhiteSmoke', WinUI='LightGray'}"
                    BorderWidth="0"
                    BorderColor="Transparent"
                    Command="{Binding AddScheduleCommand}"
                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                    FontSize="{StaticResource ButtonFontSize}"
                    HorizontalOptions="Fill"
                    MinimumHeightRequest="{OnPlatform Default='40',
                                                      WinUI='30'}"
                    Padding="10,8"
                    Text="{x:Static fn:GlyphNames.Plus}"
                    TextColor="SlateBlue" />
            </StackLayout>
            <CollectionView
                x:Name="SchedulesCollectionView"
                Grid.Row="1"
                BackgroundColor="White"
                Footer="{OnPlatform iOS=''}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                ItemsSource="{Binding Schedules}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" 
                                       ItemSpacing="0" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleListItem">
                            <Grid
                                x:Name="ScheduleItemGrid"
                                Margin="{OnPlatform Default='0,20,0,20',
                                                     WinUI='0,20,0,20'}"
                                Padding="5,10,5,10"
                                ColumnSpacing="{OnPlatform iOS='0'}"
                                HorizontalOptions="Fill"
                                VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer 
                                        Tapped="OnScheduleItemTapped" />
                                </Grid.GestureRecognizers>
                                <Grid.Resources>
                                    <enums:DaysOfWeek x:Key="Sunday">Sunday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Monday">Monday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Tuesday">Tuesday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Wednesday">Wednesday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Thursday">Thursday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Friday">Friday</enums:DaysOfWeek>
                                    <enums:DaysOfWeek x:Key="Saturday">Saturday</enums:DaysOfWeek>
                                </Grid.Resources>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="auto" />
                                </Grid.RowDefinitions>
                                <StackLayout VerticalOptions="Center"
                                             Grid.Column="0"
                                             Margin="{OnIdiom Default={OnPlatform Default='10,3,0,0',
                                                                         iOS='10,3,0,0',
                                                                         WinUI='30,3,0,0'},
                                                     Tablet={OnPlatform Default='30,3,0,0'}}"
                                             Padding="0"
                                             Orientation="Vertical">
                                    <Button
                                        Margin="0"
                                        BackgroundColor="{OnPlatform Default='WhiteSmoke',
                                                                     WinUI='LightGray'}"
                                        BorderWidth="0"
                                        BorderColor="Transparent"
                                        Command="{Binding PlayCommand}"
                                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                        HorizontalOptions="Center"
                                        MinimumHeightRequest="{OnPlatform WinUI='40',
                                                                          iOS='40'}"
                                        MinimumWidthRequest="{OnPlatform iOS='60',
                                                                         WinUI='60'}"
                                        Padding="10,8"
                                        Text="{x:Static fn:GlyphNames.Play}"
                                        TextColor="SlateBlue"
                                        VerticalOptions="Center" />
                                    <StackLayout
                                        Margin="0"
                                        Padding="0"
                                        HorizontalOptions="Start"
                                        Orientation="Horizontal"
                                        VerticalOptions="Center">
                                        <Label
                                            Padding="0"
                                            FontSize="{StaticResource AlarmTimeFontSize}"
                                            Text="{Binding TimeText}"
                                            VerticalOptions="Center"
                                            TextColor="{Binding IsEnabled, Converter={StaticResource isEnabledColorConverter}}" />
                                        <Label
                                            Margin="0"
                                            Padding="0"
                                            FontSize="{StaticResource AlarmMeridianFontSize}"
                                            Text="{Binding MeridianText}"
                                            VerticalOptions="Center"
                                            TextColor="{Binding IsEnabled, Converter={StaticResource isEnabledColorConverter}}"
                                            VerticalTextAlignment="Center" />
                                    </StackLayout>
                                </StackLayout>
                                <Grid
                                    Grid.Column="1"
                                    Margin="{OnPlatform Default='20,0,0,0',
                                                        iOS='10,0,0,0',
                                                        WinUI='20,0,0,0'}"
                                    HorizontalOptions="Start"
                                    VerticalOptions="Fill">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackLayout Grid.Row="0" 
                                                 Orientation="Horizontal"
                                                 HorizontalOptions="Start">
                                        <Label
                                            Margin="5,0,0,0"
                                            FontAttributes="Bold"
                                            Style="{StaticResource SmallLabelStyle}"
                                            Text="S"
                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Sunday}}" />
                                        <Label
                                            Margin="0,0,0,0"
                                            FontAttributes="Bold"
                                            Style="{StaticResource SmallLabelStyle}"
                                            Text="M"
                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Monday}}" />
                                        <Label
                                            Margin="0,0,0,0"
                                            FontAttributes="Bold"
                                            Style="{StaticResource SmallLabelStyle}"
                                            Text="T"
                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Tuesday}}" />
                                        <Label
                                            Margin="0,0,0,0"
                                            FontAttributes="Bold"
                                            Style="{StaticResource SmallLabelStyle}"
                                            Text="W"
                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Wednesday}}" />
                                        <Label
                                            Margin="0,0,0,0"
                                            FontAttributes="Bold"
                                            Style="{StaticResource SmallLabelStyle}"
                                            Text="T"
                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Thursday}}" />
                                        <Label
                                            Margin="0,0,0,0"
                                            FontAttributes="Bold"
                                            Style="{StaticResource SmallLabelStyle}"
                                            Text="F"
                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Friday}}" />
                                        <Label
                                            Margin="0,0,0,0"
                                            FontAttributes="Bold"
                                            Style="{StaticResource SmallLabelStyle}"
                                            Text="S"
                                            TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter={StaticResource Saturday}}" />
                                    </StackLayout>
                                    <StackLayout Grid.Row="1" 
                                                 Orientation="Vertical"
                                                 HorizontalOptions="Start"
                                                 VerticalOptions="Start">
                                        <Label
                                            Margin="2,0,0,0"
                                            HorizontalOptions="Start"
                                            HorizontalTextAlignment="Start"
                                            Text="{Binding Name}"
                                            TextColor="Black" />
                                        <Label
                                            Margin="2,0,0,0"
                                            HorizontalOptions="Start"
                                            HorizontalTextAlignment="Start"
                                            Text="{Binding SubTitle}"
                                            TextColor="SlateBlue" />
                                    </StackLayout>
                                    <StackLayout Grid.Row="2"
                                                 Orientation="Horizontal" 
                                                 HorizontalOptions="Start"
                                                 Margin="2,0,0,0"
                                                 Spacing="5"
                                                 VerticalOptions="End">
                                        <Button
                                            CharacterSpacing="0"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            BorderColor="Transparent"
                                            Command="{Binding PreviousCommand}"
                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                            Style="{StaticResource MediumLabelStyle}"
                                            HorizontalOptions="Start"
                                            MinimumHeightRequest="25"
                                            MinimumWidthRequest="30"
                                            Text="{x:Static fn:GlyphNames.Previous}"
                                            TextColor="LightGray"
                                            VerticalOptions="Center"
                                            WidthRequest="30" />
                                        <Button
                                            CharacterSpacing="0"
                                            Padding="0"
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            BorderColor="Transparent"
                                            Command="{Binding NextCommand}"
                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                            Style="{StaticResource MediumLabelStyle}"
                                            MinimumHeightRequest="25"
                                            MinimumWidthRequest="30"
                                            HorizontalOptions="Start"
                                            Text="{x:Static fn:GlyphNames.Next}"
                                            TextColor="LightGray"
                                            VerticalOptions="Center"
                                            WidthRequest="30" />
                                    </StackLayout>
                                </Grid>
                                <StackLayout
                                    Grid.Column="2"
                                    Margin="{OnIdiom Default={OnPlatform Default='15,0,30,0',
                                                                         iOS='5,0,10,0',
                                                                         WinUI='5,0,10,0'},
                                                     Tablet={OnPlatform Default='15,0,50,0'}}"
                                    HorizontalOptions="End"
                                    Orientation="Vertical"
                                    VerticalOptions="Center">
                                    <Border
                                        HorizontalOptions="End"
                                        VerticalOptions="Center"
                                        WidthRequest="{OnPlatform Default='-1', WinUI='50'}"
                                        ClipToBounds="True">
                                        <Switch
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                                            Scale="{OnPlatform Default='1',
                                                               iOS='1'}" />
                                    </Border>
                                </StackLayout>
                            </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        <!-- Overlay with busy indicator -->
        <Grid
            Grid.Row="0"
            BackgroundColor="White"
            IsVisible="{Binding IsHomePageOverlayVisible}"
            HorizontalOptions="Fill"
            VerticalOptions="Fill"
            Grid.ZIndex="2">
            <ActivityIndicator
                HorizontalOptions="Center"
                IsEnabled="True"
                IsRunning="{Binding IsHomePageOverlayVisible}"
                IsVisible="{Binding IsHomePageOverlayVisible}"
                Scale="0.5"
                VerticalOptions="Center"
                Color="SlateBlue">
                <ActivityIndicator.Scale>
                    <OnPlatform x:TypeArguments="system:Double">
                        <OnPlatform.Platforms>
                            <On Platform="iOS" Value="4.0" />
                            <On Platform="Android" Value="1.0" />
                            <On Platform="WinUI" Value="1.0" />
                        </OnPlatform.Platforms>
                    </OnPlatform>
                </ActivityIndicator.Scale>
            </ActivityIndicator>
        </Grid>
    </Grid>
</ContentPage>
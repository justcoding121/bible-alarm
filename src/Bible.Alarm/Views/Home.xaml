<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Home"
    x:Name="HomePage"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared;assembly=Bible.Alarm"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:enums="clr-namespace:Bible.Alarm.Shared.Models.Enums;assembly=Bible.Alarm.Shared"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    x:DataType="vm:HomeViewModel"
    Title="Bible Alarm"
    NavigationPage.HasNavigationBar="False">
    <!-- Converters moved to App.xaml for better performance - shared across all pages -->
    <!-- Theme-aware colors are inherited from BaseContentPage and available via StaticResource -->
    <Grid AutomationId="HomePage" BackgroundColor="{DynamicResource PageBackgroundColor}" HorizontalOptions="Fill" VerticalOptions="Fill">
        <Grid
            Grid.Row="0"
            Margin="{OnPlatform Default='0', iOS='0,20,0,0', Android='0,24,0,0'}"
            RowSpacing="0"
            Grid.ZIndex="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Padding="16,12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- SfEffectsView wrapper for WinUI only -->
                <core:SfEffectsView Grid.Row="0"
                                    TouchDownEffects="Ripple"
                                    TouchUpEffects="None"
                                    RippleBackground="{StaticResource PrimaryColor}"
                                    RippleAnimationDuration="200"
                                    ShouldIgnoreTouches="False"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Fill">
                    <core:SfEffectsView.IsVisible>
                        <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                            <On Platform="WinUI" Value="true" />
                        </OnPlatform>
                    </core:SfEffectsView.IsVisible>
                    <core:SfEffectsView.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddScheduleCommand}" />
                    </core:SfEffectsView.GestureRecognizers>
                    <Button x:Name="AddScheduleEffectsButton"
                            Margin="{OnPlatform Default='0,0,0,8',
                                                iOS='0,0,0,8'}"
                            AutomationId="AddScheduleButton"
                            BackgroundColor="{StaticResource PrimaryColor}"
                            CornerRadius="12"
                            Command="{Binding AddScheduleCommand}"
                            IsEnabled="{Binding IsBootstrapReady}"
                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                            FontSize="{DynamicResource IconStandardFontSize}"
                            HorizontalOptions="Fill"
                            HeightRequest="{DynamicResource IconStandardContainerSize}"
                            Padding="0"
                            Text="{x:Static fn:GlyphNames.Plus}"
                            TextColor="White"
                            InputTransparent="{OnPlatform WinUI=True, Default=False}">
                        <Button.Shadow>
                            <Shadow Brush="#40000000" 
                                    Offset="0,2" 
                                    Radius="4" 
                                    Opacity="0.3" />
                        </Button.Shadow>
                        <Button.Triggers>
                            <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                            </Trigger>
                            <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                                <Setter Property="Opacity" Value="1.0" />
                                <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                            </Trigger>
                        </Button.Triggers>
                    </Button>
                </core:SfEffectsView>
                <!-- Regular button for Android/iOS (with native effects) -->
                <Button Grid.Row="0"
                        x:Name="AddScheduleButtonNoEffects"
                        Margin="{OnPlatform Default='0,0,0,8',
                                            iOS='0,0,0,8'}"
                        AutomationId="AddScheduleButton"
                        BackgroundColor="{StaticResource PrimaryColor}"
                        CornerRadius="12"
                        Command="{Binding AddScheduleCommand}"
                        IsEnabled="{Binding IsBootstrapReady}"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="{DynamicResource IconStandardFontSize}"
                        HorizontalOptions="Fill"
                        HeightRequest="{DynamicResource IconStandardContainerSize}"
                        Padding="0"
                        Text="{x:Static fn:GlyphNames.Plus}"
                        TextColor="White"
                        IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}">
                    <Button.Shadow>
                        <Shadow Brush="#40000000" 
                                Offset="0,2" 
                                Radius="4" 
                                Opacity="0.3" />
                    </Button.Shadow>
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                        </Trigger>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                            <Setter Property="Opacity" Value="1.0" />
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
            </Grid>
            <!-- Progress bar for schedule loading -->
            <shared:AnimatedProgressBar
                Grid.Row="1"
                Opacity="{Binding ProgressBarOpacity}"
                VerticalOptions="Start"
                InputTransparent="{Binding IsProgressBarHidden}"
                BindingContext="{Binding}" />
            <CollectionView
                x:Name="SchedulesCollectionView"
                Grid.Row="2"
                BackgroundColor="Transparent"
                Footer="{OnPlatform iOS=''}"
                HorizontalOptions="Fill"
                VerticalOptions="Fill"
                ItemsSource="{Binding Schedules}"
                Margin="{Binding CollectionViewBottomMargin, Converter={StaticResource doubleToBottomThicknessConverter}}"
                SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" 
                                       ItemSpacing="16" />
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:ScheduleListItemViewModel">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem
                                            BackgroundColor="{StaticResource ErrorColor}"
                                            Command="{Binding DeleteCommand}">
                                        <SwipeItem.IconImageSource>
                                            <FontImageSource
                                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                    Glyph="{x:Static fn:GlyphNames.Trash}"
                                                    Color="White"
                                                    Size="20" />
                                        </SwipeItem.IconImageSource>
                                    </SwipeItem>
                                </SwipeItems>
                            </SwipeView.RightItems>
                            <Grid>
                                <core:SfEffectsView
                                        x:Name="ScheduleItemEffectsView"
                                        Margin="{OnPlatform Default='16,0,16,0',
                                                             WinUI='16,0,16,0',
                                                             iOS='16,0,16,0'}"
                                        TouchDownEffects="{OnPlatform Android=Ripple, iOS=Highlight, Default=Ripple}"
                                        TouchUpEffects="None"
                                        RippleBackground="{StaticResource PrimaryColor}"
                                        HighlightBackground="{StaticResource PrimaryLightColor}"
                                        RippleAnimationDuration="200"
                                        ShouldIgnoreTouches="False">
                                    <core:SfEffectsView.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnScheduleItemTapped" />
                                    </core:SfEffectsView.GestureRecognizers>
                                <Border
                                        x:Name="ScheduleItemBorder"
                                        Padding="16,16,16,16"
                                        BackgroundColor="{DynamicResource CardBackgroundColor}"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12,12,12,12">
                                    <Border.Shadow>
                                        <Shadow Brush="#20000000" 
                                                    Offset="0,2" 
                                                    Radius="8" 
                                                    Opacity="0.15" />
                                    </Border.Shadow>
                                    <Grid
                                            x:Name="ScheduleItemGrid"
                                    ColumnSpacing="{OnPlatform iOS='0'}"
                                    HorizontalOptions="Fill"
                                    VerticalOptions="Start">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{OnPlatform WinUI='50', Default='auto'}" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid VerticalOptions="Center"
                                      Grid.Column="0"
                                      Margin="{OnIdiom Default={OnPlatform Default='0,0,12,0',
                                                                     iOS='0,0,12,0',
                                                                     WinUI='0,0,12,0'},
                                         Tablet={OnPlatform Default='0,0,12,0'}}"
                                      RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0"
                                          Margin="0,0,0,8"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          HeightRequest="{DynamicResource IconLargeContainerSize}"
                                          WidthRequest="{DynamicResource IconLargeContainerSize}">
                                        <Border
                                                BackgroundColor="{StaticResource PrimaryColor}"
                                                StrokeThickness="0"
                                                HorizontalOptions="Fill"
                                                VerticalOptions="Fill">
                                            <Border.StrokeShape>
                                                <!-- Large CornerRadius is clipped to create circle regardless of container size -->
                                                <RoundRectangle CornerRadius="100" />
                                            </Border.StrokeShape>
                                            <Border.Shadow>
                                                <Shadow Brush="#60000000" 
                                                            Offset="0,4" 
                                                            Radius="8" 
                                                            Opacity="0.4" />
                                            </Border.Shadow>
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PlayCommand}" />
                                            </Border.GestureRecognizers>
                                            <Label
                                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                    FontSize="{DynamicResource IconLargeFontSize}"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center"
                                                    Text="{x:Static fn:GlyphNames.Play}"
                                                    TextColor="White"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    IsVisible="{Binding IsBusy, Converter={StaticResource negateBooleanConverter}}" />
                                        </Border>
                                        <!-- Loading indicator overlay - shows when IsBusy is true -->
                                        <ActivityIndicator
                                                IsRunning="{Binding IsBusy}"
                                                IsVisible="{Binding IsBusy}"
                                                Color="White"
                                                WidthRequest="{DynamicResource IconStandardFontSize}"
                                                HeightRequest="{DynamicResource IconStandardFontSize}"
                                                VerticalOptions="Center"
                                                HorizontalOptions="Center"
                                                Opacity="0.95" />
                                    </Grid>
                                    <Grid Grid.Row="1"
                                          Margin="0"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center"
                                          ColumnSpacing="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Label Grid.Column="0"
                                               Padding="0"
                                               FontSize="{DynamicResource AlarmTimeFontSize}"
                                               FontAttributes="Bold"
                                               Text="{Binding TimeText}"
                                               VerticalOptions="Center"
                                               TextColor="{Binding IsEnabled, Converter={StaticResource isEnabledColorConverter}}"
                                               LineBreakMode="NoWrap" />
                                        <Label Grid.Column="1"
                                               Margin="0"
                                               Padding="0"
                                               FontSize="{DynamicResource AlarmMeridianFontSize}"
                                               Text="{Binding MeridianText}"
                                               VerticalOptions="Center"
                                               TextColor="{Binding IsEnabled, Converter={StaticResource isEnabledColorConverter}}"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                </Grid>
                                <Grid
                                        Grid.Column="1"
                                        Margin="{OnPlatform Default='0,0,12,0',
                                                            iOS='0,0,12,0',
                                                            WinUI='0,0,8,0'}"
                                        HorizontalOptions="Fill"
                                        VerticalOptions="Fill">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <FlexLayout Grid.Row="0" 
                                          HorizontalOptions="Start"
                                          Wrap="Wrap"
                                          JustifyContent="Start"
                                          AlignItems="Center"
                                          Margin="0,0,0,8">
                                        <Border Margin="{OnPlatform WinUI='1', Default='2'}"
                                                Padding="{OnPlatform WinUI='3,1,5,5', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Sunday'}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource SmallFontSize}"
                                                    Text="S"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Sunday'}"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                        </Border>
                                        <Border Margin="{OnPlatform WinUI='1', Default='2'}"
                                                Padding="{OnPlatform WinUI='3,1,5,5', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Monday'}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource SmallFontSize}"
                                                    Text="M"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Monday'}"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                        </Border>
                                        <Border Margin="{OnPlatform WinUI='1', Default='2'}"
                                                Padding="{OnPlatform WinUI='3,1,5,5', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Tuesday'}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource SmallFontSize}"
                                                    Text="T"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Tuesday'}"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                        </Border>
                                        <Border Margin="{OnPlatform WinUI='1', Default='2'}"
                                                Padding="{OnPlatform WinUI='3,1,5,5', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Wednesday'}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource SmallFontSize}"
                                                    Text="W"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Wednesday'}"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                        </Border>
                                        <Border Margin="{OnPlatform WinUI='1', Default='2'}"
                                                Padding="{OnPlatform WinUI='3,1,5,5', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Thursday'}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource SmallFontSize}"
                                                    Text="T"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Thursday'}"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                        </Border>
                                        <Border Margin="{OnPlatform WinUI='1', Default='2'}"
                                                Padding="{OnPlatform WinUI='3,1,5,5', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Friday'}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource SmallFontSize}"
                                                    Text="F"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Friday'}"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                        </Border>
                                        <Border Margin="{OnPlatform WinUI='1', Default='2'}"
                                                Padding="{OnPlatform WinUI='3,1,5,5', Default='6,4'}"
                                                BackgroundColor="{Binding This, Converter={StaticResource dayBackgroundColorConverter}, ConverterParameter='Saturday'}"
                                                Opacity="{Binding This, Converter={StaticResource dayOpacityConverter}}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 4,4,4,4"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center">
                                            <Label
                                                    FontAttributes="Bold"
                                                    FontSize="{DynamicResource SmallFontSize}"
                                                    Text="S"
                                                    TextColor="{Binding This, Converter={StaticResource dayColorConverter}, ConverterParameter='Saturday'}"
                                                    HorizontalTextAlignment="Center"
                                                    VerticalTextAlignment="Center"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center" />
                                        </Border>
                                    </FlexLayout>
                                    <VerticalStackLayout Grid.Row="1" 
                                          HorizontalOptions="Fill"
                                          VerticalOptions="Start"
                                          Spacing="4">
                                        <Label Margin="0,0,0,0"
                                               HorizontalOptions="Fill"
                                               HorizontalTextAlignment="Start"
                                               FontSize="{DynamicResource LargeFontSize}"
                                               FontAttributes="Bold"
                                               Text="{Binding Name}"
                                               TextColor="{DynamicResource TextPrimaryColor}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1" />
                                        <Label Margin="0"
                                               HorizontalOptions="Fill"
                                               HorizontalTextAlignment="Start"
                                               FontSize="{DynamicResource MediumFontSize}"
                                               Text="{Binding SubTitle}"
                                               TextColor="{DynamicResource PrimaryTextColor}"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="2" />
                                    </VerticalStackLayout>
                                    <Grid Grid.Row="2"
                                          Grid.Column="0"
                                          HorizontalOptions="Start"
                                          Margin="0,8,0,0"
                                          ColumnSpacing="8"
                                          VerticalOptions="End">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Previous button - SfEffectsView for WinUI only -->
                                        <core:SfEffectsView Grid.Column="0"
                                                            TouchDownEffects="Ripple"
                                                            TouchUpEffects="None"
                                                            RippleBackground="{DynamicResource PrimaryColor}"
                                                            RippleAnimationDuration="200"
                                                            ShouldIgnoreTouches="False"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="Center">
                                            <core:SfEffectsView.IsVisible>
                                                <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                                                    <On Platform="WinUI" Value="true" />
                                                </OnPlatform>
                                            </core:SfEffectsView.IsVisible>
                                            <core:SfEffectsView.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding PreviousCommand}" />
                                            </core:SfEffectsView.GestureRecognizers>
                                            <Button Padding="0"
                                                    BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                    CornerRadius="6"
                                                    Command="{Binding PreviousCommand}"
                                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                    FontSize="{DynamicResource IconStandardFontSize}"
                                                    HorizontalOptions="Start"
                                                    HeightRequest="{DynamicResource IconSmallContainerSize}"
                                                    WidthRequest="{DynamicResource IconSmallContainerSize}"
                                                    Text="{x:Static fn:GlyphNames.Left}"
                                                    TextColor="{DynamicResource TextSecondaryColor}"
                                                    VerticalOptions="Center"
                                                    InputTransparent="{OnPlatform WinUI=True, Default=False}" />
                                        </core:SfEffectsView>
                                        <Button Grid.Column="0"
                                                Padding="0"
                                                BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                CornerRadius="6"
                                                Command="{Binding PreviousCommand}"
                                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                FontSize="{DynamicResource IconStandardFontSize}"
                                                HorizontalOptions="Start"
                                                HeightRequest="{DynamicResource IconSmallContainerSize}"
                                                WidthRequest="{DynamicResource IconSmallContainerSize}"
                                                Text="{x:Static fn:GlyphNames.Left}"
                                                TextColor="{DynamicResource TextSecondaryColor}"
                                                VerticalOptions="Center"
                                                IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}" />
                                        <!-- Next button - SfEffectsView for WinUI only -->
                                        <core:SfEffectsView Grid.Column="1"
                                                            TouchDownEffects="Ripple"
                                                            TouchUpEffects="None"
                                                            RippleBackground="{DynamicResource PrimaryColor}"
                                                            RippleAnimationDuration="200"
                                                            ShouldIgnoreTouches="False"
                                                            HorizontalOptions="Start"
                                                            VerticalOptions="Center">
                                            <core:SfEffectsView.IsVisible>
                                                <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                                                    <On Platform="WinUI" Value="true" />
                                                </OnPlatform>
                                            </core:SfEffectsView.IsVisible>
                                            <core:SfEffectsView.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding NextCommand}" />
                                            </core:SfEffectsView.GestureRecognizers>
                                            <Button Padding="0"
                                                    BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                    CornerRadius="6"
                                                    Command="{Binding NextCommand}"
                                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                    FontSize="{DynamicResource IconStandardFontSize}"
                                                    HeightRequest="{DynamicResource IconSmallContainerSize}"
                                                    WidthRequest="{DynamicResource IconSmallContainerSize}"
                                                    HorizontalOptions="Start"
                                                    Text="{x:Static fn:GlyphNames.Right}"
                                                    TextColor="{DynamicResource TextSecondaryColor}"
                                                    VerticalOptions="Center"
                                                    InputTransparent="{OnPlatform WinUI=True, Default=False}" />
                                        </core:SfEffectsView>
                                        <Button Grid.Column="1"
                                                Padding="0"
                                                BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                CornerRadius="6"
                                                Command="{Binding NextCommand}"
                                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                FontSize="{DynamicResource IconStandardFontSize}"
                                                HeightRequest="{DynamicResource IconSmallContainerSize}"
                                                WidthRequest="{DynamicResource IconSmallContainerSize}"
                                                HorizontalOptions="Start"
                                                Text="{x:Static fn:GlyphNames.Right}"
                                                TextColor="{DynamicResource TextSecondaryColor}"
                                                VerticalOptions="Center"
                                                IsVisible="{OnPlatform Android=True, iOS=True, WinUI=False}" />
                                    </Grid>
                                </Grid>
                                <Grid Grid.Column="2"
                                      Margin="0"
                                      HorizontalOptions="End"
                                      VerticalOptions="Center"
                                      RowSpacing="8">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <!-- Windows-specific delete button -->
                                    <core:SfEffectsView Grid.Row="0"
                                            Margin="0,0,0,8"
                                            TouchDownEffects="Ripple"
                                            TouchUpEffects="None"
                                            RippleBackground="{StaticResource ErrorColor}"
                                            RippleAnimationDuration="200"
                                            ShouldIgnoreTouches="False"
                                            HorizontalOptions="Center"
                                            VerticalOptions="Center"
                                            IsVisible="{OnPlatform WinUI='True', Default='False'}">
                                        <core:SfEffectsView.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding DeleteCommand}" />
                                        </core:SfEffectsView.GestureRecognizers>
                                        <Button Padding="0"
                                                BackgroundColor="{StaticResource ErrorColor}"
                                                CornerRadius="100"
                                                Command="{Binding DeleteCommand}"
                                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                FontSize="{DynamicResource IconSmallFontSize}"
                                                HeightRequest="{DynamicResource IconSmallContainerSize}"
                                                WidthRequest="{DynamicResource IconSmallContainerSize}"
                                                HorizontalOptions="Center"
                                                VerticalOptions="Center"
                                                Text="{x:Static fn:GlyphNames.Trash}"
                                                TextColor="White"
                                                InputTransparent="True">
                                            <Button.Shadow>
                                                <Shadow Brush="#40000000" 
                                                        Offset="0,2" 
                                                        Radius="4" 
                                                        Opacity="0.3" />
                                            </Button.Shadow>
                                        </Button>
                                    </core:SfEffectsView>
                                    <shared:PlatformSwitch Grid.Row="1"
                                            HorizontalOptions="End"
                                            IsToggled="{Binding IsEnabled, Mode=TwoWay}"
                                            Scale="1" />
                                </Grid>
                                <!-- Language label and music icon positioned at bottom right -->
                                <Grid Grid.Column="1"
                                      Grid.ColumnSpan="2"
                                      Grid.Row="0"
                                      Margin="0,0,0,0"
                                      HorizontalOptions="End"
                                      VerticalOptions="End"
                                      ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label Grid.Column="0"
                                            HorizontalOptions="End"
                                            HorizontalTextAlignment="End"
                                            FontSize="{DynamicResource StandardFontSize}"
                                            Text="{Binding Language}"
                                            TextColor="{DynamicResource PrimaryTextColor}"
                                            IsVisible="{Binding Language, Converter={StaticResource isStringNotEmptyConverter}}"
                                            VerticalOptions="Center" />
                                    <Label Grid.Column="1"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center"
                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                            FontSize="{DynamicResource StandardFontSize}"
                                            Text="{x:Static fn:GlyphNames.Music}"
                                            TextColor="{DynamicResource PrimaryTextColor}"
                                            Opacity="0.8"
                                            IsVisible="{Binding MusicEnabled, Mode=OneWay}"
                                            InputTransparent="True" />
                                </Grid>
                            </Grid>
                            </Border>
                            </core:SfEffectsView>
                            </Grid>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </Grid>
        
        <!-- Floating Alarm Settings Button (Android only) -->
        <!-- Floating alarm settings button - SfEffectsView for WinUI only -->
        <core:SfEffectsView AutomationId="AlarmSettingsFloatingButton"
            TouchDownEffects="Ripple"
            TouchUpEffects="None"
            RippleBackground="{StaticResource PrimaryColor}"
            RippleAnimationDuration="200"
            ShouldIgnoreTouches="False"
            HorizontalOptions="End"
            VerticalOptions="End"
            IsVisible="{Binding IsFloatingButtonVisible}"
            Margin="0,0,16,16"
            Opacity="{Binding IsFloatingButtonVisible, Converter={StaticResource booleanToDoubleConverter}}"
            ZIndex="100">
            <core:SfEffectsView.IsVisible>
                <OnPlatform x:TypeArguments="x:Boolean" Default="false">
                    <On Platform="WinUI" Value="true" />
                </OnPlatform>
            </core:SfEffectsView.IsVisible>
            <core:SfEffectsView.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenAlarmSettingsCommand}" />
            </core:SfEffectsView.GestureRecognizers>
            <Button BackgroundColor="{StaticResource PrimaryColor}"
                    CornerRadius="100"
                    Command="{Binding OpenAlarmSettingsCommand}"
                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                    FontSize="{DynamicResource IconStandardFontSize}"
                    HeightRequest="{DynamicResource IconLargeContainerSize}"
                    WidthRequest="{DynamicResource IconLargeContainerSize}"
                    HorizontalOptions="End"
                    Padding="0"
                    Text="{x:Static fn:GlyphNames.ExclamationTriangle}"
                    VerticalOptions="End"
                    InputTransparent="True">
                <Button.Shadow>
                    <Shadow Brush="#40000000" 
                            Offset="0,4" 
                            Radius="8" 
                            Opacity="0.4" />
                </Button.Shadow>
            </Button>
        </core:SfEffectsView>
        <!-- Regular button for Android/iOS -->
        <Button x:Name="AlarmSettingsFloatingButtonNoEffects"
                AutomationId="AlarmSettingsFloatingButton"
                BackgroundColor="{StaticResource PrimaryColor}"
                CornerRadius="100"
                Command="{Binding OpenAlarmSettingsCommand}"
                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                FontSize="{DynamicResource IconStandardFontSize}"
                HeightRequest="{DynamicResource IconLargeContainerSize}"
                WidthRequest="{DynamicResource IconLargeContainerSize}"
                HorizontalOptions="End"
                Margin="0,0,16,16"
                Opacity="{Binding IsFloatingButtonVisible, Converter={StaticResource booleanToDoubleConverter}}"
                Padding="0"
                Text="{x:Static fn:GlyphNames.ExclamationTriangle}"
                VerticalOptions="End"
                IsVisible="{Binding IsFloatingButtonVisible}"
                ZIndex="100">
            <Button.Shadow>
                <Shadow Brush="#40000000" 
                        Offset="0,4" 
                        Radius="8" 
                        Opacity="0.4" />
            </Button.Shadow>
        </Button>
    </Grid>
</views:BaseContentPage>

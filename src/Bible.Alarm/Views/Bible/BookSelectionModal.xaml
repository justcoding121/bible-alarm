<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Bible.BookSelectionModal"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:bible="clr-namespace:Bible.Alarm.ViewModels.Bible"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:shared="clr-namespace:Bible.Alarm.Views.Shared"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:DataType="bible:BookSelectionViewModel"
    Padding="0,0,0,0">
    <ContentPage.Resources>
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid
            Margin="{OnPlatform Default='0', iOS='0,20,0,0', Android='0,24,0,0'}"
            BackgroundColor="{DynamicResource BackgroundColor}"
            ColumnSpacing="0"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Border
                Grid.Row="0"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="20,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,20,20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                            Offset="0,4"
                            Opacity="0.1"
                            Radius="8" />
                </Border.Shadow>
                <Label
                    FontSize="18"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    Text="Select Book"
                    TextColor="{DynamicResource TextPrimaryColor}"
                    VerticalOptions="Fill"
                    VerticalTextAlignment="Center" />
            </Border>
            
            <!-- Collection View -->
            <CollectionView
                x:Name="bookCollectionView"
                Grid.Row="1"
                Margin="0,8,0,0"
                BackgroundColor="Transparent"
                Footer="{OnPlatform iOS=''}"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsBusy, Converter={StaticResource negateBooleanConverter}}"
                ItemsSource="{Binding Books}"
                SelectionMode="None">
                <CollectionView.Resources>
                    <!-- Style for selected/unselected item background using DynamicResource -->
                    <Style x:Key="BookItemBorderStyle" TargetType="Border">
                        <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundColor}" />
                        <Style.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </CollectionView.Resources>
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical">
                        <LinearItemsLayout.ItemSpacing>
                            <OnPlatform x:TypeArguments="x:Double">
                                <On Platform="WinUI" Value="4" />
                                <On Platform="Default" Value="8" />
                            </OnPlatform>
                        </LinearItemsLayout.ItemSpacing>
                    </LinearItemsLayout>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="bible:BibleBookListViewItemModel">
                        <Grid Margin="16,0">
                            <Border
                                Style="{StaticResource BookItemBorderStyle}"
                                StrokeThickness="0"
                                Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                            Offset="0,2"
                                            Opacity="0.08"
                                            Radius="4" />
                                </Border.Shadow>
                                <Grid
                                    Padding="20,18"
                                    ColumnSpacing="12"
                                    MinimumHeightRequest="56"
                                    BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnBookItemTapped" />
                                    </Grid.GestureRecognizers>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    
                                    <Label
                                        Grid.Column="0"
                                        FontSize="16"
                                        HorizontalOptions="Fill"
                                        HorizontalTextAlignment="Start"
                                        InputTransparent="True"
                                        LineBreakMode="TailTruncation"
                                        Text="{Binding Name}"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <!-- Close Button -->
            <Border
                Grid.Row="2"
                Margin="16,8,16,16"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                            Offset="0,2"
                            Opacity="0.1"
                            Radius="4" />
                </Border.Shadow>
                <Button
                    x:Name="CloseButton"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    BorderColor="Transparent"
                    Command="{Binding CloseModalCommand}"
                    CornerRadius="12"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    HeightRequest="50"
                    Padding="20,0"
                    Text="CLOSE"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    VerticalOptions="Fill" />
            </Border>
            
            <!-- Busy Overlay -->
            <shared:BusyOverlay Grid.Row="0"
                                Grid.RowSpan="3"
                                IsVisible="{Binding IsBusy}" />
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>


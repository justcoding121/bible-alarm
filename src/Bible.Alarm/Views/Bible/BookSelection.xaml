<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Bible.BookSelection"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:bible="clr-namespace:Bible.Alarm.ViewModels.Bible"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:DataType="bible:BookSelectionViewModel"
    Title="Select Book">
    <ContentPage.Resources>
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
        
        <!-- Style for selected/unselected item background using DynamicResource -->
        <Style x:Key="BookItemBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundColor}" />
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource BackgroundColor}">
            <!-- MAIN LIST -->
            <Grid
                Margin="0"
                IsVisible="{Binding IsBusy, Converter={StaticResource negateBooleanConverter}}"
                RowSpacing="0">
                <!-- Enhanced Collection View -->
                <CollectionView
                    x:Name="bookCollectionView"
                    Margin="0,8,0,0"
                    BackgroundColor="Transparent"
                    Footer="{OnPlatform iOS=''}"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding Books}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical">
                            <LinearItemsLayout.ItemSpacing>
                                <OnPlatform x:TypeArguments="x:Double">
                                    <On Platform="WinUI" Value="4" />
                                    <On Platform="Default" Value="8" />
                                </OnPlatform>
                            </LinearItemsLayout.ItemSpacing>
                        </LinearItemsLayout>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="bible:BibleBookListViewItemModel">
                            <Grid Margin="16,0">
                                <Border
                                    Style="{StaticResource BookItemBorderStyle}"
                                    StrokeThickness="0"
                                    Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                                Offset="0,2"
                                                Opacity="0.08"
                                                Radius="4" />
                                    </Border.Shadow>
                                    <Grid
                                        Padding="20,18"
                                        ColumnSpacing="12"
                                        MinimumHeightRequest="56">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type bible:BookSelectionViewModel}}, Path=ChapterSelectionCommand}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Book Name -->
                                        <Label
                                            Grid.Column="0"
                                            FontSize="16"
                                            HorizontalOptions="Fill"
                                            HorizontalTextAlignment="Start"
                                            InputTransparent="True"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Name}"
                                            TextColor="{DynamicResource TextPrimaryColor}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            
            <!-- BUSY OVERLAY – appears only while IsBusy = true -->
            <Grid IsVisible="{Binding IsBusy}"
                  BackgroundColor="{DynamicResource BackgroundColor}"
                  ZIndex="999">
                <Grid VerticalOptions="Center" HorizontalOptions="Center">
                    <Frame BackgroundColor="{DynamicResource CardBackgroundColor}"
                           CornerRadius="16"
                           Padding="32"
                           HasShadow="True">
                        <ActivityIndicator IsRunning="True"
                                           IsVisible="True"
                                           IsEnabled="True"
                                           Color="{StaticResource PrimaryColor}"
                                           WidthRequest="60"
                                           HeightRequest="60"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center">
                            <ActivityIndicator.Scale>
                                <OnPlatform x:TypeArguments="x:Double">
                                    <OnPlatform.Platforms>
                                        <On Platform="iOS" Value="1.0" />
                                        <On Platform="Android" Value="1.0" />
                                        <On Platform="Win" Value="1.0" />
                                    </OnPlatform.Platforms>
                                </OnPlatform>
                            </ActivityIndicator.Scale>
                        </ActivityIndicator>
                    </Frame>
                </Grid>
            </Grid>
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>


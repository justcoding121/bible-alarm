<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="Bible.Alarm.Views.Bible.ChapterSelection"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:bible="clr-namespace:Bible.Alarm.ViewModels.Bible"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    x:DataType="bible:ChapterSelectionViewModel"
    NavigationPage.HasBackButton="False"
    NavigationPage.HasNavigationBar="False">
    <ContentPage.Resources>
        <converters:PlayStatusIconConverter x:Key="playStatusIconConverter" />
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <converters:IsSelectedColorConverter x:Key="isSelectedColorConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid BackgroundColor="White">
            <ActivityIndicator
                Grid.Row="0"
                HorizontalOptions="Center"
                IsEnabled="True"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Scale="0.5"
                VerticalOptions="Center"
                Color="SlateBlue">
                <ActivityIndicator.Scale>
                    <OnPlatform x:TypeArguments="x:Double">
                        <OnPlatform.Platforms>
                            <On Platform="iOS" Value="4.0" />
                            <On Platform="Android" Value="1.0" />
                            <On Platform="Win" Value="1.0" />
                        </OnPlatform.Platforms>
                    </OnPlatform>
                </ActivityIndicator.Scale>
            </ActivityIndicator>
            <Grid
                Grid.Row="0"
                Margin="{OnPlatform iOS='0,10,0,0'}"
                IsVisible="{Binding IsBusy, Converter={StaticResource negateBooleanConverter}}"
                RowSpacing="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    x:Name="BackButton"
                    Grid.Row="0"
                    Margin="{OnPlatform Default='0',
                                        iOS='0,18,0,0'}"
                    BackgroundColor="{OnPlatform Default='WhiteSmoke',
                                                 iOS='White'}"
                    HeightRequest="50"
                    HorizontalOptions="Fill"
                    MinimumHeightRequest="50">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="8*" />
                    </Grid.ColumnDefinitions>
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding BackCommand}" NumberOfTapsRequired="1" />
                    </Grid.GestureRecognizers>
                    <StackLayout
                        Grid.Column="0"
                        HorizontalOptions="Start"
                        VerticalOptions="Center">
                        <Label
                            Margin="5,0,0,0"
                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                            Style="{StaticResource MediumLabelStyle}"
                            Text="{x:Static fn:GlyphNames.Left}"
                            TextColor="Gray" />
                    </StackLayout>
                    <Label
                        Grid.Column="1"
                        HorizontalOptions="Fill"
                        HorizontalTextAlignment="Start"
                        TextColor="Black"
                        VerticalOptions="Center" />
                </Grid>
                <CollectionView
                    x:Name="chapterCollectionView"
                    Grid.Row="1"
                    BackgroundColor="White"
                    Footer="{OnPlatform iOS=''}"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding Chapters}"
                    SelectionMode="Single">
                    <CollectionView.Behaviors>
                        <behaviours:EventToCommandBehavior
                            Command="{Binding SetChapterCommand}"
                            EventArgsConverter="{StaticResource itemTappedConverter}"
                            EventName="SelectionChanged" />
                    </CollectionView.Behaviors>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="bible:BibleChapterListViewItemModel">
                                <Grid
                                    Padding="5,0,5,0"
                                    BackgroundColor="{Binding IsSelected, Converter={StaticResource isSelectedColorConverter}}"
                                    HeightRequest="45"
                                    HorizontalOptions="Fill">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="auto" />
                                    </Grid.ColumnDefinitions>
                                    <Label
                                        Grid.Column="0"
                                        Margin="10,0,0,0"
                                        HorizontalOptions="Fill"
                                        HorizontalTextAlignment="Start"
                                        Text="{Binding Title}"
                                        TextColor="Black"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                    <StackLayout
                                        Grid.Column="1"
                                        Margin="5,0,15,0"
                                        HorizontalOptions="Start"
                                        Orientation="Horizontal"
                                        VerticalOptions="Center">
                                        <ActivityIndicator
                                            HorizontalOptions="Center"
                                            IsEnabled="True"
                                            IsRunning="{Binding IsBusy}"
                                            IsVisible="{Binding IsBusy}"
                                            MinimumWidthRequest="45"
                                            Scale="0.5"
                                            VerticalOptions="Center"
                                            WidthRequest="45"
                                            Color="SlateBlue">
                                            <ActivityIndicator.Scale>
                                                <OnPlatform x:TypeArguments="x:Double">
                                                    <OnPlatform.Platforms>
                                                        <On Platform="iOS" Value="1.0" />
                                                        <On Platform="Android" Value="0.5" />
                                                        <On Platform="Win" Value="1.0" />
                                                    </OnPlatform.Platforms>
                                                </OnPlatform>
                                            </ActivityIndicator.Scale>
                                        </ActivityIndicator>
                                        <Button
                                            BackgroundColor="Transparent"
                                            BorderWidth="0"
                                            BorderColor="Transparent"
                                            Command="{Binding TogglePlayCommand}"
                                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                            HorizontalOptions="Start"
                                            MinimumWidthRequest="45"
                                            Text="{Binding Play, Converter={StaticResource playStatusIconConverter}}"
                                            TextColor="Gray"
                                            VerticalOptions="Center"
                                            WidthRequest="45" />
                                    </StackLayout>
                                </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </ContentPage.Content>
</ContentPage>
<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Bible.ChapterSelection"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:bible="clr-namespace:Bible.Alarm.ViewModels.Bible"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:DataType="bible:ChapterSelectionViewModel"
    Title="Select Chapter">
    <ContentPage.Resources>
        <converters:PlayStatusIconConverter x:Key="playStatusIconConverter" />
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
        
        <!-- Style for selected/unselected item background using DynamicResource -->
        <Style x:Key="ChapterItemBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundColor}" />
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource BackgroundColor}">
            <!-- MAIN LIST -->
            <Grid
                Margin="0"
                IsVisible="{Binding IsBusy, Converter={StaticResource negateBooleanConverter}}"
                RowSpacing="0">
                <!-- Enhanced Collection View -->
                <CollectionView
                    x:Name="chapterCollectionView"
                    Margin="0,8,0,0"
                    BackgroundColor="Transparent"
                    Footer="{OnPlatform iOS=''}"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding Chapters}"
                    SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical">
                            <LinearItemsLayout.ItemSpacing>
                                <OnPlatform x:TypeArguments="x:Double">
                                    <On Platform="WinUI" Value="4" />
                                    <On Platform="Default" Value="8" />
                                </OnPlatform>
                            </LinearItemsLayout.ItemSpacing>
                        </LinearItemsLayout>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="bible:BibleChapterListViewItemModel">
                            <Grid Margin="16,0">
                                <Border
                                    Style="{StaticResource ChapterItemBorderStyle}"
                                    StrokeThickness="0"
                                    Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                                Offset="0,2"
                                                Opacity="0.08"
                                                Radius="4" />
                                    </Border.Shadow>
                                    <Grid
                                        Padding="20,18"
                                        ColumnSpacing="12"
                                        MinimumHeightRequest="56">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type bible:ChapterSelectionViewModel}}, Path=SetChapterCommand}" CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Chapter Title -->
                                        <Label
                                            Grid.Column="0"
                                            FontSize="16"
                                            HorizontalOptions="Fill"
                                            HorizontalTextAlignment="Start"
                                            InputTransparent="True"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Title}"
                                            TextColor="{DynamicResource TextPrimaryColor}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                        
                                        <!-- Play Controls -->
                                        <HorizontalStackLayout
                                            Grid.Column="1"
                                            Spacing="8"
                                            HorizontalOptions="End"
                                            VerticalOptions="Center">
                                            <ActivityIndicator
                                                HorizontalOptions="Center"
                                                IsEnabled="True"
                                                IsRunning="{Binding IsBusy}"
                                                IsVisible="{Binding IsBusy}"
                                                MinimumWidthRequest="32"
                                                Scale="0.5"
                                                VerticalOptions="Center"
                                                WidthRequest="32"
                                                Color="{StaticResource PrimaryColor}">
                                                <ActivityIndicator.Scale>
                                                    <OnPlatform x:TypeArguments="x:Double">
                                                        <OnPlatform.Platforms>
                                                            <On Platform="iOS" Value="1.0" />
                                                            <On Platform="Android" Value="0.5" />
                                                            <On Platform="Win" Value="1.0" />
                                                        </OnPlatform.Platforms>
                                                    </OnPlatform>
                                                </ActivityIndicator.Scale>
                                            </ActivityIndicator>
                                            <Border
                                                BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                                HeightRequest="36"
                                                HorizontalOptions="End"
                                                StrokeThickness="0"
                                                VerticalOptions="Center"
                                                WidthRequest="36">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="18" />
                                                </Border.StrokeShape>
                                                <Button
                                                    BackgroundColor="Transparent"
                                                    BorderWidth="0"
                                                    BorderColor="Transparent"
                                                    Command="{Binding TogglePlayCommand}"
                                                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                    FontSize="16"
                                                    HorizontalOptions="Center"
                                                    MinimumWidthRequest="36"
                                                    Padding="0"
                                                    Text="{Binding Play, Converter={StaticResource playStatusIconConverter}}"
                                                    TextColor="{DynamicResource TextSecondaryColor}"
                                                    VerticalOptions="Center" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
            
            <!-- BUSY OVERLAY – appears only while IsBusy = true -->
            <Grid IsVisible="{Binding IsBusy}"
                  BackgroundColor="{DynamicResource BackgroundColor}"
                  ZIndex="999">
                <Grid VerticalOptions="Center" HorizontalOptions="Center">
                    <Frame BackgroundColor="{DynamicResource CardBackgroundColor}"
                           CornerRadius="16"
                           Padding="32"
                           HasShadow="True">
                        <ActivityIndicator IsRunning="True"
                                           IsVisible="True"
                                           IsEnabled="True"
                                           Color="{StaticResource PrimaryColor}"
                                           WidthRequest="60"
                                           HeightRequest="60"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center">
                            <ActivityIndicator.Scale>
                                <OnPlatform x:TypeArguments="x:Double">
                                    <OnPlatform.Platforms>
                                        <On Platform="iOS" Value="1.0" />
                                        <On Platform="Android" Value="1.0" />
                                        <On Platform="Win" Value="1.0" />
                                    </OnPlatform.Platforms>
                                </OnPlatform>
                            </ActivityIndicator.Scale>
                        </ActivityIndicator>
                    </Frame>
                </Grid>
            </Grid>
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>


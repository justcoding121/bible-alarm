<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Music.SongBookSelection"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:music="clr-namespace:Bible.Alarm.ViewModels.Music"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:shared="clr-namespace:Bible.Alarm.ViewModels.Shared"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:DataType="music:SongBookSelectionViewModel"
    Title="Select Song Book">
    <ContentPage.Resources>
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
    </ContentPage.Resources>
    <ContentPage.ToolbarItems>
        <ToolbarItem
            Order="Primary"
            Priority="0"
            Command="{Binding OpenModalCommand}">
            <ToolbarItem.IconImageSource>
                <FontImageSource
                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                    Glyph="{x:Static fn:GlyphNames.Language}"
                    Color="{StaticResource PrimaryColor}"
                    Size="24" />
            </ToolbarItem.IconImageSource>
        </ToolbarItem>
    </ContentPage.ToolbarItems>
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource BackgroundColor}">
            <ActivityIndicator
                Grid.Row="0"
                HorizontalOptions="Center"
                IsEnabled="True"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Scale="0.5"
                VerticalOptions="Center"
                Color="{StaticResource PrimaryColor}">
                <ActivityIndicator.Scale>
                    <OnPlatform x:TypeArguments="x:Double">
                        <OnPlatform.Platforms>
                            <On Platform="iOS" Value="4.0" />
                            <On Platform="Android" Value="1.0" />
                            <On Platform="Win" Value="1.0" />
                        </OnPlatform.Platforms>
                    </OnPlatform>
                </ActivityIndicator.Scale>
            </ActivityIndicator>
            <Grid
                Grid.Row="0"
                Margin="0"
                IsVisible="{Binding IsBusy, Converter={StaticResource negateBooleanConverter}}"
                RowSpacing="0">
                <!-- Enhanced Collection View -->
                <CollectionView
                    x:Name="songBooksCollectionView"
                    Margin="0,8,0,0"
                    BackgroundColor="Transparent"
                    Footer="{OnPlatform iOS=''}"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding SongBooks}"
                    SelectionMode="None">
                    <CollectionView.Resources>
                        <!-- Style for selected/unselected item background using DynamicResource -->
                        <Style x:Key="SongBookItemBorderStyle" TargetType="Border">
                            <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundColor}" />
                            <Style.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding IsSelected, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                    <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </CollectionView.Resources>
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical">
                            <LinearItemsLayout.ItemSpacing>
                                <OnPlatform x:TypeArguments="x:Double">
                                    <On Platform="WinUI" Value="4" />
                                    <On Platform="Default" Value="8" />
                                </OnPlatform>
                            </LinearItemsLayout.ItemSpacing>
                        </LinearItemsLayout>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="shared:PublicationListViewItemModel">
                            <Grid Margin="16,0">
                                <Border
                                    Style="{StaticResource SongBookItemBorderStyle}"
                                    StrokeThickness="0"
                                    Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                                Offset="0,2"
                                                Opacity="0.08"
                                                Radius="4" />
                                    </Border.Shadow>
                                    <Grid
                                        Padding="20,18"
                                        ColumnSpacing="12"
                                        MinimumHeightRequest="56"
                                        BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnSongBookItemTapped" />
                                        </Grid.GestureRecognizers>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Song Book Name -->
                                        <Label
                                            Grid.Column="0"
                                            FontSize="16"
                                            HorizontalOptions="Fill"
                                            HorizontalTextAlignment="Start"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Name}"
                                            TextColor="{DynamicResource TextPrimaryColor}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>


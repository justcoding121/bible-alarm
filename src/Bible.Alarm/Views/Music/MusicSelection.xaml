<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Music.MusicSelection"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels"
    xmlns:music="clr-namespace:Bible.Alarm.ViewModels.Music"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:DataType="music:MusicSelectionViewModel"
    Title="Select Music Type">
    <ContentPage.Resources>
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
        
        <!-- Style for selected/unselected item background using DynamicResource -->
        <Style x:Key="MusicTypeItemBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundColor}" />
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid BackgroundColor="{DynamicResource BackgroundColor}">
            <!-- MAIN LIST -->
            <Grid
                Margin="0"
                BackgroundColor="Transparent"
                RowSpacing="0">
                <!-- Enhanced Collection View -->
                <CollectionView
                    x:Name="musicTypesCollectionView"
                    Margin="0,8,0,0"
                    BackgroundColor="Transparent"
                    Footer="{OnPlatform iOS=''}"
                    HorizontalOptions="Fill"
                    ItemsSource="{Binding MusicTypes}"
                    SelectionMode="Single">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical">
                            <LinearItemsLayout.ItemSpacing>
                                <OnPlatform x:TypeArguments="x:Double">
                                    <On Platform="WinUI" Value="4" />
                                    <On Platform="Default" Value="8" />
                                </OnPlatform>
                            </LinearItemsLayout.ItemSpacing>
                        </LinearItemsLayout>
                    </CollectionView.ItemsLayout>
                    <CollectionView.Behaviors>
                        <behaviours:EventToCommandBehavior
                            Command="{Binding SongBookSelectionCommand}"
                            EventArgsConverter="{StaticResource itemTappedConverter}"
                            EventName="SelectionChanged" />
                    </CollectionView.Behaviors>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="music:MusicTypeListItemViewModel">
                            <Grid Margin="16,0">
                                <Border
                                    Style="{StaticResource MusicTypeItemBorderStyle}"
                                    StrokeThickness="0"
                                    Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="12" />
                                    </Border.StrokeShape>
                                    <Border.Shadow>
                                        <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                                Offset="0,2"
                                                Opacity="0.08"
                                                Radius="4" />
                                    </Border.Shadow>
                                    <Grid
                                        Padding="20,18"
                                        ColumnSpacing="12"
                                        MinimumHeightRequest="56">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        
                                        <!-- Music Type Name -->
                                        <Label
                                            Grid.Column="0"
                                            FontSize="16"
                                            HorizontalOptions="Fill"
                                            HorizontalTextAlignment="Start"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Name}"
                                            TextColor="{DynamicResource TextPrimaryColor}"
                                            VerticalOptions="Center"
                                            VerticalTextAlignment="Center" />
                                        
                                        <!-- Arrow Indicator -->
                                        <Border
                                            Grid.Column="1"
                                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                                            HeightRequest="32"
                                            HorizontalOptions="End"
                                            StrokeThickness="0"
                                            VerticalOptions="Center"
                                            WidthRequest="32">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="16" />
                                            </Border.StrokeShape>
                                            <Label
                                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                                FontSize="14"
                                                HorizontalOptions="Center"
                                                HorizontalTextAlignment="Center"
                                                Text="{x:Static fn:GlyphNames.Right}"
                                                TextColor="{DynamicResource TextSecondaryColor}"
                                                VerticalOptions="Center"
                                                VerticalTextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>


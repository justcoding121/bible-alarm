<?xml version="1.0" encoding="utf-8"?>

<ContentPage
    x:Class="Bible.Alarm.Views.Shared.RootPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    NavigationPage.HasNavigationBar="False">
    <Grid x:Name="RootGrid" RowDefinitions="*,Auto">
        <!-- Row 0: NavigationPage added in code-behind (Page is IView, not View) -->
        <!-- Row 1: MiniPlaybackBar slot -->
        <ContentView
            x:Name="MiniBarHost"
            Grid.Row="1"
            IsVisible="False" />
    </Grid>
</ContentPage>

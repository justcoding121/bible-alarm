<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="Bible.Alarm.Views.Shared.AnimatedProgressBar"
    x:Name="ProgressBarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Grid
        Margin="16,0,16,8"
        HeightRequest="6"
        BackgroundColor="Transparent">
        <!-- Track background -->
        <BoxView
            BackgroundColor="{DynamicResource ProgressBarBackgroundColor}"
            HeightRequest="2"
            CornerRadius="1"
            HorizontalOptions="Fill"
            VerticalOptions="Center" />
        <!-- Animated range segment - uses native MAUI animation for smooth movement -->
        <BoxView
            x:Name="AnimatedSegment"
            BackgroundColor="{StaticResource PrimaryColor}"
            HeightRequest="2"
            CornerRadius="1"
            VerticalOptions="Center"
            HorizontalOptions="Start"
            WidthRequest="120"
            PublicationX="0" />
    </Grid>
</ContentView>


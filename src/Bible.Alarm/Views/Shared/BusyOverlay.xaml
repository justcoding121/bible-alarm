<?xml version="1.0" encoding="utf-8"?>
<ContentView x:Class="Bible.Alarm.Views.Shared.BusyOverlay"
             x:Name="busyOverlay"
             x:DataType="local:BusyOverlay"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Bible.Alarm.Views.Shared"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
             xmlns:fn="clr-namespace:Bible.Alarm.Views"
             BackgroundColor="Transparent"
             ZIndex="999"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">
    <ContentView.Resources>
        <converters:BoolToOpacityConverter x:Key="boolToOpacityConverter" />
        <converters:DefaultTextConverter x:Key="defaultTextConverter" />
    </ContentView.Resources>
    <Grid x:Name="overlayGrid"
          IsVisible="True"
          Opacity="{Binding Source={x:Reference busyOverlay}, Path=IsVisible, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
          BackgroundColor="{DynamicResource BackgroundColor}"
          ZIndex="999"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        <!-- Card container for all overlay content -->
        <!-- Set explicit HeightRequest to prevent any resizing when content visibility changes -->
        <!-- Height calculation: 30 (text) + 8 (progress) + IconLargeContainerSize (spinner) + IconStandardContainerSize (button) + 48 (3*16 spacing) + 40 (20*2 padding) -->
        <!-- Using a fixed height ensures Border never resizes regardless of content visibility -->
        <!-- VerticalOptions="Center" with fixed height ensures consistent positioning -->
        <Border
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            StrokeThickness="0"
            Padding="24,20"
            MinimumWidthRequest="{DynamicResource ContentWidthLarge}"
            HeightRequest="230">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                        Offset="0,4"
                        Opacity="0.15"
                        Radius="12" />
            </Border.Shadow>
            <!-- Grid with fixed height to prevent measurement changes that cause Border repositioning -->
            <!-- Height: 30 (text) + 8 (progress) + 56 (spinner) + 48 (button) + 48 (3*16 spacing) = 190 -->
            <Grid
                HorizontalOptions="Center"
                VerticalOptions="Center"
                RowSpacing="16"
                HeightRequest="190">
                <Grid.RowDefinitions>
                    <!-- Row 0: Progress Text - fixed height -->
                    <RowDefinition Height="30" />
                    <!-- Row 1: Progress Bar - fixed height -->
                    <RowDefinition Height="8" />
                    <!-- Row 2: Busy Indicator - fixed height based on IconLargeContainerSize (56 base) -->
                    <RowDefinition Height="{DynamicResource IconLargeContainerSize}" />
                    <!-- Row 3: Cancel Button - fixed height based on IconStandardContainerSize (48 base) -->
                    <RowDefinition Height="{DynamicResource IconStandardContainerSize}" />
                </Grid.RowDefinitions>
                
                <!-- Row 0: Progress Text (shown when ShowProgress is true) -->
                <!-- Reserve space by using Opacity instead of IsVisible -->
                <!-- Use DefaultTextConverter to ensure Label always has content for consistent measurement -->
                <!-- Set explicit HeightRequest to match Grid row height for consistent measurement -->
                <Label
                    Grid.Row="0"
                    HeightRequest="30"
                    Opacity="{Binding Source={x:Reference busyOverlay}, Path=ShowProgress, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
                    Text="{Binding Source={x:Reference busyOverlay}, Path=ProgressText, Converter={StaticResource defaultTextConverter}, ConverterParameter=0%}"
                    FontSize="{DynamicResource LargeFontSize}"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextPrimaryColor}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
                
                <!-- Row 1: Progress Bar (shown when ShowProgress is true) -->
                <!-- Reserve space by using Opacity instead of IsVisible -->
                <ProgressBar
                    Grid.Row="1"
                    Opacity="{Binding Source={x:Reference busyOverlay}, Path=ShowProgress, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
                    WidthRequest="{DynamicResource ContentWidthSmall}"
                    HeightRequest="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Progress="{Binding Source={x:Reference busyOverlay}, Path=ProgressPercent}"
                    ProgressColor="{StaticResource PrimaryColor}" />
                
                <!-- Row 2: Busy Indicator -->
                <core:SfBusyIndicator
                    Grid.Row="2"
                    x:Name="busyIndicator"
                    IsRunning="{Binding Source={x:Reference busyOverlay}, Path=IsVisible}"
                    IsVisible="True"
                    Opacity="{Binding Source={x:Reference busyOverlay}, Path=IsVisible, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
                    AnimationType="DoubleCircle"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HeightRequest="{DynamicResource IconLargeContainerSize}"
                    WidthRequest="{DynamicResource IconLargeContainerSize}"
                    IndicatorColor="{StaticResource PrimaryColor}" />
                
                <!-- Row 3: Cancel Button (visible when ShowCancelButton is true) -->
                <!-- Reserve space by using Opacity instead of IsVisible -->
                <!-- Note: MAUI handles Opacity 0 elements correctly - they don't intercept touches -->
                <Border
                    Grid.Row="3"
                    x:Name="cancelButtonBorder"
                    Opacity="{Binding Source={x:Reference busyOverlay}, Path=ShowCancelButton, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
                    BackgroundColor="{DynamicResource ControlBackgroundColor}"
                    HeightRequest="{DynamicResource IconStandardContainerSize}"
                    WidthRequest="{DynamicResource IconStandardContainerSize}"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference busyOverlay}, Path=CancelCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="{x:Static fn:GlyphNames.Xmark}"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="{DynamicResource IconStandardFontSize}"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</ContentView>


<?xml version="1.0" encoding="utf-8"?>
<ContentView x:Class="Bible.Alarm.Views.Shared.BusyOverlay"
             x:Name="busyOverlay"
             x:DataType="local:BusyOverlay"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Bible.Alarm.Views.Shared"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
             xmlns:fn="clr-namespace:Bible.Alarm.Views"
             BackgroundColor="Transparent"
             ZIndex="999"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">
    <ContentView.Resources>
        <converters:BoolToOpacityConverter x:Key="boolToOpacityConverter" />
    </ContentView.Resources>
    <Grid x:Name="overlayGrid"
          IsVisible="True"
          Opacity="{Binding Source={x:Reference busyOverlay}, Path=IsVisible, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
          BackgroundColor="{DynamicResource BackgroundColor}"
          ZIndex="999"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        <!-- Card container for all overlay content -->
        <Border
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            StrokeThickness="0"
            Padding="24,20"
            MinimumWidthRequest="{DynamicResource ContentWidthLarge}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                        Offset="0,4"
                        Opacity="0.15"
                        Radius="12" />
            </Border.Shadow>
            <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="16">
                <!-- Row 1: Progress Text (shown when ShowProgress is true) -->
                <Label
                    IsVisible="{Binding Source={x:Reference busyOverlay}, Path=ShowProgress}"
                    Text="{Binding Source={x:Reference busyOverlay}, Path=ProgressText}"
                    FontSize="{DynamicResource LargeFontSize}"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextPrimaryColor}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center" />
                <!-- Row 2: Progress Bar (shown when ShowProgress is true) -->
                <ProgressBar
                    IsVisible="{Binding Source={x:Reference busyOverlay}, Path=ShowProgress}"
                    WidthRequest="{DynamicResource ContentWidthSmall}"
                    HorizontalOptions="Center"
                    Progress="{Binding Source={x:Reference busyOverlay}, Path=ProgressPercent}"
                    ProgressColor="{StaticResource PrimaryColor}" />
                <!-- Row 3: Busy Indicator -->
                <core:SfBusyIndicator
                    x:Name="busyIndicator"
                    IsRunning="{Binding Source={x:Reference busyOverlay}, Path=IsVisible}"
                    IsVisible="True"
                    Opacity="{Binding Source={x:Reference busyOverlay}, Path=IsVisible, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
                    AnimationType="DoubleCircle"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HeightRequest="{DynamicResource IconLargeContainerSize}"
                    WidthRequest="{DynamicResource IconLargeContainerSize}"
                    IndicatorColor="{StaticResource PrimaryColor}" />
                <!-- Row 4: Cancel Button (visible when ShowCancelButton is true) -->
                <Border x:Name="cancelButtonBorder"
                    IsVisible="{Binding Source={x:Reference busyOverlay}, Path=ShowCancelButton}"
                    BackgroundColor="{DynamicResource ControlBackgroundColor}"
                    HeightRequest="{DynamicResource IconStandardContainerSize}"
                    WidthRequest="{DynamicResource IconStandardContainerSize}"
                    StrokeThickness="0"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="100" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding Source={x:Reference busyOverlay}, Path=CancelCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        Text="{x:Static fn:GlyphNames.Xmark}"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="{DynamicResource IconStandardFontSize}"
                        TextColor="{DynamicResource TextSecondaryColor}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentView>


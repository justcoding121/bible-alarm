<?xml version="1.0" encoding="utf-8"?>
<ContentView x:Class="Bible.Alarm.Views.Shared.BusyOverlay"
             x:Name="busyOverlay"
             x:DataType="local:BusyOverlay"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:Bible.Alarm.Views.Shared"
             xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
             xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
             xmlns:fn="clr-namespace:Bible.Alarm.Views"
             BackgroundColor="Transparent"
             ZIndex="999"
             Margin="0"
             HorizontalOptions="Fill"
             VerticalOptions="Fill">
    <ContentView.Resources>
        <converters:BoolToOpacityConverter x:Key="boolToOpacityConverter" />
        <converters:DefaultTextConverter x:Key="defaultTextConverter" />
    </ContentView.Resources>
    <Grid x:Name="overlayGrid"
          IsVisible="True"
          Opacity="{Binding Source={x:Reference busyOverlay}, Path=IsVisible, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
          BackgroundColor="{DynamicResource BackgroundColor}"
          ZIndex="999"
          Margin="0"
          HorizontalOptions="Fill"
          VerticalOptions="Fill">
        <!-- Card container for all overlay content -->
        <Border
            HorizontalOptions="Center"
            VerticalOptions="Center"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            StrokeThickness="0"
            Padding="24,20"
            MinimumWidthRequest="{DynamicResource ContentWidthLarge}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Border.Shadow>
                <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                        Offset="0,4"
                        Opacity="0.15"
                        Radius="12" />
            </Border.Shadow>
            <Grid HorizontalOptions="Center" VerticalOptions="Center" RowSpacing="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="30" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="{DynamicResource IconLargeContainerSize}" />
                    <RowDefinition Height="{DynamicResource IconStandardContainerSize}" />
                </Grid.RowDefinitions>

                <!-- Progress state -->
                <Label
                    Grid.Row="0"
                    HeightRequest="30"
                    Opacity="{Binding Source={x:Reference busyOverlay}, Path=ShowProgress, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
                    Text="{Binding Source={x:Reference busyOverlay}, Path=ProgressText, Converter={StaticResource defaultTextConverter}, ConverterParameter=0%}"
                    FontSize="{DynamicResource LargeFontSize}"
                    FontAttributes="Bold"
                    TextColor="{DynamicResource TextPrimaryColor}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HorizontalTextAlignment="Center"
                    VerticalTextAlignment="Center" />
                <ProgressBar
                    Grid.Row="1"
                    Opacity="{Binding Source={x:Reference busyOverlay}, Path=ShowProgress, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
                    WidthRequest="{DynamicResource ContentWidthSmall}"
                    HeightRequest="8"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Progress="{Binding Source={x:Reference busyOverlay}, Path=ProgressPercent}"
                    ProgressColor="{StaticResource PrimaryColor}" />
                <core:SfBusyIndicator
                    Grid.Row="2"
                    x:Name="busyIndicator"
                    IsRunning="{Binding Source={x:Reference busyOverlay}, Path=IsSpinnerRunning}"
                    IsVisible="True"
                    Opacity="{Binding Source={x:Reference busyOverlay}, Path=IsVisible, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
                    AnimationType="DoubleCircle"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HeightRequest="{DynamicResource IconStandardContainerSize}"
                    WidthRequest="{DynamicResource IconStandardContainerSize}"
                    IndicatorColor="{StaticResource PrimaryColor}" />

                <!-- Row 3: Cancel (when ShowProgress) -->
                <HorizontalStackLayout
                    Grid.Row="3"
                    HorizontalOptions="Center"
                    Spacing="24">
                    <!-- Cancel Button -->
                    <Border
                        Opacity="{Binding Source={x:Reference busyOverlay}, Path=ShowCancelButton, Converter={StaticResource boolToOpacityConverter}, Mode=OneWay}"
                        BackgroundColor="{DynamicResource ControlBackgroundColor}"
                        HeightRequest="{DynamicResource IconStandardContainerSize}"
                        WidthRequest="{DynamicResource IconStandardContainerSize}"
                        StrokeThickness="0"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="100" />
                        </Border.StrokeShape>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={x:Reference busyOverlay}, Path=CancelCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            Text="{x:Static fn:GlyphNames.Xmark}"
                            FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                            FontSize="{DynamicResource IconStandardFontSize}"
                            TextColor="{DynamicResource TextSecondaryColor}"
                            HorizontalOptions="Center"
                            VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>


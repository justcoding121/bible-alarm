<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="Bible.Alarm.Views.Shared.MiniPlaybackBar"
    x:Name="MiniBarView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:vm="clr-namespace:Bible.Alarm.ViewModels.Shared"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    x:DataType="vm:MiniPlaybackBarViewModel"
    BackgroundColor="{DynamicResource CardBackgroundColor}">
    <ContentView.Resources>
        <converters:IsNullConverter x:Key="isNullConverter" />
    </ContentView.Resources>
    <Grid RowDefinitions="Auto,Auto">

        <!-- Row 0: Thin progress bar at top edge (tappable to maximize) -->
        <ProgressBar
            Grid.Row="0"
            Progress="{Binding Progress}"
            ProgressColor="{StaticResource PrimaryColor}"
            BackgroundColor="{DynamicResource ProgressBarBackgroundColor}"
            HeightRequest="3"
            VerticalOptions="Start"
            HorizontalOptions="Fill">
            <ProgressBar.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding MaximizeCommand}" />
            </ProgressBar.GestureRecognizers>
        </ProgressBar>

        <!-- Row 1: Controls row -->
        <Grid
            Grid.Row="1"
            ColumnDefinitions="56,*,48,48,52,48,48"
            Padding="8,12,8,12"
            ColumnSpacing="2"
            VerticalOptions="Center"
            HorizontalOptions="Fill">

            <!-- Small artwork (tappable to maximize) -->
            <Border
                Grid.Column="0"
                StrokeThickness="0"
                HeightRequest="48"
                WidthRequest="48"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                BackgroundColor="{DynamicResource ControlBackgroundColor}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="4" />
                </Border.StrokeShape>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding MaximizeCommand}" />
                </Border.GestureRecognizers>
                <Grid>
                    <ActivityIndicator
                        IsRunning="{Binding IsArtworkLoading}"
                        IsVisible="{Binding IsArtworkLoading}"
                        HeightRequest="20"
                        WidthRequest="20"
                        Color="{DynamicResource PrimaryTextColor}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center" />
                    <Label
                        IsVisible="{Binding ShowArtworkFallback}"
                        FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                        FontSize="18"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Text="{x:Static fn:GlyphNames.Bell}"
                        TextColor="{DynamicResource PrimaryTextColor}" />
                    <Image
                        Aspect="AspectFill"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        Source="{Binding ArtworkSource}" />
                </Grid>
            </Border>

            <!-- Title (tappable to maximize) -->
            <Label
                Grid.Column="1"
                Text="{Binding Title}"
                TextColor="{DynamicResource TextPrimaryColor}"
                FontSize="{DynamicResource SmallFontSize}"
                LineBreakMode="TailTruncation"
                MaxLines="1"
                VerticalOptions="Center"
                Margin="4,0,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding MaximizeCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <!-- Stop / Stopping spinner -->
            <Grid
                Grid.Column="2"
                HeightRequest="48"
                WidthRequest="48"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Button
                    Padding="0"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Command="{Binding StopCommand}"
                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                    FontSize="18"
                    Text="{x:Static fn:GlyphNames.Xmark}"
                    TextColor="{StaticResource ErrorColor}"
                    HeightRequest="48"
                    WidthRequest="48"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsStopping, Converter={StaticResource negateBooleanConverter}}" />
                <ActivityIndicator
                    IsRunning="{Binding IsStopping}"
                    IsVisible="{Binding IsStopping}"
                    HeightRequest="20"
                    WidthRequest="20"
                    Color="{StaticResource ErrorColor}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Previous / Previous spinner -->
            <Grid
                Grid.Column="3"
                HeightRequest="48"
                WidthRequest="48"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Button
                    Padding="0"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Command="{Binding PreviousCommand}"
                    IsEnabled="{Binding IsPreviousEnabled}"
                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                    FontSize="18"
                    Text="{x:Static fn:GlyphNames.Previous}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    HeightRequest="48"
                    WidthRequest="48"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="{Binding ShowPreviousButton}">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                        </Trigger>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
                <ActivityIndicator
                    IsRunning="{Binding IsPreviousBusy}"
                    IsVisible="{Binding IsPreviousBusy}"
                    HeightRequest="20"
                    WidthRequest="20"
                    Color="{DynamicResource PrimaryTextColor}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Play/Pause -->
            <Grid
                Grid.Column="4"
                HeightRequest="44"
                WidthRequest="44"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Button
                    Padding="0"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    BorderWidth="0"
                    Command="{Binding PlayPauseCommand}"
                    IsEnabled="{Binding AreControlsEnabled}"
                    IsVisible="{Binding PlayVisible}"
                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                    FontSize="18"
                    Text="{x:Static fn:GlyphNames.Play}"
                    TextColor="White"
                    HeightRequest="44"
                    WidthRequest="44"
                    CornerRadius="22"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource DisabledTextColor}" />
                        </Trigger>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
                <Button
                    Padding="0"
                    BackgroundColor="{StaticResource PrimaryColor}"
                    BorderWidth="0"
                    Command="{Binding PlayPauseCommand}"
                    IsEnabled="{Binding AreControlsEnabled}"
                    IsVisible="{Binding PauseVisible}"
                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                    FontSize="18"
                    Text="{x:Static fn:GlyphNames.Pause}"
                    TextColor="White"
                    HeightRequest="44"
                    WidthRequest="44"
                    CornerRadius="22"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                            <Setter Property="BackgroundColor" Value="{DynamicResource DisabledTextColor}" />
                        </Trigger>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                            <Setter Property="TextColor" Value="White" />
                            <Setter Property="BackgroundColor" Value="{StaticResource PrimaryColor}" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
            </Grid>

            <!-- Next / Next spinner -->
            <Grid
                Grid.Column="5"
                HeightRequest="48"
                WidthRequest="48"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Button
                    Padding="0"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Command="{Binding NextCommand}"
                    IsEnabled="{Binding IsNextEnabled}"
                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                    FontSize="18"
                    Text="{x:Static fn:GlyphNames.Next}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    HeightRequest="48"
                    WidthRequest="48"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="{Binding ShowNextButton}">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                        </Trigger>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
                <ActivityIndicator
                    IsRunning="{Binding IsNextBusy}"
                    IsVisible="{Binding IsNextBusy}"
                    HeightRequest="20"
                    WidthRequest="20"
                    Color="{DynamicResource PrimaryTextColor}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>

            <!-- Maximize / Maximizing spinner -->
            <Grid
                Grid.Column="6"
                HeightRequest="48"
                WidthRequest="48"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                <Button
                    Padding="0"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Command="{Binding MaximizeCommand}"
                    IsEnabled="{Binding AreControlsEnabled}"
                    FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                    FontSize="18"
                    Text="{x:Static fn:GlyphNames.ChevronUp}"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    HeightRequest="48"
                    WidthRequest="48"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    IsVisible="{Binding ShowMaximizeButton}">
                    <Button.Triggers>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="False">
                            <Setter Property="TextColor" Value="{DynamicResource DisabledTextColor}" />
                        </Trigger>
                        <Trigger TargetType="Button" Property="IsEnabled" Value="True">
                            <Setter Property="TextColor" Value="{DynamicResource PrimaryTextColor}" />
                        </Trigger>
                    </Button.Triggers>
                </Button>
                <ActivityIndicator
                    IsRunning="{Binding IsMaximizeBusy}"
                    IsVisible="{Binding IsMaximizeBusy}"
                    HeightRequest="20"
                    WidthRequest="20"
                    Color="{DynamicResource PrimaryTextColor}"
                    HorizontalOptions="Center"
                    VerticalOptions="Center" />
            </Grid>
        </Grid>
    </Grid>
</ContentView>

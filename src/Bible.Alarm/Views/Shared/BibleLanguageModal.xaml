<?xml version="1.0" encoding="utf-8"?>

<views:BaseContentPage
    x:Class="Bible.Alarm.Views.Shared.BibleLanguageModal"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:ios="clr-namespace:Microsoft.Maui.Controls.PlatformConfiguration.iOSSpecific;assembly=Microsoft.Maui.Controls"
    xmlns:bible="clr-namespace:Bible.Alarm.ViewModels.Bible"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    xmlns:behaviours="clr-namespace:Bible.Alarm.Common.ViewHelpers.Behaviours"
    xmlns:shared="clr-namespace:Bible.Alarm.ViewModels.Shared"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:system="clr-namespace:System;assembly=System.Runtime"
    x:DataType="bible:BibleSelectionViewModel"
    Padding="0,0,0,0">
    <ContentPage.Resources>
        <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" />
        <converters:NegateBooleanConverter x:Key="negateBooleanConverter" />
        <!-- Theme-aware colors are inherited from BaseContentPage -->
        
        <!-- Style for selected/unselected item background using DynamicResource -->
        <Style x:Key="LanguageItemBorderStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{DynamicResource CardBackgroundColor}" />
            <Style.Triggers>
                <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BackgroundColor" Value="{DynamicResource SelectedItemBackgroundColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </ContentPage.Resources>
    <ContentPage.Content>
        <Grid
            Margin="{OnPlatform Default='0', iOS='0,44,0,0', Android='0,24,0,0'}"
            BackgroundColor="{DynamicResource BackgroundColor}"
            ColumnSpacing="0"
            RowSpacing="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="auto" />
            </Grid.RowDefinitions>
            
            <ActivityIndicator
                Grid.Row="0"
                Grid.RowSpan="4"
                HorizontalOptions="Center"
                IsEnabled="True"
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                VerticalOptions="Center"
                Color="{StaticResource PrimaryColor}">
                <ActivityIndicator.Scale>
                    <OnPlatform x:TypeArguments="x:Double">
                        <OnPlatform.Platforms>
                            <On Platform="iOS" Value="4.0" />
                            <On Platform="Android" Value="1.0" />
                            <On Platform="Win" Value="1.0" />
                        </OnPlatform.Platforms>
                    </OnPlatform>
                </ActivityIndicator.Scale>
            </ActivityIndicator>
            
            <!-- Enhanced Header -->
            <Border
                Grid.Row="0"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="20,16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="0,0,20,20" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                            Offset="0,4"
                            Opacity="0.1"
                            Radius="8" />
                </Border.Shadow>
                <Label
                    FontSize="18"
                    FontAttributes="Bold"
                    HeightRequest="56"
                    Text="Languages"
                    TextColor="{DynamicResource TextPrimaryColor}"
                    VerticalOptions="Fill"
                    VerticalTextAlignment="Center" />
            </Border>
            
            <!-- Enhanced Search Bar -->
            <!-- iOS: SearchBar without Border wrapper to avoid double-border effect -->
            <SearchBar
                Grid.Row="1"
                Margin="16,8,16,0"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                HeightRequest="50"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Start"
                MinimumHeightRequest="50"
                Placeholder="Search languages"
                Text="{Binding LanguageSearchTerm, Mode=TwoWay}"
                TextColor="{DynamicResource TextPrimaryColor}"
                CancelButtonColor="Transparent"
                IsVisible="{OnPlatform iOS='True', Default='False'}" />
            <!-- Non-iOS: SearchBar with Border wrapper for styling -->
            <Border
                Grid.Row="1"
                Margin="16,8,16,0"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="0"
                IsVisible="{OnPlatform iOS='False', Default='True'}">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                            Offset="0,2"
                            Opacity="0.08"
                            Radius="4" />
                </Border.Shadow>
                <SearchBar
                    Margin="8"
                    BackgroundColor="Transparent"
                    HeightRequest="50"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Start"
                    MinimumHeightRequest="50"
                    Placeholder="Search languages"
                    Text="{Binding LanguageSearchTerm, Mode=TwoWay}"
                    TextColor="{DynamicResource TextPrimaryColor}"
                    CancelButtonColor="{DynamicResource TextPrimaryColor}" />
            </Border>
            
            <!-- Enhanced Collection View -->
            <CollectionView
                x:Name="LanguageCollectionView"
                Grid.Row="2"
                Margin="0,8,0,0"
                BackgroundColor="Transparent"
                Footer="{OnPlatform iOS=''}"
                HorizontalOptions="Fill"
                IsVisible="{Binding IsBusy, Converter={StaticResource negateBooleanConverter}}"
                ItemsSource="{Binding Languages}"
                MinimumHeightRequest="300"
                MinimumWidthRequest="250"
                SelectionMode="Single">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical">
                        <LinearItemsLayout.ItemSpacing>
                            <OnPlatform x:TypeArguments="x:Double">
                                <On Platform="WinUI" Value="4" />
                                <On Platform="Default" Value="8" />
                            </OnPlatform>
                        </LinearItemsLayout.ItemSpacing>
                    </LinearItemsLayout>
                </CollectionView.ItemsLayout>
                <CollectionView.Behaviors>
                    <behaviours:EventToCommandBehavior
                        Command="{Binding SelectLanguageCommand}"
                        EventArgsConverter="{StaticResource itemTappedConverter}"
                        EventName="SelectionChanged" />
                </CollectionView.Behaviors>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="shared:LanguageListViewItemModel">
                        <Grid Margin="16,0">
                            <Border
                                Style="{StaticResource LanguageItemBorderStyle}"
                                StrokeThickness="0"
                                Padding="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Border.Shadow>
                                    <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                                            Offset="0,2"
                                            Opacity="0.08"
                                            Radius="4" />
                                </Border.Shadow>
                                <Grid
                                    Padding="20,18"
                                    HorizontalOptions="Fill"
                                    MinimumHeightRequest="56">
                                    <Label
                                        FontSize="16"
                                        HorizontalOptions="Start"
                                        HorizontalTextAlignment="Start"
                                        Text="{Binding Name}"
                                        TextColor="{DynamicResource TextPrimaryColor}"
                                        VerticalOptions="Center"
                                        VerticalTextAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
            
            <!-- Enhanced Close Button -->
            <Border
                Grid.Row="3"
                Margin="16,8,16,16"
                BackgroundColor="{DynamicResource CardBackgroundColor}"
                StrokeThickness="0"
                Padding="0">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>
                <Border.Shadow>
                    <Shadow Brush="{AppThemeBinding Light=#E0E0E0, Dark=#000000}"
                            Offset="0,2"
                            Opacity="0.1"
                            Radius="4" />
                </Border.Shadow>
                <Button
                    x:Name="CloseButton"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    BorderColor="Transparent"
                    Command="{Binding CloseModalCommand}"
                    CornerRadius="12"
                    FontSize="16"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    HeightRequest="50"
                    Padding="20,0"
                    Text="CLOSE"
                    TextColor="{DynamicResource PrimaryTextColor}"
                    VerticalOptions="Fill" />
            </Border>
        </Grid>
    </ContentPage.Content>
</views:BaseContentPage>


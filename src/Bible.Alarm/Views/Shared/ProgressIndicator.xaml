<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="Bible.Alarm.Views.Shared.ProgressIndicator"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    ZIndex="1000">
    <ContentView.Resources>
        <converters:MultiBoolOrConverter x:Key="multiBoolOrConverter" />
    </ContentView.Resources>
    <ContentView.InputTransparent>
        <MultiBinding Converter="{StaticResource multiBoolOrConverter}" ConverterParameter="Inverse" Mode="OneWay">
            <Binding Path="ShowProgress" FallbackValue="False" />
            <Binding Path="IsBusy" FallbackValue="False" />
        </MultiBinding>
    </ContentView.InputTransparent>
    <!-- Outer Grid visible when ShowProgress or IsBusy is true -->
    <Grid>
        <Grid.IsVisible>
            <MultiBinding Converter="{StaticResource multiBoolOrConverter}" Mode="OneWay">
                <Binding Path="ShowProgress" FallbackValue="False" />
                <Binding Path="IsBusy" FallbackValue="False" />
            </MultiBinding>
        </Grid.IsVisible>
        <!-- Opaque background overlay (blocks content underneath) -->
        <BoxView BackgroundColor="{DynamicResource BackgroundColor}"
                 Opacity="1"
                 InputTransparent="False" />
        <!-- Single card: progress (percent, bar, spinner, Cancel) -->
        <Border
            HorizontalOptions="Center"
            VerticalOptions="Center"
            InputTransparent="False"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            StrokeThickness="0"
            Padding="{DynamicResource PaddingThickness24_20}"
            MinimumWidthRequest="{DynamicResource ContentWidthLarge}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Grid
                HorizontalOptions="Center"
                VerticalOptions="Center"
                RowSpacing="12"
                WidthRequest="{DynamicResource ContentWidthMedium}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Row 0: Progress percent - only when fetch was decided (ShowProgress), not for DB-only load -->
                <Label Grid.Row="0"
                    FontSize="{DynamicResource LargeFontSize}"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    Text="{Binding ProgressText}"
                    TextColor="{DynamicResource TextPrimaryColor}"
                    MinimumHeightRequest="{DynamicResource IconStandardContainerSize}"
                    IsVisible="{Binding ShowProgress, FallbackValue=False}" />
                <!-- Row 1: Progress bar - only when fetch was decided (ShowProgress), not for DB-only load -->
                <ProgressBar Grid.Row="1"
                    Margin="{DynamicResource MarginThickness10_5}"
                    WidthRequest="{DynamicResource ContentWidthSmall}"
                    HorizontalOptions="Center"
                    Progress="{Binding ProgressPercent}"
                    ProgressColor="{StaticResource PrimaryColor}"
                    IsVisible="{Binding ShowProgress, FallbackValue=False}" />
                <!-- Row 2: Spinner - visible when ShowProgress OR IsBusy -->
                <Grid Grid.Row="2"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HeightRequest="{DynamicResource SpinnerContainerSize}"
                    WidthRequest="{DynamicResource SpinnerContainerSize}"
                    Margin="0,8,0,0">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{StaticResource multiBoolOrConverter}" Mode="OneWay">
                            <Binding Path="ShowProgress" FallbackValue="False" />
                            <Binding Path="IsBusy" FallbackValue="False" />
                        </MultiBinding>
                    </Grid.IsVisible>
                    <ActivityIndicator
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        HeightRequest="{DynamicResource SpinnerContainerSize}"
                        WidthRequest="{DynamicResource SpinnerContainerSize}"
                        Color="{DynamicResource TextSecondaryColor}">
                        <ActivityIndicator.IsRunning>
                            <MultiBinding Converter="{StaticResource multiBoolOrConverter}" Mode="OneWay">
                                <Binding Path="ShowProgress" FallbackValue="False" />
                                <Binding Path="IsBusy" FallbackValue="False" />
                            </MultiBinding>
                        </ActivityIndicator.IsRunning>
                    </ActivityIndicator>
                </Grid>
                <!-- Row 3: Cancel (when progress) -->
                <HorizontalStackLayout Grid.Row="3"
                    HorizontalOptions="Center"
                    Spacing="24"
                    Margin="0,12,0,0">
                    <!-- Cancel Button (when ShowProgress with CanCancelFetch) -->
                    <Grid
                        IsVisible="{Binding ShowCancelButton, FallbackValue=False}"
                        HeightRequest="{DynamicResource IconStandardContainerSize}"
                        WidthRequest="{DynamicResource IconStandardContainerSize}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Border
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            HeightRequest="{DynamicResource IconStandardContainerSize}"
                            WidthRequest="{DynamicResource IconStandardContainerSize}"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="100" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelFetchCommand}" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="{x:Static fn:GlyphNames.Xmark}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="{DynamicResource IconStandardFontSize}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsCancelBusy, Converter={StaticResource negateBooleanConverter}, FallbackValue=True}" />
                        </Border>
                        <ActivityIndicator
                            IsRunning="{Binding IsCancelBusy, FallbackValue=False}"
                            IsVisible="{Binding IsCancelBusy, FallbackValue=False}"
                            Color="{DynamicResource TextSecondaryColor}"
                            WidthRequest="{DynamicResource SpinnerFontSize}"
                            HeightRequest="{DynamicResource SpinnerFontSize}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Opacity="0.95" />
                    </Grid>
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>

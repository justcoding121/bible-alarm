<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="Bible.Alarm.Views.Shared.ProgressIndicator"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core"
    xmlns:fn="clr-namespace:Bible.Alarm.Views"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters"
    ZIndex="1000">
    <ContentView.Resources>
        <converters:MultiBoolOrConverter x:Key="multiBoolOrConverter" />
        <converters:SpinnerVisibleConverter x:Key="spinnerVisibleConverter" />
    </ContentView.Resources>
    <ContentView.InputTransparent>
        <MultiBinding Converter="{StaticResource multiBoolOrConverter}" ConverterParameter="Inverse" Mode="OneWay">
            <Binding Path="ShowProgress" FallbackValue="False" />
            <Binding Path="HasFetchError" FallbackValue="False" />
            <Binding Path="IsBusy" FallbackValue="False" />
        </MultiBinding>
    </ContentView.InputTransparent>
    <!-- Outer Grid visible when ShowProgress, HasFetchError, or IsBusy is true -->
    <Grid>
        <Grid.IsVisible>
            <MultiBinding Converter="{StaticResource multiBoolOrConverter}" Mode="OneWay">
                <Binding Path="ShowProgress" FallbackValue="False" />
                <Binding Path="HasFetchError" FallbackValue="False" />
                <Binding Path="IsBusy" FallbackValue="False" />
            </MultiBinding>
        </Grid.IsVisible>
        <!-- Opaque background overlay (blocks content underneath) -->
        <BoxView BackgroundColor="{DynamicResource BackgroundColor}"
                 Opacity="1"
                 InputTransparent="False" />
        <!-- Single card: progress (percent, bar, spinner, Cancel) or error (message, Retry, Cancel) -->
        <Border
            HorizontalOptions="Center"
            VerticalOptions="Center"
            InputTransparent="False"
            BackgroundColor="{DynamicResource CardBackgroundColor}"
            StrokeThickness="0"
            Padding="{DynamicResource PaddingThickness24_20}"
            MinimumWidthRequest="{DynamicResource ContentWidthLarge}">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="16" />
            </Border.StrokeShape>
            <Grid
                HorizontalOptions="Center"
                VerticalOptions="Center"
                RowSpacing="12"
                WidthRequest="{DynamicResource ContentWidthMedium}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Row 0: Progress percent (only when fetch in progress) OR error message (on failure) -->
                <Label Grid.Row="0"
                    FontSize="{DynamicResource LargeFontSize}"
                    FontAttributes="Bold"
                    HorizontalOptions="Fill"
                    HorizontalTextAlignment="Center"
                    Text="{Binding ProgressText}"
                    TextColor="{DynamicResource TextPrimaryColor}"
                    MinimumHeightRequest="{DynamicResource IconStandardContainerSize}"
                    IsVisible="{Binding ShowProgress, FallbackValue=False}" />
                <Label Grid.Row="0"
                    FontSize="{DynamicResource MediumFontSize}"
                    HorizontalOptions="Center"
                    HorizontalTextAlignment="Center"
                    TextColor="#FF6B6B"
                    Text="Network error. Please check your internet connection."
                    LineBreakMode="WordWrap"
                    IsVisible="{Binding HasFetchError, FallbackValue=False}" />
                <!-- Row 1: Progress bar (hidden when error) -->
                <ProgressBar Grid.Row="1"
                    Margin="{DynamicResource MarginThickness10_5}"
                    WidthRequest="{DynamicResource ContentWidthSmall}"
                    HorizontalOptions="Center"
                    Progress="{Binding ProgressPercent}"
                    ProgressColor="{StaticResource PrimaryColor}"
                    IsVisible="{Binding ShowProgress, FallbackValue=False}" />
                <!-- Row 2: Spinner (hidden when error) - visible when (ShowProgress OR IsBusy) AND !HasFetchError -->
                <Grid Grid.Row="2"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    HeightRequest="{DynamicResource IconStandardContainerSize}"
                    WidthRequest="{DynamicResource IconStandardContainerSize}"
                    Margin="0,8,0,0">
                    <Grid.IsVisible>
                        <MultiBinding Converter="{StaticResource spinnerVisibleConverter}" Mode="OneWay">
                            <Binding Path="ShowProgress" FallbackValue="False" />
                            <Binding Path="IsBusy" FallbackValue="False" />
                            <Binding Path="HasFetchError" FallbackValue="False" />
                        </MultiBinding>
                    </Grid.IsVisible>
                    <core:SfBusyIndicator
                        AnimationType="DoubleCircle"
                        HorizontalOptions="Fill"
                        VerticalOptions="Fill"
                        HeightRequest="{DynamicResource IconStandardContainerSize}"
                        WidthRequest="{DynamicResource IconStandardContainerSize}"
                        IndicatorColor="{StaticResource PrimaryColor}">
                        <core:SfBusyIndicator.IsRunning>
                            <MultiBinding Converter="{StaticResource spinnerVisibleConverter}" Mode="OneWay">
                                <Binding Path="ShowProgress" FallbackValue="False" />
                                <Binding Path="IsBusy" FallbackValue="False" />
                                <Binding Path="HasFetchError" FallbackValue="False" />
                            </MultiBinding>
                        </core:SfBusyIndicator.IsRunning>
                    </core:SfBusyIndicator>
                </Grid>
                <!-- Row 3: Retry (when error) + Cancel (when progress or error) -->
                <HorizontalStackLayout Grid.Row="3"
                    HorizontalOptions="Center"
                    Spacing="24"
                    Margin="0,12,0,0">
                    <!-- Retry Button (left of Cancel, only when HasFetchError; same size as Cancel) -->
                    <Grid
                        IsVisible="{Binding HasFetchError, FallbackValue=False}"
                        HeightRequest="{DynamicResource IconStandardContainerSize}"
                        WidthRequest="{DynamicResource IconStandardContainerSize}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Border
                            BackgroundColor="{StaticResource PrimaryColor}"
                            HeightRequest="{DynamicResource IconStandardContainerSize}"
                            WidthRequest="{DynamicResource IconStandardContainerSize}"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="100" />
                            </Border.StrokeShape>
                            <Border.Shadow>
                                <Shadow Brush="#6A5ACD"
                                        Offset="0,4"
                                        Opacity="0.4"
                                        Radius="12" />
                            </Border.Shadow>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RetryFetchCommand}" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="{x:Static fn:GlyphNames.Retry}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="{DynamicResource IconStandardFontSize}"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsRetryBusy, Converter={StaticResource negateBooleanConverter}, FallbackValue=True}" />
                        </Border>
                        <ActivityIndicator
                            IsRunning="{Binding IsRetryBusy, FallbackValue=False}"
                            IsVisible="{Binding IsRetryBusy, FallbackValue=False}"
                            Color="White"
                            WidthRequest="{DynamicResource IconStandardFontSize}"
                            HeightRequest="{DynamicResource IconStandardFontSize}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Opacity="0.95" />
                    </Grid>
                    <!-- Cancel Button (ShowProgress with CanCancelFetch OR HasFetchError) -->
                    <Grid
                        IsVisible="{Binding ShowCancelButton, FallbackValue=False}"
                        HeightRequest="{DynamicResource IconStandardContainerSize}"
                        WidthRequest="{DynamicResource IconStandardContainerSize}"
                        HorizontalOptions="Center"
                        VerticalOptions="Center">
                        <Border
                            BackgroundColor="{DynamicResource ControlBackgroundColor}"
                            HeightRequest="{DynamicResource IconStandardContainerSize}"
                            WidthRequest="{DynamicResource IconStandardContainerSize}"
                            StrokeThickness="0"
                            HorizontalOptions="Center"
                            VerticalOptions="Center">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="100" />
                            </Border.StrokeShape>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding CancelFetchCommand}" />
                            </Border.GestureRecognizers>
                            <Label
                                Text="{x:Static fn:GlyphNames.Xmark}"
                                FontFamily="{x:Static fn:FontFileResources.FontAwesomeSolid}"
                                FontSize="{DynamicResource IconStandardFontSize}"
                                TextColor="{DynamicResource TextSecondaryColor}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center"
                                IsVisible="{Binding IsCancelBusy, Converter={StaticResource negateBooleanConverter}, FallbackValue=True}" />
                        </Border>
                        <ActivityIndicator
                            IsRunning="{Binding IsCancelBusy, FallbackValue=False}"
                            IsVisible="{Binding IsCancelBusy, FallbackValue=False}"
                            Color="{DynamicResource TextSecondaryColor}"
                            WidthRequest="{DynamicResource IconStandardFontSize}"
                            HeightRequest="{DynamicResource IconStandardFontSize}"
                            VerticalOptions="Center"
                            HorizontalOptions="Center"
                            Opacity="0.95" />
                    </Grid>
                </HorizontalStackLayout>
            </Grid>
        </Border>
    </Grid>
</ContentView>

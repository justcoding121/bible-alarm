<?xml version="1.0" encoding="utf-8"?>

<ContentView
    x:Class="Bible.Alarm.Views.Shared.ProgressIndicator"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:core="clr-namespace:Syncfusion.Maui.Core;assembly=Syncfusion.Maui.Core">
    <Border
        IsVisible="{Binding ShowProgress}"
        BackgroundColor="{DynamicResource CardBackgroundColor}"
        StrokeThickness="0"
        Padding="{DynamicResource PaddingThickness24_20}"
        MinimumWidthRequest="{DynamicResource ContentWidthLarge}"
        ZIndex="1000">
        <Border.StrokeShape>
            <RoundRectangle CornerRadius="16" />
        </Border.StrokeShape>
        <Grid
            HorizontalOptions="Center"
            VerticalOptions="Center"
            RowSpacing="12"
            WidthRequest="{DynamicResource ContentWidthMedium}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Label Grid.Row="0"
                FontSize="{DynamicResource LargeFontSize}"
                FontAttributes="Bold"
                HorizontalOptions="Fill"
                HorizontalTextAlignment="Center"
                Text="{Binding ProgressText}"
                TextColor="{DynamicResource TextPrimaryColor}"
                MinimumHeightRequest="{DynamicResource IconStandardContainerSize}" />
            <ProgressBar Grid.Row="1"
                Margin="{DynamicResource MarginThickness10_5}"
                WidthRequest="{DynamicResource ContentWidthSmall}"
                HorizontalOptions="Center"
                Progress="{Binding ProgressPercent}"
                ProgressColor="{StaticResource PrimaryColor}" />
            <!-- Busy Indicator below progress bar -->
            <Grid Grid.Row="2"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                HeightRequest="{DynamicResource IconStandardContainerSize}"
                WidthRequest="{DynamicResource IconStandardContainerSize}"
                Margin="0,8,0,0">
                <core:SfBusyIndicator
                    IsRunning="{Binding ShowProgress}"
                    AnimationType="DoubleCircle"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"
                    HeightRequest="{DynamicResource IconStandardContainerSize}"
                    WidthRequest="{DynamicResource IconStandardContainerSize}"
                    IndicatorColor="{StaticResource PrimaryColor}" />
            </Grid>
        </Grid>
    </Border>
</ContentView>

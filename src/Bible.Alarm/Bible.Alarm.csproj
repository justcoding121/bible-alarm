<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041.0</TargetFrameworks>
		<!-- CI: restrict to Android only on Linux so iOS workload is not required (Shared stays net10.0). -->
		<TargetFrameworks Condition="'$(BUILD_ANDROID_ONLY)'=='true'">net10.0-android</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Bible.Alarm</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		<!-- Enable compiled bindings optimization for bindings with Source property -->
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		
		<!-- Syncfusion License Key: Read from environment variable SYNCFUSION_LICENSE_KEY during build -->
		<!-- MSBuild automatically reads environment variables, so SYNCFUSION_LICENSE_KEY from Windows env will be available -->
		<!-- The license key is embedded at build time for all platforms -->
		<SyncfusionLicenseKey Condition="'$(SyncfusionLicenseKey)' == ''">$(SYNCFUSION_LICENSE_KEY)</SyncfusionLicenseKey>

		<!-- Application Display Name - Used for Android Auto and app launcher -->
		<ApplicationTitle>Bible Alarm</ApplicationTitle>
		
		<!-- Display Version (Version/PackageVersion must be single value across all target frameworks for NU1105) -->
		<Version>3.22</Version>
		<ApplicationDisplayVersion>3.80</ApplicationDisplayVersion>
		<ApplicationVersion>447</ApplicationVersion>
		<!-- Single source for version-change checks: media index and schedule DB use Bible.Alarm assembly version -->
		<AssemblyInformationalVersion>$(ApplicationDisplayVersion)</AssemblyInformationalVersion>

		<!-- Android-specific -->
		<ApplicationId Condition="'$(TargetFramework)' == 'net10.0-android'">com.jthomas.info.Bible.Alarm</ApplicationId>
		<!-- Minimum OS version must match CommunityToolkit.Maui.MediaElement requirement: Android 8.0 (API 26) -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<AndroidMinSdkVersion Condition="'$(TargetFramework)' == 'net10.0-android'">26</AndroidMinSdkVersion>
		<AndroidSdkVersion Condition="'$(TargetFramework)' == 'net10.0-android'">36</AndroidSdkVersion>
		<AndroidTargetFramework Condition="'$(TargetFramework)' == 'net10.0-android'">v14.0</AndroidTargetFramework>
		<AndroidPackageFormat Condition="'$(TargetFramework)' == 'net10.0-android'">apk</AndroidPackageFormat>
		<!-- Workaround for Android build permission issues -->
		<AndroidUseAapt2 Condition="'$(TargetFramework)' == 'net10.0-android'">true</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi Condition="'$(TargetFramework)' == 'net10.0-android'">false</AndroidCreatePackagePerAbi>

		<!-- iOS-specific -->
		<!-- Allow Xcode 26.3 with .NET for iOS 26.2 workload (Xcode 26.3 has no new APIs; see https://github.com/dotnet/macios/issues/24464) -->
		<ValidateXcodeVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">false</ValidateXcodeVersion>
		<!-- Use interpreter for iOS (EF Core/reflection AOT crashes) and all Android builds (EF queries; Mono JIT !ji->async on MediaTek/ARM64, see dotnet/runtime#122881). Managed AOT must stay off on Android (RunAOTCompilation + AndroidAotEnable) or XA0119. -->
		<UseInterpreter Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' OR $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">true</UseInterpreter>
		<!-- Minimum OS version set to iOS 16.0 to support modern UNUserNotificationCenter.SetBadgeCount API -->
		<!-- CommunityToolkit.Maui.MediaElement supports iOS 15.0+, but we require 16.0 for modern notification APIs -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
		<!-- iOS SDK version - use 'latest' to automatically use the latest available SDK that matches installed simulator runtimes -->
		<!-- If you encounter simulator runtime mismatch errors, ensure your Mac build host has the correct simulator runtime installed -->
		<!-- To install: Xcode > Settings > Components, or use: xcodebuild -downloadPlatform iOS -->
		<IosSdkVersion Condition="'$(IosSdkVersion)' == ''">latest</IosSdkVersion>
		<!-- iOS Entitlements: Different entitlements for Simulator, Device Debug, and Release -->
		<!-- Simulator: CarPlay enabled (no MFi approval needed) -->
		<!-- Device Debug: CarPlay enabled (MFi approved) -->
		<!-- Release: CarPlay enabled (MFi approved) -->
		<!-- Set property to detect simulator builds -->
		<_IsSimulatorBuild Condition="'$(RuntimeIdentifier)' == 'iossimulator-arm64' OR '$(RuntimeIdentifier)' == 'iossimulator-x64' OR '$(RuntimeIdentifier)' == 'iossimulator-arm64-sim' OR '$(RuntimeIdentifier)' == 'iossimulator-x64-sim'">true</_IsSimulatorBuild>
		<!-- Use simulator entitlements (with CarPlay) for simulator builds -->
		<CodesignEntitlements Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' AND '$(_IsSimulatorBuild)' == 'true'">Platforms\iOS\Entitlements.simulator.plist</CodesignEntitlements>
		<!-- Use debug entitlements (no CarPlay) for device builds -->
		<CodesignEntitlements Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' AND '$(_IsSimulatorBuild)' != 'true'">Platforms\iOS\Entitlements.debug.plist</CodesignEntitlements>
		<!-- Use production entitlements (no CarPlay) for Release builds -->
		<CodesignEntitlements Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">Platforms\iOS\Entitlements.plist</CodesignEntitlements>

		<!-- Windows-specific -->
		<!-- For .NET MAUI 10, minimum supported OS version is Windows 10 version 1809 (10.0.17763.0) with WinUI 3 -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<!-- Specify RuntimeIdentifier for Windows to ensure the correct runtime pack is restored -->
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' AND '$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
		<UseWinUI>true</UseWinUI>
		<WindowsTargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</WindowsTargetPlatformVersion>
		<!-- Allow unsafe blocks for WinRT interop (required for CsWinRT1030) -->
		<AllowUnsafeBlocks Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</AllowUnsafeBlocks>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<!-- Debug mode: Use None (unpackaged) for faster debugging -->
		<WindowsPackageType Condition="'$(Configuration)' == 'Debug'">None</WindowsPackageType>
		<!-- Release mode: Use MSIX to enable toast notifications (requires packaged app) -->
		<WindowsPackageType Condition="'$(Configuration)' == 'Release'">MSIX</WindowsPackageType>
		<!-- Use CoreCLR runtime for Windows (not Mono) -->
		<UseMonoRuntime Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</UseMonoRuntime>
		<DefineConstants Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">$(DefineConstants);WINDOWS</DefineConstants>
		<!-- Disable Windows App SDK Deployment Manager auto-initializer on Windows (Debug and Release). -->
		<!-- Property name must be WindowsAppSdkDeploymentManagerInitialize (lowercase 'dk') - this is what the SDK targets check. -->
		<!-- When true, SDK compiles DeploymentManagerAutoInitializer.cs which uses DeploymentInitializeOptions COM - not registered when exe runs outside MSIX (e.g. F5 from bin\Release). -->
		<WindowsAppSdkDeploymentManagerInitialize Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</WindowsAppSdkDeploymentManagerInitialize>
		<!-- Use RuntimeIdentifierOverride to avoid PRI conflicts with referenced library projects (Release mode only) -->
		<!-- RuntimeIdentifierOverride prevents the build system from aggressively propagating RID-specific asset resolution to library projects -->
		<!-- Note: Use win-x64 format directly - RuntimeIdentifierOverride handles the conversion internally -->
		<RuntimeIdentifierOverride Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' AND '$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</RuntimeIdentifierOverride>

		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		
		<!-- Suppress IL trimming/linking warnings -->
		<!-- MAUI apps use platform-specific linking (AndroidLinkMode, MtouchLink), not .NET trimming -->
		<!-- IL2037: EF Core internal method resolution - safe to suppress as EF handles this at runtime -->
		<!-- IL2026/IL2072/IL2111: Suppress only when trimming is NOT enabled -->
		<NoWarn>$(NoWarn);IL2037</NoWarn>
		<NoWarn Condition="'$(PublishTrimmed)' != 'true'">$(NoWarn);IL2026;IL2072;IL2111</NoWarn>
		<!-- Suppress NU1608 warnings: We've explicitly added newer versions to resolve conflicts -->
		<!-- These warnings occur when transitive dependencies expect older versions but we use newer ones -->
		<NoWarn>$(NoWarn);NU1608</NoWarn>
		<!-- Suppress XC0022: compiled-binding suggestion when x:DataType is not specified -->
		<!-- Shared controls (e.g. ProgressIndicator) get BindingContext from various parent ViewModels -->
		<NoWarn>$(NoWarn);XC0022</NoWarn>
	</PropertyGroup>

	<!-- Interpreter + AOT together is unsupported (XA0119). Release publish defaults RunAOTCompilation=true; AndroidAotEnable alone does not disable it. -->
	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
		<AndroidAotEnable>false</AndroidAotEnable>
		<RunAOTCompilation>false</RunAOTCompilation>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.3" />
		<!-- Note: Microsoft.EntityFrameworkCore.Design is NOT needed here - it's in .tools/Bible.Alarm.DbMigration -->
		<!-- Design tools are only needed for creating migrations, which is done via the DbMigration project -->
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.41" />
		<PackageReference Include="Plugin.StoreReview" Version="6.2.0" />
		<PackageReference Include="AutoMapper" Version="16.1.1" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Fluxor" Version="6.9.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
		<PackageReference Include="Polly" Version="8.6.5" />
		<PackageReference Include="Quartz" Version="3.16.1" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Sinks.Async" Version="2.1.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
		<PackageReference Include="Syncfusion.Maui.Core" Version="32.2.9" />
		<PackageReference Include="Syncfusion.Maui.Buttons" Version="32.2.9" />
		<PackageReference Include="TagLibSharp" Version="2.3.0" />
	</ItemGroup>

	<!-- Android Auto (MediaBrowserServiceCompat) -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
		<PackageReference Include="Xamarin.AndroidX.Media" Version="1.7.1.1" />
		<PackageReference Include="Xamarin.AndroidX.Core" Version="1.17.0.1" />
	</ItemGroup>

	<!-- Exclude JVM Compose runtime annotation to avoid duplicate class conflict -->
	<!-- The Android version is sufficient and including JVM causes duplicate Immutable class -->
	<!-- Add explicit PackageReference with ExcludeAssets to override transitive inclusion -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
		<PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.10.0.1" ExcludeAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Bible.Alarm.Shared\Bible.Alarm.Shared.csproj" />
		<ProjectReference Include="..\..\libraries\CommunityToolkit.Maui.MediaElement\CommunityToolkit.Maui.MediaElement.csproj">
			<Properties>UseMonoRuntime=$(UseMonoRuntime)</Properties>
		</ProjectReference>
	</ItemGroup>
	
	<!-- Configure library project reference for MSIX packaging (Release mode only) -->
	<ItemGroup Condition="'$(Configuration)' == 'Release'">
		<ProjectReference Update="..\..\libraries\CommunityToolkit.Maui.MediaElement\CommunityToolkit.Maui.MediaElement.csproj">
			<Properties>GenerateProjectPriFile=false;UseMonoRuntime=$(UseMonoRuntime)</Properties>
		</ProjectReference>
	</ItemGroup>



	<!-- ProGuard rules to handle Java conflicts -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
		<AndroidProguardConfiguration Include="proguard.cfg" />
	</ItemGroup>

	<!-- App Icon (MauiIcon) - Modern SVG approach for .NET 10.0 with Light/Dark mode support -->
	<ItemGroup>
		<!-- Light Mode Icon (default) -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" BaseSize="512,512" ForegroundScale="0.72" />
		<!-- Dark Mode Icon (for platforms that support theme-aware icons) -->
		<MauiIcon Include="Resources\AppIcon\appicon-dark.svg" ForegroundFile="Resources\AppIcon\appiconfg-dark.svg" Color="#E8E0FF" BaseSize="512,512" ForegroundScale="0.72" Condition="false" />
	</ItemGroup>

	<!-- Splash Screen (MauiSplashScreen) - Modern SVG approach for .NET 10.0 with Light/Dark mode support -->
	<ItemGroup>
		<!-- Light Mode Splash (default) -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="256,256" />
		<!-- Dark Mode Splash (for platforms that support theme-aware splash screens) -->
		<MauiSplashScreen Include="Resources\Splash\splash-dark.svg" Color="#E8E0FF" BaseSize="256,256" Condition="false" />
	</ItemGroup>

	<!-- Fonts -->
	<!-- Font Awesome 7 fonts - explicitly include to ensure they're included in build -->
	<ItemGroup>
		<MauiFont Include="Resources\Fonts\fa_solid_900.otf" />
		<MauiFont Include="Resources\Fonts\fa_regular_400.otf" />
		<MauiFont Include="Resources\Fonts\fa_brands_400.otf" />
	</ItemGroup>

	<!-- Embedded Resources -->
	<ItemGroup>
		<EmbeddedResource Include="..\..\.tools\_index\index.zip">
			<Link>Resources\index.zip</Link>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources\silent_preparing_v2.mp3">
			<Link>Resources\silent_preparing_v2.mp3</Link>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources\schedule.db">
			<Link>Resources\schedule.db</Link>
		</EmbeddedResource>
	</ItemGroup>


	<!-- XAML Files -->
	<ItemGroup>
		<MauiXaml Include="App.xaml" />
		<MauiXaml Include="Views\**\*.xaml" />
	</ItemGroup>
	
	<!-- Exclude Windows-specific files from non-Windows builds -->
	<ItemGroup Condition="!$(TargetFramework.StartsWith('net10.0-windows'))">
		<None Include="Platforms\Windows\**\*.xaml" />
		<None Include="Platforms\Windows\**\*" />
	</ItemGroup>
	
		<!-- Enable Hot Reload for Windows (Debug only) - Must be before EnableDefaultXamlItems -->
		<PropertyGroup Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
			<XamlDebuggingInformation>True</XamlDebuggingInformation>
			<EnableHotReload>true</EnableHotReload>
			<HotReloadAutoRestart>true</HotReloadAutoRestart>
		</PropertyGroup>
		
		<!-- Disable Hot Reload for Android (Debug only) - Must be before EnableDefaultXamlItems -->
		<PropertyGroup Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
			<XamlDebuggingInformation>True</XamlDebuggingInformation>
			<EnableHotReload>false</EnableHotReload>
			<HotReloadAutoRestart>false</HotReloadAutoRestart>
		</PropertyGroup>
		
		<!-- Disable Hot Reload for iOS (Debug only) - Must be before EnableDefaultXamlItems -->
		<PropertyGroup Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
			<XamlDebuggingInformation>True</XamlDebuggingInformation>
			<EnableHotReload>false</EnableHotReload>
			<HotReloadAutoRestart>false</HotReloadAutoRestart>
		</PropertyGroup>
	
		<!-- Disable duplicate XAML compilation - We explicitly include XAML files above -->
		<PropertyGroup>
			<EnableDefaultXamlItems>false</EnableDefaultXamlItems>
		</PropertyGroup>

	<!-- Enable platform-specific multi-targeting for files with platform extensions -->
	<ItemGroup>
		<Compile Update="**\*.Android.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
			<Visible>false</Visible>
		</Compile>
		<Compile Update="**\*.iOS.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
			<Visible>false</Visible>
		</Compile>
		<Compile Update="**\*.Windows.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
			<Visible>false</Visible>
		</Compile>
	</ItemGroup>
	
	<!-- Pre-build task: Replace license key placeholder in AppSettings.cs (Windows: PowerShell; macOS/Linux: bash for iOS/Android CI) -->
	<PropertyGroup>
		<PreBuildEvent Condition="'$(OS)' == 'Windows_NT'">powershell -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)/.scripts/replace-license-key.ps1"</PreBuildEvent>
		<PreBuildEvent Condition="'$(OS)' != 'Windows_NT'">bash "$(MSBuildProjectDirectory)/.scripts/replace-license-key.sh"</PreBuildEvent>
		<!-- Post-build task: Restore license key placeholder to prevent accidental commits -->
		<PostBuildEvent Condition="'$(OS)' == 'Windows_NT'">powershell -ExecutionPolicy Bypass -File "$(MSBuildProjectDirectory)/.scripts/restore-license-key-placeholder.ps1"</PostBuildEvent>
		<PostBuildEvent Condition="'$(OS)' != 'Windows_NT'">bash "$(MSBuildProjectDirectory)/.scripts/restore-license-key-placeholder.sh"</PostBuildEvent>
		<!-- MSIX packaging properties (Release mode only). Use same cert for each build so installs update in place. -->
		<GenerateAppInstallerFile Condition="'$(Configuration)' == 'Release'">True</GenerateAppInstallerFile>
		<AppxPackageSigningEnabled Condition="'$(Configuration)' == 'Release'">True</AppxPackageSigningEnabled>
		<!-- Override with -p:PackageCertificateKeyFile=path or set env PACKAGE_CERTIFICATE_KEY_FILE for a persistent cert. -->
		<PackageCertificateKeyFile Condition="'$(Configuration)' == 'Release' AND '$(PackageCertificateKeyFile)' == ''">Bible.Alarm_TemporaryKey.pfx</PackageCertificateKeyFile>
		<AppxPackageSigningTimestampDigestAlgorithm Condition="'$(Configuration)' == 'Release'">SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision Condition="'$(Configuration)' == 'Release'">True</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled Condition="'$(Configuration)' == 'Release'">True</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts Condition="'$(Configuration)' == 'Release'">True</GenerateTestArtifacts>
		<AppInstallerUri Condition="'$(Configuration)' == 'Release'">C:\Users\YourUsername\Desktop\BibleAlarmPackage</AppInstallerUri>
		<HoursBetweenUpdateChecks Condition="'$(Configuration)' == 'Release'">0</HoursBetweenUpdateChecks>
	</PropertyGroup>
	<!-- Disable IL trimming for Windows Release: WinUI/XAML needs reflection metadata; trimming causes 0xc000027b in Microsoft.UI.Xaml.dll when navigating (e.g. Add schedule). -->
	<PropertyGroup Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PublishTrimmed>false</PublishTrimmed>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios' AND '$(Configuration)'=='Debug'">
	  <CodesignKey>Apple Development: Created via API (65WTR3TZ7L)</CodesignKey>
	  <CodesignProvision>VS: com.jthomas.info.Bible.Alarm Development</CodesignProvision>
	</PropertyGroup>
	<PropertyGroup Condition="'$(TargetFramework)'=='net10.0-ios'">
	  <CodesignKey>Apple Development: Created via API (65WTR3TZ7L)</CodesignKey>
	  <CodesignProvision>VS: com.jthomas.info.Bible.Alarm Development</CodesignProvision>
	</PropertyGroup>

	<!-- Platform-specific resources -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
		<AndroidResource Include="Platforms\Android\Resources\**" />
		<!-- Include assets (car-app-api.level is no longer needed - using metadata approach in AndroidManifest.xml) -->
		<AndroidAsset Include="Platforms\Android\Assets\**" />
	</ItemGroup>
	

	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-ios'))">
		<BundleResource Include="Platforms\iOS\Resources\**" />
		<BundleResource Include="Platforms\iOS\Assets.xcassets\**" />
		<!-- Fonts are automatically handled by MAUI SDK from Resources/Fonts/ -->
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-windows'))">
		<Content Include="Platforms\Windows\Assets\**" />
	</ItemGroup>

	<!-- CarPlay Support Notes:
	     CarPlay is now ACTIVATED:
	     ✅ CarPlay entitlement enabled in Entitlements.plist and Entitlements.debug.plist
	     ✅ UIApplicationSceneManifest added to Info.plist with both main app and CarPlay scenes
	     ✅ [Preserve] attributes added to SceneDelegate and CarPlaySceneDelegate classes
	     ✅ Provisioning profiles regenerated with CarPlay capability
	     
	     To test:
	     - Device: Connect iPhone to CarPlay-enabled vehicle or CarPlay adapter
	     - Simulator: I/O > External Displays > CarPlay
	-->
</Project>
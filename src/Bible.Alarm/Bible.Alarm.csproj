    <PackageReference Include="Plugin.StoreReview" Version="6.2.0" />
  </ItemGroup>
  
  <ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-android'))">
    <PackageReference Include="Xamarin.AndroidX.Browser" Version="1.8.0.9" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\library\Logging\NLog.Targets.Loggly\NLog.Targets.Loggly.csproj" />
    <ProjectReference Include="..\..\library\MediaManager\XamarinMediaManager\XamarinMediaManager.csproj" />
  </ItemGroup>
  

  <ItemGroup>
    <EmbeddedResource Include="App.xaml" />
    <EmbeddedResource Include="UI\Views\**\*.xaml" />
  </ItemGroup>
  
  <!-- Platform-specific code -->
  <ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-android'))">
    <Compile Include="Platforms\Android\**\*.cs" />
    <AndroidResource Include="Platforms\Android\Resources\**" />
  </ItemGroup>
  
  <ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-ios'))">
    <Compile Include="Platforms\iOS\**\*.cs" />

<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Bible.Alarm</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>latest</LangVersion>
		
		<!-- Syncfusion License Key: Read from environment variable SYNCFUSION_LICENSE_KEY during build -->
		<!-- MSBuild automatically reads environment variables, so SYNCFUSION_LICENSE_KEY from Windows env will be available -->
		<!-- The license key is embedded at build time for all platforms -->
		<SyncfusionLicenseKey Condition="'$(SyncfusionLicenseKey)' == ''">$(SYNCFUSION_LICENSE_KEY)</SyncfusionLicenseKey>

		<!-- Display Version -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Android-specific -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<AndroidSdkVersion Condition="'$(TargetFramework)' == 'net10.0-android'">36</AndroidSdkVersion>
		<AndroidTargetFramework Condition="'$(TargetFramework)' == 'net10.0-android'">v14.0</AndroidTargetFramework>
		<AndroidPackageFormat Condition="'$(TargetFramework)' == 'net10.0-android'">apk</AndroidPackageFormat>
		<!-- Workaround for Android build permission issues -->
		<AndroidUseAapt2 Condition="'$(TargetFramework)' == 'net10.0-android'">true</AndroidUseAapt2>
		<AndroidCreatePackagePerAbi Condition="'$(TargetFramework)' == 'net10.0-android'">false</AndroidCreatePackagePerAbi>

		<!-- iOS-specific -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

		<!-- Windows-specific -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<UseWinUI>true</UseWinUI>
		<WindowsTargetPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</WindowsTargetPlatformVersion>
		<!-- Allow unsafe blocks for WinRT interop (required for CsWinRT1030) -->
		<AllowUnsafeBlocks Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</AllowUnsafeBlocks>
		
		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		
		<!-- Suppress IL trimming warnings only when trimming is NOT enabled -->
		<!-- MAUI apps use platform-specific linking (AndroidLinkMode, MtouchLink), not .NET trimming -->
		<!-- If PublishTrimmed is enabled, these warnings will appear and should be addressed -->
		<NoWarn Condition="'$(PublishTrimmed)' != 'true'">$(NoWarn);IL2026;IL2072;IL2111</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="7.0.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.0" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.11" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.11" />
		<PackageReference Include="Plugin.StoreReview" Version="6.2.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
		<PackageReference Include="Fluxor" Version="6.9.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
		<PackageReference Include="Polly" Version="8.6.5" />
		<PackageReference Include="Quartz" Version="3.15.1" />
		<PackageReference Include="Serilog" Version="4.3.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Syncfusion.Maui.Core" Version="27.1.48" />
		<PackageReference Include="Syncfusion.Maui.Buttons" Version="27.1.48" />
		<PackageReference Include="TagLibSharp" Version="2.3.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Bible.Alarm.Shared\Bible.Alarm.Shared.csproj" />
	</ItemGroup>



	<!-- ProGuard rules to handle Java conflicts -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
		<AndroidProguardConfiguration Include="proguard.cfg" />
	</ItemGroup>

	<!-- App Icon (MauiIcon) -->
	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" />
	</ItemGroup>

	<!-- Fonts -->
	<ItemGroup>
		<MauiFont Include="Resources\Fonts\FontAwesome5Free_Solid_900.otf" />
	</ItemGroup>

	<!-- Embedded Resources -->
	<ItemGroup>
		<EmbeddedResource Include="..\..\.tools\_index\index.zip">
			<Link>Resources\index.zip</Link>
		</EmbeddedResource>
		<EmbeddedResource Include="Resources\cool_alarm_tone_notification_sound.mp3">
			<Link>Resources\cool-alarm-tone-notification-sound.mp3</Link>
		</EmbeddedResource>
	</ItemGroup>


	<!-- XAML Files -->
	<ItemGroup>
		<MauiXaml Include="App.xaml" />
		<MauiXaml Include="Views\**\*.xaml" />
	</ItemGroup>
	
	<!-- Exclude Windows-specific files from non-Windows builds -->
	<ItemGroup Condition="!$(TargetFramework.StartsWith('net10.0-windows'))">
		<None Include="Platforms\Windows\**\*.xaml" />
		<None Include="Platforms\Windows\**\*" />
	</ItemGroup>
	
		<!-- Enable Hot Reload for Windows (Debug only) - Must be before EnableDefaultXamlItems -->
		<PropertyGroup Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
			<XamlDebuggingInformation>True</XamlDebuggingInformation>
			<EnableHotReload>true</EnableHotReload>
			<HotReloadAutoRestart>true</HotReloadAutoRestart>
		</PropertyGroup>
		
		<!-- Disable Hot Reload for Android (Debug only) - Must be before EnableDefaultXamlItems -->
		<PropertyGroup Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
			<XamlDebuggingInformation>True</XamlDebuggingInformation>
			<EnableHotReload>false</EnableHotReload>
			<HotReloadAutoRestart>false</HotReloadAutoRestart>
		</PropertyGroup>
		
		<!-- Disable Hot Reload for iOS (Debug only) - Must be before EnableDefaultXamlItems -->
		<PropertyGroup Condition="'$(Configuration)' == 'Debug' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
			<XamlDebuggingInformation>True</XamlDebuggingInformation>
			<EnableHotReload>false</EnableHotReload>
			<HotReloadAutoRestart>false</HotReloadAutoRestart>
		</PropertyGroup>
	
		<!-- Disable duplicate XAML compilation - We explicitly include XAML files above -->
		<PropertyGroup>
			<EnableDefaultXamlItems>false</EnableDefaultXamlItems>
		</PropertyGroup>

	<!-- Enable platform-specific multi-targeting for files with platform extensions -->
	<ItemGroup>
		<Compile Update="**\*.Android.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
			<Visible>false</Visible>
		</Compile>
		<Compile Update="**\*.iOS.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
			<Visible>false</Visible>
		</Compile>
		<Compile Update="**\*.Windows.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
			<Visible>false</Visible>
		</Compile>
	</ItemGroup>
	
	<!-- Replace license key placeholder in AppSettings.cs with actual key from environment variable -->
	<Target Name="ReplaceLicenseKey" BeforeTargets="BeforeBuild" Condition="'$(SyncfusionLicenseKey)' != ''">
		<PropertyGroup>
			<_AppSettingsFile>$(MSBuildProjectDirectory)\AppSettings.cs</_AppSettingsFile>
			<_LicenseKey>$(SyncfusionLicenseKey)</_LicenseKey>
		</PropertyGroup>
		<ReadLinesFromFile File="$(_AppSettingsFile)">
			<Output TaskParameter="Lines" ItemName="AppSettingsLines" />
		</ReadLinesFromFile>
		<ItemGroup>
			<AppSettingsLinesReplaced Include="@(AppSettingsLines->Replace('{{SYNCFUSION_LICENSE_KEY}}', '$(_LicenseKey)'))" />
		</ItemGroup>
		<WriteLinesToFile File="$(_AppSettingsFile)" Lines="@(AppSettingsLinesReplaced)" Overwrite="true" />
	</Target>

	<!-- Platform-specific resources -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-android'))">
		<AndroidResource Include="Platforms\Android\Resources\**" Exclude="Platforms\Android\Resources\raw\cool_alarm_tone_notification_sound.mp3" />
		<AndroidResource Include="Resources\cool_alarm_tone_notification_sound.mp3" Link="Resources\raw\cool_alarm_tone_notification_sound.mp3" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-ios'))">
		<BundleResource Include="Platforms\iOS\Resources\**" />
		<BundleResource Include="Platforms\iOS\Assets.xcassets\**" />
		<BundleResource Include="Resources\cool_alarm_tone_notification_sound.mp3" />
		<BundleResource Include="Resources\Fonts\FontAwesome5Free_Solid_900.otf" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net10.0-windows'))">
		<Content Include="Platforms\Windows\Assets\**" />
		<Content Include="Resources\cool_alarm_tone_notification_sound.mp3" />
	</ItemGroup>
</Project>
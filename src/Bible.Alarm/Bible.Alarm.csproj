<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>Bible.Alarm</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<LangVersion>13.0</LangVersion>

		<!-- Display Version -->
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

	<!-- Android-specific -->
	<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
	<AndroidPackageFormat>apk</AndroidPackageFormat>
	<!-- Workaround for Android build permission issues -->
	<AndroidUseAapt2 Condition="'$(TargetFramework)' == 'net9.0-android'">true</AndroidUseAapt2>
	<AndroidCreatePackagePerAbi Condition="'$(TargetFramework)' == 'net9.0-android'">false</AndroidCreatePackagePerAbi>

		<!-- iOS-specific -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>

		<!-- Windows-specific -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
		<UseWinUI>true</UseWinUI>
		
		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<!-- Suppress duplicate assembly attribute warnings -->
		<NoWarn>$(NoWarn);CS0579</NoWarn>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
		<WarningsAsErrors />
		<WarningsNotAsErrors>CS0579</WarningsNotAsErrors>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="6.1.2" />
		<PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="9.0.10" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.120" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="9.0.120" />
		<PackageReference Include="Plugin.StoreReview" Version="6.2.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Bible.Alarm.Shared\Bible.Alarm.Shared.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-android'))">
		<PackageReference Include="Plugin.CurrentActivity" Version="2.1.0.4" />
	</ItemGroup>


	<!-- ProGuard rules to handle Java conflicts -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-android'))">
		<AndroidProguardConfiguration Include="proguard.cfg" />
	</ItemGroup>

	<!-- App Icon (MauiIcon) -->
	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#512BD4" />
	</ItemGroup>

	<!-- Embedded Resources -->
	<ItemGroup>
		<EmbeddedResource Include="..\..\.tools\_index\index.zip">
			<Link>Resources\index.zip</Link>
		</EmbeddedResource>
	</ItemGroup>


	<!-- XAML Files -->
	<ItemGroup>
		<MauiXaml Include="App.xaml" />
		<MauiXaml Include="UI\Views\**\*.xaml" />
	</ItemGroup>
	
	<!-- Exclude Windows-specific XAML files from MAUI build -->
	<ItemGroup Condition="!$(TargetFramework.StartsWith('net9.0-windows'))">
		<None Include="Platforms\Windows\**\*.xaml" />
	</ItemGroup>
	
	<!-- Disable duplicate XAML compilation -->
	<PropertyGroup>
		<EnableDefaultXamlItems>false</EnableDefaultXamlItems>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
		<PackageReference Include="Quartz" Version="3.13.1" />
		<PackageReference Include="Serilog" Version="4.2.0" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
		<PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
		<PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
	</ItemGroup>

	<!-- Enable platform-specific multi-targeting for files with platform extensions -->
	<ItemGroup>
		<Compile Update="**\*.Android.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
			<Visible>false</Visible>
		</Compile>
		<Compile Update="**\*.iOS.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
			<Visible>false</Visible>
		</Compile>
		<Compile Update="**\*.Windows.cs" Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
			<Visible>false</Visible>
		</Compile>
	</ItemGroup>

	<!-- Platform-specific resources -->
	<ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-android'))">
		<AndroidResource Include="Platforms\Android\Resources\**" Exclude="Platforms\Android\Resources\raw\cool_alarm_tone_notification_sound.mp3" />
		<AndroidResource Include="Resources\cool_alarm_tone_notification_sound.mp3" Link="Resources\raw\cool_alarm_tone_notification_sound.mp3" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-ios'))">
		<BundleResource Include="Platforms\iOS\Resources\**" />
		<BundleResource Include="Platforms\iOS\Assets.xcassets\**" />
		<BundleResource Include="Resources\cool_alarm_tone_notification_sound.mp3" />
	</ItemGroup>

	<ItemGroup Condition="$(TargetFramework.StartsWith('net9.0-windows'))">
		<Content Include="Platforms\Windows\Assets\**" />
		<Content Include="Resources\cool_alarm_tone_notification_sound.mp3" />
	</ItemGroup>
</Project>
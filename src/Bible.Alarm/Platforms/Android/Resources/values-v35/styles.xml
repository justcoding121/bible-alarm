<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- API 35+ (Android 15): Edge-to-edge by default. Omit deprecated statusBarColor and navigationBarColor. -->
    <style name="MainTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <!-- Dark status bar icons (time, battery, signal) so they are visible on light background -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="colorPrimary">#483D8B</item>
        <item name="colorPrimaryDark">#362d68</item>
        <item name="colorAccent">#483D8B</item>
        <item name="android:timePickerDialogTheme">@style/TimePickerDialogTheme</item>
    </style>
</resources>

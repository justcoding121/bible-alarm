<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main theme with white background to match stable version -->
    <style name="MainTheme" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/white</item>
        <item name="android:statusBarColor">@android:color/white</item>
        <item name="android:navigationBarColor">@android:color/white</item>
        <item name="colorPrimary">#483D8B</item>
        <item name="colorPrimaryDark">#362d68</item>
        <item name="colorAccent">#483D8B</item>
        <!-- Use custom time picker dialog theme with larger button text -->
        <item name="android:timePickerDialogTheme">@style/TimePickerDialogTheme</item>
    </style>
    
    <!-- Time picker dialog theme with larger button text to match OS font size -->
    <style name="TimePickerDialogTheme" parent="@style/ThemeOverlay.Material3.MaterialTimePicker">
        <item name="colorPrimary">#483D8B</item>
        <item name="colorAccent">#483D8B</item>
        <!-- Style for dialog buttons (Ok/Cancel) -->
        <item name="buttonBarPositiveButtonStyle">@style/TimePickerDialogButton</item>
        <item name="buttonBarNegativeButtonStyle">@style/TimePickerDialogButton</item>
    </style>
    
    <!-- Dialog button style with larger text -->
    <style name="TimePickerDialogButton" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#483D8B</item>
        <item name="android:minHeight">48dp</item>
    </style>
    
</resources>
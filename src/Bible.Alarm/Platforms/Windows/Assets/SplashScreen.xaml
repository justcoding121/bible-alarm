<?xml version="1.0" encoding="utf-8"?>
<Grid xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      Background="White">
    
    <!-- Main content -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        
        <!-- Alarm bell icon using Image -->
        <Image Source="ms-appx:///Platforms/Windows/Assets/AppIcon.scale-100.png"
               Width="120"
               Height="120"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"
               Stretch="Uniform"/>
        
        <!-- App name -->
        <TextBlock Text="Bible Alarm"
                   FontSize="28"
                   FontWeight="Bold"
                   Foreground="#483D8B"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"/>
        
        <!-- Loading indicator -->
        <Ellipse Width="20"
                 Height="20"
                 Fill="#483D8B"
                 HorizontalAlignment="Center"/>
        
    </StackPanel>
    
</Grid>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    DEBUG ENTITLEMENTS FOR CARPLAY DEVELOPMENT
    
    This file contains the CarPlay Audio entitlement for development and testing purposes.
    Use this file for Debug builds to test CarPlay functionality in:
    - CarPlay Simulator (Xcode)
    - Physical device with development signing
    - Real CarPlay-enabled vehicles (with development provisioning profile)
    
    IMPORTANT:
    - Do NOT include this entitlement in Release/App Store builds until you have
      official approval from Apple's MFi Program (https://mfi.apple.com/)
    - Without MFi approval, App Store submissions with this entitlement will be REJECTED
    - The production Entitlements.plist should NOT contain the carplay-audio key until approved
    
    To use these entitlements for Debug builds, configure your .csproj:
    <CodesignEntitlements Condition="'$(Configuration)' == 'Debug'">Platforms\iOS\Entitlements.debug.plist</CodesignEntitlements>
    <CodesignEntitlements Condition="'$(Configuration)' == 'Release'">Platforms\iOS\Entitlements.plist</CodesignEntitlements>
    -->
    
    <!-- CarPlay Audio Entitlement (MFi approved - enabled for device builds) -->
    <key>com.apple.developer.carplay-audio</key>
    <true/>

    <!-- Time Sensitive Notifications (iOS 15+) - allows alarm notifications to break through Focus/Sleep modes -->
    <key>com.apple.developer.usernotifications.time-sensitive</key>
    <true/>
</dict>
</plist>

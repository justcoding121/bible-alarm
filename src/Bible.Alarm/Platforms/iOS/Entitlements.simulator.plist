<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
    SIMULATOR ENTITLEMENTS
    
    This file is used for iOS Simulator builds only.
    
    Note: CarPlay entitlement can be enabled here for simulator testing once
    the CarPlaySceneDelegate is properly configured with dual-scene support.
    Currently disabled because registering the scene delegate prevents main
    window creation.
    -->
    
    <!-- CarPlay Audio Entitlement (allowed in Simulator without MFi approval) -->
    <!-- Enabled for simulator testing with dual-scene configuration -->
    <key>com.apple.developer.carplay-audio</key>
    <true/>

    <!-- Time Sensitive Notifications (iOS 15+) - allows alarm notifications to break through Focus/Sleep modes -->
    <key>com.apple.developer.usernotifications.time-sensitive</key>
    <true/>
</dict>
</plist>

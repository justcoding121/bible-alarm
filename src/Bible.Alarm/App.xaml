<?xml version="1.0" encoding="utf-8"?>

<Application
    x:Class="Bible.Alarm.App"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Bible.Alarm.Views;assembly=Bible.Alarm"
    xmlns:services="clr-namespace:Bible.Alarm.Services.UI;assembly=Bible.Alarm"
    xmlns:buttons="clr-namespace:Syncfusion.Maui.Buttons;assembly=Syncfusion.Maui.Buttons"
    xmlns:converters="clr-namespace:Bible.Alarm.Common.ViewHelpers.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Include Styles resource dictionary -->
            <ResourceDictionary.MergedDictionaries>
                <views:Styles />
            </ResourceDictionary.MergedDictionaries>
            
            <!-- Global Static Color Resources -->
            <Color x:Key="PrimaryColor">#6A5ACD</Color>
            <Color x:Key="PrimaryLightColor">#9370DB</Color>
            <Color x:Key="ErrorColor">#FF3B30</Color>
            <Color x:Key="WarningColor">#FF9500</Color>
            <Color x:Key="SuccessColor">#34C759</Color>
            
            <!-- 
            Note: AppThemeBinding cannot be defined as resources in Application.Resources.
            Theme-aware colors are set programmatically in App.xaml.cs based on current theme.
            Pages use {DynamicResource} to reference these keys for automatic theme updates.
            -->

            <!-- Global Converters - Shared across all pages for better performance -->
            <!-- Instantiating converters in App.xaml instead of per-page reduces memory and improves load time -->
            <converters:DayColorConverter x:Key="dayColorConverter" x:Shared="True" />
            <converters:DayBackgroundColorConverter x:Key="dayBackgroundColorConverter" x:Shared="True" />
            <converters:DayOpacityConverter x:Key="dayOpacityConverter" x:Shared="True" />
            <converters:IsEnabledColorConverter x:Key="isEnabledColorConverter" x:Shared="True" />
            <converters:ItemTappedEventArgsConverter x:Key="itemTappedConverter" x:Shared="True" />
            <converters:NegateBooleanConverter x:Key="negateBooleanConverter" x:Shared="True" />
            <converters:MultiBoolOrConverter x:Key="multiBoolOrConverter" x:Shared="True" />
            <converters:IsStringNotEmptyConverter x:Key="isStringNotEmptyConverter" x:Shared="True" />
            <converters:BoolToOpacityConverter x:Key="booleanToOpacityConverter" x:Shared="True" />
            <converters:DoubleToBottomThicknessConverter x:Key="doubleToBottomThicknessConverter" x:Shared="True" />

            <!-- Global base styles - apply automatically to all controls of these types -->
            <Style TargetType="Label" BasedOn="{StaticResource BaseLabelStyle}" />
            <Style TargetType="Button" BasedOn="{StaticResource BaseButtonStyle}" />
            <Style TargetType="Entry" BasedOn="{StaticResource BaseEntryStyle}" />
            <Style TargetType="Editor" BasedOn="{StaticResource BaseEditorStyle}" />
            <Style TargetType="Picker" BasedOn="{StaticResource BasePickerStyle}" />
            <Style TargetType="DatePicker" BasedOn="{StaticResource BaseDatePickerStyle}" />
            <Style TargetType="TimePicker" BasedOn="{StaticResource BaseTimePickerStyle}" />
            <Style TargetType="SearchBar" BasedOn="{StaticResource BaseSearchBarStyle}" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.jthomas.info.Bible.Alarm.Tests">
	<application android:allowBackup="false"
	             android:label="Bible Alarm Tests"
	             android:supportsRtl="true"
	             android:debuggable="true" />
	<!--
	  Permissions required by Bible.Alarm services exercised under tests (notifications, alarms, network).
	  Keep this list a strict superset of what tests under Platforms/Android/** can touch so that
	  Android does not throw SecurityException during the test run.
	-->
	<uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
	<uses-permission android:name="android.permission.INTERNET" />
	<uses-permission android:name="android.permission.WAKE_LOCK" />
	<uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
	<uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
	<uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

	<!--
	  No <instrumentation> here on purpose. Custom Android Instrumentation subclasses fail under
	  .NET MAUI: Android calls Instrumentation.onCreate before any managed code touches the type,
	  so the ACW's n_onCreate JNI binding is never registered and the process dies with
	  UnsatisfiedLinkError. Tests are launched as TestRunnerActivity instead via:
	      adb shell am start -W -n com.jthomas.info.Bible.Alarm.Tests/.TestRunnerActivity
	  See [.cursor/rules/testing/multi-platform-tests.mdc] for the full rationale and the
	  on-device results contract under /sdcard/Documents/test-results/.
	-->
</manifest>

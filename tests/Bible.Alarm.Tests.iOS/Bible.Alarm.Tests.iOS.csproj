<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Device-test host for iOS. Builds an .app bundle that xharness installs into a booted iOS simulator
    and runs via `xharness apple test`.

    iOS device tests must be built on macOS (Xcode required); the project file is also evaluable on
    Windows so `dotnet build` against the solution does not fail to load it.

    See tests/README.md and tests/run-tests.ps1 -Platform iOS for the local SSH-to-Mac workflow.

    Code coverage is intentionally NOT collected from this device-test slice — see the "iOS coverage"
    row in [.cursor/rules/testing/multi-platform-tests.mdc] for the decision history (coverlet bakes
    an absolute build-time path the simulator's seatbelt sandbox blocks; AltCover and other
    workarounds were evaluated and ruled out).
  -->
  <PropertyGroup>
    <TargetFramework>net10.0-ios</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Bible.Alarm.Tests.iOS</RootNamespace>
    <AssemblyName>Bible.Alarm.Tests.iOS</AssemblyName>
    <ApplicationId>com.jthomas.info.Bible.Alarm.Tests</ApplicationId>
    <ApplicationTitle>Bible Alarm Tests</ApplicationTitle>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <SupportedOSPlatformVersion>16.0</SupportedOSPlatformVersion>
    <!-- Match the production app: Xcode 26.x is wider than the workload manifest expects. -->
    <ValidateXcodeVersion>false</ValidateXcodeVersion>
    <!-- Interpreter on for iOS (EF Core/reflection AOT crashes on the production app, same here). -->
    <UseInterpreter>true</UseInterpreter>

    <!--
      RuntimeIdentifier is intentionally NOT defaulted here. CI passes `-p:RuntimeIdentifier=iossimulator-arm64`
      (macos-latest on GitHub is Apple Silicon); local Macs pass the matching RID via tests/run-tests.ps1.
      Defaulting to iossimulator-x64 would (a) break Apple Silicon builds and (b) trip the workload check on
      Windows when the IDE evaluates the solution.
    -->

    <!-- Skip Sonar Roslyn analyzers and identify this as a test project (parity with Bible.Alarm.Tests). -->
    <SonarQubeExclude>true</SonarQubeExclude>
    <SonarQubeTestProject>true</SonarQubeTestProject>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>

    <!--
      Device-test hosts run via `xharness apple test` against the built .app; vstest cannot launch a
      net10.0-ios testhost on a Windows/Linux desktop. Telling MSBuild this is *not* a vstest target
      makes `dotnet test Bible.Alarm.sln` skip the .dll instead of failing with hostpolicy.dll-not-
      found / "Failed to run as a self-contained app".
    -->
    <IsTestProject>false</IsTestProject>

    <NoWarn>$(NoWarn);XC0022;NU1608;IL2026;IL2037;IL2072;IL2111</NoWarn>

    <ResizetizerErrorOnDuplicateOutputFilename>false</ResizetizerErrorOnDuplicateOutputFilename>
  </PropertyGroup>

  <!--
    Same MT0180 / MT2301 / NETSDK1144 workaround as src/Bible.Alarm/Bible.Alarm.csproj: this project is
    its own net10.0-ios executable, so it runs the managed linker independently. GitHub macos-latest
    still ships Xcode 16.x while Microsoft.iOS 26 expects Xcode 26 SDK headers for the default full
    link pass. Scope to Actions via GITHUB_ACTIONS only; local Xcode 26+ keeps default linker behaviour.
  -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' AND '$(GITHUB_ACTIONS)' == 'true'">
    <MtouchLink>SdkOnly</MtouchLink>
  </PropertyGroup>

  <ItemGroup>
    <!--
      Reference Bible.Alarm so its iOS-built assembly (with Platforms/iOS/** compiled in) flows into the
      .app bundle.

      UndefineProperties: same rationale as the Android sibling — propagating a RuntimeIdentifier through
      the project ref makes Bible.Alarm.csproj try to write a per-RID runtimeconfig.json into a directory
      MAUI's targets don't pre-create when the project is built transitively.

      AdditionalProperties=EnableCodeSigning=false: undefining RuntimeIdentifier means Bible.Alarm.csproj's
      CodesignKey gate (which keys off RuntimeIdentifier.StartsWith('iossimulator')) sees an empty RID,
      falls through to "set CodesignKey", and then trips Xamarin.Shared.targets(2054) with
      "iOS code signing key '...' not found in keychain" on any host without the matching developer
      identity. Test bundles never need signing — they only ever target the simulator — so we explicitly
      pass EnableCodeSigning=false through the project reference to short-circuit the codesign step in
      the transitive build.

      Bible.Alarm.Shared comes in transitively; an explicit reference re-triggers the same RID issue.
    -->
    <ProjectReference Include="..\..\src\Bible.Alarm\Bible.Alarm.csproj"
                      UndefineProperties="RuntimeIdentifier;RuntimeIdentifiers"
                      AdditionalProperties="EnableCodeSigning=false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Mirror Bible.Alarm.csproj's MAUI version to dodge NU1605 downgrade. See Android sibling for context. -->
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />

    <PackageReference Include="xunit" Version="2.9.3" />

    <!--
      iOS does not get a "Default" entry-point package the way Android does (no instrumentation host), so
      we subclass iOSApplicationEntryPoint from TestRunners.Xunit directly in code.
    -->
    <PackageReference Include="Microsoft.DotNet.XHarness.TestRunners.Xunit" Version="10.0.0-prerelease.26230.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <!--
    Cross-platform tests are reused from Bible.Alarm.Tests; iOS-only smoke tests live under tests/Platforms/iOS.
    Platforms/Windows/** is excluded because those tests reference Bible.Alarm.Platforms.Windows.* types
    that do not exist in the iOS-targeted Bible.Alarm assembly.
  -->
  <ItemGroup>
    <Compile Include="..\Bible.Alarm.Tests\**\*.cs"
             Exclude="..\Bible.Alarm.Tests\bin\**;..\Bible.Alarm.Tests\obj\**;..\Bible.Alarm.Tests\Platforms\**">
      <Link>SharedTests\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
    <Compile Include="..\Platforms\iOS\**\*.cs"
             Exclude="..\Platforms\iOS\bin\**;..\Platforms\iOS\obj\**">
      <Link>PlatformTests\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>

</Project>

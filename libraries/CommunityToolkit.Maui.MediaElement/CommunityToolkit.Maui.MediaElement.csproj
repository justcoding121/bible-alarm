<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- All three TFMs always declared so app reference resolves on any OS (e.g. iOS pipeline on macOS). -->
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-windows10.0.19041.0</TargetFrameworks>
    <!-- CI: restrict to Android only when BUILD_ANDROID_ONLY is set (e.g. Linux runner). -->
    <TargetFrameworks Condition="'$(BUILD_ANDROID_ONLY)'=='true'">net10.0-android</TargetFrameworks>
    <SingleProject>true</SingleProject>
    <UseMaui>true</UseMaui>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- NSObject / UIKit tooling uses GC.SuppressFinalize outside IDisposable.Dispose — intentional for Objective-C lifecycle. -->
    <NoWarn>$(NoWarn);CA1816</NoWarn>
    <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
    

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>CommunityToolkit.Maui</RootNamespace>
    <AndroidGenerateResourceDesigner>false</AndroidGenerateResourceDesigner>
    <!-- Use CoreCLR runtime for Windows (not Mono) -->
    <UseMonoRuntime Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</UseMonoRuntime>
    <!-- Enable MSIX tooling for WinUI resources in the library (Release mode only) -->
    <EnableMsixTooling Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</EnableMsixTooling>
    <!-- Skip PRI file generation - this is a library project using EmbeddedResource, not app resources (Release mode only) -->
    <GenerateProjectPriFile Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</GenerateProjectPriFile>
    <!-- Ensure this library project is not treated as an app for MSIX packaging (Release mode only) -->
    <WindowsPackageType Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">None</WindowsPackageType>
    <GenerateAppxManifest Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">false</GenerateAppxManifest>
    <!-- Fix for PRI error: Force RID-appended output path to match main app expectations (Release mode only) -->
    <AppendRuntimeIdentifierToOutputPath Condition="'$(Configuration)' == 'Release' AND $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">true</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <GitInfoReportImportance>high</GitInfoReportImportance>
    <PackageId>CommunityToolkit.Maui.MediaElement</PackageId>
    <Summary>MediaElement is a view for playing video and audio in your .NET MAUI app.</Summary>
    <Authors>Microsoft</Authors>
    <Owners>Microsoft</Owners>
    <NeutralLanguage>en</NeutralLanguage>
    <Product>CommunityToolkit.Maui (net10.0)</Product>
    <Copyright>© Microsoft Corporation. All rights reserved.</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/CommunityToolkit/Maui</PackageProjectUrl>
    <RepositoryUrl>https://github.com/CommunityToolkit/Maui</RepositoryUrl>
    <PackageReleaseNotes>See https://github.com/CommunityToolkit/Maui/releases</PackageReleaseNotes>
    <DefineConstants>$(DefineConstants);</DefineConstants>
    <UseFullSemVerForNuGet>false</UseFullSemVerForNuGet>
    <Title>.NET MAUI MediaElement</Title>
    <Description>MediaElement is a view for playing video and audio in your .NET MAUI app.</Description>
    <PackageIcon>icon.png</PackageIcon>
    <Product>$(AssemblyName) ($(TargetFramework))</Product>
    <Version>1.0.0-pre1</Version>
    <PackageVersion>$(Version)$(VersionSuffix)</PackageVersion>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageTags>dotnet,maui,toolkit,kit,communitytoolkit,dotnetcommunitytoolkit,mediaelement,mediaplayer,audio,video</PackageTags>
    <Configurations>Debug;Release</Configurations>
    <NoWarn>$(NoWarn);CS1591;CA1422</NoWarn>
    <!-- Suppress NU1608 warnings: We've explicitly added newer versions to resolve conflicts -->
    <!-- These warnings occur when transitive dependencies expect older versions but we use newer ones -->
    <NoWarn>$(NoWarn);NU1608</NoWarn>
  </PropertyGroup>

  <!-- Removed analyzer references - not needed for local build -->

  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer" Version="1.9.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Common" Version="1.9.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.UI" Version="1.9.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Rtsp" Version="1.9.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Hls" Version="1.9.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.ExoPlayer.Dash" Version="1.9.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Media3.Session" Version="1.9.0.1" />
    <!-- Resolve version conflicts: Explicitly reference newer versions to satisfy dependencies -->
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.LiveData.Core.Ktx" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Runtime.Ktx.Android" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Process" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.Common" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModel.Ktx" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.Lifecycle.ViewModelSavedState.Android" Version="2.10.0.1" />
    <PackageReference Include="Xamarin.AndroidX.SavedState" Version="1.4.0.1" />
    <PackageReference Include="Xamarin.AndroidX.SavedState.SavedState.Ktx" Version="1.4.0.1" />

    <!--include the textureview.xml needed for creating textureview in android-->
    <Folder Include="Platforms\Android\Resources\layout\" />
    <AndroidResource Include="Platforms\Android\Resources\layout\textureview.xml" />
  </ItemGroup>

  <!-- Exclude JVM Compose runtime annotation to avoid duplicate class conflict -->
  <!-- The Android version is sufficient and including JVM causes duplicate Immutable class -->
  <!-- Add explicit PackageReference with ExcludeAssets to override transitive inclusion -->
  <ItemGroup Condition="$(TargetFramework.Contains('-android'))">
    <PackageReference Include="Xamarin.AndroidX.Compose.Runtime.Annotation.Jvm" Version="1.10.0.1" ExcludeAssets="all" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.3" />
    <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.41" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" Condition=" '$(Configuration)'=='Release' " PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="ResourceDictionary.windows.xaml">
      <LogicalName>ResourceDictionary.windows.xaml</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Exclude platform-specific files for unsupported platforms -->
  <ItemGroup>
    <!-- Exclude macOS files when not building for macOS -->
    <Compile Remove="**\*.macios.cs" Condition="!$(TargetFramework.Contains('-maccatalyst'))" />
    <!-- Exclude Tizen files -->
    <Compile Remove="**\*.tizen.cs" />
    <!-- Exclude Windows files when not building for Windows -->
    <Compile Remove="**\*.windows.cs" Condition="!$(TargetFramework.Contains('-windows'))" />
    <!-- Exclude iOS files when not building for iOS -->
    <Compile Remove="**\*.ios.cs" Condition="!$(TargetFramework.Contains('-ios'))" />
    <!-- Exclude Android files when not building for Android -->
    <Compile Remove="**\*.android.cs" Condition="!$(TargetFramework.Contains('-android'))" />
    <!-- Exclude net.cs file when building for platform-specific targets (android, ios, windows) -->
    <Compile Remove="**\*.net.cs" Condition="$(TargetFramework.Contains('-android')) OR $(TargetFramework.Contains('-ios')) OR $(TargetFramework.Contains('-windows'))" />
  </ItemGroup>
  
</Project>